# Copier en .env pour le développement local (jamais commité)

# URL publique du site (utilisée pour le sitemap et les balises Open Graph)
PUBLIC_SITE_URL=http://localhost:4321

# --- Administration (PWA secrète) ---
# Chemin secret de l'admin, sans slash : ex. atelier-k7x2m9
ADMIN_PATH=atelier-dev-local
# Mot de passe de l'admin, haché (généré via scripts/hash-mot-de-passe.mjs)
ADMIN_PASSWORD_HASH=
# Clé de signature du cookie de session (chaîne aléatoire longue)
SESSION_SECRET=
# Jeton API Netlify (lecture des soumissions de formulaires) — côté fonctions uniquement
NETLIFY_API_TOKEN=
NETLIFY_SITE_ID=
