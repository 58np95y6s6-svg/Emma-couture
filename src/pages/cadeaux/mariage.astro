---
/**
 * /cadeaux/mariage/ — page d'atterrissage.
 * Intention unique : « cadeau mariage brodé ».
 * Angle : les délais sont longs, et la dentelle ajourée est la pièce
 * qu'on ne trouve pas ailleurs.
 *
 * ⚠️ MAQUETTE. Prix et délais viennent de src/config.ts et du contenu.
 * Vocabulaire : broderie MACHINE. Jamais « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import { SITE, ATELIER, lienWhatsApp } from '../../config';

import photoPapillon from '../../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';
import photoArbre from '../../assets/creations/plein-ecran/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';
import photoArbreDetail from '../../assets/creations/detail/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';

const toutes = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const pour = toutes.filter((c) => c.data.occasions.includes('mariage'));
/* Une seule création est rattachée au mariage pour l'instant. On complète avec
   des pièces voisines — cousues, brodées au prénom — et on l'écrit noir sur
   blanc plutôt que d'inventer des cartes. */
const voisines = toutes.filter((c) => !pour.includes(c) && c.data.cousuMain).slice(0, 2);

const dentelle = pour.find((c) => c.data.categorie === 'decoration-ajouree') ?? pour[0];
const prixDentelle = dentelle?.data.prixDepart ?? null;
const delaiDentelle = dentelle?.data.delaiJours ?? null;

const wa = lienWhatsApp(
  `Bonjour ${SITE.nom}, c'est pour un mariage. J'aimerais parler d'une pièce brodée.`,
);

const og = await getImage({ src: photoPapillon, width: 1200, height: 630, format: 'jpeg' });

const titre = `Cadeau de mariage brodé & dentelle ajourée — ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Cadeau de mariage brodé à ${SITE.ville} (35) : pochettes des témoins, mouchoirs au prénom, dentelle ajourée à coudre sur la robe. Une série pour tout le cortège.`;

/* ⚠️ EXEMPLE : « deux à trois mois avant la date » est une recommandation
   déduite du délai d'atelier, à faire confirmer par Emma. Les prix et les
   délais chiffrés, eux, viennent du contenu des créations. */
const faq = [
  {
    q: 'Combien de temps avant le mariage faut-il s\'y prendre ?',
    r: `Plus tôt que pour n'importe quel autre cadeau. Une série de pochettes ou une pièce en dentelle, ce n'est pas une pièce unique : c'est plusieurs pièces identiques, à valider une fois et à broder l'une après l'autre. Le délai d'atelier est aujourd'hui de ${ATELIER.delaiActuel}${delaiDentelle ? `, et une pièce en dentelle demande environ ${delaiDentelle} jours ouvrés à elle seule` : ''}. Comptez large : deux à trois mois avant la date, vous êtes tranquille.`,
  },
  {
    q: 'Vous brodez directement sur ma robe ?',
    r: `Non, et c'est une bonne nouvelle : je brode la dentelle à part, sans support tissu. Elle vous arrive finie, elle tient toute seule, et elle se pose là où vous voulez — sur la robe, sur un voile, sur une ceinture, sur un ruban. Dites-moi le support dès le départ : ça change la taille et la densité du motif.`,
  },
  {
    q: 'Quel budget prévoir ?',
    r: prixDentelle
      ? `Une pièce en dentelle ajourée commence à ${prixDentelle} €. Pour une série — pochettes, mouchoirs, rubans du cortège — le prix dépend du support et du nombre de pièces : je vous fais un devis chiffré avant de commencer, sans surprise ensuite.`
      : `Le prix dépend du support et du nombre de pièces. Je vous fais un devis chiffré avant de commencer, sans surprise ensuite.`,
  },
  {
    q: 'Vous pouvez broder la même chose pour tous les témoins ?',
    r: `Oui, c'est même le cas le plus fréquent : même motif, même fil, un prénom différent sur chaque pièce. Envoyez-moi la liste des prénoms en une fois, avec l'orthographe exacte — c'est la seule chose que je ne peux pas deviner.`,
  },
  {
    q: 'Et si le motif ne me plaît pas ?',
    r: `Vous le voyez avant moi. Je vous envoie le dessin, vous dites oui ou vous demandez un changement. Tant que ce n'est pas piqué, tout est possible — et sur un mariage, c'est exactement pour ça qu'il faut de la marge dans le calendrier.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[{ nom: 'Cadeau de mariage', url: '/cadeaux/mariage/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <!-- ===================== EN-TÊTE PLEINE LARGEUR ===================== -->
  <section class="bande mar-tete">
    <div class="mar-tete__fond">
      <Image
        src={photoPapillon}
        alt="Papillon brodé en dentelle ajourée, ailes rouges et noires, surmonté de coquelicots"
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="mar-mot">
      <p class="sourcil sourcil--clair">Mariage — {SITE.ville}, Rennes, toute la France</p>
      <h1>Un mariage, ça se brode<br /><em>bien avant le jour J.</em></h1>
      <p class="mar-chapo">
        Pochettes des témoins, mouchoirs au prénom, dentelle ajourée à coudre sur la robe&nbsp;:
        je brode les pièces de votre mariage à {SITE.ville}&nbsp;(35). Un motif, validé une fois,
        brodé autant de fois qu'il y a de prénoms.
      </p>
      <p class="actions">
        <a class="btn btn--or" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--nuit" href="/contact/?occasion=mariage#devis">Demander un devis</a>
      </p>
    </div>
  </section>

  <!-- ===================== LES TROIS PIÈCES ===================== -->
  <section class="bande mar-quoi">
    <div class="mar-quoi__dire">
      <h2 class="titre-xl">Trois pièces, trois usages.</h2>
      <p class="mesure">
        Le reste se discute&nbsp;: un ruban de bouquet, un coussin d'alliances, une étiquette de
        cadeau d'invité. Dites-moi ce que vous avez en tête, même sans référence.
      </p>
    </div>

    <ul class="pieces">
      <li>
        <p class="pieces__n">La pochette des témoins</p>
        <p>
          Le prénom brodé sur le rabat, le même motif pour tout le cortège. C'est le cadeau qu'on
          donne la veille, et qui sert le lendemain.
        </p>
      </li>
      <li>
        <p class="pieces__n">Le mouchoir brodé</p>
        <p>
          Pour la mère de la mariée, pour le père, pour celui qui va pleurer. Prénom, initiales ou
          la date&nbsp;: ça tient dans un coin, et ça se garde.
        </p>
      </li>
      <li>
        <p class="pieces__n">La dentelle ajourée</p>
        <p>
          Brodée sans tissu, elle tient toute seule. Elle se coud sur une robe, un voile, une
          ceinture. C'est la pièce dont on me parle le plus, et la plus longue à faire.
        </p>
      </li>
    </ul>
  </section>

  <!-- ===================== DENTELLE LIBRE — SECTION SOMBRE ===================== -->
  <section class="bande mar-nuit">
    <figure class="mar-nuit__fig">
      <Image
        src={photoArbre}
        alt="Arbre de vie brodé en dentelle ajourée fil doré, pièce autoportante sans support tissu, sur fond sombre"
        widths={[480, 800, 1200]}
        sizes="(max-width: 62rem) 100vw, 46vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Dentelle libre, fil doré. Aucun tissu dessous&nbsp;: il ne reste que le fil.</figcaption>
    </figure>

    <div class="mar-nuit__dire">
      <p class="sourcil sourcil--clair">Ce qu'on ne trouve presque pas ailleurs</p>
      <h2 class="titre-xl">La dentelle qui<br /><em>tient toute seule.</em></h2>
      <p class="mesure mesure--clair">
        La machine brode dans le vide, sur un support qui disparaît au rinçage. Ce qui reste, c'est
        un motif en fil, ajouré, qu'on peut coudre sur une robe ou glisser dans un cadre.
      </p>
      <p class="mesure mesure--clair">
        Sur un mariage, c'est ce qui permet d'ajouter quelque chose de brodé à une robe déjà
        achetée — sans toucher à la robe avant la dernière minute.
      </p>
      {
        prixDentelle && (
          <p class="prix prix--clair">
            Dentelle ajourée à partir de <b>{prixDentelle} €</b>
            {delaiDentelle ? ` · environ ${delaiDentelle} jours ouvrés` : ''}
          </p>
        )
      }
      <p class="actions">
        <a class="btn btn--or" href="/creations/">Voir les pièces en dentelle</a>
      </p>
    </div>
  </section>

  <!-- ===================== RÉTROPLANNING ===================== -->
  <section class="bande mar-plan">
    <div class="mar-plan__dire">
      <p class="sourcil">Le calendrier</p>
      <h2 class="titre-xl">Quand me parler,<br /><em>et de quoi.</em></h2>
      <p class="mesure">
        Une série, ça ne se rattrape pas en trois jours. Voilà l'ordre dans lequel les choses se
        passent quand tout va bien.
      </p>
    </div>

    {/* ⚠️ EXEMPLE : ce rétroplanning est une recommandation à faire valider par Emma. */}
    <ol class="plan">
      <li>
        <p class="plan__q">3 mois avant</p>
        <p>
          On parle des supports et du nombre de pièces. Je vous dis tout de suite ce qui tient dans
          le délai et ce qui ne tient pas.
        </p>
      </li>
      <li>
        <p class="plan__q">2 mois avant</p>
        <p>
          Je vous envoie le motif. Vous validez l'orthographe des prénoms — c'est le moment de
          vérifier deux fois.
        </p>
      </li>
      <li>
        <p class="plan__q">1 mois avant</p>
        <p>
          Je brode la série. Délai d'atelier actuel&nbsp;: <b>{ATELIER.delaiActuel}</b>.
        </p>
      </li>
      <li>
        <p class="plan__q">2 semaines avant</p>
        <p>
          Vous avez les pièces en main. Il reste du temps pour les faire coudre, les emballer, ou
          changer d'avis sur un détail.
        </p>
      </li>
    </ol>

    <p class="actions">
      <a class="btn btn--wa" href={wa}>Donner ma date de mariage</a>
      <a class="btn btn--creux" href="/sur-mesure/">Comment se passe une commande</a>
    </p>
  </section>

  <!-- ===================== CRÉATIONS ===================== -->
  <section class="bande mar-creations">
    <div class="tete">
      <h2 class="titre-xl">Ce qui existe déjà en photo.</h2>
      <p class="mesure">
        Les pochettes et les mouchoirs partent chez les client·es avant que j'aie pensé à les
        photographier&nbsp;: ils ne sont pas encore sur le site. Voici les pièces que je peux vous
        montrer aujourd'hui, dentelle libre comprise.
      </p>
      <p class="indice"><span aria-hidden="true">→</span> faites défiler la rangée</p>
    </div>

    <div class="rangee" tabindex="0" role="region" aria-label="Créations pour un mariage">
      {pour.map((c, i) => <CarteCreation creation={c} prioritaire={i === 0} />)}
      {voisines.map((c) => <CarteCreation creation={c} />)}
      <div class="rangee__fin">
        <p>Une pochette de témoin, <b>ça se fabrique de zéro</b>.</p>
        <p class="rangee__note">
          Tissu, doublure, prénom&nbsp;: demandez-moi des photos de celles déjà parties, je vous les
          envoie par message.
        </p>
      </div>
    </div>

    <p class="mar-lien">
      <a class="btn btn--creux" href="/creations/">Voir toutes les créations</a>
    </p>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="bande mar-faq" id="questions">
    <h2 class="titre-xl">Cinq questions<br /><em>avant de vous lancer.</em></h2>
    <div class="faq">
      {
        faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.r}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ===================== APPEL FINAL ===================== -->
  <section class="bande mar-fin" id="devis">
    <figure class="mar-fin__fig">
      <Image
        src={photoArbreDetail}
        alt="Gros plan sur la dentelle ajourée : les fils dorés se croisent sans support tissu"
        widths={[320, 480, 700]}
        sizes="(max-width: 62rem) 62vw, 20rem"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="mar-fin__mot">
      <h2 class="titre-xl">Vous avez une date.<br /><em>Commençons par là.</em></h2>
      <p class="mesure">
        Dites-moi le jour du mariage et le nombre de personnes à équiper. Je réponds dans la journée
        avec un prix, un délai et ce qui est encore possible dans le temps qui reste.
      </p>
      <p class="actions">
        <a class="btn btn--wa" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--creux" href="/contact/?occasion=mariage#devis">Remplir le formulaire</a>
      </p>
      <p class="mar-fin__note">{ATELIER.zones}.</p>
    </div>
  </section>
</Base>

<style>
  /* Le sourcil global est en `white-space: nowrap` : les libellés d'une page
     occasion sont plus longs que ceux de l'accueil et débordaient à 320 px.
     Ici, ils passent à la ligne, et le filet disparaît sur petit écran. */
  /* Sur fond sombre, le vert de `.btn--wa` disparaît dans la section : le
     bouton principal passe en doré (fort contraste), le secondaire prend un
     liseré clair. */
  .btn--nuit {
    color: var(--coquille);
    border-color: color-mix(in oklab, var(--coquille) 48%, transparent);
    background: rgb(255 255 255 / 0.06);
  }
  .btn--nuit::before {
    background: var(--coquille);
  }
  .btn--nuit:hover {
    color: var(--encre);
    border-color: var(--coquille);
  }

  .sourcil {
    /* `flex-wrap` d'abord : le filet pointillé passe à la ligne suivante
       plutôt que d'écraser le libellé, qui ne se coupe donc que s'il est
       vraiment trop long pour toute la largeur. */
    white-space: normal;
    flex-wrap: wrap;
    line-height: 1.5;
  }
  @media (max-width: 40rem) {
    .sourcil::after {
      display: none;
    }
  }

  /* ---------------------------------------------------------------------------
     EN-TÊTE — photo pleine largeur, texte posé dessus. Volontairement très
     différent du bandeau scindé des autres pages occasions.
  --------------------------------------------------------------------------- */
  .mar-tete {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 7vw, 5.5rem);
    color: var(--coquille);
    background: var(--vert);
  }
  .mar-tete__fond {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .mar-tete__fond :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
    opacity: 0.5;
    filter: saturate(0.85);
  }
  .mar-tete::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(72% 70% at 12% 26%, color-mix(in oklab, var(--mauve) 78%, #000) 0%, transparent 72%),
      linear-gradient(168deg, rgb(24 20 24 / 0.82), rgb(24 20 24 / 0.62) 55%, rgb(20 26 20 / 0.9));
  }
  .mar-mot {
    min-width: 0;
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.3rem);
    justify-items: start;
    max-width: 46rem;
  }
  .mar-mot h1 em {
    color: color-mix(in oklab, var(--rose) 78%, var(--dore));
  }
  .mar-chapo {
    font-size: var(--t-chapo);
    line-height: 1.5;
    max-width: 34rem;
    color: color-mix(in oklab, var(--coquille) 88%, var(--rose));
  }

  /* ---------------------------------------------------------------------------
     TROIS PIÈCES — un index en trois colonnes, sans photo : ce sont des
     usages, pas des produits en stock.
  --------------------------------------------------------------------------- */
  .mar-quoi {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    row-gap: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .mar-quoi__dire {
    min-width: 0;
    display: grid;
    gap: 0.9rem;
  }
  .pieces {
    min-width: 0;
    display: grid;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    border-block-start: 1px solid color-mix(in oklab, var(--mauve) 40%, transparent);
    padding-block-start: clamp(1rem, 2.5vw, 1.8rem);
  }
  .pieces > li {
    min-width: 0;
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .pieces__n {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.85rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    color: var(--mauve);
  }
  .pieces > li > p:not(.pieces__n) {
    font-size: var(--t-petit);
    line-height: 1.6;
    color: var(--encre-doux);
    max-width: 26rem;
  }

  /* ---------------------------------------------------------------------------
     SECTION SOMBRE — la photo sort par le bord gauche, le texte tient à
     droite. L'inverse de la composition de la page d'accueil.
  --------------------------------------------------------------------------- */
  .mar-nuit {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    row-gap: clamp(1.5rem, 3.5vw, 2.5rem);
    color: var(--coquille);
    background:
      radial-gradient(70% 55% at 88% 8%, color-mix(in oklab, var(--mauve) 62%, var(--vert)) 0%, transparent 62%),
      linear-gradient(170deg, #241E24, var(--vert) 62%, #151B16);
  }
  .mar-nuit__fig {
    grid-column: bord-d / large-f;
    min-width: 0;
    margin: 0;
  }
  .mar-nuit__fig :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0 4px 4px 0;
    box-shadow: 0 34px 60px -44px #000;
  }
  .mar-nuit__fig figcaption {
    padding: 0.65rem var(--marge) 0;
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--rose) 66%, var(--gris));
  }
  .mar-nuit__dire {
    min-width: 0;
    display: grid;
    gap: clamp(0.8rem, 2vw, 1.2rem);
    justify-items: start;
  }
  .mar-nuit .titre-xl em {
    color: var(--dore);
  }

  @media (min-width: 62rem) {
    .mar-nuit {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, 30rem)
        [mi] minmax(0, 32rem)
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: center;
    }
    .mar-nuit__fig {
      grid-column: bord-d / mi;
      grid-row: 1;
    }
    .mar-nuit__fig figcaption {
      padding-inline: 0 0;
      margin-inline-start: var(--marge);
    }
    .mar-nuit__dire {
      grid-column: mi / large-f;
      grid-row: 1;
    }
  }

  /* ---------------------------------------------------------------------------
     RÉTROPLANNING — quatre jalons reliés par un fil pointillé. Le dispositif
     encode une vraie séquence : les numéros seraient redondants, ce sont les
     dates qui portent l'information.
  --------------------------------------------------------------------------- */
  .mar-plan {
    padding-block: clamp(2.75rem, 7vw, 5.5rem);
    row-gap: clamp(1.5rem, 3.5vw, 2.5rem);
    background: color-mix(in oklab, var(--sable) 88%, var(--mauve));
  }
  .mar-plan__dire {
    min-width: 0;
    display: grid;
    gap: 0.9rem;
  }
  .mar-plan .titre-xl em {
    color: var(--mauve);
  }
  .mar-plan .sourcil {
    color: var(--mauve);
  }
  .plan {
    min-width: 0;
    display: grid;
    gap: clamp(1.4rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    position: relative;
  }
  .plan > li {
    min-width: 0;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding-block-start: 1.5rem;
    position: relative;
  }
  /* Le fil : un pointillé horizontal sur ordinateur, vertical en colonne. */
  .plan > li::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0 0;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--mauve) 0 7px,
      transparent 7px 13px
    );
    opacity: 0.65;
  }
  .plan > li::after {
    content: '';
    position: absolute;
    inset-block-start: -3px;
    inset-inline-start: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mauve);
  }
  .plan__q {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--encre);
  }
  .plan > li > p:not(.plan__q) {
    font-size: var(--t-petit);
    line-height: 1.6;
    color: var(--encre-doux);
    max-width: 22rem;
  }
  .plan b {
    font-weight: 500;
    color: var(--encre);
  }

  /* ---------------------------------------------------------------------------
     CRÉATIONS
  --------------------------------------------------------------------------- */
  .mar-creations {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    row-gap: clamp(1.75rem, 4vw, 3rem);
  }
  .rangee__note {
    font-family: 'Jost', sans-serif;
    font-size: var(--t-micro);
    line-height: 1.5;
