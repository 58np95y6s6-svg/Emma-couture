---
/**
 * /cadeaux/mariage/ — page d'atterrissage.
 * Intention unique : « cadeau mariage brodé ». Ne pas y viser la naissance,
 * Noël ni la fête des mères.
 * Angle : les séries (témoins, cortège) qui demandent de l'anticipation, et la
 * dentelle libre, pièce que l'on ne trouve presque nulle part ailleurs.
 *
 * Gabarit commun aux quatre pages occasions : HautDePage (fond de l'occasion)
 * → pièces → dentelle libre (tapis) → Etapes → FAQ → AppelFinal.
 * Une seule création est rattachée au mariage (l'arbre de vie, déjà montré
 * dans la section dentelle) : pas de rangée de cartes, un lien vers /creations/.
 *
 * ⚠️ MAQUETTE. Prix et délais viennent de src/config.ts et du contenu.
 * Vocabulaire : broderie MACHINE. Jamais « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HautDePage from '../../components/HautDePage.astro';
import TeteSection from '../../components/TeteSection.astro';
import ListeLignes from '../../components/ListeLignes.astro';
import LigneFaits from '../../components/LigneFaits.astro';
import Etapes from '../../components/Etapes.astro';
import FAQ from '../../components/FAQ.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, OCCASIONS, LIBELLES, lienWhatsApp } from '../../config';

import photoPapillon from '../../assets/creations/galerie/papillon-brode-dentelle-ajouree-coquelicots.webp';
import photoArbreDetail from '../../assets/creations/detail/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';
import photoOg from '../../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';

const occasion = OCCASIONS.find((o) => o.slug === 'mariage')!;

const toutes = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const pour = toutes.filter((c) => c.data.occasions.includes('mariage'));

const dentelle = pour.find((c) => c.data.categorie === 'decoration-ajouree') ?? pour[0];
const prixDentelle = dentelle?.data.prixDepart ?? null;

const messageWa = 'Bonjour Emma, c’est pour un mariage. J’aimerais vous parler d’une pièce brodée.';
const wa = lienWhatsApp(messageWa);
const lienDevis = '/contact/?occasion=mariage#devis';

const og = await getImage({ src: photoOg, width: 1200, height: 630, format: 'jpeg' });

const titre = `Cadeau de mariage brodé & dentelle ajourée — ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Cadeau de mariage brodé à ${SITE.ville} (35) : pochettes des témoins, mouchoirs au prénom, dentelle ajourée à coudre sur la robe. Une série pour tout le cortège, envoi partout en France.`;

const fil = [{ nom: 'Cadeau de mariage', url: '/cadeaux/mariage/' }];

/* ⚠️ EXEMPLE : « deux à trois mois avant la date » est une recommandation
   déduite du délai d'atelier, à faire confirmer par Emma. Les prix, eux,
   viennent du contenu des créations. */
const faq = [
  {
    q: 'Combien de temps avant le mariage faut-il commander ?',
    r: `Plus tôt que pour un cadeau isolé. Une série de pochettes se compose de plusieurs pièces identiques, validées une fois puis brodées l’une après l’autre. Deux à trois mois avant la date vous assurent une préparation sereine.`,
  },
  {
    q: 'Brodez-vous directement sur la robe ?',
    r: `Non : la dentelle est brodée séparément, sans support tissu. Elle vous est livrée terminée et se pose ensuite à l’endroit choisi, sur la robe, un voile, une ceinture ou un ruban. Précisez-moi le support dès le départ : il détermine la taille et la densité du motif.`,
  },
  {
    q: 'Quel budget prévoir ?',
    r: prixDentelle
      ? `Une pièce en dentelle ajourée est proposée à partir de ${prixDentelle} €. Pour une série (pochettes, mouchoirs, rubans du cortège), le prix dépend du support et du nombre de pièces : je vous établis un devis détaillé avant toute réalisation.`
      : `Le prix dépend du support et du nombre de pièces. Je vous établis un devis détaillé avant toute réalisation.`,
  },
  {
    q: 'Pouvez-vous broder le même motif pour tous les témoins ?',
    r: `Oui, c’est la demande la plus fréquente : un même motif, un même fil, et un prénom différent sur chaque pièce. Merci de m’envoyer la liste complète en une fois, avec l’orthographe exacte de chaque prénom.`,
  },
  {
    q: 'Que se passe-t-il si le motif ne me convient pas ?',
    r: `Le motif vous est toujours soumis avant réalisation. Vous le validez ou demandez une modification : tant que la broderie n’est pas lancée, tout peut être ajusté. C’est précisément pour cette raison qu’un mariage demande de la marge dans le calendrier.`,
  },
];

const pieces = [
  {
    titre: 'La pochette des témoins',
    texte: 'Le prénom brodé sur le rabat, un même motif pour tout le cortège. Offerte la veille, elle sert le jour même.',
    meta: 'cousue et brodée',
  },
  {
    titre: 'Le mouchoir brodé',
    texte: 'Pour les parents des mariés ou les grands-parents. Un prénom, des initiales ou la date, brodés dans un angle.',
    meta: 'prénom ou initiales',
  },
  {
    titre: 'La dentelle ajourée',
    texte: 'Brodée sans tissu, elle tient seule et se coud sur une robe, un voile ou une ceinture. C’est la pièce la plus longue à réaliser.',
    meta: prixDentelle ? `dès ${prixDentelle} €` : 'sur devis',
    href: '/creations/decoration-ajouree/',
  },
];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil} messageWa={messageWa}>
  <HautDePage
    titre="Cadeaux de mariage brodés et dentelle ajourée"
    fil={fil}
    image={photoPapillon}
    alt="Papillon brodé en dentelle ajourée, ailes rouges et noires, surmonté de coquelicots"
    fond={occasion.fil}
    faits={[
      ...(prixDentelle ? [`Dentelle ajourée dès ${prixDentelle} €`] : []),
      'Un motif pour tout le cortège',
      'Emballage cadeau compris',
    ]}
  >
    <p>
      Pochettes des témoins, mouchoirs au prénom, dentelle ajourée à coudre sur la robe&nbsp;: je
      réalise en broderie machine, à {SITE.ville}&nbsp;(35), les pièces de votre mariage. Un motif
      validé une seule fois, puis brodé pour chaque personne du cortège.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={wa}>{LIBELLES.whatsapp}</a>
    <a slot="actions" class="btn btn--creux btn--grand" href={lienDevis}>{LIBELLES.devis}</a>
  </HautDePage>

  <!-- ===================== LES PIÈCES ===================== -->
  <section class="bande oc-a">
    <TeteSection titre="Les pièces du mariage" />
    <ListeLignes lignes={pieces} />
    <p class="mesure oc-a__note">
      D’autres pièces sont possibles&nbsp;: ruban de bouquet, coussin d’alliances, étiquettes des
      cadeaux d’invités. Les pochettes et les mouchoirs ne sont pas encore photographiés sur le
      site&nbsp;; je vous adresse sur demande des photographies des pièces déjà réalisées.
    </p>
    <p class="oc-a__lien"><a class="lien-fleche" href="/creations/">Toutes les créations</a></p>
  </section>

  <!-- ===================== LA DENTELLE LIBRE (le seul tapis de la page) ===================== -->
  <section class="bande tapis oc-b" aria-labelledby="dentelle-titre">
    <div class="grille">
      <div class="oc-b__dire">
        <h2 id="dentelle-titre">La dentelle libre</h2>
        <p class="chapo">
          La machine brode sur un support qui disparaît au rinçage. Il ne reste que le fil&nbsp;: un
          motif ajouré, autoportant, que l’on coud sur une robe ou que l’on glisse dans un cadre.
        </p>
        <p class="mesure mesure--clair">
          Pour un mariage, elle permet d’ajouter une broderie à une robe déjà achetée, sans
          intervenir sur la robe avant les derniers essayages.
        </p>
        {prixDentelle && <LigneFaits faits={[`Dès ${prixDentelle} €`, 'Sans support tissu']} clair />}
        <p class="actions">
          <a class="btn btn--or" href="/creations/decoration-ajouree/">Voir les pièces en dentelle</a>
        </p>
      </div>
      <figure class="oc-b__fig">
        <Image
          src={photoArbreDetail}
          alt="Gros plan sur la dentelle ajourée : les fils dorés se croisent sans support tissu"
          widths={[400, 640, 900]}
          sizes="(max-width: 48rem) 92vw, 36vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mono">Arbre de vie, fil doré, sans support tissu</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== LE CALENDRIER ===================== -->
  <section class="bande bloc oc-etapes loin">
    <TeteSection titre="Le calendrier recommandé">
      <p>
        Une série se prépare à l’avance. Voici les étapes d’une commande de mariage, de la première
        prise de contact à la remise des pièces.
      </p>
    </TeteSection>
    {/* ⚠️ EXEMPLE : rétroplanning recommandé, à faire valider par Emma. */}
    <Etapes
      etapes={[
        {
          titre: 'Trois mois avant',
          texte: 'Nous définissons les supports et le nombre de pièces. Je vous indique ce qui est réalisable dans le délai.',
        },
        {
          titre: 'Deux mois avant',
          texte: 'Je vous soumets le motif. Vous vérifiez l’orthographe de chaque prénom avant validation.',
          cle: true,
        },
        {
          titre: 'Un mois avant',
          texte: 'Je brode la série, pièce après pièce, puis je prépare l’emballage de chacune.',
        },
        {
          titre: 'Deux semaines avant',
          texte: 'Les pièces vous sont remises. Il reste le temps de les faire coudre, de les emballer ou d’ajuster un détail.',
        },
      ]}
    />
    <p class="actions oc-etapes__suite">
      <a class="lien-fleche" href="/sur-mesure/">Le déroulement d’une commande</a>
    </p>
  </section>

  <FAQ questions={faq} />

  <AppelFinal titre="Préparer votre commande" messageWa={messageWa} lienDevis={lienDevis}>
    <p>
      Indiquez-moi la date du mariage et le nombre de personnes concernées. Je vous réponds avec un
      prix, un délai et ce qu’il est possible de réaliser dans le temps disponible.
    </p>
  </AppelFinal>
</Base>

<style>
  /* Gabarit commun aux pages occasions (mêmes classes oc-* sur les quatre). */
  .oc-a { padding-block: var(--respire) var(--serre); }
  .oc-a__note { margin-block-start: 1.5rem; color: var(--encre-doux); }
  .oc-a__lien { margin-block-start: 1rem; }
  .oc-b .grille { row-gap: 2.5rem; align-items: center; }
  .oc-b__dire { display: grid; gap: 1.25rem; justify-items: start; }
  .oc-b__fig { display: grid; gap: 0.6rem; }
  .oc-b__fig :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-carte); }
  .oc-b figcaption { font-size: var(--t-micro); color: var(--tapis-trait); }
  .oc-etapes { padding-block: var(--respire); }
  .oc-etapes :global(.ts__chapo) { color: var(--encre); }
  .oc-etapes__suite { margin-block-start: 1.5rem; }
  @media (min-width: 48rem) {
    .oc-b__dire { grid-column: 1 / span 6; }
    .oc-b__fig { grid-column: 8 / -1; }
    .oc-b__fig :global(img) { aspect-ratio: 4 / 5; }
  }
</style>
