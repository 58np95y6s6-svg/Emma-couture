---
/**
 * /cadeaux/naissance/ — page d'atterrissage.
 * Intention unique : « cadeau de naissance personnalisé brodé ».
 * Ne pas y viser Noël, le mariage ni la fête des mères.
 * Angle : les informations de naissance (prénom, date, poids, taille) et le
 * calendrier du terme.
 *
 * Gabarit commun aux quatre pages occasions : HautDePage (fond de l'occasion)
 * → section propre à l'occasion → photos → Etapes → créations → FAQ → AppelFinal.
 *
 * ⚠️ MAQUETTE. Prix et délais viennent de src/config.ts et du contenu des
 * créations : provisoires tant qu'Emma ne les a pas confirmés.
 * Vocabulaire : broderie MACHINE. Jamais « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HautDePage from '../../components/HautDePage.astro';
import TeteSection from '../../components/TeteSection.astro';
import Etapes from '../../components/Etapes.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import FAQ from '../../components/FAQ.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, ATELIER, OCCASIONS, lienWhatsApp } from '../../config';

import photoHero from '../../assets/creations/galerie/doudou-plat-brode-prenom-keanu-naissance.webp';
import photoCadre from '../../assets/creations/detail/cadre-naissance-brode-prenom-chambre-bebe.webp';
import photoSac from '../../assets/creations/galerie/sac-a-dos-enfant-brode-prenom-malo.webp';
import photoMachine from '../../assets/creations/detail/machine-a-broder-en-cours-atelier-vitre.webp';
import photoOg from '../../assets/creations/galerie/cadre-naissance-brode-prenom-chambre-bebe.webp';

const occasion = OCCASIONS.find((o) => o.slug === 'naissance')!;

const toutes = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const pour = toutes.filter((c) => c.data.occasions.includes('naissance'));

const prix = pour.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
const prixMini = prix.length ? Math.min(...prix) : null;

const messageWa = `Bonjour ${SITE.nom}, c'est pour une naissance. J'aimerais une pièce brodée au prénom.`;
const wa = lienWhatsApp(messageWa);
const lienDevis = '/contact/?occasion=naissance#devis';

const og = await getImage({ src: photoOg, width: 1200, height: 630, format: 'jpeg' });

const titre = `Cadeau de naissance personnalisé brodé au prénom — ${SITE.ville} & Rennes | ${SITE.nom}`;
const description = `Cadeau de naissance personnalisé, brodé à ${SITE.ville} (35) : doudou, cadre de naissance, bavoir, cape de bain. Prénom, date, poids et taille${prixMini ? `, à partir de ${prixMini} €` : ''}. Envoi partout en France.`;

const fil = [{ nom: 'Cadeau de naissance', url: '/cadeaux/naissance/' }];

/* Questions réellement posées avant une commande de naissance.
   ⚠️ « 30 °C, fil polyester » : à faire confirmer par Emma. */
const faq = [
  {
    q: 'Puis-je commander avant la naissance ?',
    r: `Oui, c'est même la solution la plus confortable. À partir de la date du terme, nous choisissons ensemble le support, l'écriture et la couleur du fil, et je prépare le motif. Il vous suffit ensuite de m'envoyer le prénom et les mesures après la naissance.`,
  },
  {
    q: 'Quel est le délai de réalisation ?',
    r: `Le délai actuel de l'atelier est de ${ATELIER.delaiActuel}, validation du motif comprise. Je vous confirme une date précise dès que le motif est validé.`,
  },
  {
    q: 'Quelles informations peuvent être brodées ?',
    r: `Le prénom, la date et l'heure de naissance, le poids, la taille, ainsi qu'un petit motif si vous le souhaitez. En écriture cursive ou en capitales, dans la couleur de fil de votre choix. Je vous indique ce que chaque support permet d'accueillir.`,
  },
  {
    q: 'Le doudou brodé est-il lavable en machine ?',
    r: `Oui, à 30 degrés. Le fil polyester ne rétrécit pas et ne déteint pas sur les tissus clairs : un doudou brodé s'entretient comme n'importe quel doudou.`,
  },
  {
    q: 'Livrez-vous, ou faut-il venir chercher la pièce ?',
    r: `${ATELIER.zones}. L'emballage cadeau est compris, et je peux expédier directement chez les parents.`,
  },
];

/* Valeurs reprises du cadre « Ambre » photographié plus bas (cohérence
   photo / texte). ⚠️ Accord de la cliente à confirmer avant mise en ligne. */
const fiche = [
  { l: 'Prénom', v: 'Ambre', n: "l'orthographe exacte, en cursive ou en capitales" },
  { l: 'Date', v: '16.01.2024', n: 'ou « 16 janvier 2024 »' },
  { l: 'Heure', v: '14 h 46', n: 'facultatif' },
  { l: 'Poids', v: '3,135 kg', n: '' },
  { l: 'Taille', v: '50 cm', n: '' },
];

const planche = [
  {
    src: photoCadre,
    alt: 'Cadre de naissance brodé au prénom, avec la date, la taille et le poids, accroché dans une chambre de bébé',
    legende: 'Le cadre de naissance, pour la chambre',
  },
  {
    src: photoSac,
    alt: "Sac à dos d'enfant bleu marine, rabat brodé d'étoiles et du prénom Malo",
    legende: "Le sac à dos, pour l'entrée à la crèche",
  },
  {
    src: photoMachine,
    alt: 'Broderie en cours sous la tête de la machine à broder, à l’atelier de Vitré',
    legende: 'La broderie en cours, à l’atelier',
  },
];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil}>
  <HautDePage
    titre="Cadeaux de naissance brodés au prénom"
    fil={fil}
    image={photoHero}
    alt="Doudou plat blanc à pois avec une tête d'ourson, prénom brodé au centre en fil vert"
    fond={occasion.fil}
    faits={[
      ...(prixMini ? [`À partir de ${prixMini} €`] : []),
      `Délai actuel : ${ATELIER.delaiActuel}`,
      'Lavable à 30 °C',
    ]}
  >
    <p>
      Doudou, cadre de naissance, bavoir, cape de bain&nbsp;: je brode à la machine, dans mon
      atelier de {SITE.ville}&nbsp;(35), le prénom, la date, le poids et la taille de l'enfant.
      Le motif vous est soumis avant toute réalisation.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={wa}>Me contacter sur WhatsApp</a>
    <a slot="actions" class="btn btn--creux btn--grand" href={lienDevis}>Demander un devis</a>
  </HautDePage>

  <!-- ===================== LES INFORMATIONS BRODÉES ===================== -->
  <section class="bande oc-a" aria-labelledby="fiche-titre">
    <div class="grille">
      <div class="oc-a__dire">
        <h2 id="fiche-titre">Les informations brodées</h2>
        <p class="mesure">
          Ces informations me permettent de préparer le motif. Vous me les transmettez par message,
          je vous renvoie le motif pour validation&nbsp;: tant que la broderie n'est pas lancée,
          tout peut être modifié.
        </p>
      </div>
      {/* ⚠️ Données d'exemple : format d'une fiche, à confirmer avec la cliente. */}
      <dl class="fiche">
        {
          fiche.map((f) => (
            <div>
              <dt class="mono">{f.l}</dt>
              <dd>
                <span class="fiche__v">{f.v}</span>
                {f.n && <span class="fiche__n">{f.n}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ===================== PHOTOS ===================== -->
  <section class="bande oc-b" aria-label="Pièces de naissance brodées">
    <ul class="grille planche">
      {
        planche.map((p) => (
          <li>
            <Image
              src={p.src}
              alt={p.alt}
              widths={[320, 480, 700]}
              sizes="(max-width: 48rem) 92vw, 28vw"
              loading="lazy"
              decoding="async"
            />
            <p class="mono">{p.legende}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== AVANT OU APRÈS LA NAISSANCE ===================== -->
  <section class="bande oc-etapes">
    <TeteSection titre="Avant ou après la naissance">
      <p>Les deux sont possibles. Seul le moment de la validation du motif change.</p>
    </TeteSection>
    <Etapes
      etapes={[
        {
          titre: 'Pendant la grossesse',
          texte:
            "C'est le moment idéal. À partir de la date du terme, nous choisissons le support, l'écriture et la couleur du fil, et je prépare le motif. Après la naissance, vous m'envoyez le prénom et les mesures par WhatsApp.",
        },
        {
          titre: 'Après la naissance',
          texte: `Toutes les informations sont connues : la commande peut être lancée immédiatement. Le délai actuel de l'atelier est de ${ATELIER.delaiActuel}, validation du motif comprise.`,
        },
        {
          titre: 'Pour une visite très proche',
          texte:
            "Contactez-moi directement par WhatsApp plutôt que par le formulaire. Je vous indique sans attendre ce qu'il est possible de réaliser dans le temps disponible.",
        },
      ]}
    />
    <p class="actions oc-etapes__suite">
      <a class="lien-fleche" href="/sur-mesure/">Le déroulement d'une commande</a>
    </p>
  </section>

  <!-- ===================== CRÉATIONS ===================== -->
  <section class="bande oc-creations loin">
    <TeteSection titre="Créations pour une naissance" variante="duo">
      <p>
        Chacune peut servir de point de départ&nbsp;: le support, le fil ou l'écriture se modifient
        selon vos souhaits. Je brode également bavoirs, capes de bain et gigoteuses, dont je vous
        adresse des photographies sur demande.
      </p>
      <a slot="lien" class="lien-fleche" href="/creations/naissance/">Toutes les créations naissance</a>
    </TeteSection>
    <div class="rangee" tabindex="0" role="region" aria-label="Créations pour une naissance, rangée défilante">
      {pour.map((c) => <CarteCreation creation={c} />)}
    </div>
  </section>

  <FAQ questions={faq} />

  <AppelFinal titre="Votre demande" messageWa={messageWa} lienDevis={lienDevis}>
    <p>
      Le prénom, ou simplement la date du terme s'il n'est pas encore choisi. Je vous réponds avec
      un prix, un délai et une proposition de motif, sans engagement de votre part. Emballage
      cadeau compris.
    </p>
  </AppelFinal>
</Base>

<style>
  /* Gabarit commun aux pages occasions (mêmes classes oc-* sur les quatre). */
  .oc-a { padding-block: var(--respire) var(--serre); }
  .oc-a .grille { row-gap: 2rem; }
  .oc-a__dire { display: grid; gap: 1rem; align-content: start; }
  .oc-b { padding-block: var(--serre); }
  .oc-etapes { padding-block: var(--serre); }
  .oc-etapes__suite { margin-block-start: 1.5rem; }
  .oc-creations { padding-block: var(--serre); }

  /* La fiche : grandes valeurs, filets pleins. */
  .fiche { border-block-start: 1px solid color-mix(in oklab, var(--encre) 20%, transparent); }
  .fiche > div {
    display: grid; gap: 0.2rem 1.5rem; align-items: baseline;
    padding-block: 1rem;
    border-block-end: 1px solid color-mix(in oklab, var(--encre) 15%, transparent);
  }
  .fiche dt { font-size: var(--t-micro); color: var(--gris); }
  .fiche dd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1.2rem; }
  .fiche__v { font-family: var(--f-titre); font-size: var(--t-h2); line-height: 1; }
  .fiche__n { font-size: var(--t-petit); color: var(--encre-doux); }

  /* Trois photos 4:5, mêmes forme et hauteur. */
  .planche { row-gap: 2rem; }
  .planche li { display: grid; gap: 0.6rem; align-content: start; }
  .planche :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--r-m); }
  .planche p { font-size: var(--t-micro); color: var(--gris); }

  @media (min-width: 48rem) {
    .oc-a__dire { grid-column: 1 / span 4; }
    .fiche { grid-column: 5 / -1; }
    .fiche > div { grid-template-columns: minmax(0, 7rem) minmax(0, 1fr); }
    .planche li { grid-column: span 4; }
  }
</style>
