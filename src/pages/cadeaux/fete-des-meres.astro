---
/**
 * /cadeaux/fete-des-meres/ — page d'atterrissage.
 * Intention unique : « cadeau fête des mères brodé ». Ne pas y viser la
 * naissance, le mariage ni Noël.
 * Angle : choisir l'objet d'après la personne ; la date est fixe et connue
 * d'avance, donc calculée au build, jamais écrite en dur.
 *
 * ⚠️ MAQUETTE. Prix et délais viennent de src/config.ts et du contenu.
 * Vocabulaire : broderie MACHINE. « Cousu main » ne vaut que pour les
 * trousses, sacs et tabliers qu'Emma confectionne.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import { SITE, ATELIER, lienWhatsApp } from '../../config';

import photoDrap from '../../assets/creations/galerie/serviette-brodee-prenom-alicia-rose.webp';
import photoTrousse from '../../assets/creations/galerie/trousse-cousue-main-brodee-prenom-lisa.webp';
import photoTambour from '../../assets/creations/galerie/tambour-decoratif-brode-fee-rouge.webp';
import photoBanane from '../../assets/creations/galerie/sac-banane-cousu-main-broderie-chats.webp';
import photoFinal from '../../assets/creations/plein-ecran/tambour-decoratif-brode-fee-rouge.webp';

/* ---------------------------------------------------------------------------
   La fête des mères en France : dernier dimanche de mai, sauf si c'est la
   Pentecôte — dans ce cas, premier dimanche de juin. Calculée au build.
--------------------------------------------------------------------------- */
function paques(an: number): Date {
  const A = an % 19;
  const B = Math.floor(an / 100);
  const C = an % 100;
  const D = Math.floor(B / 4);
  const E = B % 4;
  const F = Math.floor((B + 8) / 25);
  const G = Math.floor((B - F + 1) / 3);
  const H = (19 * A + B - D - G + 15) % 30;
  const I = Math.floor(C / 4);
  const K = C % 4;
  const L = (32 + 2 * E + 2 * I - H - K) % 7;
  const M = Math.floor((A + 11 * H + 22 * L) / 451);
  const mois = Math.floor((H + L - 7 * M + 114) / 31);
  const jour = ((H + L - 7 * M + 114) % 31) + 1;
  return new Date(Date.UTC(an, mois - 1, jour));
}

function feteDesMeres(an: number): Date {
  const dernierDimancheMai = new Date(Date.UTC(an, 4, 31));
  dernierDimancheMai.setUTCDate(31 - ((dernierDimancheMai.getUTCDay() + 7) % 7));
  const pentecote = new Date(paques(an).getTime() + 49 * 86400000);
  if (dernierDimancheMai.getTime() === pentecote.getTime()) {
    const juin = new Date(Date.UTC(an, 5, 1));
    juin.setUTCDate(1 + ((7 - juin.getUTCDay()) % 7));
    return juin;
  }
  return dernierDimancheMai;
}

const aujourdhui = new Date();
const anneeCourante = aujourdhui.getUTCFullYear();
const prochaine =
  feteDesMeres(anneeCourante).getTime() >= aujourdhui.getTime()
    ? feteDesMeres(anneeCourante)
    : feteDesMeres(anneeCourante + 1);

/* ⚠️ EXEMPLE : trois semaines de marge avant la date. À faire confirmer par
   Emma — c'est elle qui sait combien de commandes elle peut tenir en mai. */
const MARGE_JOURS = 21;
const dateLimite = new Date(prochaine.getTime() - MARGE_JOURS * 86400000);

const fmtLong = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const fmtCourt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const fmtJour = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', timeZone: 'UTC' });
const fmtMois = new Intl.DateTimeFormat('fr-FR', { month: 'long', timeZone: 'UTC' });
const dateFete = fmtLong.format(prochaine);
const anneeFete = prochaine.getUTCFullYear();
const dateFeteCourte = fmtCourt.format(prochaine);
const jourFete = fmtJour.format(prochaine);
const moisFete = fmtMois.format(prochaine);
const isoFete = prochaine.toISOString().slice(0, 10);
const dateLimiteTexte = fmtLong.format(dateLimite);
const isoLimite = dateLimite.toISOString().slice(0, 10);

const toutes = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const pour = toutes.filter((c) => c.data.occasions.includes('fete-des-meres'));
const prix = pour.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
const prixMini = prix.length ? Math.min(...prix) : null;

const trousse = toutes.find((c) => c.id === 'trousse-cousue-brodee');
const drap = toutes.find((c) => c.id === 'drap-de-bain-brode-prenom');

/* Quatre entrées d'après la personne, pas d'après un catalogue.
   Prix seulement quand une création existe et porte un prix. */
const idees = [
  {
    pour: 'Pour la plage ou la piscine',
    quoi: 'Le drap de bain au prénom',
    dit: 'Prénom brodé en écriture cursive, accompagné d’un motif floral si vous le souhaitez. Il se reconnaît immédiatement.',
    photo: photoDrap,
    alt: 'Drap de bain rose poudré brodé au prénom en lettres cursives violettes',
    prix: drap?.data.prixDepart ?? null,
    lien: drap ? `/creations/${drap.id}/` : null,
  },
  {
    pour: 'Pour le sac à main',
    quoi: 'La trousse cousue main, brodée au prénom',
    dit: 'Je la couds avant de la broder. Le tissu se choisit parmi mes coupons, ou vous me confiez le vôtre.',
    photo: photoTrousse,
    alt: 'Trousse matelassée en tissu blanc à motif de feuillage, cousue main, brodée au prénom en fil doré',
    prix: trousse?.data.prixDepart ?? null,
    lien: trousse ? `/creations/${trousse.id}/` : null,
  },
  {
    pour: 'Pour la maison',
    quoi: 'Le tambour décoratif',
    dit: 'Un motif brodé, tendu dans son cadre et prêt à accrocher. Un prénom ou une date peuvent y figurer.',
    photo: photoTambour,
    alt: 'Tambour à broder décoratif avec une fée brodée en fil rouge, prêt à accrocher',
    prix: null,
    lien: null,
  },
  {
    pour: 'Pour les sorties',
    quoi: 'Le sac banane cousu main',
    dit: 'Cousu à l’atelier, brodé du motif de votre choix. Celui-ci porte un semis de petits chats.',
    photo: photoBanane,
    alt: 'Sac banane cousu main, tissu brodé de petits chats',
    prix: null,
    lien: null,
  },
];

const wa = lienWhatsApp(
  `Bonjour ${SITE.nom}, c'est pour la fête des mères. J'aimerais une pièce brodée à son prénom.`,
);

const og = await getImage({ src: photoTrousse, width: 1200, height: 630, format: 'jpeg' });

const titre = `Cadeau fête des mères brodé et personnalisé — ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Cadeau de fête des mères brodé au prénom à ${SITE.ville} (35) : trousse cousue main, drap de bain, tablier, tambour décoratif. Le ${dateFeteCourte} ${anneeFete} : commande avant le ${fmtCourt.format(dateLimite)}.`;

const faq = [
  {
    q: 'Jusqu’à quelle date puis-je commander pour la fête des mères ?',
    r: `La fête des mères a lieu le ${dateFete} ${anneeFete}. Je vous recommande de commander avant le ${dateLimiteTexte}, afin de disposer du temps nécessaire à la validation du motif, à la broderie et à l'expédition. Au-delà, contactez-moi sur WhatsApp : je vous indiquerai ce qui reste réalisable.`,
  },
  {
    q: 'Quels sont les prix ?',
    r: [
      drap?.data.prixDepart ? `Le drap de bain au prénom est proposé à partir de ${drap.data.prixDepart} €` : null,
      trousse?.data.prixDepart ? `la trousse cousue main à partir de ${trousse.data.prixDepart} €` : null,
    ]
      .filter(Boolean)
      .join(', ')
      .concat(
        `. Pour un tablier, des serviettes ou un tambour décoratif, le prix dépend du support et de la taille du motif : je vous communique un prix ferme avant toute réalisation.`,
      ),
  },
  {
    q: 'Je ne sais pas quel objet choisir.',
    r: `Décrivez-moi plutôt la personne : ses occupations, ce qu'elle emporte au quotidien, les couleurs qu'elle porte. Je vous propose deux ou trois pistes chiffrées, parmi lesquelles vous choisissez.`,
  },
  {
    q: 'Peut-on broder les prénoms des enfants plutôt que le sien ?',
    r: `Oui, c'est une demande fréquente : les prénoms des enfants ou des petits-enfants, les uns sous les autres. Au-delà de quatre ou cinq prénoms, un support plus grand, comme un tablier ou un drap de bain, est préférable.`,
  },
  {
    q: 'La pièce est-elle emballée, et pouvez-vous l’expédier ?',
    r: `L'emballage cadeau est compris. ${ATELIER.zones}. Je peux également expédier directement à la destinataire.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[{ nom: 'Cadeau fête des mères', url: '/cadeaux/fete-des-meres/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <div class="pg">
    <!-- ===================== HAUT DE PAGE ===================== -->
    <section class="bande fm-ouv">
      <nav class="ariane" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span aria-hidden="true">/</span>
        <span aria-current="page">Cadeau fête des mères</span>
      </nav>

      <h1>Cadeaux de fête des mères brodés au prénom</h1>

      <div class="fm-ouv__dire">
        <p class="chapo">
          Trousse cousue main, drap de bain, tablier, tambour décoratif&nbsp;: je brode à la
          machine, dans mon atelier de {SITE.ville}&nbsp;(35), des cadeaux personnalisés à son
          prénom. Vous me donnez le prénom et la couleur, je vous soumets le motif avant
          réalisation.
        </p>
        <p class="actions">
          <a class="btn btn--wa btn--grand" href={wa}>Écrire sur WhatsApp</a>
          <a class="btn btn--creux btn--grand" href="/contact/?occasion=fete-des-meres#devis">Demander un devis</a>
        </p>
        {prixMini && (
          <p class="prix">À partir de <b>{prixMini}&nbsp;€</b></p>
        )}
      </div>

      <figure class="fm-ouv__photo">
        <Image
          src={photoFinal}
          alt="Tambour à broder décoratif avec une fée brodée en fil rouge, prêt à accrocher"
          widths={[360, 560, 760, 1000]}
          sizes="(max-width: 48rem) 92vw, (max-width: 64rem) 44vw, 30rem"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      {/* ⚠️ La date de la fête des mères est calculée. La MARGE de trois semaines
          est une hypothèse, à faire confirmer par Emma. */}
      <aside class="fm-date" aria-label="Date de la fête des mères et date limite de commande">
        <p class="fm-date__q mono">Fête des mères {anneeFete}</p>
        <time class="fm-date__j" datetime={isoFete}>
          <span>{jourFete}</span>
          <span class="fm-date__m">{moisFete}</span>
        </time>
        <p class="fm-date__lim">
          Commande recommandée avant le <time datetime={isoLimite}>{dateLimiteTexte}</time>.
        </p>
      </aside>
    </section>

    <!-- ===================== LES IDÉES ===================== -->
    <section class="bande fm-idees">
      <div class="fm-idees__tete">
        <h2 class="titre-xl">Choisir selon la personne</h2>
        <p class="mesure">
          Le plus sûr est de partir de ses habitudes&nbsp;: dites-moi comment elle occupe ses
          journées, je vous indique ce qui se prête à la broderie. Quatre exemples.
        </p>
      </div>

      <ul class="idees">
        {
          idees.map((i) => (
            <li class="idee">
              <div class="idee__in">
                <figure class="idee__fig">
                  <Image
                    src={i.photo}
                    alt={i.alt}
                    widths={[320, 480, 700]}
                    sizes="(max-width: 48rem) 88vw, 32vw"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="idee__txt">
                  <p class="idee__pour mono">{i.pour}</p>
                  <h3>{i.quoi}</h3>
                  <p>{i.dit}</p>
                  <p class="prix">
                    {i.prix ? (
                      <Fragment>
                        à partir de <b>{i.prix}&nbsp;€</b>
                      </Fragment>
                    ) : (
                      'prix selon le support, communiqué avant réalisation'
                    )}
                  </p>
                  {i.lien && <a class="lien-fleche" href={i.lien}>Voir la création</a>}
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="actions">
        <a class="btn btn--wa" href={wa}>Me décrire la destinataire</a>
        <a class="lien-fleche" href="/sur-mesure/">Le déroulement d'une commande</a>
      </p>
    </section>

    <!-- ===================== CRÉATIONS ===================== -->
    <section class="bande fm-creations loin">
      <div class="tete tete--duo">
        <h2 class="titre-xl">Créations pour la fête des mères</h2>
        <div class="fm-creations__dire">
          <p class="mesure">
            Le tablier et les serviettes de plage sont également très demandés en mai. Je vous en
            adresse des photographies sur demande.
          </p>
          <a class="lien-fleche" href="/creations/">Toutes les créations</a>
        </div>
      </div>

      <div class="rangee" tabindex="0" role="region" aria-label="Créations pour la fête des mères, rangée défilante">
        {pour.map((c, i) => <CarteCreation creation={c} />)}
        <div class="rangee__fin">
          <p>Le tablier cousu et brodé</p>
          <p class="rangee__note">
            Tissu, poche et prénom sont choisis avec vous. C'est la pièce la plus longue à
            réaliser&nbsp;: je vous conseille de la commander en premier.
          </p>
        </div>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    <section class="bande fm-faq loin" id="questions">
      <h2 class="titre-xl">Questions fréquentes</h2>
      <div class="faq">
        {
          faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.r}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ===================== APPEL FINAL ===================== -->
    <section class="final bande fm-fin" id="devis">
      <div class="final__in">
        <h2 class="titre-geant">Votre demande</h2>
        <p class="chapo">
          Indiquez-moi son prénom et la couleur qu'elle préfère. Je vous réponds avec un prix, un
          délai et une proposition de motif, à valider avant réalisation. Commande recommandée
          avant le <time datetime={isoLimite}>{dateLimiteTexte}</time>.
        </p>
        <p class="actions">
          <a class="btn btn--wa btn--grand" href={wa}>Écrire sur WhatsApp</a>
          <a class="btn btn--or btn--grand" href="/contact/?occasion=fete-des-meres#devis">Remplir le formulaire</a>
        </p>
        <p class="final__note">{ATELIER.delaiReponse} · {ATELIER.zones} · emballage cadeau compris.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Le fil de la page : rouille #A8492A.
     Contrastes : blanc / lin-haut dessus ≈ 5,7:1 ; cette rouille sur le lin
     ≈ 4,8:1 (AA texte courant). */
  .pg { --fil: #A8492A; --fil-sombre: #7A3119; }

  /* ============================ HAUT DE PAGE ============================
     Le titre d'abord, sur toute la largeur ; dessous, trois blocs de
     hauteurs différentes : le texte, la photo, et la date en carton rouille. */
  .fm-ouv {
    padding-block: clamp(1rem, 3vw, 2rem) var(--serre);
    row-gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  .fm-ouv h1 { max-width: 16ch; color: var(--encre); }
  .fm-ouv__dire { display: grid; gap: 1.3rem; justify-items: start; align-content: start; }
  .fm-ouv__photo :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: var(--r-l) var(--r-l) var(--r-l) 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fm-ouv__photo { animation: deroule 1100ms var(--sortie) both; }
    .fm-date { animation: pose 900ms var(--sortie) 350ms both; }
  }
  @keyframes deroule { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes pose { from { transform: translateY(2rem) rotate(4deg); } to { transform: none; } }

  .fm-date {
    position: relative;
    display: grid; gap: 0.6rem; align-content: start;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--fil);
    color: var(--lin-haut);
    border-radius: var(--r-s);
  }
  /* Le carton est perforé en haut, comme une étiquette d'atelier */
  .fm-date::before {
    content: ''; position: absolute; inset: 0.6rem 0.6rem auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, color-mix(in oklab, var(--lin-haut) 60%, transparent) 0 6px, transparent 6px 11px);
  }
  .fm-date__q { font-size: var(--t-micro); color: color-mix(in oklab, var(--lin-haut) 88%, transparent); margin-block-start: 0.6rem; }
  .fm-date__j {
    display: grid;
    font-family: var(--f-titre);
    font-size: clamp(5rem, 3.5rem + 6vw, 9rem);
    line-height: 0.8; letter-spacing: -0.05em;
  }
  .fm-date__m { font-size: 0.34em; letter-spacing: -0.02em; line-height: 1.1; }
  .fm-date__lim {
    padding-block-start: 0.8rem;
    border-block-start: 1px solid color-mix(in oklab, var(--lin-haut) 35%, transparent);
    font-size: var(--t-petit);
  }

  @media (min-width: 48rem) {
    .fm-ouv {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.4)) [a] minmax(0, calc(var(--large) * 0.36))
        [b] minmax(0, calc(var(--large) * 0.24)) [large-f] minmax(var(--marge), 1fr) [bord-f];
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    .fm-ouv h1 { grid-column: large-d / large-f; font-size: clamp(3.6rem, 1rem + 5.6vw, 8rem); max-width: 18ch; }
    .fm-ouv__dire { grid-column: large-d / a; grid-row: 3; }
    .fm-ouv__photo { grid-column: a / large-f; grid-row: 3; }
    .fm-date { grid-column: a / large-f; grid-row: 4; justify-self: end; width: min(100%, 22rem); margin-block-start: -6rem; margin-inline-end: 1rem; }
  }
  @media (min-width: 64rem) {
    .fm-ouv__photo { grid-column: a / b; }
    .fm-date { grid-column: b / large-f; grid-row: 3; align-self: end; margin: 0 0 3rem -3rem; justify-self: stretch; width: auto; }
    .fm-ouv__dire { padding-inline-end: 2rem; }
  }

  /* ============================ LES IDÉES ============================
     Chaque idée est un conteneur : sa mise en page dépend de sa propre
     largeur (@container), pas de l'écran. Les lignes alternent. */
  .fm-idees { padding-block: var(--respire); row-gap: clamp(2.5rem, 5vw, 4rem); }
  .fm-idees__tete { display: grid; gap: 1.1rem; }
  @media (min-width: 56rem) {
    .fm-idees__tete { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; column-gap: 4rem; }
  }
  .idees { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
  .idee { container-type: inline-size; }
  .idee__in { display: grid; gap: 1.2rem; align-items: center; }
  .idee__fig :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--r-m); }
  .idee__txt { display: grid; gap: 0.7rem; justify-items: start; }
  .idee__pour { font-size: var(--t-micro); color: var(--fil); }
  .idee h3 { font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.4rem); line-height: 1; max-width: 16ch; }
  .idee__txt > p:not(.prix):not(.idee__pour) { color: var(--encre-doux); max-width: 30rem; }
  @container (min-width: 40rem) {
    .idee__in { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5cqi, 4rem); }
    .idee:nth-child(even) .idee__fig { order: 2; }
  }
  @container (min-width: 56rem) {
    .idee__in { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); }
    .idee:nth-child(even) .idee__in { grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); }
    .idee:nth-child(even) .idee__txt { padding-inline-start: 12%; }
  }
  /* Le cadre se resserre autour de la photo à l'entrée, comme un tambour */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .idee__fig { animation: cadre linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
    }
  }
  @keyframes cadre {
    from { clip-path: inset(12% 12% 12% 12% round 50%); }
    to { clip-path: inset(0 0 0 0 round var(--r-m)); }
  }

  /* ============================ CRÉATIONS ============================ */
  .fm-creations { padding-block: var(--serre) var(--respire); row-gap: clamp(2rem, 4vw, 3rem); background: color-mix(in oklab, var(--fil) 7%, var(--lin)); }
  .fm-creations__dire { display: grid; gap: 0.8rem; justify-items: start; }
  .rangee__fin {
    display: grid; align-content: center; gap: 0.9rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--r-l);
    border: 1.5px dashed color-mix(in oklab, var(--fil) 50%, transparent);
    scroll-snap-align: start;
  }
  .rangee__fin p:first-child { font-family: var(--f-titre); font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); line-height: 1.05; }
  .rangee__note { font-size: var(--t-petit); color: var(--encre-doux); }

  /* ============================ FAQ ============================ */
  .fm-faq { padding-block: var(--respire) var(--serre); row-gap: 2rem; }
  @media (min-width: 64rem) {
    .fm-faq {
