---
/**
 * /cadeaux/noel/ — page d'atterrissage.
 * Intention unique : « chaussette de Noël brodée prénom / cadeau de Noël
 * personnalisé ». Ne pas y viser la naissance, le mariage ni la fête des mères.
 * Angle : la date limite de commande (traitement fort : c'est la page urgente
 * d'octobre-novembre), et la série — un motif, un prénom par personne.
 *
 * ⚠️ MAQUETTE. Prix et délais viennent de src/config.ts et du contenu des
 * créations : provisoires tant qu'Emma ne les a pas confirmés.
 * Gabarit commun aux quatre pages occasions : HautDePage (fond de l'occasion)
 * → section propre à l'occasion (ici sur le tapis) → Etapes → FAQ → AppelFinal.
 * Une seule création de Noël (la chaussette, déjà en haut de page) : pas de
 * rangée de cartes complétée par des pièces hors sujet, un lien vers la catégorie.
 *
 * Vocabulaire : broderie MACHINE. Jamais « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HautDePage from '../../components/HautDePage.astro';
import TeteSection from '../../components/TeteSection.astro';
import ListeLignes from '../../components/ListeLignes.astro';
import Etapes from '../../components/Etapes.astro';
import FAQ from '../../components/FAQ.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, OCCASIONS, LIBELLES, lienWhatsApp } from '../../config';

import photoChaussette from '../../assets/creations/galerie/chaussette-de-noel-brodee-prenom.webp';

const toutes = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const pour = toutes.filter((c) => c.data.occasions.includes('noel'));

const chaussette = pour[0];
const prixChaussette = chaussette?.data.prixDepart ?? null;

/* ---------------------------------------------------------------------------
   ⚠️ DATE LIMITE DE COMMANDE — À CONFIRMER PAR EMMA.
   Seule source : la fiche « chaussette de Noël » (« à commander avant la
   mi-novembre »). Le 15 est notre lecture de « mi-novembre » : ce n'est pas
   une date qu'elle a donnée. La remplacer par la sienne avant la mise en
   ligne (et, à terme, la piloter depuis l'admin, sans rebuild).
   Seule l'ANNÉE est calculée, pour que la page ne périme pas.
--------------------------------------------------------------------------- */
const LIMITE_JOUR = 15; // [À CONFIRMER PAR EMMA]
const LIMITE_MOIS = 'novembre'; // [À CONFIRMER PAR EMMA]
const maintenant = new Date();
const anneeNoel =
  maintenant.getUTCMonth() === 11 && maintenant.getUTCDate() > 24
    ? maintenant.getUTCFullYear() + 1
    : maintenant.getUTCFullYear();
const isoLimite = `${anneeNoel}-11-${String(LIMITE_JOUR).padStart(2, '0')}`;
const dateLimite = `${LIMITE_JOUR} ${LIMITE_MOIS}`;

const occasion = OCCASIONS.find((o) => o.slug === 'noel')!;

const messageWa = 'Bonjour Emma, c’est pour Noël. J’aimerais des pièces brodées au prénom.';
const wa = lienWhatsApp(messageWa);
const lienDevis = '/contact/?occasion=noel#devis';

const og = await getImage({ src: photoChaussette, width: 1200, height: 630, format: 'jpeg' });

const titre = `Chaussette de Noël brodée au prénom, cadeau personnalisé — ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Chaussette de Noël brodée au prénom et cadeau de Noël personnalisé, brodés à ${SITE.ville} (35)${prixChaussette ? ` dès ${prixChaussette} €` : ''}. Une pièce par personne. Commande avant le ${dateLimite} pour Noël.`;

const fil = [{ nom: 'Cadeau de Noël', url: '/cadeaux/noel/' }];

const faq = [
  {
    q: 'Quelle est la date limite pour recevoir ma commande avant Noël ?',
    r: `Le ${dateLimite}. Au-delà, je ne peux plus garantir une livraison avant le 24 décembre. N’hésitez pas à me contacter malgré tout : je vous indiquerai ce qui reste réalisable.`,
  },
  {
    q: 'Peut-on commander une chaussette par personne ?',
    r: `Oui, c’est la demande la plus courante. Le motif est validé une seule fois, puis brodé pour chaque prénom. Merci de m’envoyer la liste complète en une fois, avec l’orthographe exacte de chaque prénom.`,
  },
  {
    q: 'Combien coûte une chaussette de Noël brodée au prénom ?',
    r: prixChaussette
      ? `À partir de ${prixChaussette} €. Pour un pyjama, un plaid ou une boule, le prix dépend du support et de la taille du motif : je vous donne un prix ferme avant de commencer.`
      : `Le prix dépend du support et de la taille du motif. Je vous donne un prix ferme avant de commencer.`,
  },
  {
    q: 'Le pyjama et le plaid passent-ils en machine ?',
    r: `Oui, à 30 degrés. Le fil polyester ne rétrécit pas et ne déteint pas sur les tissus clairs : la broderie s’entretient comme le vêtement.`,
  },
  {
    q: 'Puis-je vous confier le vêtement ou le plaid à broder ?',
    r: `Oui. Vous pouvez me le remettre en main propre ou me l’envoyer : j’examine le tissu, je vous indique les possibilités de broderie et nous choisissons le fil ensemble. Prévoyez quelques jours supplémentaires pour l’acheminement.`,
  },
];

const menu = [
  { titre: 'La chaussette de cheminée', texte: 'Prénom brodé sur le revers.', meta: prixChaussette ? `dès ${prixChaussette} €` : undefined },
  { titre: 'Le pyjama de Noël', texte: 'Prénom ou initiale sur la poitrine.' },
  { titre: 'Le plaid', texte: 'Un grand motif et un prénom.' },
  { titre: 'La boule brodée', texte: 'En dentelle libre, ou sur feutrine.' },
];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil} messageWa={messageWa}>
  {/* ⚠️ « Commandes avant le 15 novembre » : date [À CONFIRMER PAR EMMA] (voir LIMITE_JOUR). */}
  <HautDePage
    titre="Chaussettes et cadeaux de Noël brodés au prénom"
    fil={fil}
    image={photoChaussette}
    alt="Chaussette de Noël rouge à revers blanc, brodée au prénom et de drapeaux, devant un mur de bobines de fil"
    fond={occasion.fil}
    faits={[
      `Commandes avant le ${dateLimite}`,
      ...(prixChaussette ? [`La chaussette dès ${prixChaussette} €`] : []),
      'Emballage cadeau compris',
    ]}
  >
    <p>
      Je réalise en broderie machine, dans mon atelier de {SITE.ville}&nbsp;(35), des cadeaux de
      Noël personnalisés&nbsp;: chaussette de cheminée brodée au prénom, pyjama, plaid, boule. Le
      motif est validé une seule fois, puis brodé pour chaque membre de la famille. Remise en main
      propre à {SITE.ville} et à Rennes, envoi soigné partout en France.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={wa}>{LIBELLES.whatsapp}</a>
    <a slot="actions" class="btn btn--creux btn--grand" href={lienDevis}>{LIBELLES.devis}</a>
  </HautDePage>

  <!-- ===================== LA SÉRIE (le seul tapis de la page) ===================== -->
  <section class="bande bloc bloc--papier oc-a" aria-labelledby="serie-titre">
    <div class="grille">
      <div class="oc-a__dire">
        <h2 id="serie-titre">Une série pour toute la famille</h2>
        <p class="chapo">
          C’est la commande de Noël la plus fréquente&nbsp;: la même chaussette pour chaque membre
          de la famille, avec un prénom différent sur chacune.
        </p>
        <p class="mesure">
          Vous validez le motif une seule fois, je réalise ensuite toute la série. Merci de
          m’envoyer la liste complète des prénoms en une fois, avec leur orthographe exacte.
        </p>
      </div>
      <div class="oc-a__liste">
        <h3 class="lu-seulement">Ce que je brode pour les fêtes</h3>
        <ListeLignes lignes={menu} />
        <p class="oc-a__note">
          Je brode également les torchons, sacs à pain ou bonnets&nbsp;: tout textile qui peut être
          tendu dans un cadre de broderie. Seule la chaussette est photographiée sur le site&nbsp;;
          je vous adresse sur demande des photographies des pyjamas, plaids et boules déjà réalisés.
        </p>
        <p class="oc-a__lien"><a class="lien-fleche" href="/creations/noel/">Les créations de Noël</a></p>
      </div>
    </div>
  </section>

  <!-- ===================== LE CALENDRIER ===================== -->
  <section class="bande bloc oc-etapes">
    <TeteSection titre="Le calendrier des commandes de Noël">
      <p>
        Les commandes de Noël se préparent en novembre&nbsp;: en décembre, l’atelier et les services
        postaux sont saturés.
      </p>
    </TeteSection>
    {/* ⚠️ EXEMPLE : découpage en trois périodes à faire valider par Emma.
        Seule la « mi-novembre » vient de son propre texte. */}
    <Etapes
      etapes={[
        {
          titre: `Jusqu’au ${dateLimite}`,
          texte:
            'Tout est possible : une série de chaussettes, un plaid, un vêtement que vous me confiez. Nous avons le temps de valider le motif et d’y apporter des modifications.',
        },
        {
          titre: 'Fin novembre',
          texte:
            'J’étudie chaque demande selon les commandes en cours et je vous réponds clairement, en vous proposant au besoin un autre support plus rapide à réaliser.',
        },
        {
          titre: 'En décembre',
          texte:
            'Je ne garantis plus la livraison avant le 24 décembre. Je reste disponible pour les cadeaux du Nouvel An et des fêtes de début d’année.',
        },
      ]}
    />
    <p class="actions oc-etapes__suite">
      <a class="lien-fleche" href="/sur-mesure/">Le déroulement d’une commande</a>
    </p>
  </section>

  <FAQ questions={faq} />

  <AppelFinal titre="Votre commande de Noël" messageWa={messageWa} lienDevis={lienDevis}>
    <p>
      Indiquez-moi les prénoms, même si la liste n’est pas encore complète. Je vous réponds avec un
      prix, un délai et un motif à valider avant réalisation. Pour une livraison avant le
      24&nbsp;décembre, merci de commander avant le <time datetime={isoLimite}>{dateLimite}</time>.
    </p>
  </AppelFinal>
</Base>

<style>
  /* Gabarit commun aux pages occasions (mêmes classes oc-* sur les quatre). */
  .oc-a .grille { row-gap: 2.5rem; }
  .oc-a__dire { display: grid; gap: 1.25rem; align-content: start; }
  .oc-a .chapo { color: var(--encre); }
  .oc-a__note { margin-block-start: 1.25rem; font-size: var(--t-petit); color: var(--encre-doux); }
  .oc-etapes { padding-block: var(--respire); }
  .oc-etapes :global(.ts__chapo) { color: var(--encre); }
  .oc-etapes__suite { margin-block-start: 1.5rem; }
  .oc-a__lien { margin-block-start: 1rem; }
  @media (min-width: 64rem) {
    .oc-a__dire { grid-column: 1 / span 5; }
    .oc-a__liste { grid-column: 6 / -1; }
  }
</style>
