---
/**
 * /cadeaux/noel/ — page d'atterrissage.
 * Intention unique : « cadeau de Noël brodé prénom ».
 * Angle : la date limite de commande, et la pièce par personne qu'on ressort
 * chaque année.
 *
 * ⚠️ MAQUETTE. Prix et délais viennent de src/config.ts et du contenu.
 * La mi-novembre vient de la fiche « chaussette de Noël » écrite par Emma ;
 * le découpage en trois périodes est une proposition à lui faire valider.
 * Vocabulaire : broderie MACHINE. Jamais « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import { SITE, ATELIER, lienWhatsApp } from '../../config';

import photoChaussette from '../../assets/creations/galerie/chaussette-de-noel-brodee-prenom.webp';
import photoBobines from '../../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import photoMachine from '../../assets/creations/detail/machine-a-broder-en-cours-atelier-vitre.webp';

const toutes = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const pour = toutes.filter((c) => c.data.occasions.includes('noel'));
/* Une seule création de Noël est photographiée. On complète avec des pièces
   qui se brodent aussi bien pour un cadeau de fin d'année, et on le dit. */
const voisines = toutes.filter((c) => !pour.includes(c)).slice(0, 3);

const chaussette = pour[0];
const prixChaussette = chaussette?.data.prixDepart ?? null;
const delaiChaussette = chaussette?.data.delaiJours ?? null;

/* La date limite : la mi-novembre, écrite par Emma dans la fiche de la
   chaussette. Seule l'ANNÉE est calculée, pour que la page ne périme pas. */
const maintenant = new Date();
const anneeNoel =
  maintenant.getUTCMonth() === 11 && maintenant.getUTCDate() > 24
    ? maintenant.getUTCFullYear() + 1
    : maintenant.getUTCFullYear();
const isoLimite = `${anneeNoel}-11-15`;

const wa = lienWhatsApp(
  `Bonjour ${SITE.nom}, c'est pour Noël. J'aimerais des pièces brodées au prénom.`,
);

const og = await getImage({ src: photoChaussette, width: 1200, height: 630, format: 'jpeg' });

const titre = `Cadeau de Noël brodé au prénom — ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Cadeau de Noël brodé au prénom à ${SITE.ville} (35) : chaussette, pyjama, plaid, boule${prixChaussette ? `, à partir de ${prixChaussette} €` : ''}. Une pièce par personne, à commander avant la mi-novembre.`;

const faq = [
  {
    q: 'Quelle est la date limite pour être livré avant Noël ?',
    r: `La mi-novembre. Passé le 15 novembre, je ne garantis plus la livraison pour le 24 : en décembre, l'atelier est plein et La Poste aussi. Écrivez-moi quand même — je vous dirai ce qui reste faisable, sans vous faire attendre pour rien.`,
  },
  {
    q: 'Une chaussette par personne, c\'est possible ?',
    r: `C'est même l'idée. Le motif est validé une seule fois, puis brodé autant de fois qu'il y a de prénoms — chacun reconnaît la sienne, et elle ressort de la boîte l'année suivante. Envoyez-moi la liste des prénoms d'un coup, avec l'orthographe exacte.`,
  },
  {
    q: 'Combien ça coûte ?',
    r: prixChaussette
      ? `La chaussette de Noël brodée commence à ${prixChaussette} €${delaiChaussette ? `, comptez ${delaiChaussette} jours ouvrés` : ''}. Pour un pyjama, un plaid ou une boule, le prix dépend du support et de la taille du motif : je vous donne un prix ferme avant de commencer.`
      : `Le prix dépend du support et de la taille du motif. Je vous donne un prix ferme avant de commencer.`,
  },
  {
    q: 'Le pyjama et le plaid passent en machine ?',
    r: `Oui, à 30 degrés. Fil polyester : il ne rétrécit pas et il ne déteint pas sur le tissu clair. Un pyjama brodé au prénom se lave comme un pyjama.`,
  },
  {
    q: 'Je peux fournir le vêtement ou le plaid à broder ?',
    r: `Oui, et beaucoup de gens le font pour Noël. Apportez-le ou envoyez-le-moi : je regarde le tissu, je vous dis ce que la machine peut faire dessus, et on choisit le fil. Prévoyez juste quelques jours de plus pour l'aller-retour.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};

/* ⚠️ Prénoms d'EXEMPLE — ce sont ceux déjà visibles sur les photos du site. */
const prenomsExemple = ['Malo', 'Alicia', 'Keanu', 'Lisa', 'Ambre'];

const menu = [
  { nom: 'La chaussette de cheminée', note: 'prénom brodé sur le revers' },
  { nom: 'Le pyjama de Noël', note: 'prénom ou initiale sur la poitrine' },
  { nom: 'Le plaid', note: 'grand motif, un seul prénom' },
  { nom: 'La boule brodée', note: 'en dentelle, ou brodée sur feutrine' },
];
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[{ nom: 'Cadeau de Noël', url: '/cadeaux/noel/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <!-- ===================== EN-TÊTE SOMBRE ===================== -->
  <section class="bande noel-tete">
    <div class="noel-mot">
      <p class="sourcil sourcil--clair">Noël — {SITE.ville}&nbsp;(35), envoi partout en France</p>
      <h1>Une chaussette par prénom.<br /><em>Et on la ressort chaque année.</em></h1>
      <p class="noel-chapo">
        Cadeau de Noël brodé au prénom&nbsp;: chaussette de cheminée, pyjama, plaid, boule brodée.
        Le motif est validé une fois, puis brodé autant de fois qu'il y a de monde à table.
        {prixChaussette && ` À partir de ${prixChaussette} €.`}
      </p>
      <p class="actions">
        <a class="btn btn--or" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--nuit" href="/contact/?occasion=noel#devis">Demander un devis</a>
      </p>
      <p class="noel-limite">
        <span>À commander avant le</span>
        <time datetime={isoLimite}>15 novembre {anneeNoel}</time>
        <span>pour être livré avant le 24</span>
      </p>
    </div>

    <figure class="noel-fig">
      <Image
        src={photoChaussette}
        alt="Chaussette de Noël rouge bordée de fourrure blanche, brodée au prénom et à un motif de canne à sucre"
        widths={[390, 620, 800]}
        sizes="(max-width: 62rem) 92vw, 28rem"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>

  <!-- ===================== LES TROIS PÉRIODES ===================== -->
  <section class="bande noel-quand">
    <div class="noel-quand__dire">
      <p class="sourcil">Le calendrier de l'atelier</p>
      <h2 class="titre-xl">En décembre, je ne promets plus rien.</h2>
      <p class="mesure">
        Autant le dire tout de suite&nbsp;: la broderie de Noël se joue en novembre. Délai d'atelier
        actuel&nbsp;: <b>{ATELIER.delaiActuel}</b>.
      </p>
    </div>

    {/* ⚠️ EXEMPLE : découpage en trois périodes à faire valider par Emma.
        Seule la mi-novembre vient de son propre texte. */}
    <ol class="quand">
      <li class="quand--vert">
        <p class="quand__d">Jusqu'au 15 novembre</p>
        <p>
          Tout est possible&nbsp;: une série de chaussettes, un plaid, un vêtement que vous
          m'envoyez. On a le temps de valider le motif et de changer d'avis.
        </p>
      </li>
      <li class="quand--ocre">
        <p class="quand__d">Du 15 au 30 novembre</p>
        <p>
          Au cas par cas. Je regarde ce qui reste dans la file et je vous réponds franchement&nbsp;:
          oui, non, ou « oui mais sur un autre support ».
        </p>
      </li>
      <li class="quand--rouge">
        <p class="quand__d">En décembre</p>
        <p>
          Plus de garantie pour le 24. On peut broder pour après les fêtes — ou viser le Nouvel An,
          ce qui, entre nous, fait un cadeau qu'on n'oublie pas dans la pile.
        </p>
      </li>
    </ol>

    <p class="actions">
      <a class="btn btn--wa" href={wa}>Réserver ma place sur WhatsApp</a>
      <a class="btn btn--creux" href="/sur-mesure/">Comment se passe une commande</a>
    </p>
  </section>

  <!-- ===================== UNE PAR PERSONNE ===================== -->
  <section class="bande noel-serie">
    <div class="noel-serie__dire">
      <h2 class="titre-xl">Un motif, cinq prénoms,<br /><em>cinq fois la même pièce.</em></h2>
      <p class="mesure">
        C'est la commande de Noël typique&nbsp;: la même chaussette pour toute la maison, un prénom
        différent sur chacune. Vous ne validez le dessin qu'une fois.
      </p>
    </div>

    {/* ⚠️ Prénoms d'exemple, repris des photos du site. */}
    <ul class="prenoms" aria-label="Exemple de série : un prénom par pièce">
      {prenomsExemple.map((p) => <li>{p}</li>)}
    </ul>

    <figure class="noel-bande plein">
      <Image
        src={photoBobines}
        alt="Mur de l'atelier couvert de bobines de fil à broder de toutes les couleurs"
        widths={[800, 1400, 2000, 2400]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Le rouge de Noël, ce n’est pas une seule couleur. On la choisit ensemble.</figcaption>
    </figure>
  </section>

  <!-- ===================== CE QUI SE BRODE ===================== -->
  <section class="bande noel-menu">
    <h2 class="titre-xl">Ce qui se brode<br /><em>pour les fêtes.</em></h2>
    <ul class="fetes">
      {
        menu.map((m) => (
          <li>
            <span class="fetes__n">{m.nom}</span>
            <span class="fetes__fil" aria-hidden="true" />
            <span class="fetes__p">{m.note}</span>
          </li>
        ))
      }
    </ul>
    <p class="fetes__note">
      Et le reste&nbsp;: un torchon, un sac à pain, un set de table, un bonnet. Si ça se tend dans un
      cadre, ça se brode.
    </p>
  </section>

  <!-- ===================== CRÉATIONS ===================== -->
  <section class="bande noel-creations">
    <div class="tete">
      <h2 class="titre-xl">Ce que je peux vous montrer.</h2>
      <p class="mesure">
        Une seule pièce de Noël est photographiée pour l'instant — les autres sont parties avant que
        j'y pense. Les trois suivantes ne sont pas des pièces de Noël, mais elles se brodent
        exactement de la même façon.
      </p>
      <p class="indice"><span aria-hidden="true">→</span> faites défiler la rangée</p>
    </div>

    <div class="rangee" tabindex="0" role="region" aria-label="Créations pour Noël">
      {pour.map((c, i) => <CarteCreation creation={c} prioritaire={i === 0} />)}
      {voisines.map((c) => <CarteCreation creation={c} />)}
      <div class="rangee__fin">
        <p>Le pyjama, le plaid et la boule&nbsp;: <b>pas encore en photo</b>.</p>
        <p class="rangee__note">
          Demandez-moi, je vous envoie ce qui est parti l'an dernier par message.
        </p>
      </div>
    </div>

    <p class="noel-lien">
      <a class="btn btn--creux" href="/creations/">Voir toutes les créations</a>
    </p>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="bande noel-faq" id="questions">
    <h2 class="titre-xl">Les questions de novembre.</h2>
    <div class="faq">
      {
        faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.r}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ===================== APPEL FINAL ===================== -->
  <section class="bande noel-fin" id="devis">
    <div class="noel-fin__mot">
      <p class="sourcil">On s'y prend maintenant&nbsp;?</p>
      <h2 class="titre-xl">Donnez-moi la liste<br /><em>des prénoms.</em></h2>
      <p class="mesure">
        Même incomplète. Je vous réponds dans la journée avec un prix, un délai et une proposition de
        motif — et vous validez le dessin avant que je lance la machine. Commandes avant
        le <time datetime={isoLimite}>15 novembre {anneeNoel}</time> pour une livraison avant le 24.
      </p>
      <p class="actions">
        <a class="btn btn--wa" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--creux" href="/contact/?occasion=noel#devis">Remplir le formulaire</a>
      </p>
      <p class="noel-fin__note">{ATELIER.zones}. Emballage cadeau compris.</p>
    </div>

    <figure class="noel-fin__fig">
      <Image
        src={photoMachine}
        alt="Broderie en cours sous la tête de la machine, fil de couleur tendu"
        widths={[320, 480, 700]}
        sizes="(max-width: 62rem) 70vw, 22rem"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>
</Base>

<style>
  /* Le sourcil global est en `white-space: nowrap` : les libellés d'une page
     occasion sont plus longs que ceux de l'accueil et débordaient à 320 px.
     Ici, ils passent à la ligne, et le filet disparaît sur petit écran. */
  /* Sur fond sombre, le vert de `.btn--wa` disparaît dans la section : le
     bouton principal passe en doré (fort contraste), le secondaire prend un
     liseré clair. */
  .btn--nuit {
    color: var(--coquille);
    border-color: color-mix(in oklab, var(--coquille) 48%, transparent);
    background: rgb(255 255 255 / 0.06);
  }
  .btn--nuit::before {
    background: var(--coquille);
  }
  .btn--nuit:hover {
    color: var(--encre);
    border-color: var(--coquille);
  }

  .sourcil {
    /* `flex-wrap` d'abord : le filet pointillé passe à la ligne suivante
       plutôt que d'écraser le libellé, qui ne se coupe donc que s'il est
       vraiment trop long pour toute la largeur. */
    white-space: normal;
    flex-wrap: wrap;
    line-height: 1.5;
  }
  @media (max-width: 40rem) {
    .sourcil::after {
      display: none;
    }
  }

  /* ---------------------------------------------------------------------------
     EN-TÊTE SOMBRE — la seule page occasion qui ouvre sur une section de
     rupture : c'est une fête de décembre, et le rouge a besoin de nuit.
  --------------------------------------------------------------------------- */
  .noel-tete {
    padding-block: clamp(2.25rem, 6vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
    row-gap: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--coquille);
    background:
      radial-gradient(64% 52% at 6% 4%, color-mix(in oklab, #B03A52 42%, var(--vert)) 0%, transparent 64%),
      radial-gradient(50% 50% at 92% 96%, color-mix(in oklab, var(--dore) 26%, var(--vert)) 0%, transparent 70%),
      linear-gradient(168deg, #222822, var(--vert) 45%, #141A15);
  }
  .noel-mot {
    min-width: 0;
    display: grid;
    gap: clamp(0.8rem, 2vw, 1.2rem);
    justify-items: start;
    align-content: center;
  }
  .noel-mot h1 em {
    color: color-mix(in oklab, var(--rose) 62%, var(--dore));
  }
  .noel-chapo {
    font-size: var(--t-chapo);
    line-height: 1.5;
    max-width: 32rem;
    color: color-mix(in oklab, var(--coquille) 88%, var(--rose));
  }
  .noel-limite {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    margin-block-start: 0.4rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid color-mix(in oklab, var(--dore) 50%, transparent);
    border-radius: 3px;
    background: rgb(255 255 255 / 0.04);
  }
  .noel-limite span {
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--rose) 70%, var(--gris));
  }
  .noel-limite time {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1;
    color: var(--dore);
  }
  .noel-fig {
    min-width: 0;
    margin: 0;
    max-width: 28rem;
    justify-self: start;
  }
  .noel-fig :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px 4px 4px 110px;
    box-shadow: 0 34px 60px -40px #000;
  }

  @media (min-width: 62rem) {
    .noel-tete {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, 38rem)
        [mi] minmax(0, 26rem)
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      column-gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
      padding-block: clamp(3rem, 5vw, 4.5rem);
    }
    .noel-mot {
      grid-column: large-d / mi;
      grid-row: 1;
    }
    .noel-fig {
      grid-column: mi / large-f;
      grid-row: 1;
      justify-self: stretch;
    }
  }

  /* ---------------------------------------------------------------------------
     LES TROIS PÉRIODES — un feu tricolore, parce que l'information EST un
     état : possible, incertain, non garanti.
  --------------------------------------------------------------------------- */
  .noel-quand {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    row-gap: clamp(1.4rem, 3vw, 2.25rem);
  }
  .noel-quand > * {
    min-width: 0;
  }
  .noel-quand__dire {
    display: grid;
    gap: 0.9rem;
  }
  .noel-quand b {
    font-weight: 500;
    color: var(--encre);
  }
  .quand {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }
  .quand > li {
    min-width: 0;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1rem 1.1rem;
    border-radius: 3px;
    border-inline-start: 4px solid var(--f, var(--gris));
    background: color-mix(in oklab, var(--f, var(--gris)) 9%, var(--sable-haut));
  }
  .quand--vert {
    --f: var(--olive);
  }
  .quand--ocre {
    --f: var(--ocre);
  }
  .quand--rouge {
    --f: #b03a52;
  }
  .quand__d {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem);
    line-height: 1.08;
    color: var(--f);
  }
  .quand > li > p:not(.quand__d) {
    font-size: var(--t-petit);
    line-height: 1.6;
    color: var(--encre-doux);
  }

  /* ---------------------------------------------------------------------------
     LA SÉRIE — les prénoms comme des étiquettes cousues, séparées par un
     pointillé. C'est la démonstration du « une par personne ».
  --------------------------------------------------------------------------- */
  .noel-serie {
    padding-block: clamp(2.25rem, 5.5vw, 4rem) 0;
    row-gap: clamp(1.4rem, 3vw, 2.25rem);
  }
  .noel-serie > * {
    min-width: 0;
  }
  .noel-serie__dire {
    display: grid;
    gap: 0.9rem;
  }
  .noel-serie .titre-xl em {
    color: #b03a52;
  }
  .prenoms {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem clamp(0.9rem, 2.5vw, 2rem);
  }
  .prenoms > li {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.7rem, 1rem + 4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--mauve);
    position: relative;
    padding-inline-end: clamp(0.9rem, 2.5vw, 2rem);
  }
  .prenoms > li:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-block: 0.55em auto;
    inset-inline-end: 0;
    width: clamp(0.5rem, 1.6vw, 1.2rem);
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--brique) 0 4px, transparent 4px 8px);
    opacity: 0.7;
  }
  .prenoms > li:nth-child(2) {
    color: #b03a52;
  }
  .prenoms > li:nth-child(4) {
    color: var(--olive);
  }
  .prenoms > li:nth-child(5) {
    color: var(--dore);
  }

  .noel-bande {
    margin: 0;
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
  }
  .noel-bande :global(img) {
    width: 100%;
    height: clamp(170px, 26vw, 330px);
    object-fit: cover;
    mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
  }
  .noel-bande figcaption {
    padding: 0.5rem var(--marge) 0;
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gris);
    max-width: 34rem;
  }

  /* ---------------------------------------------------------------------------
     LE MENU — noms à gauche, précision à droite, pointillé entre les deux.
     Une carte, pas une grille de produits : rien n'est en stock.
  --------------------------------------------------------------------------- */
  .noel-menu {
    padding-block: clamp(2.25rem, 5.5vw, 4rem);
    row-gap: clamp(1.25rem, 3vw, 2rem);
  }
  .noel-menu > * {
    min-width: 0;
  }
  .noel-menu .titre-xl em {
    color: var(--dore);
  }
  .fetes {
    display: grid;
    gap: 0;
    max-width: 44rem;
  }
  /* Une carte, pas une grille de produits : rien n'est en stock. Le filet
     pointillé est un vrai élément de la ligne — il occupe l'espace libre,
