---
/**
 * /sur-mesure/ — comment commander.
 *
 * ⚠️ MAQUETTE — CONTENU D'EXEMPLE
 * Les prix et les délais affichés ici ne sont PAS saisis à la main : ils sont
 * CALCULÉS à partir du champ `prixDepart` / `delaiJours` des créations
 * (src/content/creations/*.md). Ces valeurs sont elles-mêmes provisoires et
 * doivent être confirmées par Emma avant mise en production.
 * Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, CONTACT, ATELIER, lienWhatsApp } from '../config';

import bobines from '../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import machine from '../assets/creations/detail/machine-a-broder-en-cours-atelier-vitre.webp';
import ogSource from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const og = await getImage({ src: ogSource, format: 'webp', width: 1200 });

/* ---------------------------------------------------------------------------
   PRIX & DÉLAIS — calculés, jamais saisis
--------------------------------------------------------------------------- */
const creations = await getCollection('creations', ({ data }) => !data.masquee);

const LIBELLE: Record<string, { nom: string; quoi: string }> = {
  naissance: { nom: 'Naissance & enfant', quoi: 'Doudou, cadre de naissance, bavoir, sac à dos' },
  'linge-de-bain': { nom: 'Linge de bain', quoi: 'Drap de bain, serviette, cape de bain, peignoir' },
  vetements: { nom: 'Vêtements', quoi: 'Polo, sweat, doudoune, chemise' },
  couture: { nom: 'Sacs, trousses & tabliers', quoi: 'Cousus main par moi, puis brodés' },
  'decoration-ajouree': { nom: 'Dentelle libre', quoi: 'Arbre de vie, papillon, initiale, napperon' },
  noel: { nom: 'Noël', quoi: 'Chaussette de cheminée, pyjama, boule brodée' },
};
const ORDRE_CAT = ['naissance', 'linge-de-bain', 'couture', 'decoration-ajouree', 'vetements', 'noel'];

const fourchettes = ORDRE_CAT.map((cat) => {
  const lot = creations.filter((c) => c.data.categorie === cat);
  const prix = lot.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
  const jours = lot.map((c) => c.data.delaiJours).filter((n): n is number => typeof n === 'number');
  if (prix.length === 0) return null;
  return {
    cat,
    nom: LIBELLE[cat].nom,
    quoi: LIBELLE[cat].quoi,
    prix: Math.min(...prix),
    jours: jours.length ? Math.max(...jours) : null,
  };
}).filter((f): f is NonNullable<typeof f> => f !== null);

const tousPrix = creations.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
const tousJours = creations.map((c) => c.data.delaiJours).filter((n): n is number => typeof n === 'number');

const prixMin = Math.min(...tousPrix);
const prixMax = Math.max(...tousPrix);
const joursMin = Math.min(...tousJours);
const joursMax = Math.max(...tousJours);

/* Les cinq étapes : une vraie séquence, la seule de la page à être numérotée. */
const etapes = [
  {
    t: "Vous m'écrivez",
    r: "WhatsApp, formulaire ou téléphone. Le prénom, l'occasion, la date. Une photo d'inspiration si vous en avez une. Même flou, ça suffit pour commencer.",
  },
  {
    t: 'Je vous réponds avec un prix',
    r: `Un prix, un délai, une proposition. ${ATELIER.delaiReponse}. Beaucoup de gens m'écrivent juste pour savoir, et c'est très bien comme ça.`,
  },
  {
    t: 'On choisit ensemble',
    r: "Le support, l'écriture, la couleur du fil, l'emplacement. Dans mes coupons et mes bobines, ou sur le tissu que vous m'apportez.",
  },
  {
    t: 'Je vous montre le motif',
    r: "Avant de lancer la machine, je vous envoie le dessin. Si quelque chose ne va pas, on le change : tant que ce n'est pas piqué, tout est possible.",
    decision: true,
  },
  {
    t: "Je brode, j'emballe",
    r: `Emballage cadeau compris. Remise en main propre à ${SITE.ville} ou à Rennes sur rendez-vous, sinon par la poste, partout en France.`,
  },
];

/* ---------------------------------------------------------------------------
   FAQ — une seule source, utilisée pour l'affichage ET pour le JSON-LD.
   ⚠️ La date limite de Noël (mi-novembre) est un EXEMPLE, à faire valider.
--------------------------------------------------------------------------- */
const faq = [
  {
    q: 'Vous brodez à la main ?',
    r: `Non, à la machine. C'est elle qui donne un prénom net, régulier, qui tient au lavage. Ce que je fais à la main, c'est la couture : les sacs, les trousses et les tabliers sont cousus main, puis brodés.`,
  },
  {
    q: 'Combien de temps faut-il prévoir ?',
    r: `En ce moment, ${ATELIER.delaiActuel} à partir de la validation du motif. Selon la pièce, de ${joursMin} à ${joursMax} jours ouvrés. Pour Noël, écrivez-moi avant la mi-novembre : après, je ne garantis plus le 24.`,
  },
  {
    q: 'Combien ça coûte ?',
    r: `Les pièces du catalogue commencent entre ${prixMin} et ${prixMax} €. Trois choses font le prix : la taille du motif, le nombre de points et le support. Un prénom court coûte moins cher qu'un grand motif dense, parce que la machine y passe moins de temps. Vous avez le prix exact avant que je commence, et il ne vous engage à rien.`,
  },
  {
    q: 'Qu’est-ce que vous pouvez broder ?',
    r: `Un prénom, une date, des mesures de naissance, une phrase, un motif. Sur du linge de bain, des vêtements, des doudous, des bavoirs, des sacs, des tabliers. Et la dentelle libre, brodée sans tissu dessous, qui tient toute seule.`,
  },
  {
    q: 'Je peux vous apporter mon propre tissu ou mon vêtement ?',
    r: `Oui, c'est fréquent. Vous m'apportez le vêtement, le drap de bain ou le coupon, je brode dessus et vous ne payez que la broderie. Dites-moi la matière avant : un tissu très fin ou très extensible demande un renfort, et je préfère le savoir avant de piquer.`,
  },
  {
    q: 'Et si le motif ne me plaît pas ?',
    r: `Vous le voyez avant que je lance la machine : l'écriture, la taille, la couleur du fil, l'emplacement. Si quelque chose ne va pas, on le change. Tant que ce n'est pas piqué, tout est possible. Après, le fil ne s'enlève plus proprement : c'est pour ça que cette étape existe.`,
  },
  {
    q: 'Comment je récupère ma commande ?',
    r: `${ATELIER.zones}. La remise en main propre se fait sur rendez-vous, dans un lieu public convenu ensemble. Les frais d'envoi dépendent du poids et du format : je les indique avec le devis. L'emballage cadeau est compris.`,
  },
  {
    q: 'C’est pour dans trois jours. C’est possible ?',
    r: `Parfois. Ça dépend de la pièce et de ce qui est déjà sur la machine. Écrivez-moi la date sur WhatsApp : je regarde et je vous réponds franchement. Je préfère dire non que livrer en retard.`,
  },
  {
    q: 'Comment on entretient une broderie ?',
    r: `Machine à 30°, pièce retournée. Repassage sur l'envers. Pas d'eau de Javel : c'est elle qui décolore le fil, pas le lavage.`,
  },
];

const donneesFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};

const titre = `Sur-mesure : commander une broderie personnalisée à ${SITE.ville} · ${SITE.nom}`;
const description = `Étapes, délais, prix à partir de ${prixMin} €, entretien, livraison et emballage cadeau : tout ce qu'il faut savoir avant de commander une broderie personnalisée ou une pièce cousue sur mesure à ${SITE.ville} (35).`;
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[{ nom: 'Sur-mesure', url: '/sur-mesure/' }]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donneesFaq)} />

  {/*
    ⚠️ MAQUETTE — prix, délais, date limite de Noël, numéro et e-mail
    provisoires (src/config.ts et src/content/creations). À faire valider
    par Emma avant la mise en production.
  */}

  <!-- ===================== OUVERTURE ===================== -->
  <section class="bande sm-ouv">
    <nav class="ariane sm-ouv__ariane" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Sur-mesure</span>
    </nav>

    <div class="sm-ouv__dire">
      <h1>Vous m'envoyez le prénom. Je brode. <em>Vous offrez.</em></h1>
      <p class="chapo">
        Broderie personnalisée et couture sur mesure à {SITE.ville}&nbsp;(35), pour Rennes et
        toute la France. Ici, tout ce qu'on me demande avant de commander&nbsp;: les étapes, les
        prix, les délais, l'entretien. Sans petites lignes.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>Écrire sur WhatsApp</a>
        <a class="btn btn--creux btn--grand" href="/contact/#devis">Demander un devis</a>
      </p>
    </div>

    <!-- La fiche d'atelier : ce qu'on cherche en arrivant, en quatre lignes. -->
    <aside class="sm-fiche" aria-label="L'essentiel en bref">
      <p class="sm-fiche__tete mono">fiche de commande · {SITE.ville}</p>
      <dl class="sm-fiche__dl">
        <div>
          <dt>prix</dt>
          <dd><span class="mono">à partir de</span> <b>{prixMin}&nbsp;€</b></dd>
        </div>
        <div>
          <dt>délai actuel</dt>
          <dd><b>{ATELIER.delaiActuel}</b></dd>
        </div>
        <div>
          <dt>réponse</dt>
          <dd>{ATELIER.delaiReponse}</dd>
        </div>
        <div>
          <dt>emballage</dt>
          <dd>cadeau, compris</dd>
        </div>
      </dl>
      <p class="sm-fiche__pied mono">motif validé avant la première piqûre</p>
    </aside>
  </section>

  <!-- ===================== LES ÉTAPES : la vraie séquence ===================== -->
  <section class="bande sm-pas" id="etapes" data-broderie="fil" data-fil="#D93D28">
    <div class="sm-pas__tete">
      <h2 class="titre-xl">Cinq étapes, et <em>une seule</em> décision à prendre.</h2>
      <p class="mesure">
        La décision, c'est l'étape&nbsp;4&nbsp;: vous validez le motif, ou vous me dites ce qui ne
        va pas. Le reste, c'est mon travail.
      </p>
    </div>

    <ol class="etapes sm-etapes">
      {
        etapes.map((e, i) => (
          <li class={e.decision ? 'sm-etapes__decision' : undefined}>
            <p class="etapes__n">
              {i + 1} / {etapes.length}
              {e.decision && <span class="sm-etapes__marque">votre décision</span>}
            </p>
            <h3>{e.t}</h3>
            <p>{e.r}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ===================== PRIX : le tarif, comme une fiche d'atelier ===================== -->
  <section class="bande sm-prix" id="prix">
    <div class="sm-prix__intro">
      <h2 class="titre-xl">Les prix commencent ici.</h2>
      <p class="mesure">
        Trois choses font le prix&nbsp;: la taille du motif, le nombre de points et le support. Un
        prénom court passe vite sous l'aiguille&nbsp;; un grand motif dense y reste longtemps. Les
        pièces du catalogue commencent entre {prixMin} et {prixMax}&nbsp;€.
      </p>
      <p class="sm-prix__note">Vous apportez votre vêtement&nbsp;? Vous ne payez que la broderie.</p>
    </div>

    {/* ⚠️ EXEMPLES : prix et délais calculés depuis les créations provisoires. */}
    <ul class="sm-tarif" aria-label="Prix de départ par type de pièce">
      {
        fourchettes.map((f) => (
          <li>
            <a class="sm-tarif__ligne" href={`/creations/${f.cat}/`}>
              <span class="sm-tarif__nom">{f.nom}</span>
              <span class="sm-tarif__quoi">{f.quoi}</span>
              {f.jours && <span class="sm-tarif__delai mono">≈ {f.jours} jours ouvrés</span>}
              <span class="sm-tarif__prix prix">
                dès <b>{f.prix}&nbsp;€</b>
              </span>
              <span class="sm-tarif__voir" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="sm-prix__pied">
      Pour un devis, je prépare le motif avant de vous répondre&nbsp;: le prix part du nombre de
      points, pas d'une estimation au jugé.
      <a class="lien-fleche" href="/contact/#devis">Décrire mon projet</a>
    </p>
  </section>

  <!-- ===================== DÉLAIS — RUPTURE SUR LE TAPIS ===================== -->
  <section class="bande tapis sm-delais" id="delais">
    <span class="regle plein sm-delais__regle" aria-hidden="true"></span>

    <div class="sm-delais__dire">
      <h2 class="sm-delais__titre">Une machine. <em>Une pièce à la fois.</em></h2>
      <p class="mesure mesure--clair">
        Je brode une commande après l'autre. Votre pièce a sa place dans la file, et quand vous me
        demandez où elle en est, je le sais sans chercher.
      </p>
      <p class="sm-delais__actuel">
        <span class="mono">délai actuel</span>
        <b>{ATELIER.delaiActuel}</b>
        <span class="mono">après validation du motif · de {joursMin} à {joursMax} jours ouvrés selon la pièce</span>
      </p>
    </div>

    {/* ⚠️ « mi-novembre » : EXEMPLE de date limite, à faire confirmer par Emma. */}
    <ul class="sm-dates">
      <li>
        <span class="sm-dates__quand mono">Noël</span>
        <p>Écrivez-moi avant la mi-novembre. Après, je ne garantis plus le 24.</p>
      </li>
      <li>
        <span class="sm-dates__quand mono">Naissance</span>
        <p>Le terme suffit. Je prépare le motif, je brode le prénom quand il arrive.</p>
      </li>
      <li>
        <span class="sm-dates__quand mono">Urgent</span>
        <p>Envoyez-moi la date sur WhatsApp. Je regarde la file et je réponds franchement.</p>
        <a
          class="btn btn--or"
          href={lienWhatsApp('Bonjour Emma, est-ce que vous pourriez broder une pièce pour une date précise ?')}
        >
          Demander si c'est jouable
        </a>
      </li>
    </ul>
  </section>

  <!-- ===================== BANDEAU PLEINE LARGEUR ===================== -->
  <div class="bandeau">
    <Image
      src={bobines}
      alt="Mur de l'atelier couvert de bobines de fil à broder de toutes les couleurs"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="bandeau__mot" aria-hidden="true">la couleur, on la choisit ensemble.</p>
  </div>

  <!-- ===================== ENTRETIEN + LIVRAISON ===================== -->
  <section class="bande sm-soin loin" id="entretien">
    <figure class="sm-soin__fig" data-broderie="tambour">
      <Image
        src={machine}
        alt="Gros plan de la broderie en cours sous la tête de la machine : motif de cerisier en fleurs en fil de couleur"
        widths={[420, 680, 1000]}
        sizes="(max-width: 64rem) 80vw, 30vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="sm-soin__txt">
      {/* ⚠️ Le 30° vient du contenu des créations. Le reste des conseils
          d'entretien est à faire confirmer par Emma. [À CONFIRMER] */}
      <h2 class="titre-xl">Ça passe en machine à&nbsp;30°.</h2>
      <p class="mesure">
        C'est la question qui suit le prix. Un doudou brodé se lave comme un doudou, une serviette
        brodée comme une serviette. Le fil ne bouge pas.
      </p>

      <!-- L'étiquette d'entretien, cousue comme celles des vêtements -->
      <dl class="sm-etiquette">
        <div>
          <dt>lavage</dt>
          <dd><b>30°</b> cycle normal, pièce retournée</dd>
        </div>
        <div>
          <dt>repassage</dt>
          <dd>sur l'envers, ou avec un linge entre le fer et la broderie</dd>
        </div>
        <div>
          <dt>à éviter</dt>
          <dd>l'eau de Javel&nbsp;: c'est elle qui décolore le fil, pas le lavage</dd>
        </div>
      </dl>
    </div>

    <div class="sm-soin__livraison">
      <h2 class="sm-soin__h2b">Vous récupérez la pièce emballée.</h2>
      <p>
        {ATELIER.zones}. La remise en main propre se fait <b>sur rendez-vous</b>, dans un lieu
        public convenu ensemble&nbsp;: je travaille chez moi, je ne reçois pas. Les frais d'envoi
        dépendent du poids et du format, je vous les donne avec le devis.
      </p>
      <p class="sm-soin__cadeau">
        L'emballage cadeau est compris. Si c'est une surprise, dites-le-moi&nbsp;: rien n'est écrit
        sur le paquet.
      </p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="bande sm-faq loin" id="questions">
    <div class="sm-faq__tete">
      <h2 class="titre-xl">Les questions <em>qu'on me pose.</em></h2>
      <p class="mesure">
        La vôtre n'y est pas&nbsp;? Envoyez-la-moi. C'est comme ça que cette liste s'allonge.
      </p>
      <a class="lien-wa" href={lienWhatsApp("Bonjour Emma, j'ai une question avant de commander :")}>
        Poser ma question
      </a>
    </div>

    <div class="sm-faq__liste">
      {
        faq.map((f, i) => (
          <details class="sm-q" open={i === 0}>
            <summary>
              <span class="sm-q__q">{f.q}</span>
              <span class="sm-q__croix" aria-hidden="true" />
            </summary>
            <div class="sm-q__r">
              <p>{f.r}</p>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ===================== APPEL FINAL ===================== -->
  <section class="final bande">
    <div class="final__in">
      <h2 class="titre-geant sm-final__titre">Écrivez-moi un prénom. <em>Je m'occupe du reste.</em></h2>
      <p class="chapo">
        Le formulaire prend deux minutes et pose une question à la fois. Ou écrivez-moi sur
        WhatsApp&nbsp;: c'est moi qui lis.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>Écrire sur WhatsApp</a>
        <a class="btn btn--or btn--grand" href="/contact/#devis">Remplir le formulaire</a>
      </p>
      <p class="final__note">
        ou par téléphone&nbsp;: <a href={`tel:${CONTACT.telephone}`}>{CONTACT.telephone}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     /sur-mesure/ — préfixe `sm-`.
     Rythme vertical volontairement inégal d'une section à l'autre.
     ========================================================================== */

  /* ============================ OUVERTURE ============================ */
  .sm-ouv {
    padding-block: clamp(0.5rem, 2vw, 1.5rem) var(--serre);
    row-gap: clamp(1.5rem, 4vw, 3rem);
  }
  .sm-ouv__dire { display: grid; gap: clamp(1.1rem, 2.2vw, 1.8rem); justify-items: start; }
  .sm-ouv h1 { max-width: 12ch; }

  /* La fiche : papier, coin replié, bord perforé en haut */
  .sm-fiche {
    --perfo: 10px;
    position: relative;
    justify-self: start;
    width: min(100%, 24rem);
    padding: 1.6rem 1.4rem 1.2rem;
    background: var(--papier);
    border-radius: 0 0 var(--r-s) var(--r-s);
    box-shadow: 0 24px 50px -30px color-mix(in oklab, var(--encre) 60%, transparent);
    rotate: -1.5deg;
    /* une rangée de trous en haut, comme une fiche arrachée d'un carnet */
    mask-image:
      radial-gradient(circle at 50% 0, transparent 4px, #000 4.5px),
      linear-gradient(#000, #000);
    mask-size: 18px 12px, 100% calc(100% - 12px);
    mask-position: 0 0, 0 12px;
    mask-repeat: repeat-x, no-repeat;
    -webkit-mask-image:
      radial-gradient(circle at 50% 0, transparent 4px, #000 4.5px),
      linear-gradient(#000, #000);
    -webkit-mask-size: 18px 12px, 100% calc(100% - 12px);
    -webkit-mask-position: 0 0, 0 12px;
    -webkit-mask-repeat: repeat-x, no-repeat;
  }
  .sm-fiche__tete,
  .sm-fiche__pied {
    font-size: var(--t-micro);
    color: var(--coquelicot-fonce);
  }
  .sm-fiche__pied { color: var(--gris); padding-block-start: 0.9rem; }
  .sm-fiche__dl { margin-block-start: 0.8rem; }
  .sm-fiche__dl > div {
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: baseline;
    padding-block: 0.65rem;
    border-block-end: 1px dashed color-mix(in oklab, var(--encre) 28%, transparent);
  }
  .sm-fiche dt { font-family: var(--f-mono); font-size: var(--t-micro); color: var(--gris); }
  .sm-fiche dd { margin: 0; font-size: var(--t-petit); line-height: 1.35; }
  .sm-fiche dd .mono { font-size: var(--t-micro); color: var(--gris); }
  .sm-fiche dd b {
    font-family: var(--f-titre);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    line-height: 1;
    color: var(--encre);
  }
  .sm-fiche__dl > div:first-child b { color: var(--coquelicot-fonce); }

  @media (min-width: 64rem) {
    .sm-ouv {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.66)) [mi] minmax(0, calc(var(--large) * 0.34))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      min-height: calc(88svh - 4.5rem);
      align-content: center;
    }
    .sm-ouv__ariane { grid-column: large-d / large-f; align-self: start; }
    .sm-ouv__dire { grid-column: large-d / mi; padding-inline-end: 2rem; }
    .sm-ouv h1 { font-size: clamp(4rem, 1rem + 5.4vw, 7.6rem); max-width: 11ch; }
    .sm-fiche { grid-column: mi / large-f; justify-self: end; align-self: end; margin-block-end: 1rem; }
  }

