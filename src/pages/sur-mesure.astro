---
/**
 * /sur-mesure/ — comment commander.
 *
 * ⚠️ MAQUETTE — CONTENU D'EXEMPLE
 * Les prix et les délais affichés ici ne sont PAS saisis à la main : ils sont
 * CALCULÉS à partir du champ `prixDepart` / `delaiJours` des créations
 * (src/content/creations/*.md). Ces valeurs sont elles-mêmes provisoires et
 * doivent être confirmées par Emma avant mise en production.
 * Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
 */
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import TeteSection from '../components/TeteSection.astro';
import Etapes from '../components/Etapes.astro';
import ListeLignes from '../components/ListeLignes.astro';
import FAQ from '../components/FAQ.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { SITE, ATELIER, LIBELLES, ETAPES_COMMANDE, lienWhatsApp } from '../config';

import machine from '../assets/creations/galerie/machine-a-broder-en-cours-atelier-vitre.webp';
import ogSource from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const og = await getImage({ src: ogSource, format: 'webp', width: 1200 });

/* ---------------------------------------------------------------------------
   PRIX & DÉLAIS — calculés, jamais saisis
--------------------------------------------------------------------------- */
const creations = await getCollection('creations', ({ data }) => !data.masquee);

const LIBELLE: Record<string, { nom: string; quoi: string }> = {
  naissance: { nom: 'Naissance & enfant', quoi: 'Doudou, cadre de naissance, bavoir, sac à dos' },
  'linge-de-bain': { nom: 'Linge de maison', quoi: 'Drap de bain, serviette, cape de bain, linge de maison' },
  vetements: { nom: 'Vêtements', quoi: 'Polo, sweat, doudoune, chemise' },
  couture: { nom: 'Sacs, trousses & tabliers', quoi: 'Cousus main par moi, puis brodés' },
  'decoration-ajouree': { nom: 'Dentelle libre', quoi: 'Arbre de vie, papillon, initiale, napperon' },
  noel: { nom: 'Noël', quoi: 'Chaussette de cheminée, pyjama, boule brodée' },
};
const ORDRE_CAT = ['naissance', 'linge-de-bain', 'couture', 'decoration-ajouree', 'vetements', 'noel'];

const fourchettes = ORDRE_CAT.map((cat) => {
  const lot = creations.filter((c) => c.data.categorie === cat);
  const prix = lot.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
  if (prix.length === 0) return null;
  return {
    cat,
    nom: LIBELLE[cat].nom,
    quoi: LIBELLE[cat].quoi,
    prix: Math.min(...prix),
  };
}).filter((f): f is NonNullable<typeof f> => f !== null);

const tousPrix = creations.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');

const prixMin = Math.min(...tousPrix);
const prixMax = Math.max(...tousPrix);

/* Le déroulement détaillé (4 étapes). La validation du motif est reprise
   telle quelle de ETAPES_COMMANDE : même libellé, même texte partout. */
const validation = ETAPES_COMMANDE.find((e) => e.cle)!;
const etapes = [
  {
    titre: 'Votre demande',
    texte: 'Par WhatsApp, par le formulaire ou par téléphone, indiquez-moi le prénom ou le texte, l’occasion et la date souhaitée. Une photo d’inspiration est la bienvenue.',
  },
  {
    titre: 'Ma proposition',
    texte: `${ATELIER.delaiReponse}, avec un prix, un délai et une proposition de motif. Nous choisissons ensemble le support, l’écriture, la couleur du fil et l’emplacement.`,
  },
  validation,
  {
    titre: 'Réalisation et remise',
    texte: `Je brode la pièce et l’emballe, prête à offrir. Remise en main propre à ${SITE.ville} ou à Rennes sur rendez-vous, ou envoi soigné partout en France.`,
  },
];

/* ---------------------------------------------------------------------------
   FAQ — affichée et émise en JSON-LD par le composant FAQ.
   ⚠️ La date limite de Noël (mi-novembre) est un EXEMPLE, à faire valider.
--------------------------------------------------------------------------- */
const faq = [
  {
    q: 'Brodez-vous à la main ?',
    r: `Non, je travaille en broderie machine. Elle garantit un tracé net et régulier, qui résiste au lavage. La couture, en revanche, est faite par mes soins : les sacs, les trousses et les tabliers sont cousus main, puis brodés.`,
  },
  {
    q: 'Que pouvez-vous broder ?',
    r: `Un prénom, une date, des mesures de naissance, une phrase ou un motif, sur du linge de bain, des vêtements, des doudous, des bavoirs, des sacs ou des tabliers. Je réalise également de la dentelle libre : une broderie sans tissu de support, qui tient seule.`,
  },
  {
    q: 'Puis-je fournir mon propre tissu ou vêtement ?',
    r: `Oui, c’est une demande fréquente. Je brode alors directement sur votre pièce, et seule la broderie est facturée. Précisez-moi la matière à l’avance : un tissu très fin ou extensible nécessite un renfort adapté.`,
  },
  {
    q: 'Que se passe-t-il si le motif ne me convient pas ?',
    r: `Je vous soumets le motif avant de lancer la machine : écriture, taille, couleur du fil et emplacement. Tant qu’il n’est pas brodé, tout reste modifiable. Une fois piqué, le fil ne peut plus être retiré proprement : c’est la raison d’être de cette étape de validation.`,
  },
  {
    q: 'Comment récupérer ma commande ?',
    r: `${ATELIER.zones}. La remise en main propre se fait sur rendez-vous, dans un lieu public convenu ensemble : je travaille à domicile et ne reçois pas de public. Les frais d’envoi dépendent du poids et du format ; ils figurent sur le devis. L’emballage cadeau est compris ; s’il s’agit d’une surprise, rien n’est inscrit sur le colis.`,
  },
  {
    q: 'Comment entretenir une broderie ?',
    r: `Une broderie machine se lave comme la pièce qui la porte : lavage en machine à 30°, pièce retournée, repassage sur l’envers ou avec un linge entre le fer et la broderie. Évitez l’eau de Javel, qui décolore le fil.`,
  },
];


const titre = `Sur-mesure : commander une broderie personnalisée à ${SITE.ville} · ${SITE.nom}`;
const description = `Étapes, délais, prix à partir de ${prixMin} €, entretien, livraison et emballage cadeau : tout ce qu’il faut savoir avant de commander une broderie personnalisée ou une pièce cousue sur mesure à ${SITE.ville} (35).`;
const fil = [{ nom: 'Sur-mesure', url: '/sur-mesure/' }];

/* ⚠️ EXEMPLES : prix calculés depuis les créations provisoires. */
const lignesTarif = fourchettes.map((f) => ({
  titre: f.nom,
  texte: f.quoi,
  meta: `dès ${f.prix} €`,
  href: `/creations/${f.cat}/`,
}));

/* ⚠️ « mi-novembre » : EXEMPLE de date limite, à faire confirmer par Emma. */
const lignesDates = [
  { titre: 'Noël', texte: 'Pour une livraison avant le 24 décembre, merci de me contacter avant la mi-novembre.' },
  { titre: 'Naissance', texte: 'La date du terme suffit : je prépare le motif à l’avance et je brode le prénom dès la naissance.' },
  { titre: 'Demande urgente', texte: 'Indiquez-moi la date sur WhatsApp : je vérifie le planning et je vous réponds honnêtement.' },
];

---

<Base titre={titre} description={description} imageOg={og.src} fil={fil}>
  {/*
    ⚠️ MAQUETTE — prix, délais, date limite de Noël, numéro et e-mail
    provisoires (src/config.ts et src/content/creations). À faire valider
    par Emma avant la mise en production.
  */}

  <HautDePage
    titre="Commander une broderie sur mesure"
    fil={fil}
    image={machine}
    alt="Broderie en cours sous la tête de la machine : motif de cerisier en fleurs en fil de couleur"
    cadrage="50% 50%"
    faits={[
      `Dès ${prixMin} €`,
      `Délai actuel : ${ATELIER.delaiActuel}`,
      ATELIER.delaiReponse,
      'Emballage cadeau compris',
    ]}
  >
    <p>
      Broderie personnalisée et couture sur mesure à {SITE.ville}&nbsp;(35), avec remise en main
      propre à {SITE.ville} et à Rennes, ou envoi dans toute la France. Le déroulement d’une
      commande, les prix de départ et les délais de réalisation.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={lienWhatsApp()}>{LIBELLES.whatsapp}</a>
    <a slot="actions" class="btn btn--creux btn--grand" href="/contact/#devis">{LIBELLES.devis}</a>
  </HautDePage>

  <!-- ===================== DÉROULEMENT ===================== -->
  <section class="bande bloc sm-section" id="etapes">
    <TeteSection titre="Le déroulement d’une commande">
      <p>
        Une seule étape vous demande une décision&nbsp;: la validation du motif. Je me charge de
        tout le reste, de la préparation à l’emballage.
      </p>
    </TeteSection>
    <Etapes etapes={etapes} />
  </section>

  <!-- ===================== PRIX ===================== -->
  <section class="bande sm-section" id="prix">
    <TeteSection titre="Les prix de départ" variante="duo">
      <p>
        Le prix dépend de la taille du motif, du nombre de points et du support. Un prénom court
        demande moins de temps de broderie qu’un motif large et dense. Les pièces du catalogue
        débutent entre {prixMin} et {prixMax}&nbsp;€.
      </p>
    </TeteSection>
    <ListeLignes lignes={lignesTarif} />
    <p class="sm-note mesure">
      Si vous fournissez le vêtement, seule la broderie est facturée. Chaque devis est établi à
      partir du motif préparé&nbsp;: le prix correspond au nombre de points réel.
    </p>
  </section>

  <!-- ===================== DÉLAIS (le seul tapis de la page) ===================== -->
  <section class="bande tapis sm-section" id="delais">
    <TeteSection titre="Les délais de réalisation" variante="duo">
      <p>
        Délai actuel&nbsp;: {ATELIER.delaiActuel}, à compter de la validation du motif. Je réalise
        les commandes l’une après l’autre et je peux vous indiquer à tout moment où en est la
        vôtre.
      </p>
    </TeteSection>
    <ListeLignes lignes={lignesDates} />
    <p class="actions sm-note">
      <a
        class="btn btn--or"
        href={lienWhatsApp('Bonjour Emma, pourriez-vous réaliser une pièce pour une date précise ?')}
      >
        {LIBELLES.whatsapp}
      </a>
    </p>
  </section>

  <FAQ questions={faq} />

  <AppelFinal>
    <p>
      Le formulaire vous guide en quatre étapes courtes. Vous pouvez aussi m’écrire directement
      sur WhatsApp&nbsp;: je lis et je réponds personnellement à chaque message.
    </p>
  </AppelFinal>
</Base>

<style>
  .sm-section { padding-block: var(--serre); }
  .sm-section.tapis, .sm-section.bloc { padding-block: var(--respire); }
  .sm-section.bloc :global(.ts__chapo) { color: var(--encre); }
  .sm-note { margin-block-start: 1.5rem; }
</style>
