---
/**
 * /sur-mesure/ — comment commander.
 *
 * ⚠️ MAQUETTE — CONTENU D'EXEMPLE
 * Les prix et les délais affichés ici ne sont PAS saisis à la main : ils sont
 * CALCULÉS à partir du champ `prixDepart` / `delaiJours` des créations
 * (src/content/creations/*.md). Ces valeurs sont elles-mêmes provisoires et
 * doivent être confirmées par Emma avant mise en production.
 * Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, CONTACT, ATELIER, lienWhatsApp } from '../config';

import bobines from '../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import machine from '../assets/creations/detail/machine-a-broder-en-cours-atelier-vitre.webp';
import ogSource from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const og = await getImage({ src: ogSource, format: 'webp', width: 1200 });

/* ---------------------------------------------------------------------------
   PRIX & DÉLAIS — calculés, jamais saisis
--------------------------------------------------------------------------- */
const creations = await getCollection('creations', ({ data }) => !data.masquee);

const LIBELLE: Record<string, { nom: string; quoi: string }> = {
  naissance: { nom: 'Naissance & enfant', quoi: 'Doudou, cadre de naissance, bavoir, sac à dos' },
  'linge-de-bain': { nom: 'Linge de bain', quoi: 'Drap de bain, serviette, cape de bain, peignoir' },
  vetements: { nom: 'Vêtements', quoi: 'Polo, sweat, doudoune, chemise' },
  couture: { nom: 'Sacs, trousses & tabliers', quoi: 'Cousus main par moi, puis brodés' },
  'decoration-ajouree': { nom: 'Dentelle libre', quoi: 'Arbre de vie, papillon, initiale, napperon' },
  noel: { nom: 'Noël', quoi: 'Chaussette de cheminée, pyjama, boule brodée' },
};
const ORDRE_CAT = ['naissance', 'linge-de-bain', 'couture', 'decoration-ajouree', 'vetements', 'noel'];

const fourchettes = ORDRE_CAT.map((cat) => {
  const lot = creations.filter((c) => c.data.categorie === cat);
  const prix = lot.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
  const jours = lot.map((c) => c.data.delaiJours).filter((n): n is number => typeof n === 'number');
  if (prix.length === 0) return null;
  return {
    cat,
    nom: LIBELLE[cat].nom,
    quoi: LIBELLE[cat].quoi,
    prix: Math.min(...prix),
    jours: jours.length ? Math.max(...jours) : null,
  };
}).filter((f): f is NonNullable<typeof f> => f !== null);

const tousPrix = creations.map((c) => c.data.prixDepart).filter((n): n is number => typeof n === 'number');
const tousJours = creations.map((c) => c.data.delaiJours).filter((n): n is number => typeof n === 'number');

const prixMin = Math.min(...tousPrix);
const prixMax = Math.max(...tousPrix);
const joursMin = Math.min(...tousJours);
const joursMax = Math.max(...tousJours);

/* Les cinq étapes : une vraie séquence, la seule de la page à être numérotée. */
const etapes = [
  {
    t: 'Votre demande',
    r: "Par WhatsApp, par le formulaire ou par téléphone, indiquez-moi le prénom ou le texte, l'occasion et la date souhaitée. Une photo d'inspiration est la bienvenue. Une idée encore imprécise suffit pour commencer.",
  },
  {
    t: 'Ma proposition',
    r: `Je vous réponds avec un prix, un délai de réalisation et une proposition de motif. ${ATELIER.delaiReponse}. Cette demande ne vous engage à rien.`,
  },
  {
    t: 'Le choix des matières',
    r: "Nous choisissons ensemble le support, l'écriture, la couleur du fil et l'emplacement du motif, parmi mes tissus et mes fils ou sur la pièce que vous m'apportez.",
  },
  {
    t: 'La validation du motif',
    r: "Avant de lancer la machine, je vous envoie le motif. Tant que la broderie n'est pas réalisée, tout peut encore être modifié.",
    decision: true,
  },
  {
    t: 'Réalisation et remise',
    r: `Je brode la pièce, puis je l'emballe pour qu'elle soit prête à offrir. Remise en main propre à ${SITE.ville} ou à Rennes sur rendez-vous, ou envoi soigné partout en France.`,
  },
];

/* ---------------------------------------------------------------------------
   FAQ — une seule source, utilisée pour l'affichage ET pour le JSON-LD.
   ⚠️ La date limite de Noël (mi-novembre) est un EXEMPLE, à faire valider.
--------------------------------------------------------------------------- */
const faq = [
  {
    q: 'Brodez-vous à la main ?',
    r: `Non, je travaille en broderie machine. Elle garantit un tracé net et régulier, qui résiste au lavage. La couture, en revanche, est faite par mes soins : les sacs, les trousses et les tabliers sont cousus main, puis brodés.`,
  },
  {
    q: 'Quel délai faut-il prévoir ?',
    r: `Le délai de réalisation est actuellement de ${ATELIER.delaiActuel} à compter de la validation du motif, soit de ${joursMin} à ${joursMax} jours ouvrés selon la pièce. Pour Noël, je vous conseille de me contacter avant la mi-novembre afin de garantir une livraison avant le 24 décembre.`,
  },
  {
    q: 'Combien coûte une broderie personnalisée ?',
    r: `Les pièces du catalogue débutent entre ${prixMin} et ${prixMax} €. Le prix dépend de la taille du motif, du nombre de points et du support : un prénom court demande moins de temps de broderie qu'un motif large et dense. Le prix exact vous est communiqué avant toute réalisation, sans engagement.`,
  },
  {
    q: 'Que pouvez-vous broder ?',
    r: `Un prénom, une date, des mesures de naissance, une phrase ou un motif, sur du linge de bain, des vêtements, des doudous, des bavoirs, des sacs ou des tabliers. Je réalise également de la dentelle libre : une broderie sans tissu de support, qui tient seule.`,
  },
  {
    q: 'Puis-je fournir mon propre tissu ou vêtement ?',
    r: `Oui, c'est une demande fréquente. Je brode alors directement sur votre pièce, et seule la broderie est facturée. Précisez-moi la matière à l'avance : un tissu très fin ou extensible nécessite un renfort adapté.`,
  },
  {
    q: 'Que se passe-t-il si le motif ne me convient pas ?',
    r: `Je vous soumets le motif avant de lancer la machine : écriture, taille, couleur du fil et emplacement. Tant que la broderie n'est pas réalisée, tout peut être modifié. Une fois piqué, le fil ne peut plus être retiré proprement : c'est la raison d'être de cette étape de validation.`,
  },
  {
    q: 'Comment récupérer ma commande ?',
    r: `${ATELIER.zones}. La remise en main propre se fait sur rendez-vous, dans un lieu public convenu ensemble. Les frais d'envoi dépendent du poids et du format ; ils figurent sur le devis. L'emballage cadeau est compris.`,
  },
  {
    q: 'Acceptez-vous les commandes urgentes ?',
    r: `Cela dépend de la pièce et du planning en cours. Indiquez-moi la date souhaitée sur WhatsApp : je vérifie et je vous réponds honnêtement. Je préfère décliner une commande plutôt que de la livrer en retard.`,
  },
  {
    q: 'Comment entretenir une broderie ?',
    r: `Lavage en machine à 30°, pièce retournée. Repassage sur l'envers. Évitez l'eau de Javel, qui décolore le fil.`,
  },
];

const donneesFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};

const titre = `Sur-mesure : commander une broderie personnalisée à ${SITE.ville} · ${SITE.nom}`;
const description = `Étapes, délais, prix à partir de ${prixMin} €, entretien, livraison et emballage cadeau : tout ce qu'il faut savoir avant de commander une broderie personnalisée ou une pièce cousue sur mesure à ${SITE.ville} (35).`;
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[{ nom: 'Sur-mesure', url: '/sur-mesure/' }]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donneesFaq)} />

  {/*
    ⚠️ MAQUETTE — prix, délais, date limite de Noël, numéro et e-mail
    provisoires (src/config.ts et src/content/creations). À faire valider
    par Emma avant la mise en production.
  */}

  <!-- ===================== OUVERTURE ===================== -->
  <section class="bande sm-ouv">
    <nav class="ariane sm-ouv__ariane" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Sur-mesure</span>
    </nav>

    <div class="sm-ouv__dire">
      <h1>Commander une broderie sur mesure</h1>
      <p class="chapo">
        Broderie personnalisée et couture sur mesure à {SITE.ville}&nbsp;(35), avec remise en main
        propre à {SITE.ville} et à Rennes, ou envoi dans toute la France. Vous trouverez ici le
        déroulement d'une commande, les prix de départ, les délais de réalisation et les conseils
        d'entretien.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>Écrire sur WhatsApp</a>
        <a class="btn btn--creux btn--grand" href="/contact/#devis">Demander un devis</a>
      </p>
    </div>

    <!-- La fiche d'atelier : ce qu'on cherche en arrivant, en quatre lignes. -->
    <aside class="sm-fiche" aria-label="L'essentiel en bref">
      <p class="sm-fiche__tete">L'essentiel</p>
      <dl class="sm-fiche__dl">
        <div>
          <dt>Prix</dt>
          <dd><span class="mono">à partir de</span> <b>{prixMin}&nbsp;€</b></dd>
        </div>
        <div>
          <dt>Délai actuel</dt>
          <dd><b>{ATELIER.delaiActuel}</b></dd>
        </div>
        <div>
          <dt>Réponse</dt>
          <dd>{ATELIER.delaiReponse}</dd>
        </div>
        <div>
          <dt>Emballage</dt>
          <dd>emballage cadeau compris</dd>
        </div>
      </dl>
      <p class="sm-fiche__pied">Le motif vous est soumis pour validation avant toute réalisation.</p>
    </aside>
  </section>

  <!-- ===================== LES ÉTAPES : la vraie séquence ===================== -->
  <section class="bande sm-pas" id="etapes" data-broderie="fil" data-fil="#D93D28">
    <div class="sm-pas__tete">
      <h2 class="titre-xl">Le déroulement d'une commande</h2>
      <p class="mesure">
        Une seule étape vous demande une décision&nbsp;: la validation du motif. Je me charge de
        tout le reste, de la préparation à l'emballage.
      </p>
    </div>

    <ol class="etapes sm-etapes">
      {
        etapes.map((e, i) => (
          <li class={e.decision ? 'sm-etapes__decision' : undefined}>
            <p class="etapes__n">
              Étape {i + 1}
              {e.decision && <span class="sm-etapes__marque">votre validation</span>}
            </p>
            <h3>{e.t}</h3>
            <p>{e.r}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ===================== PRIX : le tarif, comme une fiche d'atelier ===================== -->
  <section class="bande sm-prix" id="prix">
    <div class="sm-prix__intro">
      <h2 class="titre-xl">Les prix de départ</h2>
      <p class="mesure">
        Le prix dépend de trois éléments&nbsp;: la taille du motif, le nombre de points et le
        support. Un prénom court demande moins de temps de broderie qu'un motif large et dense. Les
        pièces du catalogue débutent entre {prixMin} et {prixMax}&nbsp;€.
      </p>
      <p class="sm-prix__note">Si vous fournissez le vêtement, seule la broderie est facturée.</p>
    </div>

    {/* ⚠️ EXEMPLES : prix et délais calculés depuis les créations provisoires. */}
    <ul class="sm-tarif" aria-label="Prix de départ par type de pièce">
      {
        fourchettes.map((f) => (
          <li>
            <a class="sm-tarif__ligne" href={`/creations/${f.cat}/`}>
              <span class="sm-tarif__nom">{f.nom}</span>
              <span class="sm-tarif__quoi">{f.quoi}</span>
              {f.jours && <span class="sm-tarif__delai mono">≈ {f.jours} jours ouvrés</span>}
              <span class="sm-tarif__prix prix">
                à partir de <b>{f.prix}&nbsp;€</b>
              </span>
              <span class="sm-tarif__voir" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="sm-prix__pied">
      Chaque devis est établi à partir du motif préparé&nbsp;: le prix correspond au nombre de
      points réel, et non à une estimation.
      <a class="lien-fleche" href="/contact/#devis">Décrire mon projet</a>
    </p>
  </section>

  <!-- ===================== DÉLAIS — RUPTURE SUR LE TAPIS ===================== -->
  <section class="bande tapis sm-delais" id="delais">
    <span class="regle plein sm-delais__regle" aria-hidden="true"></span>

    <div class="sm-delais__dire">
      <h2 class="sm-delais__titre">Les délais de réalisation</h2>
      <p class="mesure mesure--clair">
        Je réalise les commandes l'une après l'autre. Chaque pièce a sa place dans le planning, et
        je peux vous indiquer à tout moment où en est la vôtre.
      </p>
      <p class="sm-delais__actuel">
        <span class="mono">Délai actuel</span>
        <b>{ATELIER.delaiActuel}</b>
        <span class="sm-delais__precision">à compter de la validation du motif, soit de {joursMin} à {joursMax} jours ouvrés selon la pièce</span>
      </p>
    </div>

    {/* ⚠️ « mi-novembre » : EXEMPLE de date limite, à faire confirmer par Emma. */}
    <ul class="sm-dates">
      <li>
        <span class="sm-dates__quand">Noël</span>
        <p>Pour une livraison avant le 24 décembre, merci de me contacter avant la mi-novembre.</p>
      </li>
      <li>
        <span class="sm-dates__quand">Naissance</span>
        <p>La date du terme suffit&nbsp;: je prépare le motif à l'avance et je brode le prénom dès la naissance.</p>
      </li>
      <li>
        <span class="sm-dates__quand">Demande urgente</span>
        <p>Indiquez-moi la date sur WhatsApp&nbsp;: je vérifie le planning et je vous réponds honnêtement.</p>
        <a
          class="btn btn--or"
          href={lienWhatsApp('Bonjour Emma, est-ce que vous pourriez broder une pièce pour une date précise ?')}
        >
          Vérifier une date
        </a>
      </li>
    </ul>
  </section>

  <!-- ===================== BANDEAU PLEINE LARGEUR ===================== -->
  <div class="bandeau">
    <Image
      src={bobines}
      alt="Mur de l'atelier couvert de bobines de fil à broder de toutes les couleurs"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="bandeau__mot" aria-hidden="true">Le choix du fil se fait ensemble.</p>
  </div>

  <!-- ===================== ENTRETIEN + LIVRAISON ===================== -->
  <section class="bande sm-soin loin" id="entretien">
    <figure class="sm-soin__fig" data-broderie="tambour">
      <Image
        src={machine}
        alt="Gros plan de la broderie en cours sous la tête de la machine : motif de cerisier en fleurs en fil de couleur"
        widths={[420, 680, 1000]}
        sizes="(max-width: 64rem) 80vw, 30vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="sm-soin__txt">
      {/* ⚠️ Le 30° vient du contenu des créations. Le reste des conseils
          d'entretien est à faire confirmer par Emma. [À CONFIRMER] */}
      <h2 class="titre-xl">Entretien d'une broderie</h2>
      <p class="mesure">
        Une broderie machine se lave comme la pièce qui la porte&nbsp;: un doudou brodé comme un
        doudou, une serviette brodée comme une serviette. Le fil conserve sa tenue et sa couleur.
      </p>

      <!-- L'étiquette d'entretien, cousue comme celles des vêtements -->
      <dl class="sm-etiquette">
        <div>
          <dt>lavage</dt>
          <dd><b>30°</b> cycle normal, pièce retournée</dd>
        </div>
        <div>
          <dt>repassage</dt>
          <dd>sur l'envers, ou avec un linge entre le fer et la broderie</dd>
        </div>
        <div>
          <dt>à éviter</dt>
          <dd>l'eau de Javel, qui décolore le fil</dd>
        </div>
      </dl>
    </div>

    <div class="sm-soin__livraison">
      <h2 class="sm-soin__h2b">Remise et envoi</h2>
      <p>
        {ATELIER.zones}. La remise en main propre se fait <b>sur rendez-vous</b>, dans un lieu
        public convenu ensemble&nbsp;: je travaille à domicile et ne reçois pas de public. Les
        frais d'envoi dépendent du poids et du format&nbsp;; ils figurent sur le devis.
      </p>
      <p class="sm-soin__cadeau">
        L'emballage cadeau est compris. S'il s'agit d'une surprise, précisez-le&nbsp;: rien ne
        sera inscrit sur le colis.
      </p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="bande sm-faq loin" id="questions">
    <div class="sm-faq__tete">
      <h2 class="titre-xl">Questions fréquentes</h2>
      <p class="mesure">
        Si votre question n'y figure pas, posez-la-moi directement&nbsp;: je vous répondrai
        volontiers.
      </p>
      <a class="lien-wa" href={lienWhatsApp("Bonjour Emma, j'ai une question avant de commander :")}>
        Poser une question
      </a>
    </div>

    <div class="sm-faq__liste">
      {
        faq.map((f, i) => (
          <details class="sm-q" open={i === 0}>
            <summary>
              <span class="sm-q__q">{f.q}</span>
              <span class="sm-q__croix" aria-hidden="true" />
            </summary>
            <div class="sm-q__r">
              <p>{f.r}</p>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ===================== APPEL FINAL ===================== -->
  <section class="final bande">
    <div class="final__in">
      <h2 class="titre-geant sm-final__titre">Demander un devis</h2>
      <p class="chapo">
        Le formulaire vous guide en quelques questions courtes. Vous pouvez aussi m'écrire
        directement sur WhatsApp&nbsp;: je lis et je réponds personnellement à chaque message.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>Écrire sur WhatsApp</a>
        <a class="btn btn--or btn--grand" href="/contact/#devis">Remplir le formulaire</a>
      </p>
      <p class="final__note">
        ou par téléphone&nbsp;: <a href={`tel:${CONTACT.telephone}`}>{CONTACT.telephone}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     /sur-mesure/ — préfixe `sm-`.
     Rythme vertical volontairement inégal d'une section à l'autre.
     ========================================================================== */

  /* ============================ OUVERTURE ============================ */
  .sm-ouv {
    padding-block: clamp(0.5rem, 2vw, 1.5rem) var(--serre);
    row-gap: clamp(1.5rem, 4vw, 3rem);
  }
  .sm-ouv__dire { display: grid; gap: clamp(1.1rem, 2.2vw, 1.8rem); justify-items: start; }
  .sm-ouv h1 { max-width: 13ch; }

  /* La fiche : papier, coin replié, bord perforé en haut */
  .sm-fiche {
    --perfo: 10px;
    position: relative;
    justify-self: start;
    width: min(100%, 24rem);
    padding: 1.6rem 1.4rem 1.2rem;
    background: var(--papier);
    border-radius: 0 0 var(--r-s) var(--r-s);
    box-shadow: 0 24px 50px -30px color-mix(in oklab, var(--encre) 60%, transparent);
    rotate: -1.5deg;
    /* une rangée de trous en haut, comme une fiche arrachée d'un carnet */
    mask-image:
      radial-gradient(circle at 50% 0, transparent 4px, #000 4.5px),
      linear-gradient(#000, #000);
    mask-size: 18px 12px, 100% calc(100% - 12px);
    mask-position: 0 0, 0 12px;
    mask-repeat: repeat-x, no-repeat;
    -webkit-mask-image:
      radial-gradient(circle at 50% 0, transparent 4px, #000 4.5px),
      linear-gradient(#000, #000);
    -webkit-mask-size: 18px 12px, 100% calc(100% - 12px);
    -webkit-mask-position: 0 0, 0 12px;
    -webkit-mask-repeat: repeat-x, no-repeat;
  }
  .sm-fiche__tete {
    font-family: var(--f-titre);
    font-size: 1.7rem;
    line-height: 1;
  }
  .sm-fiche__pied { font-size: var(--t-petit); line-height: 1.45; color: var(--encre-doux); padding-block-start: 0.9rem; }
  .sm-fiche__dl { margin-block-start: 0.8rem; }
  .sm-fiche__dl > div {
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: baseline;
    padding-block: 0.65rem;
    border-block-end: 1px dashed color-mix(in oklab, var(--encre) 28%, transparent);
  }
  .sm-fiche dt { font-size: var(--t-petit); color: var(--gris); }
  .sm-fiche dd { margin: 0; font-size: var(--t-petit); line-height: 1.35; }
  .sm-fiche dd .mono { font-size: var(--t-micro); color: var(--gris); }
  .sm-fiche dd b {
    font-family: var(--f-titre);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    line-height: 1;
    color: var(--encre);
  }
  .sm-fiche__dl > div:first-child b { color: var(--coquelicot-fonce); }

  @media (min-width: 64rem) {
    .sm-ouv {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.66)) [mi] minmax(0, calc(var(--large) * 0.34))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      min-height: calc(88svh - 4.5rem);
      align-content: center;
    }
    .sm-ouv__ariane { grid-column: large-d / large-f; align-self: start; }
    .sm-ouv__dire { grid-column: large-d / mi; padding-inline-end: 2rem; }
    .sm-ouv h1 { font-size: clamp(4rem, 1rem + 5vw, 7rem); max-width: 12ch; }
    .sm-fiche { grid-column: mi / large-f; justify-self: end; align-self: end; margin-block-end: 1rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
