---
/**
 * /merci/ — page d'arrivée après l'envoi du formulaire de demande.
 * C'est la valeur de `action` du formulaire de /contact/.
 * ⚠️ noindex : cette page ne doit jamais apparaître dans les résultats.
 * Pas d'AppelFinal : la demande vient d'être envoyée.
 * Le déroulement est ETAPES_COMMANDE (canonique), jamais réécrit ici.
 */
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import TeteSection from '../components/TeteSection.astro';
import Etapes from '../components/Etapes.astro';
import ListeLignes from '../components/ListeLignes.astro';
import { SITE, CONTACT, ATELIER, LIBELLES, ETAPES_COMMANDE, lienWhatsApp, telephoneLisible } from '../config';

const titre = `Demande reçue · ${SITE.nom}`;
const description =
  'Votre demande est bien arrivée. Je vous réponds avec un prix, un délai de réalisation et une proposition.';
const fil = [{ nom: 'Demande reçue', url: '/merci/' }];

const messageWa = 'Bonjour Emma, je viens de vous envoyer une demande depuis votre site.';

/* ⚠️ Le délai de 48 heures avant relance est un EXEMPLE à faire valider par Emma. */
const precisions = [
  {
    titre: 'Votre boîte de réception',
    texte: `Ma réponse part de ${CONTACT.email}. Si elle n’apparaît pas, pensez à vérifier le dossier des courriers indésirables.`,
  },
  {
    titre: 'Sans réponse sous 48 heures',
    texte: 'Un e-mail peut se perdre. Écrivez-moi alors sur WhatsApp : c’est le moyen le plus rapide de me joindre.',
  },
  {
    titre: 'Un élément à ajouter',
    texte: 'Une photo, une date ou une couleur : envoyez-la sur WhatsApp, je la joindrai à votre demande.',
  },
];

const liens = [
  { titre: 'Les créations', texte: 'Les pièces réalisées récemment à l’atelier.', href: '/creations/' },
  { titre: 'Le déroulement d’une commande', texte: 'Étapes, prix, délais et questions fréquentes.', href: '/sur-mesure/' },
  { titre: `@${CONTACT.instagram}`, texte: 'Les pièces récentes y sont publiées en premier.', href: CONTACT.instagramUrl },
  { titre: 'Retour à l’accueil', texte: SITE.baseline, href: '/' },
];
---

<Base titre={titre} description={description} noindex={true} fil={fil} messageWa={messageWa}>
  {/* ⚠️ MAQUETTE — délai de réponse provisoire (src/config.ts). */}

  <HautDePage titre="Votre demande a bien été reçue" fil={fil}>
    <p>
      Merci. {ATELIER.delaiReponse}, avec un prix, un délai de réalisation et une proposition de
      motif. Cette demande ne vous engage à rien.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={lienWhatsApp(messageWa)}>{LIBELLES.whatsapp}</a>
    <a slot="actions" class="btn btn--creux btn--grand" href={`tel:${CONTACT.telephone}`}>
      Appeler le {telephoneLisible()}
    </a>
    <div slot="aside" class="mr-aside">
      <ListeLignes lignes={precisions} />
    </div>
  </HautDePage>

  <!-- ===================== LA SUITE ===================== -->
  <section class="bande mr-section" aria-labelledby="mr-suite">
    <TeteSection titre="La suite de votre commande" id="mr-suite">
      <p>Votre demande est la première étape&nbsp;; voici les deux suivantes.</p>
    </TeteSection>
    <Etapes etapes={ETAPES_COMMANDE} />
  </section>

  <!-- ===================== POUR CONTINUER ===================== -->
  <section class="bande mr-section" aria-labelledby="mr-visite">
    <TeteSection titre="Pour continuer la visite" id="mr-visite" />
    <ListeLignes lignes={liens} />
  </section>
</Base>

<style>
  .mr-section { padding-block: var(--serre); }
</style>
