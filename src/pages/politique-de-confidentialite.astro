---
/**
 * Politique de confidentialité.
 *
 * Rédigée d'après CLAUDE.md § Légal :
 *  - demandes de contact : finalité, base légale, 3 ans après le dernier contact ;
 *  - données de vente : conservation comptable 10 ans ;
 *  - mailing : consentement explicite, désinscription à chaque envoi ;
 *  - statistiques de visite : agrégées, sans cookie ni identifiant ;
 *  - droits RGPD et façon concrète de les exercer ;
 *  - sous-traitants : Netlify (hébergement, formulaires, stockage) et
 *    WhatsApp / Meta si la visiteuse choisit ce canal.
 *
 * Ton : sobre et clair. Emma doit pouvoir relire cette page et la comprendre.
 * ⚠️ Aucune adresse postale publiée (elle travaille chez elle) : l'exercice des
 * droits passe par le courriel.
 *
 * Mise en page : page de lecture longue, gabarit jumeau de mentions-legales.astro
 * (les deux feuilles de style sont à garder alignées). Sommaire collant à gauche
 * sur grand écran, section en cours allumée en CSS pur (timeline-scope).
 */
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import { SITE, CONTACT } from '../config';
/* Le gabarit retombe sinon sur /og-defaut.jpg, qui n'existe pas encore
   dans public/ : l'aperçu de partage serait cassé. */
import ogPage from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const titre = `Politique de confidentialité | ${SITE.nom}`;
const description =
  "Ce que devient ce que vous m’écrivez : données collectées, durées de conservation, absence de cookie de suivi, sous-traitants (Netlify, WhatsApp) et vos droits RGPD.";

/* ⚠️ À mettre à jour à la main à chaque modification du texte de cette page. */
const miseAJour = '26 septembre 2026';

/** Vrai si la valeur de config est encore un marqueur à compléter. */
const manque = (v: string) => v.includes('[À');

/**
 * Les traitements, un par bloc. C'est le cœur de la page : chacun dit ce qui
 * est collecté, pourquoi, sur quelle base légale, et pendant combien de temps.
 * `article` et `court` alimentent le tableau récapitulatif : ce sont des
 * abréviations fidèles de `base` et `duree`, rien de plus.
 */
const traitements = [
  {
    nom: 'Votre demande de devis',
    donnees:
      'Prénom et nom, adresse e-mail, téléphone si vous le donnez, type de projet, occasion, date souhaitée, budget indicatif, texte à broder, photo d’inspiration si vous en joignez une, canal de réponse préféré.',
    finalite:
      'Vous répondre, établir un devis, préparer la pièce, et retrouver votre historique si vous recommandez.',
    base: 'Exécution d’un contrat ou mesures précontractuelles prises à votre demande (article 6.1.b du RGPD).',
    article: '6.1.b · contrat',
    duree: '3 ans à compter de notre dernier échange.',
    court: '3 ans après notre dernier échange',
  },
  {
    nom: 'Vos commandes et vos factures',
    donnees:
      'Identité, nature de la pièce, montant, date, mode de règlement. Ces informations alimentent le livre des recettes obligatoire en micro-entreprise.',
    finalite: 'Tenir la comptabilité de l’entreprise et justifier les recettes déclarées.',
    base: 'Obligation légale comptable et fiscale (article 6.1.c du RGPD).',
    article: '6.1.c · obligation légale',
    duree: '10 ans, durée légale de conservation des pièces comptables.',
    court: '10 ans',
  },
  {
    nom: 'La liste des nouveautés',
    donnees: 'Votre adresse e-mail, la date et l’origine de votre inscription.',
    finalite:
      'Vous prévenir des nouveautés et des dates limites de commande avant Noël ou la fête des mères. Quelques messages par an, pas plus.',
    base: 'Votre consentement, donné par une case à cocher qui n’est jamais pré-cochée (article 6.1.a du RGPD).',
    article: '6.1.a · consentement',
    duree:
      'Jusqu’à votre désinscription. Chaque message indique comment se désinscrire ; une simple réponse « STOP » suffit.',
    court: 'Jusqu’à votre désinscription',
  },
  {
    nom: 'Les statistiques de visite',
    donnees:
      'Des compteurs agrégés par jour : nombre de pages vues, page consultée, provenance approximative (moteur de recherche, réseau social, QR code). Aucun cookie, aucun identifiant, aucune empreinte de navigateur, aucune adresse IP conservée. Ces chiffres ne permettent pas de vous reconnaître ni de vous suivre d’une page à l’autre.',
    finalite:
      'Savoir quelles pages sont réellement utiles, afin d’améliorer le site, et à aucune autre fin.',
    base: 'Intérêt légitime à mesurer l’audience de son propre site (article 6.1.f du RGPD).',
    article: '6.1.f · intérêt légitime',
    duree: 'Les compteurs agrégés sont conservés sous forme de totaux, sans donnée individuelle.',
    court: 'Totaux seulement, sans donnée individuelle',
  },
  {
    nom: 'Si vous m’écrivez sur WhatsApp',
    donnees: 'Votre numéro de téléphone, votre nom tel qu’il apparaît, et le contenu du message.',
    finalite: 'Échanger sur votre projet par le canal que vous avez choisi.',
    base: 'Votre initiative : c’est vous qui ouvrez la conversation (article 6.1.b du RGPD).',
    article: '6.1.b · votre initiative',
    duree:
      'La conversation reste dans WhatsApp selon ses propres règles, et dans le téléphone d’Emma jusqu’à suppression. Si vous préférez l’e-mail, le formulaire du site convient tout aussi bien.',
    court: 'Selon WhatsApp, et jusqu’à suppression',
  },
];

const droits = [
  { nom: 'Accès', dire: 'savoir ce que je conserve à votre sujet, et en recevoir une copie' },
  { nom: 'Rectification', dire: 'corriger une information fausse ou incomplète' },
  { nom: 'Effacement', dire: 'demander la suppression de vos données' },
  { nom: 'Opposition', dire: 'refuser un traitement fondé sur l’intérêt légitime' },
  { nom: 'Limitation', dire: 'demander le gel d’un traitement le temps d’une vérification' },
  { nom: 'Portabilité', dire: 'récupérer les données que vous m’avez fournies, dans un fichier' },
  {
    nom: 'Retrait du consentement',
    dire: 'quitter la liste des nouveautés à tout moment, sans justification',
  },
];

const sommaire = [
  { id: 'responsable', nom: 'Responsable du traitement' },
  { id: 'collecte', nom: 'Données collectées' },
  { id: 'cookies', nom: 'Cookies' },
  { id: 'destinataires', nom: 'Destinataires' },
  { id: 'droits', nom: 'Vos droits' },
  { id: 'securite', nom: 'Sécurité' },
  { id: 'modifications', nom: 'Modifications' },
];
const fil = [{ nom: 'Politique de confidentialité', url: '/politique-de-confidentialite/' }];
const tl = (id: string) => `--pc-${id}`;
const portee = `timeline-scope: ${sommaire.map((s) => tl(s.id)).join(', ')}`;
const vt = (id: string) => `view-timeline-name: ${tl(id)}`;
---

<Base
  titre={titre}
  description={description}
  imageOg={ogPage.src}
  fil={fil}
>
  <HautDePage titre="Politique de confidentialité" fil={fil} faits={[`Dernière mise à jour : ${miseAJour}`]}>
    <p>
      Cette page explique quelles informations je conserve lorsque vous me contactez, dans quel
      but et pendant combien de temps. Je travaille seule&nbsp;: vos messages ne sont lus par
      personne d’autre, et aucune donnée n’est revendue ni cédée.
    </p>
  </HautDePage>

  <div class="bande lecture">
    <div class="grille lecture__grille" style={portee}>
      <nav class="som" aria-labelledby="som-titre">
        <p class="som__titre mono" id="som-titre">Sur cette page</p>
        <ol>
          {
            sommaire.map((s) => (
              <li>
                <a href={`#${s.id}`} style={`animation-timeline: ${tl(s.id)}`}>
                  {s.nom}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="lecture__texte">
          <ul class="resume">
            <li><b>Aucun cookie de suivi</b>, donc aucun bandeau de consentement.</li>
            <li><b>Aucune publicité</b>, aucun pixel de réseau social, aucune revente de données.</li>
            <li><b>Vos coordonnées servent uniquement</b> à vous répondre et à réaliser votre commande.</li>
          </ul>
        <section class="sec" id="responsable" style={vt('responsable')}>
          <h2>Responsable du traitement</h2>
          <p>
            {SITE.nomLegal}, exploitante de {SITE.nom}, entrepreneure individuelle à {SITE.ville} ({
              SITE.departement
            }).
          </p>
          <p>
            Pour toute question sur cette page ou sur vos données&nbsp;:{' '}
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
          </p>
          <p class="note">
            L’adresse de l’atelier n’est pas publiée&nbsp;: c’est un domicile. Les demandes passent
            donc par courriel, et reçoivent une réponse écrite.
            {
              manque(SITE.siret) && (
                <span class="drapeau">
                  Identification de l’entreprise (SIRET) encore à compléter&nbsp;: voir les{' '}
                  <a href="/mentions-legales/">mentions légales</a>.
                </span>
              )
            }
          </p>
        </section>

        <section class="sec" id="collecte" style={vt('collecte')}>
          <h2>Les données que je collecte</h2>
          <p>
            Cinq situations sont concernées. Pour chacune, vous trouverez ci-dessous ce qui est
            collecté, dans quel but, sur quelle base légale et pendant combien de temps.
          </p>

          <div class="tableau" role="region" aria-labelledby="tableau-titre" tabindex="0">
            <table>
              <caption id="tableau-titre" class="mono">Récapitulatif des durées de conservation</caption>
              <thead>
                <tr>
                  <th scope="col">Situation</th>
                  <th scope="col">Base légale (RGPD)</th>
                  <th scope="col">Conservation</th>
                </tr>
              </thead>
              <tbody>
                {
                  traitements.map((t) => (
                    <tr>
                      <th scope="row">{t.nom}</th>
                      <td class="mono">{t.article}</td>
                      <td>{t.court}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="traitements">
            {
              traitements.map((t) => (
                <article class="trait">
                  <h3>{t.nom}</h3>
                  <dl class="fiche">
                    <div>
                      <dt>Données</dt>
                      <dd>{t.donnees}</dd>
                    </div>
                    <div>
                      <dt>Finalité</dt>
                      <dd>{t.finalite}</dd>
                    </div>
                    <div>
                      <dt>Base légale</dt>
                      <dd>{t.base}</dd>
                    </div>
                    <div>
                      <dt>Durée</dt>
                      <dd>{t.duree}</dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>

          <p class="note">
            Les champs du formulaire marqués comme obligatoires sont ceux sans lesquels je ne peux
            pas vous répondre. Tous les autres sont facultatifs&nbsp;: un formulaire partiellement
            rempli me suffit pour commencer.
          </p>
        </section>

        <section class="sec" id="cookies" style={vt('cookies')}>
          <h2>Cookies</h2>
          <p>
            Ce site ne dépose <b>aucun cookie de mesure d’audience, de publicité ou de réseau
            social</b>. Les statistiques décrites plus haut sont de simples compteurs sans
            identifiant. C’est pour cette raison qu’aucun bandeau de consentement ne s’affiche à
            votre arrivée.
          </p>
          <p>
            Un seul cookie existe&nbsp;: celui qui maintient la session de l’espace
            d’administration, utilisé uniquement par Emma pour gérer ses commandes. Il est
            strictement nécessaire au fonctionnement de cet outil, ne sert à aucun suivi et ne vous
            concerne pas&nbsp;: à ce titre, il est exempté de consentement.
          </p>
        </section>

        <section class="sec" id="destinataires" style={vt('destinataires')}>
          <h2>Qui d’autre peut voir ces données</h2>
          <p>
            Personne, à l’exception des prestataires techniques qui font fonctionner le site. Aucune
            donnée n’est vendue, louée, échangée ni transmise à un partenaire commercial.
          </p>

          <dl class="prestataires">
            <div>
              <dt>Netlify, Inc.</dt>
              <dd>
                Hébergement du site, réception des formulaires et stockage des données de gestion
                (demandes, ventes, réglages). Société établie aux États-Unis, à San Francisco. Les
                transferts hors Union européenne sont encadrés par les clauses contractuelles types
                de la Commission européenne et par le cadre de protection des données UE – États-Unis.
                <!-- ⚠️ À revérifier avant la mise en ligne : le DPA de Netlify et l'état du cadre
                     UE–États-Unis évoluent. Voir aussi les mentions légales. -->
              </dd>
            </div>
            <div>
              <dt>WhatsApp Ireland Ltd. (groupe Meta)</dt>
              <dd>
                Uniquement si <b>vous choisissez</b> d’écrire par WhatsApp. Dans ce cas, la
                conversation circule dans WhatsApp et relève aussi de sa politique de
                confidentialité, sur laquelle je n’ai pas la main. Si vous préférez l’éviter, le
                formulaire du site ou un simple e-mail ne passent pas par WhatsApp.
              </dd>
            </div>
          </dl>
        </section>

        <section class="sec" id="droits" style={vt('droits')}>
          <h2>Vos droits</h2>
          <p>Sur les données qui vous concernent, vous pouvez exercer les droits suivants&nbsp;:</p>
          <dl class="fiche droits">
            {
              droits.map((d) => (
                <div>
                  <dt>{d.nom}</dt>
                  <dd>{d.dire}</dd>
                </div>
              ))
            }
          </dl>
          <p>
            Il suffit d’écrire à <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> en précisant
            votre demande&nbsp;: aucun formulaire ni justificatif n’est nécessaire dans les cas
            simples. Je réponds dans un délai d’un mois au maximum, et en pratique bien plus tôt.
          </p>
          <p class="note">
            Une limite&nbsp;: les informations liées à une vente (montant, date, nature) doivent être
            conservées dix ans pour la comptabilité. Une demande d’effacement ne peut donc pas les
            supprimer avant ce délai&nbsp;; toutes les autres données, si.
          </p>
          <p>
            Si ma réponse ne vous satisfait pas, vous pouvez saisir la CNIL&nbsp;: 3 place de
            Fontenoy, TSA 80715, 75334 Paris Cedex 07,
            ou <a href="https://www.cnil.fr/" rel="noopener nofollow" target="_blank">cnil.fr</a>.
          </p>
        </section>

        <section class="sec" id="securite" style={vt('securite')}>
          <h2>Sécurité</h2>
          <p>
            Les formulaires et l’espace d’administration passent par une connexion chiffrée
            (HTTPS). L’accès aux demandes et aux ventes est protégé par un mot de passe et une
            session limitée dans le temps. Les photos publiées sur le site sont nettoyées de leurs
            métadonnées, notamment de la position GPS que les téléphones ajoutent aux photos.
          </p>
        </section>

        <section class="sec" id="modifications" style={vt('modifications')}>
          <h2>Modifications de cette page</h2>
          <p>
            Cette page sera mise à jour si nécessaire, et la date indiquée en haut de page en fera
            foi. En cas de changement important (une nouvelle finalité, un nouveau prestataire),
            l’information sera visible sur le site.
          </p>
        </section>

        <p class="voir-aussi">
          <a class="lien-fleche" href="/mentions-legales/">Mentions légales</a>
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Page de lecture longue — gabarit jumeau de mentions-legales.
     Sommaire en col. 1-4 (collant), texte en col. 5-12 (~65 caractères). */
  .lecture { padding-block: var(--serre) var(--respire); }
  .lecture__grille { row-gap: 2rem; align-items: start; }
  .lecture__texte { max-width: 40rem; }
  @media (min-width: 64rem) {
    .som { grid-column: 1 / span 4; }
    .lecture__texte { grid-column: 5 / -1; }
  }

  /* ---------- Sommaire ---------- */
  .som__titre { font-size: var(--t-micro); color: var(--gris); padding-block-end: 0.4rem; }
  /* Téléphone : une ligne de liens qui défile dans son propre conteneur. */
  .som ol {
    display: flex; gap: 1.25rem;
    overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none;
    border-block: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .som ol::-webkit-scrollbar { display: none; }
  .som li { flex: none; }
  .som a {
    position: relative;
    display: flex; align-items: center; min-height: 44px;
    font-size: var(--t-petit); color: var(--encre-doux); text-decoration: none; white-space: nowrap;
  }
  .som a:hover { color: var(--prune); }
  @media (min-width: 64rem) {
    .som { position: sticky; inset-block-start: 6.5rem; }
    .som ol {
      display: grid; gap: 0; overflow: visible; border-block: 0;
      border-inline-start: 1px solid color-mix(in oklab, currentColor 18%, transparent);
    }
    .som a { white-space: normal; padding-inline-start: 1.1rem; line-height: 1.35; }
    /* Repère de la section en cours : un trait plein sur le filet. */
    .som a::before {
      content: ''; position: absolute; inset-block: 0.55rem; inset-inline-start: -1.5px; inline-size: 2px;
      background: var(--prune); border-radius: 2px;
      transform: scaleY(0); transform-origin: 50% 0;
    }
    .som a:hover::before { transform: none; }
  }
  /* La section en cours s'allume sans script (timeline-scope + view-timeline). */
  @supports (timeline-scope: --a) and (animation-timeline: view()) {
    .sec { view-timeline-inset: 28% 71%; }
    @media (min-width: 64rem) {
      .som a { animation: som-actif linear; animation-range: cover 0% cover 100%; }
      .som a::before {
        animation: inherit; animation-name: som-repere;
        animation-timeline: inherit; animation-range: inherit;
      }
    }
  }
  @keyframes som-actif { from, to { color: var(--prune); font-weight: 700; } }
  @keyframes som-repere { from, to { transform: none; } }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: var(--serre);
    border-block-start: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .sec:first-child { padding-block-start: 0; border: 0; }
  /* Texte long en colonne de 40rem : les H2 restent dans l'échelle mais
     descendent d'un cran, sinon Anybody casse chaque titre en 3 lignes. */
  .sec h2 { text-wrap: balance; margin-block-end: 1rem; font-size: calc(var(--t-h3) * 1.45); line-height: 1.02; }
  .sec p { max-width: 38rem; line-height: 1.7; color: var(--encre-doux); }
  .sec p + p { margin-block-start: 1em; }
  .sec a { text-underline-offset: 3px; overflow-wrap: anywhere; }
  .sec a:hover { color: var(--prune); }
  .sec .note {
    margin-block-start: 1.25em; padding: 1rem 1.25rem;
    border-radius: var(--r-m); background: var(--papier-2);
    font-size: var(--t-petit); color: var(--encre-doux);
  }

  /* ---------- Fiche d'identité ---------- */
  .fiche > div {
    display: grid; gap: 0.15rem; padding-block: 0.75rem;
    border-block-end: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .fiche dt { font-family: var(--f-mono); font-size: var(--t-micro); color: var(--gris); }
  .fiche dd { min-width: 0; line-height: 1.55; }
  @media (min-width: 40rem) {
    .fiche > div { grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); column-gap: 1.5rem; align-items: baseline; }
  }
  .drapeau { display: block; padding-block-start: 0.2rem; font-size: var(--t-petit); color: var(--gris); }

  .voir-aussi {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }

  /* ---------- Propre à la politique de confidentialité ---------- */
  .resume {
    display: grid; margin-block-end: var(--serre);
    border-block-start: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .resume li {
    padding-block: 0.85rem; color: var(--encre-doux);
    border-block-end: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .resume + .sec { border: 0; padding-block-start: 0; }
  .resume b, .prestataires b, .sec p b { font-weight: 500; color: var(--encre); }

  /* Tableau récapitulatif : il défile dans son propre conteneur. */
  .tableau {
    margin-block: 1.5rem 0.5rem;
    overflow-x: auto; overscroll-behavior-x: contain;
    border-block: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .tableau table { inline-size: 100%; min-inline-size: 34rem; border-collapse: collapse; font-size: var(--t-petit); line-height: 1.45; }
  .tableau caption { caption-side: top; text-align: start; padding-block: 0.9rem 0.6rem; font-size: var(--t-micro); color: var(--gris); }
  .tableau th, .tableau td {
    padding: 0.7rem 1rem 0.7rem 0; text-align: start; vertical-align: top;
    border-block-start: 1px solid color-mix(in oklab, currentColor 12%, transparent);
  }
  .tableau thead th { font-family: var(--f-mono); font-size: var(--t-micro); font-weight: 400; color: var(--gris); }
  .tableau tbody th { font-weight: 500; }
  .tableau td { color: var(--encre-doux); }
  .tableau td.mono { font-size: var(--t-micro); white-space: nowrap; }

  .traitements { display: grid; gap: var(--serre); margin-block-start: var(--serre); }
  .trait h3 { padding-block-end: 0.35rem; }

  .prestataires { display: grid; gap: 1.2rem; margin-block-start: 1.3rem; }
  .prestataires > div { padding: 1rem 1.25rem; border-radius: var(--r-m); background: var(--papier-2); }
  .prestataires dd { padding-block-start: 0.25rem; line-height: 1.65; color: var(--encre-doux); }
  .droits { margin-block: 0.8rem 1.2rem; }
  .droits dd { color: var(--encre-doux); }
</style>
