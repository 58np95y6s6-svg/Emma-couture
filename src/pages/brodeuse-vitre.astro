---
/**
 * Page locale principale : Vitré.
 *
 * Intention : c'est le terrain d'Emma. L'angle est la présence sur place :
 * la remise en main propre sur rendez-vous, les communes alentour, les
 * marchés. Rien de ce texte ne doit pouvoir être recopié sur la page Rennes
 * en changeant la ville : là-bas, l'angle est la distance.
 *
 * Cible : « brodeuse Vitré », « broderie Vitré », « cadeau personnalisé Vitré ».
 *
 * ⚠️ Emma travaille CHEZ ELLE : jamais d'adresse, jamais d'invitation à
 * passer. Retrait sur rendez-vous, adresse communiquée après accord.
 * ⚠️ CONTENU D'EXEMPLE : prix, délais, numéro WhatsApp, e-mail et téléphone
 * sont provisoires (src/config.ts). Vocabulaire : broderie MACHINE.
 */
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import TeteSection from '../components/TeteSection.astro';
import ListeLignes from '../components/ListeLignes.astro';
import LigneFaits from '../components/LigneFaits.astro';
import FAQ from '../components/FAQ.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { SITE, ATELIER, LIBELLES, lienWhatsApp } from '../config';

import sacAdos from '../assets/creations/galerie/sac-a-dos-enfant-brode-prenom-malo.webp';
import ogPage from '../assets/creations/og/emma-brodeuse-vitre-portrait.webp';

import pLinge from '../assets/creations/galerie/serviette-brodee-prenom-alicia-rose.webp';
import pNaissance from '../assets/creations/galerie/doudou-lapin-brode-prenom-naissance-vitre.webp';
import pCouture from '../assets/creations/galerie/trousse-cousue-main-brodee-prenom-lisa.webp';
import pDeco from '../assets/creations/galerie/tambour-decoratif-brode-fee-rouge.webp';

const titre = `Brodeuse à Vitré (35) · broderie personnalisée et couture | ${SITE.nom}`;
const description =
  'Brodeuse à Vitré (35) : broderie machine personnalisée au prénom, dentelle libre, sacs et trousses cousus main. Remise en main propre sur rendez-vous à Vitré, envoi partout en France.';
const fil = [{ nom: 'Brodeuse à Vitré', url: '/brodeuse-vitre/' }];

const messageWa =
  'Bonjour Emma, j’habite à Vitré ou dans les environs et j’aimerais vous confier un projet de broderie.';

/*
  ⚠️ À CONFIRMER AVEC EMMA — liste plausible, non validée.
  Jusqu'où accepte-t-elle de se déplacer ? Ces communes sont celles du pays
  de Vitré ; elles sont citées ici, et seulement ici, pour ne pas créer une
  page par commune (Google traite la série de pages « ville » comme du spam).
*/
const communes = [
  'Châteaubourg',
  'Argentré-du-Plessis',
  'La Guerche-de-Bretagne',
  'Étrelles',
  'Val-d’Izé',
  'Torcé',
  'Domalain',
  'Balazé',
  'Pocé-les-Bois',
  'Erbrée',
  'Montreuil-sous-Pérouse',
  'Saint-M’Hervé',
];

/*
  ⚠️ CONTENU À VALIDER — les quatre familles de pièces sont un exemple ;
  Emma choisira celles qui la représentent le mieux.
*/
const pieces = [
  {
    image: pLinge,
    alt: 'Drap de bain rose avec le prénom Alicia brodé en fil mauve sur la bordure',
    titre: 'Le linge de bain',
    texte: 'Drap de bain, serviette, peignoir, cape de bain, brodés au prénom.',
    href: '/creations/linge-de-bain/',
  },
  {
    image: pNaissance,
    alt: 'Lapin en peluche, prénom et date brodés sur les oreilles, cadeau de naissance',
    titre: 'Les cadeaux de naissance',
    texte: 'Doudou, bavoir, cadre de naissance avec le prénom, la date et le poids.',
    href: '/creations/naissance/',
  },
  {
    image: pCouture,
    alt: 'Trousse en tissu cousue main, prénom Lisa brodé sur le rabat',
    titre: 'Les sacs et trousses',
    texte: 'Cousus main à l’atelier, puis brodés. Le tissu et la doublure se choisissent ensemble.',
    href: '/creations/couture/',
  },
  {
    image: pDeco,
    alt: 'Tambour à broder décoratif : une fée en robe rouge brodée, prêt à accrocher',
    titre: 'Les pièces décoratives',
    texte: 'Tambour décoratif, cadre, dentelle libre ajourée, à accrocher ou à poser.',
    href: '/creations/decoration-ajouree/',
  },
];

/* FAQ locale. Le composant FAQ affiche ces questions et émet le JSON-LD. */
const faq = [
  {
    q: 'Où récupérer ma commande à Vitré ?',
    r: 'Nous convenons ensemble d’un lieu et d’un horaire par message, dans Vitré. Mon atelier se trouve à mon domicile et n’est pas ouvert au public : la remise se fait sur rendez-vous, et l’adresse précise n’est communiquée qu’après accord.',
  },
  {
    q: 'Quel est le délai de réalisation d’une broderie ?',
    r: 'Le délai court à compter de la validation du motif, et je vous l’indique précisément dès ma première réponse. Si vous avez une date impérative (naissance, mariage, anniversaire), indiquez-la dès votre premier message : je vous confirme aussitôt si elle peut être tenue.',
  },
  {
    q: 'Est-il possible d’être livré dans une commune proche de Vitré ?',
    r: 'Indiquez-moi votre commune : selon le cas, nous convenons d’un point de rendez-vous à Vitré ou je vous adresse la pièce par envoi suivi, sous emballage cadeau.',
  },
  {
    q: 'Puis-je voir le motif avant la réalisation ?',
    r: 'Oui, c’est systématique. Je vous soumets le motif (écriture, taille, emplacement, couleurs de fil) et la broderie n’est lancée qu’après votre validation.',
  },
];

---

<Base titre={titre} description={description} imageOg={ogPage.src} fil={fil} messageWa={messageWa}>
  <HautDePage
    titre="Brodeuse à Vitré"
    fil={fil}
    image={sacAdos}
    alt="Sac à dos d’enfant brodé au prénom Malo"
    faits={[ATELIER.delaiReponse, 'Remise en main propre sur rendez-vous', 'Envoi partout en France']}
  >
    <p>
      Je réalise à {SITE.ville} des broderies machine personnalisées&nbsp;: prénoms, motifs et
      dentelle libre, sur le linge, les vêtements et les cadeaux de naissance. Je couds aussi les
      sacs, les trousses et les tabliers que je brode. Pour un cadeau personnalisé à Vitré, la
      pièce vous est remise en main propre, sur rendez-vous, dans un lieu convenu par message.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={lienWhatsApp(messageWa)}>{LIBELLES.whatsapp}</a>
    <a slot="actions" class="btn btn--creux btn--grand" href="/contact/#devis">{LIBELLES.devis}</a>
  </HautDePage>

  <!-- ===================== RECEVOIR VOTRE PIÈCE ===================== -->
  <section class="bande vi-section" id="recevoir">
    <TeteSection titre="Recevoir votre pièce" />
    <div class="grille">
      <div class="vi-col">
        <h3>En main propre, à Vitré</h3>
        {/* ⚠️ À CONFIRMER : point de rendez-vous habituel à Vitré. */}
        <p class="mesure">
          Nous fixons ensemble le lieu et l’horaire par message. Vous découvrez la pièce avant de
          l’offrir, sans frais de port ni délai d’acheminement. Mon atelier se trouve à mon
          domicile&nbsp;: l’adresse précise n’est communiquée qu’après accord.
        </p>
      </div>
      <div class="vi-col">
        <h3>Par envoi suivi</h3>
        {/* ⚠️ À CONFIRMER : frais de port et transporteur. */}
        <p class="mesure">
          J’expédie la pièce en colis suivi, sous emballage cadeau, partout en France, y compris
          directement à la personne à qui vous l’offrez. Les frais d’envoi sont indiqués dans le
          devis.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== CE QUE JE RÉALISE ===================== -->
  <section class="bande vi-section" id="pieces">
    <TeteSection titre="Ce que je réalise" variante="duo">
      <p>
        Chaque pièce est brodée à l’unité, au prénom ou au motif de votre choix. Ces quatre
        familles donnent un aperçu&nbsp;; le reste se décide ensemble.
      </p>
    </TeteSection>
    <ListeLignes lignes={pieces} />
  </section>

  <!-- ===================== AUTOUR DE VITRÉ (le seul tapis de la page) ===================== -->
  <section class="bande tapis loin" id="environs">
    <div class="grille">
      <div class="vi-autour">
        <h2>Vitré et ses environs</h2>
        <p class="mesure mesure--clair">
          Je travaille pour les particuliers de {SITE.ville} et des communes voisines. Indiquez-moi
          d’où vous êtes&nbsp;: nous choisissons ensemble le point de rendez-vous le plus pratique,
          ou je vous adresse la pièce par envoi suivi. Je participe aussi à des marchés de
          créateurs du pays de Vitré, où l’on peut voir les pièces et commander de vive voix.
        </p>
        {/*
          ⚠️ À CONFIRMER : marchés habituels (lesquels, quand, à quelle fréquence).
          Les dates viendront des réglages de l'admin (CLAUDE.md § 5 « Prochains marchés »),
          sans rebuild Netlify.
        */}
      </div>
      {/* ⚠️ À CONFIRMER : périmètre réel de déplacement d'Emma (voir const communes). */}
      <div class="vi-communes">
        <h3>Communes desservies</h3>
        <LigneFaits faits={communes} clair label="Communes proches de Vitré" />
      </div>
    </div>
  </section>

  <FAQ questions={faq} />

  <AppelFinal messageWa={messageWa}>
    <p>
      Indiquez-moi le prénom, l’occasion et la date souhaitée. Je vous réponds avec un prix, un
      délai et une proposition de motif, sans engagement de votre part. Vous habitez à
      Rennes&nbsp;? Consultez la page <a href="/broderie-personnalisee-rennes/">broderie personnalisée à Rennes</a>.
    </p>
  </AppelFinal>
</Base>

<style>
  .vi-section { padding-block: var(--serre); }
  .tapis .grille, .vi-section .grille { row-gap: 2rem; }
  .vi-col, .vi-autour, .vi-communes { display: grid; gap: 1rem; align-content: start; }
  .vi-col {
    padding-block-start: 1.25rem;
    border-block-start: 1px solid color-mix(in oklab, currentColor 18%, transparent);
  }
  .vi-col .mesure { color: var(--encre-doux); }
  @media (min-width: 48rem) {
    .vi-col { grid-column: span 6; }
    .vi-autour { grid-column: 1 / span 6; }
    .vi-communes { grid-column: 8 / -1; }
  }
</style>
