---
/**
 * Page locale Rennes.
 *
 * ⚠️ RÈGLE ABSOLUE : Emma n'est PAS à Rennes. Aucune phrase ne doit laisser
 * croire à un atelier, une boutique ou une adresse rennaise. L'angle honnête
 * est la proximité : l'atelier est à Vitré, et tout se règle par message.
 *
 * Construite autrement que /brodeuse-vitre/ :
 *   Vitré  → la présence sur place, les communes autour, les marchés.
 *   Rennes → la distance (le mètre ruban), les façons de recevoir la pièce,
 *            la pièce à l'unité face aux ateliers de marquage, offrir à distance.
 *
 * Positionnement : particuliers uniquement (CLAUDE.md). Pas de clubs, pas
 * d'associations, pas de logos d'entreprise sur cette page.
 *
 * Cible : « broderie personnalisée Rennes », « cadeau personnalisé Rennes ».
 *
 * ⚠️ CONTENU D'EXEMPLE : délais, numéro WhatsApp, e-mail et téléphone sont
 * provisoires (src/config.ts). Vocabulaire : broderie MACHINE.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, CONTACT, ATELIER, lienWhatsApp } from '../config';

import machine from '../assets/creations/plein-ecran/machine-a-broder-en-cours-atelier-vitre.webp';
import cadre from '../assets/creations/detail/cadre-naissance-brode-prenom-chambre-bebe.webp';
import ogPage from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const titre = `Broderie personnalisée à Rennes · réalisée à Vitré | ${SITE.nom}`;
const description =
  'Broderie personnalisée pour Rennes : prénoms et motifs brodés à la machine, à l’unité, avec validation du motif. Atelier à Vitré (35), remise en main propre sur rendez-vous ou envoi suivi.';

const wa = lienWhatsApp(
  "Bonjour Emma, j'habite à Rennes et j'aimerais vous confier un projet de broderie.",
);

/*
  ⚠️ VALEURS À VÉRIFIER (ordres de grandeur, volontairement approximatifs) :
  distance routière Vitré → Rennes (~ 38 km), durée en TER (~ 25 à 35 min),
  durée en voiture par la N157 (~ 40 min).
  Ne jamais afficher de chiffre précis non vérifié.
*/
const mesures = [
  { valeur: '≈ 35 km', dire: 'entre Vitré et Rennes' },
  { valeur: '≈ 30 min', dire: 'en train, ligne directe' },
  { valeur: '≈ 40 min', dire: 'en voiture, par la N157' },
];

/*
  Les façons de recevoir la commande. Pas une séquence : pas de numéros.
  ⚠️ À CONFIRMER : remise en main propre à Rennes (fréquence, lieux possibles).
*/
const recevoir = [
  {
    nom: 'Par envoi suivi',
    dire: "La pièce part de Vitré en colis suivi, sous emballage cadeau. Elle peut être adressée chez vous ou directement à la personne à qui vous l'offrez.",
  },
  {
    nom: 'En main propre à Rennes',
    dire: "Lorsque j'ai un déplacement prévu à Rennes, nous convenons d'un lieu et d'un horaire. Indiquez-moi votre date limite dès le premier message.",
  },
  {
    nom: 'En main propre à Vitré',
    dire: "Si vous passez par Vitré, nous pouvons nous y retrouver sur rendez-vous. L'adresse précise vous est communiquée après accord.",
  },
];

/*
  FAQ Rennes. Questions différentes de celles de la page Vitré.
  Le JSON-LD est généré depuis ce tableau, il ne peut donc pas en diverger.
*/
const faq = [
  {
    q: 'Livrez-vous à Rennes ?',
    r: "Oui, par envoi suivi, sous emballage cadeau. Vous pouvez également faire adresser la pièce directement à la personne à qui vous l'offrez.",
  },
  {
    q: 'Une remise en main propre à Rennes est-elle possible ?',
    r: "Oui, lorsque j'ai un déplacement prévu à Rennes. Indiquez-moi votre date limite dès votre premier message : je vous dirai si une remise en main propre est envisageable, sinon la pièce vous est expédiée.",
  },
  {
    q: 'Quel délai prévoir entre ma demande et la réception ?',
    r: `Le délai de réalisation est actuellement de ${ATELIER.delaiActuel} à compter de la validation du motif, auquel s'ajoute le délai d'acheminement en cas d'envoi.`,
  },
  {
    q: 'Puis-je commander une seule pièce ?',
    r: "Oui. Je brode à l'unité : un doudou, une serviette, une trousse. Il n'y a aucune quantité minimum.",
  },
];

const jsonFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};

/* Le mètre ruban : un chiffre tous les 5 cm. Décoratif. */
const ruban = Array.from({ length: 8 }, (_, i) => i * 5);
---

<Base
  titre={titre}
  description={description}
  imageOg={ogPage.src}
  fil={[{ nom: 'Broderie personnalisée à Rennes', url: '/broderie-personnalisee-rennes/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonFaq)} is:inline />

  <!-- ===================== HAUT DE PAGE ===================== -->
  <section class="bande re-ouv">
    <nav class="ariane" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Broderie personnalisée à Rennes</span>
    </nav>

    <h1>Broderie personnalisée à Rennes</h1>

    <div class="re-ouv__bas">
      <p class="chapo">
        Mon atelier se trouve à {SITE.ville}, à proximité de Rennes. J'y réalise des broderies
        machine personnalisées pour les particuliers&nbsp;: prénoms et motifs sur le linge de bain,
        les vêtements, les cadeaux de naissance, ainsi que des sacs et trousses cousus main. Tout
        se règle par message, et vous choisissez la façon de recevoir votre pièce.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--creux btn--grand" href="/contact/#devis">Demander un devis</a>
      </p>
    </div>
  </section>

  <!-- ===================== LE MÈTRE RUBAN ===================== -->
  <div class="bande re-ruban-zone">
    <div class="re-ruban plein" aria-hidden="true">
      <div class="re-ruban__bande">
        <span class="re-ruban__bout re-ruban__bout--d">{SITE.ville}</span>
        <span class="re-ruban__chiffres">
          {ruban.map((n) => <span>{n}</span>)}
        </span>
        <span class="re-ruban__bout re-ruban__bout--f">Rennes</span>
      </div>
    </div>

    {/* ⚠️ Valeurs à vérifier : voir const mesures. */}
    <ul class="re-mesures">
      {
        mesures.map((m) => (
          <li>
            <b>{m.valeur}</b>
            <span>{m.dire}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- ===================== BANDEAU MACHINE ===================== -->
  <div class="bandeau re-bandeau">
    <Image
      src={machine}
      alt="Broderie en cours sous la tête de la machine : cerisiers en fleurs et colibri en fil de couleur"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="bandeau__mot" aria-hidden="true">Brodé à Vitré</p>
  </div>

  <!-- ===================== RECEVOIR ===================== -->
  <section class="bande re-recevoir">
    <div class="re-recevoir__tete">
      <h2 class="titre-xl">Recevoir votre commande</h2>
      <p class="mesure">
        Vous choisissez au moment du devis. Les frais d'envoi éventuels y sont indiqués, avant
        toute validation.
        {/* ⚠️ À CONFIRMER : frais de port et transporteur. */}
      </p>
    </div>

    <ul class="re-voies">
      {
        recevoir.map((r) => (
          <li class="re-voie">
            <h3>{r.nom}</h3>
            <p>{r.dire}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== L'UNITÉ ET LA VALIDATION ===================== -->
  <section class="bande re-unite loin">
    <figure class="re-unite__fig">
      <Image
        src={cadre}
        alt="Cadre de naissance brodé au prénom, accroché au mur d’une chambre de bébé"
        widths={[420, 700, 1000]}
        sizes="(max-width: 64rem) 92vw, 40vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="re-unite__dire">
      <h2 class="titre-xl">Une pièce à l'unité, un motif validé avant la réalisation</h2>
      <p class="mesure">
        À Rennes, la broderie est surtout proposée par des ateliers de marquage, qui travaillent
        sur des vêtements professionnels, par lots et avec un minimum de commande.
        {/* ⚠️ Constat issu de la recherche concurrentielle de CLAUDE.md. À faire relire par
             Emma : on décrit un marché, on ne dénigre personne. */}
      </p>
      <p class="mesure">
        Je travaille différemment&nbsp;: je brode une seule pièce, pour une personne. Avant de
        lancer la machine, je vous soumets le motif (écriture du prénom, taille, emplacement,
        couleurs de fil). Tant que la broderie n'est pas lancée, tout peut encore être ajusté.
      </p>
      <p class="actions">
        <a class="lien-fleche" href="/sur-mesure/">Le déroulement d'une commande</a>
        <a class="lien-fleche" href="/l-atelier/">L'atelier</a>
      </p>
    </div>
  </section>

  <!-- ===================== OFFRIR À DISTANCE (tapis) ===================== -->
  <section class="bande tapis re-offrir loin">
    <div class="re-offrir__dire">
      <h2 class="titre-xl">Offrir sans se déplacer</h2>
      <p class="chapo">
        Lorsque la personne à qui vous offrez n'habite pas à Rennes, la pièce peut lui être
        adressée directement, sous emballage cadeau, sans passer par chez vous.
      </p>
      <p class="mesure mesure--clair">
        Vous validez le motif par message, vous m'indiquez l'adresse de livraison, et je me charge
        du reste.
        {/* ⚠️ À CONFIRMER avec Emma : envoi direct au destinataire, mot d'accompagnement. */}
      </p>
    </div>

    <div class="re-paquet" aria-hidden="true">
      <span class="re-paquet__ficelle"></span>
      <span class="re-paquet__etiquette">
        <span>à offrir</span>
        <span>{SITE.ville} → partout en France</span>
      </span>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="bande re-faq loin" id="questions">
    <h2 class="titre-xl">Questions fréquentes depuis Rennes</h2>
    <div class="re-faq__liste">
      {
        faq.map((f) => (
          <details class="re-faq__item">
            <summary>
              <span>{f.q}</span>
              <span class="re-faq__plus" aria-hidden="true" />
            </summary>
            <p>{f.r}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ===================== APPEL FINAL ===================== -->
  <section class="final bande re-final" id="devis">
    <div class="final__in">
      <h2 class="titre-xl">Votre projet de broderie</h2>
      <p class="chapo">
        Indiquez-moi le prénom, l'occasion et la date souhaitée. Je vous réponds avec un prix, un
        délai et une proposition de motif, sans engagement. {ATELIER.delaiReponse}.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--or btn--grand" href="/contact/#devis">Remplir le formulaire</a>
      </p>
      <p class="final__note">
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> ·
        <a href={`tel:${CONTACT.telephone}`}>{CONTACT.telephone}</a> · Vous habitez près de
        {' '}{SITE.ville}&nbsp;? <a href="/brodeuse-vitre/">Brodeuse à Vitré</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ============================ HAUT DE PAGE ============================ */
  .re-ouv {
    padding-block: 0.5rem clamp(2rem, 4vw, 3rem);
    row-gap: clamp(1.2rem, 3vw, 2.2rem);
  }
  /* Le titre occupe toute la largeur : une seule ligne sur grand écran */
  .re-ouv h1 {
    font-size: clamp(3rem, 0.6rem + 8.4vw, 9.6rem);
    line-height: 0.88;
    max-width: 14ch;
  }
  .re-ouv__bas { display: grid; gap: 1.5rem; justify-items: start; }
  @media (min-width: 64rem) {
    .re-ouv { min-height: calc(62svh - 4.5rem); align-content: end; }
    .re-ouv h1 { max-width: none; }
    .re-ouv__bas { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; column-gap: 4rem; justify-items: stretch; }
    .re-ouv__bas .actions { justify-content: flex-end; }
  }

  /* ============================ MÈTRE RUBAN ============================ */
  .re-ruban-zone { padding-block: 1rem clamp(3rem, 7vw, 5rem); row-gap: 2rem; }
  .re-ruban { overflow: hidden; padding-block: 1.2rem; }
  .re-ruban__bande {
    position: relative;
    display: flex; align-items: stretch;
    block-size: 3.6rem;
    background-color: var(--dore);
    background-image:
      linear-gradient(90deg, var(--encre) 1.5px, transparent 1.5px),
      linear-gradient(90deg, color-mix(in oklab, var(--encre) 70%, transparent) 1px, transparent 1px);
    background-size: calc(var(--cm) * 5) 1.3rem, var(--cm) 0.7rem;
    background-repeat: repeat-x;
    background-position: 0 0, 0 0;
    box-shadow: 0 14px 26px -16px color-mix(in oklab, var(--encre) 60%, transparent);
    transform: rotate(-0.6deg);
    transform-origin: 0 50%;
  }
  .re-ruban__chiffres { flex: 1 1 auto; display: flex; overflow: hidden; padding-inline-start: 0; }
  .re-ruban__chiffres span {
    flex: none;
    inline-size: calc(var(--cm) * 5);
    padding: 1.35rem 0 0 0.25rem;
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--encre);
  }
  .re-ruban__bout {
    flex: none;
    display: grid; place-items: center;
    padding-inline: 1rem;
    font-family: var(--f-titre);
    font-size: clamp(1.2rem, 1rem + 1vw, 1.7rem);
    background: var(--encre); color: var(--lin-haut);
  }
  .re-ruban__bout--f { background: var(--coquelicot); color: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .re-ruban__bande { animation: deroule 1600ms var(--sortie) 200ms both; }
  }
  @keyframes deroule { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  .re-mesures { display: grid; gap: 1.2rem; }
  .re-mesures li { display: grid; gap: 0.15rem; padding-block-start: 0.9rem; border-block-start: 1px dashed color-mix(in oklab, var(--encre) 30%, transparent); }
  .re-mesures b { font-family: var(--f-titre); font-weight: 400; font-size: clamp(2.2rem, 1.6rem + 2vw, 3.4rem); line-height: 1; }
  .re-mesures span { font-size: var(--t-petit); color: var(--encre-doux); }
  @media (min-width: 48rem) { .re-mesures { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }

  /* ============================ BANDEAU ============================ */
  .re-bandeau { block-size: clamp(13rem, 36vw, 30rem); }

  /* ============================ RECEVOIR ============================ */
  .re-recevoir { padding-block: var(--respire) var(--serre); row-gap: clamp(2rem, 4vw, 3rem); }
  .re-recevoir__tete { display: grid; gap: 1rem; justify-items: end; text-align: end; }
  .re-recevoir__tete .mesure { max-width: 28rem; }
  .re-voies { display: grid; gap: 1rem; }
  .re-voie {
    display: grid; gap: 0.8rem; align-content: start;
    padding: clamp(1.5rem, 3.5vw, 2.6rem);
    border-radius: var(--r-l);
    background: var(--papier);
    border: 1px solid color-mix(in oklab, var(--encre) 10%, transparent);
  }
  .re-voie h3 { font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem); line-height: 1; }
  .re-voie p { color: var(--encre-doux); max-width: 32rem; }
  .re-voie:first-child { background: var(--encre); color: var(--lin-haut); border-color: transparent; }
  .re-voie:first-child h3 { color: var(--lin-haut); }
  .re-voie:first-child p { color: color-mix(in oklab, var(--lin-haut) 84%, transparent); font-size: var(--t-chapo); line-height: 1.45; }
  @media (min-width: 56rem) {
    .re-voies { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); grid-template-rows: auto auto; }
    .re-voie:first-child { grid-row: 1 / span 2; align-content: end; min-height: 26rem; }
  }

  /* ============================ UNITÉ ============================ */
  .re-unite { padding-block: var(--serre) var(--respire); row-gap: 2.5rem; align-items: center; }
  .re-unite__fig :global(img) { inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; }
  .re-unite__fig { inline-size: min(100%, 32rem); justify-self: center; }
  .re-unite__dire { display: grid; gap: 1.1rem; justify-items: start; }
  .re-unite__dire .titre-xl { font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4.6rem); max-width: 16ch; }
  @media (min-width: 64rem) {
    .re-unite { grid-template-columns: [bord-d] minmax(var(--marge), 1fr) [large-d] minmax(0, calc(var(--large) * 0.45)) [mi] minmax(0, calc(var(--large) * 0.55)) [large-f] minmax(var(--marge), 1fr) [bord-f]; }
    .re-unite__fig { grid-column: large-d / mi; grid-row: 1; margin-inline-end: 3rem; }
    .re-unite__dire { grid-column: mi / large-f; grid-row: 1; }
  }

  /* ============================ OFFRIR (tapis) ============================ */
  .re-offrir { padding-block: var(--serre); row-gap: 3rem; align-items: center; overflow-x: clip; }
  .re-offrir__dire { display: grid; gap: 1.2rem; }
  .re-paquet {
    position: relative;
    inline-size: min(70vw, 20rem);
    aspect-ratio: 5 / 4;
    justify-self: center;
    border-radius: var(--r-s);
    background:
      repeating-linear-gradient(45deg, color-mix(in oklab, var(--encre) 6%, transparent) 0 2px, transparent 2px 9px),
      var(--lin-bas);
    box-shadow: 0 30px 50px -24px rgb(0 0 0 / 0.7);
    transform: rotate(-4deg);
  }
  .re-paquet__ficelle::before, .re-paquet__ficelle::after {
    content: ''; position: absolute; background: var(--coquelicot);
  }
  .re-paquet__ficelle::before { inset-block: 0; inset-inline-start: 58%; inline-size: 5px; }
  .re-paquet__ficelle::after { inset-inline: 0; inset-block-start: 40%; block-size: 5px; }
  .re-paquet__etiquette {
    position: absolute; inset-block-start: 52%; inset-inline-start: 8%;
    display: grid; gap: 0.1rem;
    padding: 0.6rem 0.9rem;
    background: var(--papier); color: var(--encre);
    border-radius: var(--r-s);
    font-family: var(--f-mono); font-size: var(--t-micro);
    transform: rotate(6deg);
    box-shadow: 0 8px 16px -10px rgb(0 0 0 / 0.5);
  }
  .re-paquet__etiquette span:first-child { color: var(--coquelicot-fonce); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .re-paquet { animation: glisse linear both; animation-timeline: view(); animation-range: entry 0% cover 50%; }
    }
  }
  @keyframes glisse { from { transform: translateX(30%) rotate(8deg); } to { transform: rotate(-4deg); } }
  @media (min-width: 64rem) {
    .re-offrir { grid-template-columns: [bord-d] minmax(var(--marge), 1fr) [large-d] minmax(0, calc(var(--large) * 0.6)) [mi] minmax(0, calc(var(--large) * 0.4)) [large-f] minmax(var(--marge), 1fr) [bord-f]; }
    .re-offrir__dire { grid-column: large-d / mi; padding-inline-end: 3rem; }
    .re-paquet { grid-column: mi / large-f; inline-size: 100%; max-inline-size: 22rem; }
  }

  /* ============================ FAQ ============================ */
  .re-faq { padding-block: var(--respire) var(--serre); row-gap: 2rem; }
  .re-faq .titre-xl { max-width: 16ch; }
  .re-faq__liste { max-width: 56rem; border-block-start: 1px solid color-mix(in oklab, var(--encre) 18%, transparent); }
  .re-faq__item { border-block-end: 1px solid color-mix(in oklab, var(--encre) 18%, transparent); }
  .re-faq__item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 3.5rem; padding-block: 1.1rem;
    cursor: pointer; list-style: none;
    font-family: var(--f-titre);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.15;
  }
  .re-faq__item summary::-webkit-details-marker { display: none; }
  .re-faq__plus { position: relative; flex: none; inline-size: 1.1rem; block-size: 1.1rem; }
  .re-faq__plus::before, .re-faq__plus::after {
    content: ''; position: absolute; inset: 50% 0 auto; block-size: 1.5px; background: currentColor;
    transition: transform 300ms var(--sortie);
  }
  .re-faq__plus::after { transform: rotate(90deg); }
  .re-faq__item[open] .re-faq__plus::after { transform: rotate(0deg); }
  .re-faq__item p { padding-block-end: 1.3rem; max-width: 42rem; color: var(--encre-doux); }
  @media (min-width: 64rem) { .re-faq__liste { margin-inline-start: auto; inline-size: 62%; } }

  /* ============================ FINAL ============================ */
  .re-final .titre-xl { max-width: 12ch; }
  .re-final .chapo { max-width: 36rem; }
</style>
