---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteCreation from '../components/CarteCreation.astro';
import { SITE, CONTACT, ATELIER, OCCASIONS, lienWhatsApp } from '../config';

import portrait from '../assets/creations/galerie/emma-brodeuse-vitre-portrait.webp';
import bobines from '../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import machine from '../assets/creations/plein-ecran/machine-a-broder-en-cours-atelier-vitre.webp';
import papillon from '../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';
import arbre from '../assets/creations/galerie/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';

/* Photos des quatre occasions, dans l'ordre de config.OCCASIONS. */
import occNaissance from '../assets/creations/galerie/doudou-plat-brode-prenom-keanu-naissance.webp';
import occMariage from '../assets/creations/galerie/papillon-brode-dentelle-ajouree-coquelicots.webp';
import occMeres from '../assets/creations/galerie/tambour-decoratif-brode-fee-rouge.webp';
import occNoel from '../assets/creations/galerie/chaussette-de-noel-brodee-prenom.webp';

const photosOccasions = [occNaissance, occMariage, occMeres, occNoel];
const altOccasions = [
  'Doudou plat en tissu, prénom brodé au centre, cadeau de naissance',
  'Papillon en dentelle libre, entièrement brodé de fil, à coudre sur une robe',
  'Tambour à broder décoratif, brodé et prêt à accrocher au mur',
  'Chaussette de Noël rouge, prénom brodé sur le revers',
];

/* Les créations mises en avant. L'ordre viendra de l'admin ; ici, du build. */
const creations = (await getCollection('creations', ({ data }) => !data.masquee))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 6);

/*
  Le carrousel du haut de page : des prénoms de CLIENTES, avec une légende
  qui les ancre dans une vraie commande. Ce sont les prénoms lisibles sur
  les photos d'Emma.
  ⚠️ EXEMPLES : légendes et poids à faire valider par Emma, et accord des
  clientes à confirmer avant mise en ligne.
*/
const prenoms = [
  { prenom: 'Ambre', legende: 'cadre de naissance · prénom, date, 3,85 kg' },
  { prenom: 'Malo', legende: "sac à dos d'école · brodé au prénom" },
  { prenom: 'Lisa', legende: 'trousse cousue main · brodée au prénom' },
  { prenom: 'Alicia', legende: 'drap de bain rose · fil mauve', fil: '#6B5560' },
];

const metiers = [
  'Prénoms',
  'Dentelle libre',
  'Doudous',
  'Linge de bain',
  'Trousses cousues',
  'Tabliers',
  'Logos de club',
  'Chaussettes de Noël',
  'Sacs',
];

const titre = `${SITE.nom} · broderie personnalisée & couture sur mesure à ${SITE.ville} (35)`;
const description =
  'Broderie personnalisée au prénom et couture sur mesure à Vitré (35) : cadeaux de naissance, linge de bain, dentelle libre, sacs et trousses. Remise en main propre à Vitré et Rennes, envoi partout en France.';
---

<Base titre={titre} description={description}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix, délais, légendes, numéro WhatsApp, téléphone et e-mail sont
    provisoires (voir src/config.ts). À remplacer par les vraies valeurs
    d'Emma avant toute mise en production.
    Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
  */}

  <!-- ===================== HAUT DE PAGE ===================== -->
  <section class="ouv bande">
    <div class="ouv__texte">
      <p class="sourcil">Brodeuse et couturière à {SITE.ville}, Ille-et-Vilaine</p>

      <h1>Broderie personnalisée et couture sur mesure</h1>

      <p class="chapo">
        Je réalise dans mon atelier de {SITE.ville} des pièces brodées au prénom ou au motif de
        votre choix&nbsp;: linge de bain, cadeaux de naissance, décoration en dentelle libre. Je
        confectionne également sacs, trousses et tabliers. Chaque motif vous est soumis avant
        réalisation.
      </p>

      <p class="actions">
        <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-1.5 0-3.9-1.2-5.6-3S7 10.4 7 9.3c0-.8.5-1.6 1-1.9.3-.2.9-.2 1.1.1l.9 1.5c.1.3.1.5-.1.8l-.4.5c-.2.2-.2.4 0 .7.4.7 1.7 2 2.5 2.3.3.1.5.1.7-.1l.6-.6c.2-.2.5-.3.7-.2l1.6.8c.4.2.5.6.4.9Z"
            /></svg
          >
          Me contacter sur WhatsApp
        </a>
        <a class="btn btn--creux btn--grand" href="/contact/#devis">Demander un devis</a>
      </p>

      <ul class="rassure">
        <li><b>{ATELIER.delaiReponse}</b></li>
        <li>Délai actuel&nbsp;: <b>{ATELIER.delaiActuel}</b></li>
        <li>Vitré · Rennes · envoi en France</li>
      </ul>
    </div>

    <div class="ouv__metier">
      <!-- Le grand tambour : le produit lui-même, en train de se faire. -->
      <div
        class="tambour tambour--grand"
        data-broderie="carrousel"
        data-prenoms={JSON.stringify(prenoms)}
        data-fil="#D93D28"
        data-duree="2600"
        data-legende="legende-prenom"
      >
        <span class="tambour__vis" aria-hidden="true"></span>
        <p class="tambour__scene" data-scene aria-hidden="true">{prenoms[0].prenom}</p>
        <p class="lu-seulement">Exemples de prénoms brodés pour des clientes.</p>
      </div>
      <p class="ouv__legende mono" aria-hidden="true">
        <span>sur le métier&nbsp;:</span>
        <span id="legende-prenom">{prenoms[0].legende}</span>
      </p>

      <figure class="tambour tambour--emma">
        <span class="tambour__vis" aria-hidden="true"></span>
        <Image
          src={portrait}
          alt="Emma, brodeuse et couturière à Vitré, souriante"
          widths={[240, 360, 480]}
          sizes="(max-width: 64rem) 40vw, 15rem"
          loading="eager"
          decoding="async"
        />
      </figure>
      <p class="ouv__moi">
        <strong>Emma</strong>
        <span>Votre seule interlocutrice, de la demande à l'envoi.</span>
      </p>
    </div>
  </section>

  <!-- ===================== CE QUE JE FAIS : frise ===================== -->
  <div class="frise plein" aria-label="Ce que je brode et ce que je couds">
    <ul class="frise__piste">
      {metiers.map((m) => <li>{m}</li>)}
    </ul>
    <ul class="frise__piste" aria-hidden="true">
      {metiers.map((m) => <li>{m}</li>)}
    </ul>
  </div>

  <!-- ===================== CRÉATIONS ===================== -->
  <section class="bande creations" id="creations">
    <div class="tete tete--duo">
      <h2 class="titre-xl">Créations récentes</h2>
      <div class="creations__dire">
        <p class="mesure">
          Chaque pièce est personnalisée&nbsp;: le tissu, l'écriture et la couleur du fil sont
          choisis avec vous. Toutes les créations présentées peuvent être réalisées à votre nom.
        </p>
        <a class="lien-fleche" href="/creations/">Voir toutes les créations</a>
      </div>
    </div>

    <div class="rangee" tabindex="0" role="region" aria-label="Créations récentes, rangée défilante">
      {creations.map((c, i) => <CarteCreation creation={c} prioritaire={i === 0} />)}
    </div>
    <div class="creations__barre" aria-hidden="true"><span></span></div>
  </section>

  <!-- ===================== BANDEAU BOBINES ===================== -->
  <div class="bandeau">
    <Image
      src={bobines}
      alt="Mur de l'atelier couvert de bobines de fil à broder de toutes les couleurs"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- ===================== DENTELLE LIBRE ===================== -->
  <section class="bande tapis dentelle" id="dentelle">
    <div class="dentelle__dire">
      <p class="sourcil">Ma spécialité</p>
      <h2 class="titre-geant">La dentelle libre</h2>
      <p class="chapo">
        Une broderie machine réalisée sans tissu&nbsp;: le motif est brodé sur un support soluble,
        qui disparaît au rinçage. Il ne reste que le fil, ajouré et autoportant.
      </p>
      <p class="mesure mesure--clair">
        Arbre de vie, papillon, initiale, napperon&nbsp;: ces pièces se présentent sous cadre, se
        suspendent à une fenêtre ou se cousent sur une robe de mariée. C'est une technique encore
        rare en Ille-et-Vilaine, et celle que je pratique avec le plus de plaisir.
      </p>
      <p class="actions">
        <a class="btn btn--or" href="/creations/decoration-ajouree/">Découvrir la dentelle libre</a>
      </p>
    </div>

    <div class="dentelle__photos">
      <figure class="dentelle__fig devoile">
        <Image
          src={papillon}
          alt="Papillon brodé en relief aux ailes rouges et noires, surmonté de coquelicots brodés"
          widths={[480, 800, 1200]}
          sizes="(max-width: 64rem) 92vw, 46vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mono">papillon &amp; coquelicots · sans tissu</figcaption>
      </figure>
      <figure class="dentelle__fig dentelle__fig--b devoile">
        <Image
          src={arbre}
          alt="Arbre de vie brodé en dentelle ajourée fil doré, pièce autoportante sans support tissu"
          widths={[400, 640, 900]}
          sizes="(max-width: 64rem) 70vw, 30vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mono">arbre de vie · fil doré</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== OCCASIONS ===================== -->
  <section class="bande occasions loin" id="occasions">
    <div class="occasions__tete">
      <h2 class="titre-xl">Pour chaque occasion</h2>
      <p class="mesure">
        Indiquez-moi la date de votre événement&nbsp;: je vous confirme aussitôt si le délai de
        réalisation le permet. Baptêmes, anniversaires et départs en retraite sont également les
        bienvenus.
      </p>
    </div>

    <ul class="occ">
      {
        OCCASIONS.map((o, i) => (
          <li style={`--f:${o.fil}`}>
            <a class="occ__lien" href={`/cadeaux/${o.slug}/`}>
              <span class="occ__nom">{o.nom}</span>
              <span class="occ__liste">{o.liste}</span>
              <span class="occ__img">
                <Image
                  src={photosOccasions[i]}
                  alt={altOccasions[i]}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 40rem) 88vw, (max-width: 64rem) 44vw, 20rem"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="occ__fleche" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== MÉTHODE : la seule vraie séquence ===================== -->
  <section class="bande methode loin" id="methode">
    <div class="methode__tete">
      <h2 class="titre-xl">Le déroulement d'une commande</h2>
      <p class="mesure">Aucune réalisation n'est lancée sans votre accord sur le motif.</p>
    </div>

    <ol class="pile">
      <li>
        <p class="pile__n mono">Étape 1</p>
        <h3>Votre demande</h3>
        <p>
          Précisez-moi le prénom, l'occasion et la date souhaitée, avec une photo d'inspiration si
          vous en avez une. Je reviens vers vous avec une proposition, un prix et un délai.
        </p>
      </li>
      <li>
        <p class="pile__n mono">Étape 2</p>
        <h3>La validation du motif</h3>
        <p>
          Avant toute réalisation, je vous adresse le motif. Il peut être ajusté autant que
          nécessaire&nbsp;: tant qu'il n'est pas brodé, tout reste modifiable.
        </p>
      </li>
      <li>
        <p class="pile__n mono">Étape 3</p>
        <h3>La remise</h3>
        <p>
          Votre pièce est emballée, prête à offrir. Remise en main propre à {SITE.ville} ou à
          Rennes, ou envoi soigné partout en France.
        </p>
      </li>
    </ol>
  </section>

  <!-- ===================== ATELIER ===================== -->
  <section class="bande atelier loin" id="atelier">
    <figure class="atelier__fig" data-broderie="tambour">
      <Image
        src={machine}
        alt="Broderie en cours sous la tête de la machine : cerisiers en fleurs et colibri en fil de couleur"
        widths={[480, 800, 1200]}
        sizes="(max-width: 64rem) 92vw, 44vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="atelier__dire">
      <h2 class="titre-xl">Un atelier, une seule interlocutrice</h2>
      <p class="mesure">
        Je lis personnellement chacun de vos messages, je choisis les fils parmi mon mur de
        bobines, je réalise la broderie et je prépare l'envoi. Du premier échange à la remise,
        vous traitez avec la personne qui réalise votre pièce.
      </p>
      <p class="actions">
        <a class="lien-fleche" href="/l-atelier/">Découvrir l'atelier</a>
        <a class="lien-fleche" href="/sur-mesure/">Tarifs et délais</a>
      </p>
    </div>
  </section>

  <!-- ===================== APPEL FINAL ===================== -->
  <section class="final bande" id="devis">
    <div class="final__in">
      <h2 class="titre-geant">Parlons de votre projet</h2>
      <p class="chapo">
        Un prénom, une date et une première idée suffisent pour commencer. Je vous réponds avec
        une proposition, un prix et un délai, sans engagement de votre part.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>Me contacter sur WhatsApp</a>
        <a class="btn btn--or btn--grand" href="/contact/#devis">Remplir le formulaire</a>
      </p>
      <p class="final__note">
        Également par téléphone&nbsp;: <a href={`tel:${CONTACT.telephone}`}>{CONTACT.telephone}</a>
      </p>
    </div>
  </section>
</Base>


<style>
  /* ============================ HAUT DE PAGE ============================ */
  .ouv {
    padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    row-gap: clamp(2.5rem, 6vw, 4rem);
  }
  .ouv__texte { display: grid; gap: clamp(1.1rem, 2.2vw, 1.8rem); align-content: center; }
  .ouv h1 { max-width: 13ch; font-size: clamp(2.6rem, 1.2rem + 6vw, 4.4rem); }

  .ouv__metier {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 34rem;
    width: 100%;
    justify-self: center;
    align-self: center;
    align-content: start;
  }

  /* --- Le tambour : un cercle de toile tendue dans un anneau de bois --- */
  .tambour {
    --bois: #C9A97E;
    --bois-fonce: #8A6A46;
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    container-type: inline-size;
    box-shadow:
      0 0 0 clamp(7px, 1.4cqi, 12px) var(--bois),
      0 0 0 calc(clamp(7px, 1.4cqi, 12px) + 2px) var(--bois-fonce),
      0 0 0 calc(clamp(7px, 1.4cqi, 12px) + 7px) var(--bois),
      0 30px 60px -25px color-mix(in oklab, var(--encre) 55%, transparent);
  }
  /* La vis de serrage, en haut : le détail qui dit « tambour à broder » */
  .tambour__vis {
    position: absolute; z-index: 2;
    inset-block-start: -1.6rem; inset-inline-start: 50%;
    width: 1.1rem; height: 1.6rem;
    transform: translateX(-50%);
    border-radius: 3px;
    background: linear-gradient(90deg, var(--bois-fonce), var(--bois) 45%, var(--bois-fonce));
  }
  .tambour__vis::after {
    content: ''; position: absolute; inset: -0.55rem -0.35rem auto;
    height: 0.55rem; border-radius: 3px 3px 1px 1px;
    background: #B6AEA8;
  }

  .tambour--grand {
    grid-column: 1 / -1; grid-row: 1;
    width: min(100%, 34rem);
    justify-self: center;
    display: grid; place-items: center;
    /* La toile : un tissage serré, rose poudré, éclairé de biais */
    background:
      radial-gradient(70% 60% at 35% 30%, color-mix(in oklab, #fff 55%, transparent), transparent 70%),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--encre) 4%, transparent) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--encre) 4%, transparent) 0 1px, transparent 1px 3px),
      var(--rose);
  }
  /* La scène a une taille fixe : les prénoms n'ont pas la même longueur,
     la page ne doit pas sauter à chaque tour. */
  .tambour__scene {
    width: 82%;
    height: 34cqi;
    display: grid; place-items: center;
    font-family: var(--f-titre);
    font-size: 26cqi;
    line-height: 1;
    color: var(--coquelicot);
    overflow: visible;
  }
  .tambour__scene :global(.broderie-prenom-pret) { line-height: 0; }
  .tambour__scene :global(.broderie-prenom) { height: 34cqi; max-width: 100%; vertical-align: middle; }
  .tambour__scene :global(.broderie-trace path) { stroke: var(--coquelicot); }

  .ouv__legende {
    grid-column: 1 / -1; grid-row: 2;
    justify-self: center;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.15rem 0.5rem;
    margin-block-start: 1.6rem;
    font-size: var(--t-micro);
    color: var(--encre-doux);
    text-align: center;
    min-height: 2.8em;  /* deux lignes réservées : aucun saut */
  }
  .ouv__legende span:first-child { color: var(--coquelicot-fonce); }

  /* Le petit tambour d'Emma, accroché en haut à gauche du grand */
  .tambour--emma {
    position: absolute; z-index: 3;
    inset-block-start: -2%; inset-inline-start: 0;
    width: 31%;
    background: var(--tapis);
  }
  .tambour--emma :global(img) {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .tambour--emma .tambour__vis { display: none; }

  .ouv__moi {
    grid-column: 1 / -1; grid-row: 3;
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.2rem 0.6rem;
    text-align: center;
    margin-block-start: 0.4rem;
  }
  .ouv__moi strong { font-family: var(--f-titre); font-weight: 400; font-size: 1.6rem; line-height: 1; }
  .ouv__moi span { font-size: var(--t-petit); color: var(--encre-doux); line-height: 1.4; }

  @media (min-width: 64rem) {
    .tambour--emma { inset-inline-start: -4%; }
    .ouv {
      min-height: calc(100svh - 4.5rem);
      align-content: center;
      grid-template-rows: auto;
    }
    .ouv__texte { grid-column: large-d / span 1; grid-row: 1; max-width: 46rem; }
    .ouv__metier { grid-column: large-d / large-f; grid-row: 1; justify-self: end; width: 38%; max-width: 32rem; }
    .ouv h1 { max-width: 15ch; font-size: clamp(3.6rem, 0.8rem + 4.4vw, 6rem); }
  }
  @media (min-width: 64rem) and (max-width: 80rem) {
    .ouv__texte { max-width: 58%; }
  }

  /* Arrivée : courte, CSS seule, jamais d'attente de script.
     Le H1 n'est jamais masqué : il glisse simplement en place. */
  @media (prefers-reduced-motion: no-preference) {
    .ouv__texte > * { animation: arrive 800ms var(--sortie) both; }
    .ouv__texte > :nth-child(2) { animation-delay: 60ms; }
    .ouv__texte > :nth-child(3) { animation-delay: 160ms; }
    .ouv__texte > :nth-child(4) { animation-delay: 240ms; }
    .ouv__texte > :nth-child(5) { animation-delay: 320ms; }
    .tambour--grand { animation: tend 1100ms var(--sortie) 120ms both; }
    .tambour--emma { animation: tend 1000ms var(--sortie) 450ms both; }
  }
  @keyframes arrive { from { transform: translateY(24px); opacity: 0.001; } to { transform: none; opacity: 1; } }
  @keyframes tend { from { transform: scale(0.86) rotate(-8deg); opacity: 0.001; } to { transform: none; opacity: 1; } }

  /* ============================ FRISE ============================ */
  .frise {
    display: flex;
    overflow: hidden;
    background: var(--encre);
    color: var(--lin-haut);
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .frise__piste {
    display: flex; flex: none; gap: 0; align-items: center;
    font-family: var(--f-titre);
    font-size: clamp(1.7rem, 1.1rem + 2.4vw, 3.4rem);
    line-height: 1.1;
    white-space: nowrap;
  }
  .frise__piste li { display: inline-flex; align-items: center; }
  /* Entre deux mots, un point de croix rouge */
  .frise__piste li::after {
    content: '';
    width: 0.42em; height: 0.42em;
    margin-inline: 0.55em;
    background:
      linear-gradient(45deg, transparent 42%, var(--coquelicot) 42% 58%, transparent 58%),
      linear-gradient(-45deg, transparent 42%, var(--coquelicot) 42% 58%, transparent 58%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .frise__piste { animation: defile 38s linear infinite; }
    .frise:hover .frise__piste { animation-play-state: paused; }
  }
  @keyframes defile { to { transform: translateX(-100%); } }

  /* ============================ CRÉATIONS ============================ */
  .creations {
    padding-block: var(--respire) var(--serre);
    row-gap: clamp(2rem, 4vw, 3.5rem);
    timeline-scope: --rangee;
  }
  .creations__dire { display: grid; gap: 1rem; justify-items: start; }
  .creations__barre {
    height: 2px;
