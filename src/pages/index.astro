---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteCreation from '../components/CarteCreation.astro';
import TeteSection from '../components/TeteSection.astro';
import Etapes from '../components/Etapes.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { SITE, ATELIER, OCCASIONS, LIBELLES, ETAPES_COMMANDE, lienWhatsApp } from '../config';

import portrait from '../assets/creations/hero-mobile/emma-brodeuse-vitre-portrait.webp';
import bobines from '../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import machine from '../assets/creations/galerie/machine-a-broder-en-cours-atelier-vitre.webp';
import arbre from '../assets/creations/galerie/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';
import papillon from '../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';

/* Photos des quatre occasions, dans l'ordre de config.OCCASIONS. */
import occNaissance from '../assets/creations/galerie/doudou-plat-brode-prenom-keanu-naissance.webp';
import occMariage from '../assets/creations/galerie/papillon-brode-dentelle-ajouree-coquelicots.webp';
import occMeres from '../assets/creations/galerie/tambour-decoratif-brode-fee-rouge.webp';
import occNoel from '../assets/creations/galerie/chaussette-de-noel-brodee-prenom.webp';

const photosOccasions = [occNaissance, occMariage, occMeres, occNoel];
const altOccasions = [
  'Doudou plat en tissu, prénom brodé au centre, cadeau de naissance',
  'Papillon en dentelle libre, entièrement brodé de fil, à coudre sur une robe',
  'Tambour à broder décoratif, brodé et prêt à accrocher au mur',
  'Chaussette de Noël rouge, prénom brodé sur le revers',
];

/* Les créations mises en avant. L'ordre viendra de l'admin ; ici, du build. */
const creations = (await getCollection('creations', ({ data }) => !data.masquee))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 6);



const titre = `Brodeuse et couturière à ${SITE.ville} (35) · broderie personnalisée | ${SITE.nom}`;
const description =
  'Broderie personnalisée au prénom et couture sur mesure à Vitré (35) : cadeaux de naissance, linge de bain, dentelle libre, sacs et trousses. Vitré, Rennes, Châteaubourg et alentours, envoi en France.';

const prixMin = Math.min(...creations.map((c) => c.data.prixDepart ?? Infinity));
---

<Base titre={titre} description={description}>
  {/*
    ⚠️ CONTENU D'EXEMPLE : prix, délais, numéro WhatsApp, téléphone et e-mail
    sont provisoires (voir src/config.ts).
    Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
    Direction « Bobines » : blocs de couleur arrondis sur la grille à 12
    colonnes, aucune rotation, aucun décalage en escalier (voir le SKILL).
  */}

  <!-- ===================== HAUT DE PAGE : le bento ===================== -->
  <section class="haut bande" aria-labelledby="titre-accueil">
    <div class="haut__grille">
      <div class="haut__texte">
        <div class="haut__dire">
          <p class="haut__lieu">Brodeuse et couturière à {SITE.ville}, Ille-et-Vilaine</p>
          <h1 id="titre-accueil">Broderie personnalisée et couture sur mesure</h1>
          <p class="chapo">
            Je réalise dans mon atelier de {SITE.ville} des pièces brodées au prénom ou au motif de
            votre choix&nbsp;: linge de bain, cadeaux de naissance, décoration en dentelle libre. Je
            confectionne également sacs, trousses et tabliers. Chaque motif vous est soumis avant
            réalisation.
          </p>
        </div>
        <p class="actions">
          <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-1.5 0-3.9-1.2-5.6-3S7 10.4 7 9.3c0-.8.5-1.6 1-1.9.3-.2.9-.2 1.1.1l.9 1.5c.1.3.1.5-.1.8l-.4.5c-.2.2-.2.4 0 .7.4.7 1.7 2 2.5 2.3.3.1.5.1.7-.1l.6-.6c.2-.2.5-.3.7-.2l1.6.8c.4.2.5.6.4.9Z"/></svg>
            {LIBELLES.whatsapp}
          </a>
          <a class="btn btn--creux btn--grand" href="/contact/#devis">{LIBELLES.devis}</a>
        </p>
      </div>

      <figure class="haut__portrait">
        <Image
          src={portrait}
          alt="Emma, brodeuse et couturière à Vitré, souriante, en extérieur"
          widths={[400, 600, 800, 1000]}
          sizes="(max-width: 56rem) 92vw, 40vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption><span>Emma, votre seule interlocutrice</span></figcaption>
      </figure>

      {/* ⚠️ Délai, prix et temps de réponse d'exemple, à faire valider par Emma. */}
      <ul class="tuiles haut__faits" aria-label="En bref">
        <li class="tuile" style="--c:var(--menthe)"><strong>Dans la journée</strong><span>Réponse à votre message</span></li>
        <li class="tuile" style="--c:var(--beurre)"><strong>{ATELIER.delaiActuel}</strong><span>Délai de réalisation actuel</span></li>
        <li class="tuile" style="--c:var(--bleu)"><strong>Dès {prixMin}&nbsp;€</strong><span>Pièce personnalisée au prénom</span></li>
        <li class="tuile tuile--prune" style="--c:var(--prune)"><strong>Vitré, Rennes</strong><span>En main propre, ou envoi en France</span></li>
      </ul>
    </div>
  </section>

  <!-- La signature : les cinq fils des bobines se brodent au défilement. -->
  <div class="fils bande" aria-hidden="true">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path pathLength="1" d="M0 30 C 150 30, 200 90, 360 90 S 560 30, 720 30 S 920 90, 1080 90 S 1170 60, 1200 60"/>
      <path pathLength="1" d="M0 45 C 150 45, 200 99, 360 99 S 560 45, 720 45 S 920 99, 1080 99 S 1170 72, 1200 72"/>
      <path pathLength="1" d="M0 60 C 150 60, 200 108, 360 108 S 560 60, 720 60 S 920 108, 1080 108 S 1170 84, 1200 84"/>
      <path pathLength="1" d="M0 15 C 150 15, 200 81, 360 81 S 560 15, 720 15 S 920 81, 1080 81 S 1170 48, 1200 48"/>
      <path pathLength="1" d="M0 0 C 150 0, 200 72, 360 72 S 560 0, 720 0 S 920 72, 1080 72 S 1170 36, 1200 36"/>
    </svg>
  </div>

  <!-- ===================== CRÉATIONS ===================== -->
  <section class="bande creations" id="creations" aria-labelledby="creations-titre">
    <TeteSection titre="Créations récentes" variante="duo" id="creations-titre">
      <p>
        Chaque pièce se commande au prénom, aux couleurs et aux dimensions de votre choix. Les prix
        indiqués correspondent au modèle présenté.
      </p>
    </TeteSection>

    <div class="rangee rangee--grille" tabindex="0" role="region" aria-label="Créations récentes">
      {creations.map((c, i) => (
        <CarteCreation
          creation={c}
          prioritaire={i === 0}
          tailles="(max-width: 40rem) 78vw, (max-width: 64rem) 44vw, 28rem"
        />
      ))}
    </div>
    <p><a class="lien-fleche" href="/creations/">Voir toutes les créations</a></p>
  </section>

  <!-- ===================== DENTELLE LIBRE ===================== -->
  <section class="bande dentelle" id="dentelle" aria-labelledby="dentelle-titre">
    <div class="dentelle__grille">
      <figure class="dentelle__photo">
        <Image
          src={papillon}
          alt="Papillon et fleurs rouges en dentelle libre, brodés sans tissu, posés sur un feuillage"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 56rem) 92vw, 56vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="dentelle__texte">
        <h2 id="dentelle-titre">La dentelle libre</h2>
        <p>
          Une broderie machine réalisée sans tissu&nbsp;: le motif est brodé sur un support soluble,
          qui disparaît au rinçage. Il ne reste que le fil, ajouré et autoportant.
        </p>
        <p class="actions">
          <a class="btn btn--creux" href="/creations/decoration-ajouree/">Découvrir la dentelle libre</a>
        </p>
      </div>
      <figure class="dentelle__arbre">
        <Image
          src={arbre}
          alt="Arbre de vie brodé en dentelle ajourée fil doré, pièce autoportante sans support tissu"
          widths={[320, 480, 640]}
          sizes="(max-width: 56rem) 46vw, 16vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="dentelle__legende">
        <p>
          Arbre de vie, papillon, initiale, napperon&nbsp;: ces pièces se présentent sous cadre, se
          suspendent à une fenêtre ou se cousent sur une robe de mariée.
        </p>
        <p class="mono">Une technique encore rare en Ille-et-Vilaine</p>
      </div>
    </div>
  </section>

  <!-- ===================== OCCASIONS ===================== -->
  <section class="bande occasions" id="occasions" aria-labelledby="occasions-titre">
    <TeteSection titre="Pour chaque occasion" variante="duo" id="occasions-titre">
      <p>
        Indiquez-moi la date de votre événement&nbsp;: je vous confirme aussitôt si le délai de
        réalisation le permet. Baptêmes, anniversaires et départs en retraite sont également les
        bienvenus.
      </p>
    </TeteSection>

    <ul class="occ">
      {
        OCCASIONS.map((o, i) => (
          <li>
            <a class:list={['occ__lien', { 'occ__lien--sombre': o.fil === 'prune' }]} style={`--c:var(--${o.fil})`} href={`/cadeaux/${o.slug}/`}>
              <span class="occ__img">
                <Image
                  src={photosOccasions[i]}
                  alt={altOccasions[i]}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 64rem) 46vw, 22vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="occ__nom">
                {o.nom}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== DÉROULEMENT ===================== -->
  <section class="bande bloc methode loin" id="methode" aria-labelledby="methode-titre">
    <TeteSection titre="Le déroulement d'une commande" variante="duo" id="methode-titre">
      <p>
        Trois étapes, de votre premier message à la remise de la pièce. Rien n'est brodé tant que le
        motif n'a pas reçu votre accord.
      </p>
    </TeteSection>
    <Etapes etapes={ETAPES_COMMANDE} />
  </section>

  <!-- ===================== ATELIER ===================== -->
  <section class="bande atelier loin" id="atelier" aria-labelledby="atelier-titre">
    <figure class="atelier__bobines">
      <Image
        src={bobines}
        alt="Mur de l'atelier couvert de bobines de fil à broder : jaune, bleu ciel, turquoise, rose, prune, menthe"
        widths={[640, 1200, 1800]}
        sizes="(max-width: 85rem) 92vw, 85rem"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="atelier__bas">
      <div class="atelier__dire">
        <h2 id="atelier-titre">Un atelier, une seule interlocutrice</h2>
        <p>
          Je lis personnellement chacun de vos messages, je choisis les fils parmi mon mur de bobines,
          je réalise la broderie et je prépare l'envoi. Du premier échange à la remise, vous traitez
          avec la personne qui réalise votre pièce.
        </p>
        <p>
          Je travaille pour les particuliers de Vitré, de Rennes et des communes voisines&nbsp;:
          Pocé-les-Bois, Châteaubourg, Étrelles, Argentré-du-Plessis, Cesson-Sévigné. Remise en main
          propre à Vitré et à Rennes, envoi soigné partout en France.
        </p>
        <p class="actions">
          <a class="lien-fleche" href="/l-atelier/">Découvrir l'atelier</a>
          <a class="lien-fleche" href="/brodeuse-vitre/">À Vitré</a>
          <a class="lien-fleche" href="/broderie-personnalisee-rennes/">À Rennes</a>
        </p>
      </div>
      <figure class="atelier__machine">
        <Image
          src={machine}
          alt="Broderie en cours sous la tête de la machine : cerisiers en fleurs et colibri en fil de couleur"
          widths={[480, 800, 1200]}
          sizes="(max-width: 56rem) 92vw, 46vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <AppelFinal />
</Base>

<style>
  /* ============================ HAUT DE PAGE ============================ */
  .haut { padding-block: clamp(1rem, 2.4vw, 2rem) var(--gout); }
  .haut__grille {
    display: grid; gap: var(--gout);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'portrait' 'texte' 'faits';
  }
  .haut__texte {
    grid-area: texte;
    display: flex; flex-direction: column; justify-content: space-between; gap: clamp(1.25rem, 2vw, 1.75rem);
    padding: clamp(24px, 4vw, 64px);
    border-radius: var(--r-l);
    background: var(--rose);
  }
  .haut__dire { display: flex; flex-direction: column; gap: clamp(0.9rem, 1.6vw, 1.4rem); }
  .haut__lieu { font-weight: 700; font-size: var(--t-chapo); color: var(--prune); }
  .haut h1 { font-size: var(--t-h1-accueil); max-width: 15ch; }
  .haut .chapo { color: var(--encre); max-width: 58ch; }
  .haut__portrait {
    grid-area: portrait; position: relative; margin: 0;
    border-radius: var(--r-l); overflow: hidden;
    background: var(--bleu); aspect-ratio: 5 / 4;
  }
  .haut__portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .haut__portrait figcaption { position: absolute; inset: auto 14px 14px; display: flex; }
  .haut__portrait figcaption span {
    background: var(--papier); border-radius: 999px; padding: 0.45em 1em;
    font-size: var(--t-micro); font-weight: 500;
  }
  .haut__faits { grid-area: faits; }
  @media (min-width: 56rem) {
    .haut__grille {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        'texte texte texte texte texte texte texte portrait portrait portrait portrait portrait'
        'faits faits faits faits faits faits faits portrait portrait portrait portrait portrait';
    }
    .haut__portrait { aspect-ratio: auto; min-height: 100%; }
  }
  @media (min-width: 56rem) and (max-height: 760px) { .haut__texte { padding: 40px; } }

  /* ============================ CRÉATIONS ============================ */
  .creations { padding-block: var(--serre); }
  .creations :global(.ts) { margin-block-end: clamp(1.5rem, 3vw, 2.5rem); }
  .creations > p { margin-block-start: 1rem; }

  /* ============================ DENTELLE ============================ */
  .dentelle { padding-block: var(--serre); }
  .dentelle__grille { display: grid; gap: var(--gout); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dentelle__photo, .dentelle__texte { grid-column: 1 / -1; }
  .dentelle__photo { border-radius: var(--r-l); overflow: hidden; aspect-ratio: 16 / 10; background: var(--papier-2); }
  .dentelle__photo :global(img), .dentelle__arbre :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .dentelle__texte {
    display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start;
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--r-l);
    background: var(--prune); color: #fff;
  }
  .dentelle__texte h2 { color: #fff; }
  .dentelle__texte p { font-size: var(--t-chapo); line-height: 1.55; color: color-mix(in oklab, #fff 92%, transparent); }
  .dentelle__texte .btn--creux { --texte: #fff; --bord: #fff; --survol: #fff; --survol-texte: var(--prune); }
  .dentelle__texte :focus-visible { outline-color: #fff; }
  .dentelle__arbre { border-radius: var(--r-carte); overflow: hidden; background: #1f1f22; aspect-ratio: 4 / 5; }
  .dentelle__legende {
    display: flex; flex-direction: column; justify-content: space-between; gap: 1rem;
    padding: 1.4rem; border-radius: var(--r-carte); background: var(--beurre);
  }
  .dentelle__legende .mono { font-size: var(--t-micro); }
  @media (max-width: 29.999rem) { .dentelle__arbre, .dentelle__legende { grid-column: 1 / -1; } .dentelle__arbre { aspect-ratio: 4 / 3; } }
  @media (min-width: 56rem) {
    .dentelle__grille { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .dentelle__photo { grid-column: 1 / span 7; grid-row: 1 / span 2; aspect-ratio: auto; min-height: 34rem; }
    .dentelle__texte { grid-column: 8 / -1; }
    .dentelle__arbre { grid-column: 8 / span 2; aspect-ratio: auto; min-height: 13rem; }
    .dentelle__legende { grid-column: 10 / -1; }
  }

  /* ============================ OCCASIONS ============================ */
  .occasions { padding-block: var(--serre); }
  .occ { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gout); }
  @media (min-width: 64rem) { .occ { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .occ__lien {
    display: flex; flex-direction: column; height: 100%;
    border-radius: var(--r-carte); overflow: hidden;
    background: var(--c); color: var(--encre); text-decoration: none;
  }
  .occ__lien--sombre { color: #fff; }
  .occ__img { display: block; aspect-ratio: 1; overflow: hidden; }
  .occ__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--sortie); }
  .occ__nom {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    min-height: 3.5rem; padding: 1rem 1.1rem 1.1rem;
    font-family: var(--f-titre); font-weight: 740; font-stretch: 110%;
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.4rem); line-height: 1.1;
  }
  .occ__nom svg { width: 26px; height: 26px; flex: none; transition: transform 300ms ease; }
  @media (hover: hover) {
    .occ__lien:hover .occ__img :global(img) { transform: scale(1.05); }
    .occ__lien:hover .occ__nom svg { transform: translateX(4px); }
  }

  /* ============================ DÉROULEMENT ============================ */
  .methode :global(.ts__chapo) { color: var(--encre); }

  /* ============================ ATELIER ============================ */
  .atelier { padding-block: var(--serre); }
  .atelier__bobines { border-radius: var(--r-l); overflow: hidden; aspect-ratio: 1800 / 465; min-height: 11rem; background: var(--papier-2); }
  .atelier__bobines :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .atelier__bas { margin-block-start: var(--gout); display: grid; gap: var(--gout); grid-template-columns: minmax(0, 1fr); }
  .atelier__dire { display: flex; flex-direction: column; gap: 1.1rem; align-items: flex-start; padding-block: clamp(0.5rem, 2vw, 1.5rem); }
  .atelier__dire p:not(.actions) { font-size: var(--t-chapo); max-width: 52ch; }
  .atelier__dire .actions { gap: 0.25rem 1.5rem; }
  .atelier__machine { border-radius: var(--r-carte); overflow: hidden; aspect-ratio: 16 / 10; }
  .atelier__machine :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 37.5rem) { .atelier__bobines { aspect-ratio: 4 / 3; } }
  @media (min-width: 56rem) {
    .atelier__bas { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .atelier__dire { grid-column: 1 / span 6; }
    .atelier__machine { grid-column: 7 / -1; align-self: start; }
  }
</style>
