---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteCreation from '../components/CarteCreation.astro';
import TeteSection from '../components/TeteSection.astro';
import Etapes from '../components/Etapes.astro';
import AppelFinal from '../components/AppelFinal.astro';
import LigneFaits from '../components/LigneFaits.astro';
import { SITE, ATELIER, OCCASIONS, lienWhatsApp } from '../config';

import portrait from '../assets/creations/hero-mobile/emma-brodeuse-vitre-portrait.webp';
import bobines from '../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import machine from '../assets/creations/galerie/machine-a-broder-en-cours-atelier-vitre.webp';
import arbre from '../assets/creations/galerie/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';

/* Photos des quatre occasions, dans l'ordre de config.OCCASIONS. */
import occNaissance from '../assets/creations/galerie/doudou-plat-brode-prenom-keanu-naissance.webp';
import occMariage from '../assets/creations/galerie/papillon-brode-dentelle-ajouree-coquelicots.webp';
import occMeres from '../assets/creations/galerie/tambour-decoratif-brode-fee-rouge.webp';
import occNoel from '../assets/creations/galerie/chaussette-de-noel-brodee-prenom.webp';

const photosOccasions = [occNaissance, occMariage, occMeres, occNoel];
const altOccasions = [
  'Doudou plat en tissu, prénom brodé au centre, cadeau de naissance',
  'Papillon en dentelle libre, entièrement brodé de fil, à coudre sur une robe',
  'Tambour à broder décoratif, brodé et prêt à accrocher au mur',
  'Chaussette de Noël rouge, prénom brodé sur le revers',
];

/* Les créations mises en avant. L'ordre viendra de l'admin ; ici, du build. */
const creations = (await getCollection('creations', ({ data }) => !data.masquee))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 6);

/*
  Le carrousel du haut de page : des prénoms de CLIENTES, avec une légende
  qui les ancre dans une vraie commande. Ce sont les prénoms lisibles sur
  les photos d'Emma.
  ⚠️ EXEMPLES : légendes et poids à faire valider par Emma, et accord des
  clientes à confirmer avant mise en ligne.
*/
const prenoms = [
  { prenom: 'Ambre', legende: 'cadre de naissance · prénom, date, poids et taille' },
  { prenom: 'Malo', legende: "sac à dos d'école · brodé au prénom" },
  { prenom: 'Lisa', legende: 'trousse cousue main · brodée au prénom' },
  { prenom: 'Alicia', legende: 'drap de bain rose · fil mauve', fil: '#6B5560' },
];



const titre = `${SITE.nom} · broderie personnalisée & couture sur mesure à ${SITE.ville} (35)`;
const description =
  'Broderie personnalisée au prénom et couture sur mesure à Vitré (35) : cadeaux de naissance, linge de bain, dentelle libre, sacs et trousses. Remise en main propre à Vitré et Rennes, envoi partout en France.';

const prixMin = Math.min(...creations.map((c) => c.data.prixDepart ?? Infinity));
---

<Base titre={titre} description={description}>
  {/*
    ⚠️ CONTENU D'EXEMPLE : prix, délais, légendes, numéro WhatsApp, téléphone
    et e-mail sont provisoires (voir src/config.ts).
    Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
    Règles de mise en page : grille à 12 colonnes, aucune rotation, aucun
    chevauchement, aucun décalage en escalier (voir le SKILL).
  */}

  <!-- ===================== HAUT DE PAGE ===================== -->
  <section class="ouv bande">
    <div class="grille">
      <div class="ouv__texte">
        <p class="ouv__lieu">Brodeuse et couturière à {SITE.ville}, Ille-et-Vilaine</p>
        <h1>Broderie personnalisée et couture sur mesure</h1>
        <p class="chapo">
          Je réalise dans mon atelier de {SITE.ville} des pièces brodées au prénom ou au motif de
          votre choix&nbsp;: linge de bain, cadeaux de naissance, décoration en dentelle libre. Je
          confectionne également sacs, trousses et tabliers. Chaque motif vous est soumis avant
          réalisation.
        </p>
        <p class="actions">
          <a class="btn btn--wa btn--grand" href={lienWhatsApp()}>Me contacter sur WhatsApp</a>
          <a class="btn btn--creux btn--grand" href="/contact/#devis">Demander un devis</a>
        </p>
        <LigneFaits
          faits={[
            ATELIER.delaiReponse,
            `Délai actuel : ${ATELIER.delaiActuel}`,
            `À partir de ${prixMin} €`,
            'Vitré, Rennes, envoi en France',
          ]}
        />
      </div>

      <figure class="ouv__portrait">
        <Image
          src={portrait}
          alt="Emma, brodeuse et couturière à Vitré, souriante"
          widths={[400, 600, 800, 1000]}
          sizes="(max-width: 48rem) 92vw, 36vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="mono">Emma, votre seule interlocutrice, de la demande à l'envoi.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== SUR LE MÉTIER : la signature ===================== -->
  <section class="metier bande" aria-labelledby="metier-titre">
    <div class="grille">
      <div
        class="tambour"
        data-broderie="carrousel"
        data-prenoms={JSON.stringify(prenoms)}
        data-fil="#D93D28"
        data-duree="2600"
        data-legende="legende-prenom"
      >
        <p class="tambour__scene" data-scene aria-hidden="true">{prenoms[0].prenom}</p>
        <p class="lu-seulement">Exemples de prénoms brodés pour des clientes.</p>
      </div>
      <div class="metier__dire">
        <h2 id="metier-titre">Sur le métier</h2>
        <p class="metier__legende mono" aria-hidden="true">
          <span id="legende-prenom">{prenoms[0].legende}</span>
        </p>
        <p class="mesure">
          Chaque prénom est numérisé, puis brodé point par point par la machine. Avant de lancer la
          broderie, je vous envoie le motif : l'écriture, la taille et la couleur du fil restent
          modifiables jusqu'à votre accord.
        </p>
        <a class="lien-fleche" href="/sur-mesure/">Le déroulement d'une commande</a>
      </div>
    </div>
  </section>

  <!-- ===================== CRÉATIONS ===================== -->
  <section class="bande creations" id="creations">
    <TeteSection titre="Créations récentes" variante="duo">
      <p>
        Chaque pièce est personnalisée : le tissu, l'écriture et la couleur du fil sont choisis avec
        vous. Toutes les créations présentées peuvent être réalisées à votre nom.
      </p>
      <a slot="lien" class="lien-fleche" href="/creations/">Voir toutes les créations</a>
    </TeteSection>

    <div class="rangee" tabindex="0" role="region" aria-label="Créations récentes, rangée défilante">
      {creations.map((c, i) => <CarteCreation creation={c} prioritaire={i === 0} />)}
    </div>
    <div class="creations__barre" aria-hidden="true"><span></span></div>
  </section>

  <!-- ===================== BANDEAU BOBINES (seule occurrence du site) ===================== -->
  <figure class="bandeau">
    <Image
      src={bobines}
      alt="Mur de l'atelier couvert de bobines de fil à broder de toutes les couleurs"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </figure>

  <!-- ===================== DENTELLE LIBRE (le seul tapis de la page) ===================== -->
  <section class="bande tapis dentelle" id="dentelle" aria-labelledby="dentelle-titre">
    <div class="grille">
      <div class="dentelle__dire">
        <h2 id="dentelle-titre">La dentelle libre</h2>
        <p class="chapo">
          Une broderie machine réalisée sans tissu : le motif est brodé sur un support soluble, qui
          disparaît au rinçage. Il ne reste que le fil, ajouré et autoportant.
        </p>
        <p class="mesure">
          Arbre de vie, papillon, initiale, napperon : ces pièces se présentent sous cadre, se
          suspendent à une fenêtre ou se cousent sur une robe de mariée. C'est une technique encore
          rare en Ille-et-Vilaine, et celle que je pratique avec le plus de plaisir.
        </p>
        <p class="actions">
          <a class="btn btn--or" href="/creations/decoration-ajouree/">Découvrir la dentelle libre</a>
        </p>
      </div>
      <figure class="dentelle__fig">
        <Image
          src={arbre}
          alt="Arbre de vie brodé en dentelle ajourée fil doré, pièce autoportante sans support tissu"
          widths={[400, 640, 900]}
          sizes="(max-width: 48rem) 92vw, 36vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mono">Arbre de vie, fil doré, sans support tissu</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== OCCASIONS ===================== -->
  <section class="bande occasions loin" id="occasions">
    <TeteSection titre="Pour chaque occasion" variante="duo">
      <p>
        Indiquez-moi la date de votre événement : je vous confirme aussitôt si le délai de
        réalisation le permet. Baptêmes, anniversaires et départs en retraite sont également les
        bienvenus.
      </p>
    </TeteSection>

    <ul class="occ">
      {
        OCCASIONS.map((o, i) => (
          <li style={`--f:${o.fil}`}>
            <a class="occ__lien" href={`/cadeaux/${o.slug}/`}>
              <span class="occ__img">
                <Image
                  src={photosOccasions[i]}
                  alt={altOccasions[i]}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 48rem) 46vw, 22vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="occ__bas">
                <span class="occ__nom">{o.nom}</span>
                <span class="occ__fleche" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== DÉROULEMENT ===================== -->
  <section class="bande methode loin" id="methode">
    <TeteSection titre="Le déroulement d'une commande">
      <p>Aucune réalisation n'est lancée sans votre accord sur le motif.</p>
    </TeteSection>
    <Etapes
      etapes={[
        {
          titre: 'Votre demande',
          texte:
            "Précisez-moi le prénom, l'occasion et la date souhaitée, avec une photo d'inspiration si vous en avez une. Je reviens vers vous avec une proposition, un prix et un délai.",
        },
        {
          titre: 'La validation du motif',
          texte:
            "Avant toute réalisation, je vous adresse le motif. Il peut être ajusté autant que nécessaire : tant qu'il n'est pas brodé, tout reste modifiable.",
          cle: true,
        },
        {
          titre: 'La remise',
          texte:
            'Votre pièce est emballée, prête à offrir. Remise en main propre à Vitré ou à Rennes, ou envoi soigné partout en France.',
        },
      ]}
    />
  </section>

  <!-- ===================== ATELIER ===================== -->
  <section class="bande atelier loin" id="atelier" aria-labelledby="atelier-titre">
    <div class="grille">
      <figure class="atelier__fig">
        <Image
          src={machine}
          alt="Broderie en cours sous la tête de la machine : cerisiers en fleurs et colibri en fil de couleur"
          widths={[400, 640, 900]}
          sizes="(max-width: 48rem) 92vw, 40vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="atelier__dire">
        <h2 id="atelier-titre">Un atelier, une seule interlocutrice</h2>
        <p class="mesure">
          Je lis personnellement chacun de vos messages, je choisis les fils parmi mon mur de
          bobines, je réalise la broderie et je prépare l'envoi. Du premier échange à la remise,
          vous traitez avec la personne qui réalise votre pièce.
        </p>
        <p class="actions">
          <a class="lien-fleche" href="/l-atelier/">Découvrir l'atelier</a>
          <a class="lien-fleche" href="/sur-mesure/">Tarifs et délais</a>
        </p>
      </div>
    </div>
  </section>

  <AppelFinal />
</Base>

<style>
  /* ============================ HAUT DE PAGE ============================ */
  .ouv { padding-block: clamp(1.5rem, 4vw, 3.5rem) var(--serre); }
  .ouv .grille { row-gap: 2rem; align-items: center; }
  .ouv__texte { display: grid; gap: 1.25rem; justify-items: start; }
  .ouv__lieu { font-size: var(--t-petit); color: var(--coquelicot-fonce); }
  .ouv h1 { font-size: var(--t-h1-accueil); max-width: 13ch; }

  .ouv__portrait { display: grid; gap: 0.6rem; }
  .ouv__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: var(--r-m);
  }
  .ouv__portrait figcaption { font-size: var(--t-micro); color: var(--gris); }

  @media (min-width: 48rem) {
    .ouv__texte { grid-column: 1 / span 7; }
    .ouv__portrait { grid-column: 8 / -1; }
    .ouv__portrait :global(img) { aspect-ratio: 4 / 5; }
  }
  @media (min-width: 64rem) {
    .ouv { min-height: calc(100svh - 5rem); display: grid; align-content: center; }
  }

  /* ============================ SUR LE MÉTIER ============================ */
  .metier {
    padding-block: var(--serre);
    border-block: 1px solid color-mix(in oklab, var(--encre) 12%, transparent);
  }
  .metier .grille { row-gap: 2rem; align-items: center; }

  /* Le tambour à broder : la seule occurrence du site. */
  .tambour {
    --bois: #C9A97E;
    --bois-fonce: #8A6A46;
    /* l'anneau de bois (17 px de chaque côté) compte dans la largeur */
    width: min(calc(100% - 34px), 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid; place-items: center;
    container-type: inline-size;
    background:
      radial-gradient(70% 60% at 35% 30%, color-mix(in oklab, #fff 55%, transparent), transparent 70%),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--encre) 4%, transparent) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--encre) 4%, transparent) 0 1px, transparent 1px 3px),
      var(--rose);
    box-shadow:
      0 0 0 10px var(--bois),
      0 0 0 12px var(--bois-fonce),
      0 0 0 17px var(--bois);
    margin: 17px;
  }
  /* Taille fixe : les prénoms n'ont pas la même longueur, rien ne saute. */
  .tambour__scene {
    width: 80%;
    height: 32cqi;
    display: grid; place-items: center;
    font-family: var(--f-titre);
    font-size: 24cqi;
    line-height: 1;
    color: var(--coquelicot);
  }
  .tambour__scene :global(.broderie-prenom-pret) { line-height: 0; }
  .tambour__scene :global(.broderie-prenom) { height: 32cqi; max-width: 100%; vertical-align: middle; }
  .tambour__scene :global(.broderie-trace path) { stroke: var(--coquelicot); }

  .metier__dire { display: grid; gap: 1rem; justify-items: start; }
  .metier__legende { font-size: var(--t-micro); color: var(--coquelicot-fonce); min-height: 1.5em; }

  @media (min-width: 48rem) {
    .tambour { grid-column: 1 / span 5; justify-self: center; }
    .metier__dire { grid-column: 7 / -1; }
  }

  /* ============================ CRÉATIONS ============================ */
  .creations { padding-block: var(--respire) var(--serre); timeline-scope: --rangee; }
  .creations__barre {
    height: 2px;
    background: color-mix(in oklab, var(--encre) 12%, transparent);
    max-width: 20rem;
    margin-block-start: 0.5rem;
  }
  .creations__barre span {
    display: block; height: 100%;
    background: var(--coquelicot);
    transform-origin: 0 50%;
    transform: scaleX(0.15);
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .creations__barre span { animation: barre linear both; animation-timeline: --rangee; }
    }
  }
  @keyframes barre { from { transform: scaleX(0.15); } to { transform: scaleX(1); } }

  .bandeau { margin: 0; }

  /* ============================ DENTELLE ============================ */
  .dentelle .grille { row-gap: 2.5rem; align-items: center; }
  .dentelle__dire { display: grid; gap: 1.25rem; justify-items: start; }
  .dentelle__fig { display: grid; gap: 0.6rem; }
  .dentelle__fig :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--r-m); }
  .dentelle figcaption { font-size: var(--t-micro); color: var(--tapis-trait); }
  @media (min-width: 48rem) {
    .dentelle__dire { grid-column: 1 / span 6; }
    .dentelle__fig { grid-column: 8 / -1; }
  }

  /* ============================ OCCASIONS ============================ */
  .occasions { padding-block: var(--respire) var(--serre); }
  .occ { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gout); }
  @media (min-width: 64rem) { .occ { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .occ__lien {
    display: grid;
    border-radius: var(--r-m);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--f);
  }
  .occ__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .occ__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--sortie); }
  .occ__lien:hover .occ__img :global(img) { transform: scale(1.04); }
  .occ__bas {
    display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
    min-height: 3.75rem;
    padding: 0.9rem 1rem;
  }
  .occ__nom { font-family: var(--f-titre); font-size: var(--t-h3); line-height: 1.05; }
  .occ__fleche { transition: transform 300ms var(--sortie); }
  .occ__lien:hover .occ__fleche { transform: translateX(4px); }
  .occ__lien:focus-visible { outline-color: var(--encre); }

  /* ============================ DÉROULEMENT ============================ */
  .methode { padding-block: var(--serre) var(--respire); }

  /* ============================ ATELIER ============================ */
  .atelier { padding-block: 0 var(--respire); }
  .atelier .grille { row-gap: 2rem; align-items: center; }
  .atelier__fig :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-m); }
  .atelier__dire { display: grid; gap: 1.25rem; justify-items: start; }
  @media (min-width: 48rem) {
    .atelier__fig { grid-column: 1 / span 6; }
    .atelier__dire { grid-column: 8 / -1; }
  }
</style>
