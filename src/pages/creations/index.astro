---
/**
 * /creations/ — la galerie complète.
 *
 * Les filtres par catégorie sont des LIENS vers les pages catégorie : chaque
 * catégorie a sa propre URL indexable. Aucun JavaScript de filtrage.
 *
 * Mise en page : grille à 12 colonnes, cartes de largeur égale
 * (1 colonne sur téléphone, 2 sur tablette, 3 sur ordinateur), alignées en
 * haut et en bas. Aucun décalage.
 */
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HautDePage from '../../components/HautDePage.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, ATELIER } from '../../config';

import partage from '../../assets/creations/plein-ecran/machine-a-broder-en-cours-atelier-vitre.webp';
import papillon from '../../assets/creations/galerie/papillon-brode-dentelle-ajouree-coquelicots.webp';

/* Image de partage 1200×630 : sans elle, la page repartirait sur l'image par
   défaut du gabarit. En JPEG, le format que tous les aperçus savent lire. */
const og = await getImage({
  src: partage,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

/* Libellés courts des catégories, pour les filtres. L'ordre est éditorial :
   on ouvre sur la naissance (la demande la plus fréquente) et on garde Noël
   à la fin. */
const ETIQUETTES = [
  { slug: 'naissance', court: 'Naissance' },
  { slug: 'linge-de-bain', court: 'Linge de bain' },
  { slug: 'vetements', court: 'Vêtements' },
  { slug: 'couture', court: 'Couture' },
  { slug: 'decoration-ajouree', court: 'Dentelle libre' },
  { slug: 'noel', court: 'Noël' },
] as const;

const creations = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

/* Un filtre n'existe que si la catégorie contient au moins une pièce :
   un lien vers une page vide serait un cul-de-sac. */
const filtres = ETIQUETTES.map((e) => ({
  ...e,
  nombre: creations.filter((c) => c.data.categorie === e.slug).length,
})).filter((e) => e.nombre > 0);

/* Prix d'appel : le plus bas réellement présent dans le contenu. */
const prix = creations
  .map((c) => c.data.prixDepart)
  .filter((p): p is number => typeof p === 'number');
const prixMini = prix.length > 0 ? Math.min(...prix) : null;
const aDentelle = filtres.some((f) => f.slug === 'decoration-ajouree');

/* ⚠️ Prix et délai : exemples à valider par Emma. */
const faits = [
  ...(prixMini ? [`À partir de ${prixMini} €`] : []),
  `Délai actuel : ${ATELIER.delaiActuel}`,
  'Remise à Vitré ou Rennes, envoi en France',
];

const titre = `Créations brodées & cousues à Vitré (35) — toutes mes pièces | ${SITE.nom}`;
const description =
  'Toutes mes créations brodées à Vitré : doudous et cadres de naissance, linge de bain au prénom, dentelle ajourée, sacs et trousses cousus. Prix à partir de, délai annoncé, devis dans la journée.';
const fil = [{ nom: 'Créations', url: '/creations/' }];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix et délais viennent de src/content/creations/ et de src/config.ts :
    provisoires tant qu'Emma ne les a pas confirmés.
    Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
    « Cousu main » : seulement pour les sacs, trousses et tabliers.
  */}

  <HautDePage titre="Créations brodées et cousues à Vitré" fil={fil} faits={faits}>
    <p>
      Broderie personnalisée et couture sur mesure à {SITE.ville}&nbsp;(35)&nbsp;: doudous et
      cadres de naissance, linge de bain au prénom, dentelle libre, sacs et trousses cousus main.
      Chaque pièce présentée ici a été réalisée pour une cliente.
    </p>
    <p>
      Chacune peut être reproduite avec un autre prénom, une autre couleur de fil ou un autre
      tissu. Le bouton «&nbsp;Je veux la même&nbsp;» m'envoie directement la pièce concernée.
    </p>
  </HautDePage>

  <!-- ===================== FILTRES = PAGES CATÉGORIE ===================== -->
  <nav class="bande filtres" aria-label="Catégories de créations">
    <ul class="filtres__liste">
      <li><span class="filtre filtre--ici" aria-current="page">Tout</span></li>
      {
        filtres.map((f) => (
          <li>
            <a class="filtre" href={`/creations/${f.slug}/`}>
              {f.court}
              <span class="lu-seulement">
                ({f.nombre} pièce{f.nombre > 1 ? 's' : ''})
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- ===================== LA GALERIE ===================== -->
  <section class="bande galerie" aria-label="Toutes les créations">
    <ul class="grille cartes">
      {
        creations.map((c, i) => (
          <li>
            <CarteCreation
              creation={c}
              prioritaire={i < 2}
              tailles="(max-width: 48rem) 92vw, (max-width: 64rem) 46vw, 27rem"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== RENVOI DENTELLE ===================== -->
  {
    aDentelle && (
      <section class="bande tapis renvoi loin" aria-labelledby="renvoi-titre">
        <div class="grille">
          <figure class="renvoi__fig">
            <Image
              src={papillon}
              alt="Papillon en dentelle libre aux ailes rouges et noires, brodé sans tissu"
              widths={[400, 640, 900]}
              sizes="(max-width: 48rem) 92vw, 40vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="renvoi__dire">
            <h2 id="renvoi-titre">La dentelle libre</h2>
            <p class="mesure mesure--clair">
              Elle se brode sur un voile soluble qui disparaît au rinçage. Il ne reste que le fil,
              qui tient seul, sans aucun tissu. C'est le travail que je préfère, et une technique
              encore rare en Ille-et-Vilaine.
            </p>
            <a class="btn btn--or" href="/creations/decoration-ajouree/">Voir la dentelle libre</a>
          </div>
        </div>
      </section>
    )
  }

  <AppelFinal titre="Une pièce sur mesure">
    <p>
      Votre idée ne figure pas dans cette galerie&nbsp;? Indiquez-moi le prénom, l'objet et la date
      souhaitée. Je vous réponds avec un prix et un délai de réalisation, et je vous soumets le
      motif pour validation avant toute broderie.
    </p>
    <p><a href="/sur-mesure/">Prix, délais, entretien&nbsp;: le déroulement d'une commande</a></p>
  </AppelFinal>
</Base>

<style>
  /* ============================ FILTRES ============================
     Des liens en pilule (forme réservée aux filtres). La liste défile si
     elle est trop longue, jamais la page. */
  .filtres { padding-block: 0 var(--serre); }
  .filtres__liste {
    display: flex; gap: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .filtres__liste::-webkit-scrollbar { display: none; }
  .filtres__liste > li { flex: none; position: relative; }
  .filtre {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--encre) 20%, transparent);
    color: var(--encre);
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, color 200ms ease;
  }
  a.filtre:hover, .filtre--ici { background: var(--encre); border-color: var(--encre); color: var(--lin-haut); }

  /* ============================ GALERIE ============================ */
  .galerie { padding-block: 0 var(--respire); }
  .cartes { row-gap: clamp(2.5rem, 5vw, 4rem); }
  .cartes > li { display: grid; }
  @media (min-width: 48rem) { .cartes > li { grid-column: span 6; } }
  @media (min-width: 64rem) { .cartes > li { grid-column: span 4; } }

  /* ============================ RENVOI DENTELLE ============================ */
  .renvoi .grille { row-gap: 2rem; align-items: center; }
  .renvoi__fig :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-m); }
  .renvoi__dire { display: grid; gap: 1.25rem; justify-items: start; }
  @media (min-width: 48rem) {
    .renvoi__fig { grid-column: 1 / span 6; }
    .renvoi__dire { grid-column: 8 / -1; }
  }
</style>
