---
/**
 * /creations/ — la galerie complète.
 *
 * Les filtres par catégorie sont des LIENS vers les pages catégorie : chaque
 * catégorie a sa propre URL. Aucun JavaScript de filtrage. La même barre de
 * filtres figure sur les pages catégorie (catégorie active en aria-current).
 *
 * Présentation « catalogue » (demande client : les codes d'une boutique, sans
 * panier ni paiement — la commande passe par WhatsApp ou le devis) : barre en
 * tête avec le nombre de pièces et les filtres, puis grille régulière de
 * cartes produit (1 colonne, 2 dès 34rem, 3 dès 64rem, 4 dès 80rem).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HautDePage from '../../components/HautDePage.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE } from '../../config';

import partage from '../../assets/creations/plein-ecran/machine-a-broder-en-cours-atelier-vitre.webp';

/* Image de partage 1200×630 : sans elle, la page repartirait sur l'image par
   défaut du gabarit. En JPEG, le format que tous les aperçus savent lire. */
const og = await getImage({
  src: partage,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

/* Libellés courts des catégories, pour les filtres. L'ordre est éditorial :
   on ouvre sur la naissance (la demande la plus fréquente) et on garde Noël
   à la fin. ⚠️ Même liste que dans [categorie].astro. */
const ETIQUETTES = [
  { slug: 'naissance', court: 'Naissance' },
  { slug: 'linge-de-bain', court: 'Linge de maison' },
  { slug: 'vetements', court: 'Vêtements' },
  { slug: 'couture', court: 'Couture' },
  { slug: 'decoration-ajouree', court: 'Dentelle libre' },
  { slug: 'noel', court: 'Noël' },
] as const;

const creations = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

/* Un filtre n'existe que si la catégorie contient au moins une pièce :
   un lien vers une page vide serait un cul-de-sac. */
const filtres = ETIQUETTES.map((e) => ({
  ...e,
  nombre: creations.filter((c) => c.data.categorie === e.slug).length,
})).filter((e) => e.nombre > 0);

const titre = `Créations brodées & cousues à Vitré (35) — toutes mes pièces | ${SITE.nom}`;
const description =
  'Toutes mes créations brodées à Vitré : doudous et cadres de naissance, linge de bain au prénom, dentelle ajourée, sacs et trousses cousus. Prix à partir de, délai annoncé, devis dans la journée.';
const fil = [{ nom: 'Créations', url: '/creations/' }];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix et délais viennent de src/content/creations/ et de src/config.ts :
    provisoires tant qu'Emma ne les a pas confirmés.
    Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
    « Cousu main » : seulement pour les sacs, trousses et tabliers.
  */}

  <HautDePage titre="Créations brodées et cousues à Vitré" fil={fil}>
    <p>
      Broderie personnalisée et couture sur mesure, réalisées à {SITE.ville}&nbsp;(35). Chaque
      modèle est réalisé sur commande, à votre prénom&nbsp;: vous le commandez sur WhatsApp ou par
      une demande de devis.
    </p>
  </HautDePage>

  <!-- ===================== LE CATALOGUE =====================
       Barre en tête (nombre de pièces + filtres = pages catégorie), puis
       grille régulière de cartes produit. -->
  <section class="bande catalogue" aria-labelledby="catalogue-titre">
    <h2 class="lu-seulement" id="catalogue-titre">Toutes les créations</h2>
    <nav class="cat-barre" aria-label="Catégories de créations">
      <p class="cat-barre__nombre mono">{creations.length} pièce{creations.length > 1 ? 's' : ''}</p>
      <ul class="cat-barre__filtres">
        <li><a class="filtre" href="/creations/" aria-current="page">Tout</a></li>
        {
          filtres.map((f) => (
            <li>
              <a class="filtre" href={`/creations/${f.slug}/`}>
                {f.court}
                <span class="lu-seulement">({f.nombre} pièce{f.nombre > 1 ? 's' : ''})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="grille cartes">
      {
        creations.map((c, i) => (
          <li>
            <CarteCreation
              creation={c}
              prioritaire={i < 2}
              tailles="(max-width: 34rem) 92vw, (max-width: 64rem) 46vw, (max-width: 80rem) 30vw, 20rem"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <AppelFinal titre="Une pièce sur mesure">
    <p>
      Votre idée ne figure pas dans cette galerie&nbsp;? Indiquez-moi le prénom, l’objet et la date
      souhaitée. Je vous réponds avec un prix et un délai de réalisation, et je vous soumets le
      motif pour validation avant toute broderie.
    </p>
    <p><a href="/sur-mesure/">Prix, délais, entretien&nbsp;: le déroulement d’une commande</a></p>
  </AppelFinal>
</Base>

<style>
  /* ============================ BARRE DU CATALOGUE ============================
     Nombre de pièces + filtres en pilule (forme réservée aux filtres). Sur
     téléphone, les filtres défilent dans leur conteneur, jamais la page. */
  .catalogue { padding-block: 0 var(--respire); }
  .cat-barre {
    display: grid; gap: 0.6rem;
    margin-block-end: clamp(1.25rem, 2.5vw, 2rem);
  }
  .cat-barre__nombre { font-size: var(--t-micro); color: var(--encre-doux); }
  .cat-barre__filtres {
    display: flex; gap: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .cat-barre__filtres::-webkit-scrollbar { display: none; }
  .cat-barre__filtres > li { flex: none; }
  .filtre {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 2px solid var(--encre);
    color: var(--encre);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .filtre:hover { background: var(--papier-2); }
  .filtre[aria-current] { background: var(--encre); border-color: var(--encre); color: var(--papier); }
  @media (min-width: 48rem) {
    .cat-barre { grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 1.5rem; }
    .cat-barre__filtres { flex-wrap: wrap; overflow: visible; }
  }

  /* ============================ GRILLE PRODUITS ============================ */
  .cartes { row-gap: var(--gout); }
  .cartes > li { display: grid; }
  @media (min-width: 34rem) { .cartes > li { grid-column: span 6; } }
  @media (min-width: 64rem) { .cartes > li { grid-column: span 4; } }
  @media (min-width: 80rem) { .cartes > li { grid-column: span 3; } }
</style>
