---
/**
 * /creations/ — la galerie complète.
 *
 * Les filtres par catégorie sont des LIENS vers les pages catégorie : chaque
 * catégorie a sa propre URL. Aucun JavaScript de filtrage. La même barre de
 * filtres figure sur les pages catégorie (catégorie active en aria-current).
 *
 * Premier écran : le haut de page porte les filtres dans sa colonne de droite
 * (slot `aside`) et la grille remonte juste dessous, pour que des créations
 * soient visibles dès l'arrivée, sur téléphone comme sur ordinateur.
 *
 * Grille : cartes de largeur égale (1 colonne sur petit téléphone, 2 dès
 * 34rem, 3 dès 64rem), alignées en haut et en bas. Aucun décalage.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HautDePage from '../../components/HautDePage.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE } from '../../config';

import partage from '../../assets/creations/plein-ecran/machine-a-broder-en-cours-atelier-vitre.webp';

/* Image de partage 1200×630 : sans elle, la page repartirait sur l'image par
   défaut du gabarit. En JPEG, le format que tous les aperçus savent lire. */
const og = await getImage({
  src: partage,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

/* Libellés courts des catégories, pour les filtres. L'ordre est éditorial :
   on ouvre sur la naissance (la demande la plus fréquente) et on garde Noël
   à la fin. ⚠️ Même liste que dans [categorie].astro. */
const ETIQUETTES = [
  { slug: 'naissance', court: 'Naissance' },
  { slug: 'linge-de-bain', court: 'Linge de bain' },
  { slug: 'vetements', court: 'Vêtements' },
  { slug: 'couture', court: 'Couture' },
  { slug: 'decoration-ajouree', court: 'Dentelle libre' },
  { slug: 'noel', court: 'Noël' },
] as const;

const creations = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

/* Un filtre n'existe que si la catégorie contient au moins une pièce :
   un lien vers une page vide serait un cul-de-sac. */
const filtres = ETIQUETTES.map((e) => ({
  ...e,
  nombre: creations.filter((c) => c.data.categorie === e.slug).length,
})).filter((e) => e.nombre > 0);

/* Prix d'appel : le plus bas réellement présent dans le contenu. */
const prix = creations
  .map((c) => c.data.prixDepart)
  .filter((p): p is number => typeof p === 'number');
const prixMini = prix.length > 0 ? Math.min(...prix) : null;

/* ⚠️ Prix : exemple à valider par Emma. Le délai actuel de l'atelier n'est
   affiché que dans l'appel final (règle : un seul délai par page). */
const faits = [
  ...(prixMini ? [`Dès ${prixMini} €`] : []),
  'Vitré, Rennes, envoi en France',
];

const titre = `Créations brodées & cousues à Vitré (35) — toutes mes pièces | ${SITE.nom}`;
const description =
  'Toutes mes créations brodées à Vitré : doudous et cadres de naissance, linge de bain au prénom, dentelle ajourée, sacs et trousses cousus. Prix à partir de, délai annoncé, devis dans la journée.';
const fil = [{ nom: 'Créations', url: '/creations/' }];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix et délais viennent de src/content/creations/ et de src/config.ts :
    provisoires tant qu'Emma ne les a pas confirmés.
    Vocabulaire : broderie MACHINE. Ne jamais écrire « brodé à la main ».
    « Cousu main » : seulement pour les sacs, trousses et tabliers.
  */}

  <HautDePage titre="Créations brodées et cousues à Vitré" fil={fil} faits={faits}>
    <p>
      Broderie personnalisée et couture sur mesure, réalisées à {SITE.ville}&nbsp;(35). Chaque
      pièce a été faite pour une cliente et peut être reproduite avec un autre prénom, une autre
      couleur de fil ou un autre tissu.
    </p>

    <!-- FILTRES = PAGES CATÉGORIE -->
    <nav slot="aside" class="filtres" aria-labelledby="filtres-titre">
      <p class="filtres__titre mono" id="filtres-titre">Par catégorie</p>
      <ul class="filtres__liste">
        <li><a class="filtre" href="/creations/" aria-current="page">Tout</a></li>
        {
          filtres.map((f) => (
            <li>
              <a class="filtre" href={`/creations/${f.slug}/`}>
                {f.court}
                <span class="lu-seulement">
                  ({f.nombre} pièce{f.nombre > 1 ? 's' : ''})
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </HautDePage>

  <!-- ===================== LA GALERIE ===================== -->
  <section class="bande galerie" aria-label="Toutes les créations">
    <ul class="grille cartes">
      {
        creations.map((c, i) => (
          <li>
            <CarteCreation
              creation={c}
              prioritaire={i < 2}
              tailles="(max-width: 34rem) 92vw, (max-width: 64rem) 46vw, 27rem"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <AppelFinal titre="Une pièce sur mesure">
    <p>
      Votre idée ne figure pas dans cette galerie&nbsp;? Indiquez-moi le prénom, l’objet et la date
      souhaitée. Je vous réponds avec un prix et un délai de réalisation, et je vous soumets le
      motif pour validation avant toute broderie.
    </p>
    <p><a href="/sur-mesure/">Prix, délais, entretien&nbsp;: le déroulement d’une commande</a></p>
  </AppelFinal>
</Base>

<style>
  /* ============================ FILTRES ============================
     Des liens en pilule (forme réservée aux filtres). Sur téléphone, la
     liste défile dans son conteneur, jamais la page ; dès 48rem, dans la
     colonne de droite du haut de page, elle passe à la ligne. */
  .filtres { display: grid; gap: 0.7rem; }
  .filtres__titre { font-size: var(--t-micro); color: var(--gris); }
  .filtres__liste {
    display: flex; gap: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .filtres__liste::-webkit-scrollbar { display: none; }
  .filtres__liste > li { flex: none; }
  .filtre {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--encre) 20%, transparent);
    color: var(--encre);
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, color 200ms ease;
  }
  .filtre:hover, .filtre[aria-current] { background: var(--encre); border-color: var(--encre); color: var(--lin-haut); }
  @media (min-width: 48rem) {
    .filtres__liste { flex-wrap: wrap; overflow: visible; }
  }

  /* ============================ GALERIE ============================ */
  .galerie { padding-block: 0 var(--respire); }
  .cartes { row-gap: clamp(2.5rem, 5vw, 4rem); }
  .cartes > li { display: grid; }
  @media (min-width: 34rem) { .cartes > li { grid-column: span 6; } }
  @media (min-width: 64rem) { .cartes > li { grid-column: span 4; } }
</style>
