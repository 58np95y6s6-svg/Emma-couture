---
/**
 * /creations/<categorie>/ — une page par catégorie réellement remplie.
 *
 * Chaque catégorie a son titre, sa meta description et son chapô : ce sont
 * des pages différentes, pas des variantes d'un gabarit. Une catégorie vide
 * ne génère aucune page (pas de cul-de-sac dans le sitemap).
 *
 * Mise en page selon le nombre de pièces :
 *  - une seule : « vedette », grande photo et fiche à côté ;
 *  - deux et plus : mosaïque, comme la galerie.
 * La dentelle libre (decoration-ajouree) est l'angle différenciant : son
 * entête est une section « tapis » avec la technique expliquée en trois
 * étapes réelles.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import { SITE, ATELIER, lienWhatsApp } from '../../config';

import papillon from '../../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';

export const getStaticPaths: GetStaticPaths = async () => {
  /**
   * Le texte de chaque catégorie. Le H1 est informatif, le chapô porte les
   * mots-clés. ⚠️ Emma brode à la MACHINE : jamais « brodé à la main ».
   * « Cousu main » n'est vrai que pour la couture (sacs, trousses, tabliers).
   *
   * ⚠️ Défini DANS getStaticPaths : Astro isole cette fonction dans son propre
   * module au build. Les textes voyagent donc par les props.
   */
  const CATEGORIES = {
    naissance: {
      court: 'Naissance',
      h1: 'Cadeaux de naissance brodés au prénom',
      titre: 'Doudou, cadre & bavoir brodés au prénom — créations naissance',
      description:
        'Toutes mes créations de naissance brodées au prénom : doudou, cadre, bavoir, cape de bain, sac à dos. Prix à partir de, délais et photos — brodé à Vitré (35).',
      chapo:
        'Doudou, cadre de naissance, bavoir, cape de bain. Vous me transmettez les informations du faire-part : prénom, date, heure, poids et taille. Je compose la mise en page et vous la soumets avant broderie. Le fil résiste au lavage à 30 °C ; ces pièces sont faites pour servir.',
      note: 'Vous pouvez commander avant la naissance et me transmettre les informations ensuite. Le support est préparé à l’avance et la broderie est réalisée dès réception de votre message.',
      occasion: { slug: 'naissance', nom: 'Idées de cadeaux de naissance' },
    },
    'linge-de-bain': {
      court: 'Linge de bain',
      h1: 'Linge de bain brodé au prénom',
      titre: 'Drap de bain & serviette brodés au prénom — Vitré (35)',
      description:
        'Draps de bain, serviettes et capes brodés au prénom en lettres cursives, brodés à Vitré (35). Vous choisissez la couleur du linge, celle du fil et l’écriture. Envoi partout en France.',
      chapo:
        'Draps de bain, serviettes et capes de bain en coton épais, brodés au prénom en lettres cursives. Vous choisissez la couleur du linge, celle du fil et le style d’écriture ; je vous soumets le rendu avant broderie. Un cadeau personnel qui sert au quotidien.',
      note: 'Pour un ensemble familial, avec un prénom par pièce, indiquez-moi le nombre de pièces : je vous établis un prix pour l’ensemble.',
      occasion: { slug: 'fete-des-meres', nom: 'Idées pour la fête des mères' },
    },
    vetements: {
      court: 'Vêtements',
      h1: 'Broderie personnalisée sur vêtement',
      titre: 'Broderie sur vêtement : prénom, initiale, motif — Vitré (35)',
      description:
        'Pyjamas, tabliers, blouses, vestes : je brode le prénom, l’initiale ou un motif à Vitré (35). Sur votre vêtement ou sur un vêtement que je fournis.',
      chapo:
        'Pyjama, tablier, blouse, veste : je brode le prénom, l’initiale ou un motif à l’endroit de votre choix. Vous pouvez me confier votre vêtement, ou je le fournis. Je vérifie au préalable que le tissu se prête à la broderie.',
      note: '',
      occasion: null,
    },
    couture: {
      court: 'Couture',
      h1: 'Sacs et trousses cousus main, puis brodés',
      titre: 'Sacs & trousses cousus main et brodés — Vitré (35)',
      description:
        'Sacs, trousses et tabliers cousus main puis brodés au prénom à Vitré (35). Vous choisissez dans mes coupons ou vous apportez votre tissu. Devis dans la journée.',
      chapo:
        'Sacs, trousses et tabliers : je confectionne ces pièces avant de les broder. Vous choisissez parmi mes coupons, ou vous me confiez votre propre tissu, par exemple un linge de famille ou un coupon trouvé au marché. Ce sont les seules pièces du site que je peux dire cousues main.',
      note: 'Un tissu qui a une histoire fait souvent le plus beau cadeau. Envoyez-moi une photo du coupon : je vous indique ce qu’il est possible d’en faire.',
      occasion: { slug: 'fete-des-meres', nom: 'Idées pour la fête des mères' },
    },
    'decoration-ajouree': {
      court: 'Dentelle libre',
      h1: 'La dentelle libre',
      titre: 'Dentelle libre : broderie ajourée sans support — Vitré (35)',
      description:
        'Dentelle libre brodée à Vitré (35) : arbre de vie, papillon, initiale, napperon. Des pièces ajourées sans support tissu, qui se tiennent seules. À encadrer, à suspendre ou à coudre.',
      chapo:
        'Broderie ajourée réalisée à Vitré (35) : arbre de vie, papillon, initiale, napperon. Ces pièces de dentelle libre sont brodées sans support tissu et tiennent seules. Elles s’encadrent, se suspendent à une fenêtre ou se cousent sur une robe.',
      note: 'Un dessin, une initiale, un motif que vous avez remarqué : envoyez-moi l’image. Je vous dirai si la dentelle peut tenir seule et sous quelle forme.',
      occasion: { slug: 'mariage', nom: 'Idées pour un mariage' },
    },
    noel: {
      court: 'Noël',
      h1: 'Cadeaux de Noël brodés au prénom',
      titre: 'Cadeaux de Noël brodés au prénom — Vitré (35)',
      description:
        'Chaussettes de cheminée, pyjamas, plaids et boules brodés au prénom à Vitré (35). Une pièce par personne. À commander avant la mi-novembre pour être livré le 24.',
      chapo:
        'Chaussettes de cheminée, pyjamas, plaids et boules, brodés au prénom de chacun. Ces pièces ressortent chaque année : je vous soumets le motif avant broderie, afin que tout soit juste dès la première fois.',
      /* ⚠️ Date limite d'exemple, à confirmer par Emma. */
      note: 'Pour une livraison avant le 24 décembre, je vous recommande de commander avant la mi-novembre.',
      occasion: { slug: 'noel', nom: 'Idées de cadeaux de Noël' },
    },
  } as const;

  type Slug = keyof typeof CATEGORIES;

  const creations = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
    (a, b) => a.data.ordre - b.data.ordre,
  );

  const remplies = (Object.keys(CATEGORIES) as Slug[]).filter((s) =>
    creations.some((c) => c.data.categorie === s),
  );

  return remplies.map((slug) => ({
    params: { categorie: slug },
    props: {
      cat: CATEGORIES[slug],
      pieces: creations.filter((c) => c.data.categorie === slug),
      voisines: remplies
        .filter((s) => s !== slug)
        .map((s) => ({ slug: s, court: CATEGORIES[s].court })),
    },
  }));
};

const { categorie } = Astro.params;
const { cat, pieces, voisines } = Astro.props;
const estDentelle = categorie === 'decoration-ajouree';

/* Prix d'appel de la catégorie : le plus bas réellement présent. */
const prix = pieces.map((c) => c.data.prixDepart).filter((p): p is number => typeof p === 'number');
const prixMini = prix.length > 0 ? Math.min(...prix) : null;

/* Une seule pièce : elle est présentée en vedette, avec ses deux appels. */
const vedette = pieces.length === 1 ? pieces[0] : null;
const v = vedette
  ? (() => {
      const d = vedette.data;
      const feminin = /^la\s/i.test(d.titre.trim());
      const meme = feminin ? 'la même' : 'le même';
      const url = `/creations/${vedette.id}/`;
      return {
        d,
        id: vedette.id,
        url,
        meme,
        wa: lienWhatsApp(
          `Bonjour ${SITE.nom}, j'ai vu « ${d.titre} » sur votre site et j'aimerais ${meme}.`,
          new URL(url, SITE.url).href,
        ),
      };
    })()
  : null;

/* Image de partage : la première pièce, recadrée en 1200×630, sans
   agrandissement. */
const ogLargeur = Math.min(1200, pieces[0].data.photo.width);
const og = await getImage({
  src: pieces[0].data.photo,
  width: ogLargeur,
  height: Math.round((ogLargeur * 630) / 1200),
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

const titre = `${cat.titre} | ${SITE.nom}`;
---

<Base
  titre={titre}
  description={cat.description}
  imageOg={og.src}
  fil={[
    { nom: 'Créations', url: '/creations/' },
    { nom: cat.court, url: `/creations/${categorie}/` },
  ]}
>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix et délais viennent du contenu et de src/config.ts : provisoires.
    Vocabulaire : broderie MACHINE.
  */}

  {
    estDentelle ? (
      /* ===================== ENTÊTE DENTELLE : le tapis ===================== */
      <section class="bande tapis dt">
        <span class="regle plein dt__regle" aria-hidden="true" />
        <nav class="ariane ariane--clair" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/creations/">Créations</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{cat.court}</span>
        </nav>

        <div class="dt__dire">
          <h1 class="titre-geant">{cat.h1}</h1>
          <p class="chapo">{cat.chapo}</p>
          {/* ⚠️ À confirmer par Emma : réalise-t-elle la dentelle libre sur commande ? */}
          <p class="mesure mesure--clair">
            C’est le travail que je préfère, et une technique encore rare en Ille-et-Vilaine.
          </p>
        </div>

        <figure class="dt__tambour">
          <Image
            src={papillon}
            alt="Papillon brodé en dentelle libre, ailes rouges et noires, surmonté de coquelicots brodés"
            widths={[480, 720, 1000, 1300]}
            sizes="(max-width: 64rem) 86vw, 40vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <div class="dt__technique">
          <h2 class="dt__h2">La technique, en trois temps</h2>
          <ol class="dt__etapes">
            <li>
              <span class="mono">1</span>
              <p>Je tends dans le cadre un voile soluble, qui servira de support provisoire.</p>
            </li>
            <li>
              <span class="mono">2</span>
              <p>
                La machine brode le motif sur ce voile, en croisant les fils pour qu’ils se
                soutiennent entre eux.
              </p>
            </li>
            <li>
              <span class="mono">3</span>
              <p>Au rinçage, le voile se dissout. Il ne reste que la dentelle, qui tient seule.</p>
            </li>
          </ol>
        </div>
      </section>
    ) : (
      /* ===================== ENTÊTE ===================== */
      <section class="bande ct">
        <nav class="ariane" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/creations/">Créations</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{cat.court}</span>
        </nav>
        <h1>{cat.h1}</h1>
        <div class="ct__dire">
          <p class="chapo">{cat.chapo}</p>
        </div>
      </section>
    )
  }

  <!-- ===================== LES PIÈCES ===================== -->
  <section class:list={['bande', 'pieces', { 'pieces--dentelle': estDentelle }]} aria-label={`Créations : ${cat.court}`}>
    {/* ⚠️ Prix et délai : exemples à valider par Emma. */}
    <dl class="faits mono">
      {
        prixMini && (
          <div>
            <dt>à partir de</dt>
            <dd>{prixMini}&nbsp;€</dd>
          </div>
        )
      }
      <div>
        <dt>délai actuel</dt>
        <dd>{ATELIER.delaiActuel}</dd>
      </div>
      <div>
        <dt>réalisé à</dt>
        <dd>{SITE.ville}, {SITE.departement}</dd>
      </div>
    </dl>

    {
      v ? (
        <article class="vedette">
          <a class="vedette__photo" href={v.url} aria-hidden="true" tabindex="-1">
            <Image
              src={v.d.photo}
              alt={v.d.alt}
              widths={[390, 620, 800, 1000]}
              sizes="(max-width: 56rem) 92vw, 46vw"
              loading={estDentelle ? 'lazy' : 'eager'}
              decoding="async"
            />
          </a>
          <div class="vedette__dire">
            <h2 class="vedette__titre">
              <a href={v.url}>{v.d.titre}</a>
            </h2>
            <p class="vedette__accroche">{v.d.accroche}</p>
            {(v.d.prixDepart || v.d.delaiJours) && (
              <p class="vedette__ligne mono" data-reglage-creation={v.id}>
                {v.d.prixDepart && (
                  <span>
                    à partir de <b>{v.d.prixDepart}&nbsp;€</b>
                  </span>
                )}
                {v.d.delaiJours && (
                  <span>
                    réalisation <b>{v.d.delaiJours}&nbsp;jours</b>
                  </span>
                )}
              </p>
            )}
            <p class="actions">
              <a class="btn btn--wa" href={v.wa}>Je veux {v.meme}</a>
              <a class="btn btn--creux" href={`/contact/?creation=${v.id}`}>Demander un devis</a>
            </p>
            <a class="lien-fleche" href={v.url}>Voir la fiche complète</a>
            {cat.note && <p class="note">{cat.note}</p>}
          </div>
        </article>
      ) : (
        <>
          <ul class="mosaique">
            {pieces.map((c, i) => (
              <li>
                <CarteCreation
                  creation={c}
                  prioritaire={i < 2}
                  tailles="(max-width: 34rem) 92vw, (max-width: 64rem) 46vw, 36vw"
                />
              </li>
            ))}
          </ul>
          {cat.note && <p class="note note--seule">{cat.note}</p>}
        </>
      )
    }
  </section>

  <!-- ===================== SUITE : appel + maillage ===================== -->
  <section class="bande suite loin">
    <div class="suite__appel">
      <h2 class="titre-xl">Une demande sur mesure</h2>
      <p class="chapo">
        Indiquez-moi le prénom, l’objet et la date souhaitée. Je vous réponds avec un prix et un
        délai de réalisation, et je vous soumets le motif pour validation avant toute broderie.
      </p>
      <p class="actions">
        <a
          class="btn btn--wa"
          href={lienWhatsApp(`Bonjour ${SITE.nom}, je souhaiterais une création dans la catégorie « ${cat.court} ».`)}
        >
          Écrire sur WhatsApp
        </a>
        <a class="btn btn--creux" href="/contact/#devis">Remplir le formulaire</a>
      </p>
      <p class="suite__liens">
        <a class="lien-fleche" href="/sur-mesure/">Le déroulement d’une commande</a>
        {cat.occasion && (
          <a class="lien-fleche" href={`/cadeaux/${cat.occasion.slug}/`}>{cat.occasion.nom}</a>
        )}
      </p>
    </div>

    <nav class="suite__nav" aria-label="Autres catégories">
      <h2 class="suite__h2">Les autres catégories</h2>
      <ul>
        {
          voisines.map((x) => (
            <li>
              <a href={`/creations/${x.slug}/`}>{x.court}</a>
            </li>
          ))
        }
        <li><a href="/creations/">Toutes les créations</a></li>
      </ul>
    </nav>
  </section>
</Base>

<style>
  /* ============================ ENTÊTE STANDARD ============================ */
  .ct {
    padding-block: clamp(0.5rem, 2vw, 1.5rem) clamp(1.5rem, 3vw, 2.5rem);
    row-gap: clamp(1rem, 2.5vw, 1.8rem);
  }
  .ct h1 { max-width: 16ch; }
  @media (min-width: 64rem) {
    .ct {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.58))
        [mi] minmax(0, calc(var(--large) * 0.42))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      align-items: end;
    }
    .ct .ariane { grid-column: large-d / large-f; }
    .ct h1 { grid-column: large-d / mi; font-size: clamp(3.8rem, 1rem + 4.6vw, 7rem); }
    .ct__dire { grid-column: mi / large-f; padding-inline-start: clamp(1.5rem, 3vw, 3rem); padding-block-end: 0.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ct h1, .dt__dire { animation: arrive 800ms var(--sortie) both; }
    .ct__dire { animation: arrive 800ms var(--sortie) 120ms both; }
  }
  @keyframes arrive { from { transform: translateY(20px); opacity: 0.001; } to { transform: none; opacity: 1; } }

  /* ============================ ENTÊTE DENTELLE ============================
     Le tapis de coupe, une règle graduée en tête, un tambour géant à droite
     et la technique en trois temps — une vraie séquence, donc numérotée. */
  .dt {
    padding-block: 0 var(--respire);
    row-gap: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
  }
  .dt__regle { margin-block-end: 0.5rem; }
  .ariane--clair { color: var(--tapis-trait); }
  .ariane--clair [aria-current] { color: var(--lin-haut); }
  .ariane--clair a:hover { color: var(--rose); }
  .dt__dire { display: grid; gap: clamp(1rem, 2vw, 1.5rem); align-content: start; }
  .dt h1 { color: var(--lin-haut); max-width: 9ch; text-wrap: balance; font-size: clamp(3.6rem, 1rem + 11vw, 10.5rem); }
  .dt__tambour {
    --bois: #C9A97E; --bois-fonce: #8A6A46;
    position: relative;
    width: min(100% - 2.5rem, 34rem);
    justify-self: center;
    aspect-ratio: 1;
    border-radius: 50%;
    container-type: inline-size;
    box-shadow:
      0 0 0 clamp(7px, 2cqi, 12px) var(--bois),
      0 0 0 calc(clamp(7px, 2cqi, 12px) + 2px) var(--bois-fonce),
      0 0 0 calc(clamp(7px, 2cqi, 12px) + 7px) var(--bois),
      0 40px 70px -30px #000;
    margin-block: 1rem;
  }
  .dt__tambour :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .dt__technique { display: grid; gap: 1.2rem; }
  .dt__h2 {
    font-size: var(--t-h3);
    color: var(--lin-haut);
  }
  .dt__etapes {
    display: grid; gap: 0;
    border-block-start: 1.5px dashed color-mix(in oklab, var(--tapis-trait) 55%, transparent);
  }
  .dt__etapes li {
    display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 0.8rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-end: 1px dashed color-mix(in oklab, var(--tapis-trait) 35%, transparent);
  }
  .dt__etapes .mono { font-size: 1rem; color: var(--rose); }
  .dt__etapes p { color: color-mix(in oklab, var(--lin-haut) 88%, transparent); max-width: 36rem; }

  @media (min-width: 64rem) {
    .dt {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.52))
        [mi] minmax(0, calc(var(--large) * 0.48))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
    }
    .dt__regle { grid-column: bord-d / bord-f; }
    .dt .ariane { grid-column: large-d / large-f; }
    .dt__dire { grid-column: large-d / mi; grid-row: 3; padding-inline-end: 3rem; align-self: center; }
    .dt__tambour { grid-column: mi / large-f; grid-row: 3; width: min(100%, 36rem); justify-self: end; align-self: center; }
    .dt__technique { grid-column: large-d / large-f; grid-row: 4; margin-block-start: clamp(1rem, 3vw, 3rem); }
    .dt__etapes { grid-template-columns: repeat(3, minmax(0, 1fr)); border-block-end: 1px dashed color-mix(in oklab, var(--tapis-trait) 35%, transparent); }
    .dt__etapes li { grid-template-columns: minmax(0, 1fr); align-content: start; align-items: start; gap: 0.5rem; border-block-end: 0; padding-inline-end: 1.6rem; padding-block: 1.4rem 1.6rem; }
    .dt__etapes li + li { padding-inline-start: 1.2rem; border-inline-start: 1px dashed color-mix(in oklab, var(--tapis-trait) 35%, transparent); }
    .dt__etapes p { font-size: var(--t-corps); }
  }

  /* Le tambour tourne d'un quart de tour pendant que la section défile,
     comme un cadre qu'on repositionne. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .dt__tambour :global(img) {
        animation: tambour linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes tambour { from { transform: rotate(-10deg) scale(1.08); } to { transform: rotate(14deg) scale(1.08); } }

  /* ============================ FAITS ============================ */
  .pieces { padding-block: clamp(1rem, 2vw, 1.5rem) var(--respire); row-gap: clamp(2rem, 5vw, 4rem); }
  .pieces--dentelle { padding-block-start: clamp(2.5rem, 5vw, 4rem); }
  .faits {
    display: flex; flex-wrap: wrap;
    border-block: 1.5px dashed color-mix(in oklab, var(--encre) 30%, transparent);
    font-size: var(--t-micro);
  }
  .faits > div { display: grid; gap: 0.1rem; padding: 0.8rem 1.4rem 0.8rem 0; }
  .faits > div + div { padding-inline-start: 1.2rem; border-inline-start: 1px dashed color-mix(in oklab, var(--encre) 18%, transparent); }
  .faits dt { color: var(--gris); }
  .faits dd { margin: 0; font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem); color: var(--encre); }
  .faits > div:first-child dd { color: var(--coquelicot-fonce); }
  @media (max-width: 30rem) {
