---
/**
 * /creations/<categorie>/ — une page par catégorie réellement remplie.
 *
 * Chaque catégorie a son titre, sa meta description et son chapô : ce sont
 * des pages différentes, pas des variantes d'un gabarit. Une catégorie vide
 * ne génère aucune page (pas de cul-de-sac dans le sitemap).
 *
 * Filtres : la même barre que la galerie, catégorie active en aria-current
 * (colonne de droite du haut de page ; sous le haut de page quand celui-ci
 * porte une photo, comme la dentelle libre).
 *
 * Mise en page (grille à 12 colonnes, sans décalage) selon le nombre de pièces :
 *  - une seule : « vedette », photo col. 1-6 et texte col. 8-12 ;
 *  - deux et plus : cartes de largeur égale, comme la galerie.
 * La dentelle libre (decoration-ajouree) est l'angle différenciant : photo
 * dans le haut de page et technique expliquée en trois étapes réelles.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import HautDePage from '../../components/HautDePage.astro';
import TeteSection from '../../components/TeteSection.astro';
import Etapes from '../../components/Etapes.astro';
import ListeLignes from '../../components/ListeLignes.astro';
import LigneFaits from '../../components/LigneFaits.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, LIBELLES, lienWhatsApp } from '../../config';

import papillon from '../../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';

export const getStaticPaths: GetStaticPaths = async () => {
  /**
   * Le texte de chaque catégorie. Le H1 est informatif, le chapô porte les
   * mots-clés. ⚠️ Emma brode à la MACHINE : jamais « brodé à la main ».
   * « Cousu main » n'est vrai que pour la couture (sacs, trousses, tabliers).
   *
   * ⚠️ Défini DANS getStaticPaths : Astro isole cette fonction dans son propre
   * module au build. Les textes voyagent donc par les props.
   */
  const CATEGORIES = {
    naissance: {
      court: 'Naissance',
      h1: 'Cadeaux de naissance brodés au prénom',
      titre: 'Doudou, cadre & bavoir brodés au prénom — créations naissance',
      description:
        'Toutes mes créations de naissance brodées au prénom : doudou, cadre, bavoir, cape de bain, sac à dos. Prix à partir de, délais et photos — brodé à Vitré (35).',
      chapo:
        'Doudou, cadre de naissance, bavoir, cape de bain. Vous me transmettez les informations du faire-part : prénom, date, heure, poids et taille. Je compose la mise en page et vous la soumets avant broderie. Le fil résiste au lavage à 30 °C ; ces pièces sont faites pour servir.',
      note: 'Vous pouvez commander avant la naissance et me transmettre les informations ensuite. Le support est préparé à l’avance et la broderie est réalisée dès réception de votre message.',
      occasion: { slug: 'naissance', nom: 'Idées de cadeaux de naissance' },
    },
    'linge-de-bain': {
      court: 'Linge de bain',
      h1: 'Linge de bain brodé au prénom',
      titre: 'Drap de bain & serviette brodés au prénom — Vitré (35)',
      description:
        'Draps de bain, serviettes et capes brodés au prénom en lettres cursives, brodés à Vitré (35). Vous choisissez la couleur du linge, celle du fil et l’écriture. Envoi partout en France.',
      chapo:
        'Draps de bain, serviettes et capes de bain en coton épais, brodés au prénom en lettres cursives. Vous choisissez la couleur du linge, celle du fil et le style d’écriture ; je vous soumets le rendu avant broderie. Un cadeau personnel qui sert au quotidien.',
      note: 'Pour un ensemble familial, avec un prénom par pièce, indiquez-moi le nombre de pièces : je vous établis un prix pour l’ensemble.',
      occasion: { slug: 'fete-des-meres', nom: 'Idées pour la fête des mères' },
    },
    vetements: {
      court: 'Vêtements',
      h1: 'Broderie personnalisée sur vêtement',
      titre: 'Broderie sur vêtement : prénom, initiale, motif — Vitré (35)',
      description:
        'Pyjamas, tabliers, blouses, vestes : je brode le prénom, l’initiale ou un motif à Vitré (35). Sur votre vêtement ou sur un vêtement que je fournis.',
      chapo:
        'Pyjama, tablier, blouse, veste : je brode le prénom, l’initiale ou un motif à l’endroit de votre choix. Vous pouvez me confier votre vêtement, ou je le fournis. Je vérifie au préalable que le tissu se prête à la broderie.',
      note: '',
      occasion: null,
    },
    couture: {
      court: 'Couture',
      h1: 'Sacs et trousses cousus main, puis brodés',
      titre: 'Sacs & trousses cousus main et brodés — Vitré (35)',
      description:
        'Sacs, trousses et tabliers cousus main puis brodés au prénom à Vitré (35). Vous choisissez dans mes coupons ou vous apportez votre tissu. Devis dans la journée.',
      chapo:
        'Sacs, trousses et tabliers : je confectionne ces pièces avant de les broder. Vous choisissez parmi mes coupons, ou vous me confiez votre propre tissu, par exemple un linge de famille ou un coupon trouvé au marché. Ce sont les seules pièces du site que je peux dire cousues main.',
      note: 'Un tissu qui a une histoire fait souvent le plus beau cadeau. Envoyez-moi une photo du coupon : je vous indique ce qu’il est possible d’en faire.',
      occasion: { slug: 'fete-des-meres', nom: 'Idées pour la fête des mères' },
    },
    'decoration-ajouree': {
      court: 'Dentelle libre',
      h1: 'La dentelle libre',
      titre: 'Dentelle libre : broderie ajourée sans support — Vitré (35)',
      description:
        'Dentelle libre brodée à Vitré (35) : arbre de vie, papillon, initiale, napperon. Des pièces ajourées sans support tissu, qui se tiennent seules. À encadrer, à suspendre ou à coudre.',
      chapo:
        'Broderie ajourée réalisée à Vitré (35) : arbre de vie, papillon, initiale, napperon. Ces pièces de dentelle libre sont brodées sans support tissu et tiennent seules. Elles s’encadrent, se suspendent à une fenêtre ou se cousent sur une robe.',
      note: 'Un dessin, une initiale, un motif que vous avez remarqué : envoyez-moi l’image. Je vous dirai si la dentelle peut tenir seule et sous quelle forme.',
      occasion: { slug: 'mariage', nom: 'Idées pour un mariage' },
    },
    noel: {
      court: 'Noël',
      h1: 'Cadeaux de Noël brodés au prénom',
      titre: 'Cadeaux de Noël brodés au prénom — Vitré (35)',
      description:
        'Chaussettes de cheminée, pyjamas, plaids et boules brodés au prénom à Vitré (35). Une pièce par personne. À commander avant la mi-novembre pour être livré le 24.',
      chapo:
        'Chaussettes de cheminée, pyjamas, plaids et boules, brodés au prénom de chacun. Ces pièces ressortent chaque année : je vous soumets le motif avant broderie, afin que tout soit juste dès la première fois.',
      /* ⚠️ Date limite d'exemple, à confirmer par Emma. */
      note: 'Pour une livraison avant le 24 décembre, je vous recommande de commander avant la mi-novembre.',
      occasion: { slug: 'noel', nom: 'Idées de cadeaux de Noël' },
    },
  } as const;

  type Slug = keyof typeof CATEGORIES;

  const creations = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
    (a, b) => a.data.ordre - b.data.ordre,
  );

  const remplies = (Object.keys(CATEGORIES) as Slug[]).filter((s) =>
    creations.some((c) => c.data.categorie === s),
  );

  return remplies.map((slug) => ({
    params: { categorie: slug },
    props: {
      cat: CATEGORIES[slug],
      pieces: creations.filter((c) => c.data.categorie === slug),
      /* Toutes les catégories remplies, pour la barre de filtres. */
      filtres: remplies.map((s) => ({
        slug: s,
        court: CATEGORIES[s].court,
        nombre: creations.filter((c) => c.data.categorie === s).length,
      })),
    },
  }));
};

const { categorie } = Astro.params;
const { cat, pieces, filtres } = Astro.props;
const estDentelle = categorie === 'decoration-ajouree';

/* Apostrophe typographique à l'affichage (les titres du contenu gardent l'apostrophe droite). */
const typo = (t: string) => t.replace(/'/g, '’');

/* [CONTENU EMMA] Une catégorie de moins de 3 pièces reste hors de l'index
   (page trop mince pour Google). Elle s'indexera d'elle-même dès qu'Emma
   aura ajouté des pièces. */
const tropMince = pieces.length < 3;

/* Prix d'appel de la catégorie : le plus bas réellement présent. */
const prix = pieces.map((c) => c.data.prixDepart).filter((p): p is number => typeof p === 'number');
const prixMini = prix.length > 0 ? Math.min(...prix) : null;

/* ⚠️ Prix : exemple à valider par Emma. Le délai actuel de l'atelier n'est
   affiché que dans l'appel final. */
const faits = [
  ...(prixMini ? [`Dès ${prixMini} €`] : []),
  `Réalisé à ${SITE.ville}, ${SITE.departement}`,
];

/* Une seule pièce : elle est présentée en vedette, avec ses deux appels. */
const vedette = pieces.length === 1 ? pieces[0] : null;
const v = vedette
  ? (() => {
      const d = vedette.data;
      const url = `/creations/${vedette.id}/`;
      return {
        d,
        id: vedette.id,
        url,
        wa: lienWhatsApp(
          `Bonjour Emma, j'ai vu « ${d.titre} » sur votre site et j'aimerais un modèle similaire.`,
          new URL(url, SITE.url).href,
        ),
      };
    })()
  : null;

/* Image de partage : la première pièce, recadrée en 1200×630, sans
   agrandissement. */
const ogLargeur = Math.min(1200, pieces[0].data.photo.width);
const og = await getImage({
  src: pieces[0].data.photo,
  width: ogLargeur,
  height: Math.round((ogLargeur * 630) / 1200),
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

const titre = `${cat.titre} | ${SITE.nom}`;
const fil = [
  { nom: 'Créations', url: '/creations/' },
  { nom: cat.court, url: `/creations/${categorie}/` },
];

/* Pour continuer : trois liens au plus (l'occasion liée, la galerie, le sur-mesure). */
const suite = [
  ...(cat.occasion ? [{ titre: cat.occasion.nom, href: `/cadeaux/${cat.occasion.slug}/` }] : []),
  { titre: 'Toutes les créations', href: '/creations/' },
  { titre: 'Le déroulement d’une commande', href: '/sur-mesure/' },
];

const messageWa = `Bonjour Emma, je souhaiterais une création dans la catégorie « ${cat.court} ».`;
---

<Base titre={titre} description={cat.description} imageOg={og.src} fil={fil} noindex={tropMince} messageWa={messageWa}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix et délais viennent du contenu et de src/config.ts : provisoires.
    Vocabulaire : broderie MACHINE.
  */}

  <HautDePage
    titre={cat.h1}
    fil={fil}
    faits={faits}
    image={estDentelle ? papillon : undefined}
    alt="Papillon brodé en dentelle libre, ailes rouges et noires, surmonté de coquelicots brodés"
  >
    <p>{cat.chapo}</p>
    {cat.note && <p>{cat.note}</p>}

    {/* Sans photo, les filtres prennent la colonne de droite du haut de page. */}
    {
      !estDentelle && (
        <nav slot="aside" class="filtres" aria-labelledby="filtres-titre">
          <p class="filtres__titre mono" id="filtres-titre">Par catégorie</p>
          <ul class="filtres__liste">
            <li><a class="filtre" href="/creations/">Tout</a></li>
            {filtres.map((f) => (
              <li>
                <a class="filtre" href={`/creations/${f.slug}/`} aria-current={f.slug === categorie ? 'page' : undefined}>
                  {f.court}
                  <span class="lu-seulement">({f.nombre} pièce{f.nombre > 1 ? 's' : ''})</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </HautDePage>

  {/* Avec photo dans le haut de page : la même barre, juste dessous. */}
  {
    estDentelle && (
      <nav class="bande filtres filtres--bande" aria-labelledby="filtres-titre">
        <p class="filtres__titre mono" id="filtres-titre">Par catégorie</p>
        <ul class="filtres__liste">
          <li><a class="filtre" href="/creations/">Tout</a></li>
          {filtres.map((f) => (
            <li>
              <a class="filtre" href={`/creations/${f.slug}/`} aria-current={f.slug === categorie ? 'page' : undefined}>
                {f.court}
                <span class="lu-seulement">({f.nombre} pièce{f.nombre > 1 ? 's' : ''})</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <!-- ===================== LES PIÈCES ===================== -->
  <section class="bande pieces" aria-label={`Créations : ${cat.court}`}>
    {
      v ? (
        <article class="grille vedette">
          <a class="vedette__photo" href={v.url} aria-hidden="true" tabindex="-1">
            <Image
              src={v.d.photo}
              alt={v.d.alt}
              widths={[390, 620, 800, 1000]}
              sizes="(max-width: 48rem) 92vw, 42vw"
              loading={estDentelle ? 'lazy' : 'eager'}
              decoding="async"
            />
          </a>
          <div class="vedette__dire">
            <h2><a href={v.url}>{typo(v.d.titre)}</a></h2>
            <p class="chapo">{v.d.accroche}</p>
            {/* ⚠️ Prix et délai : exemples à valider par Emma. */}
            {(v.d.prixDepart || v.d.delaiJours) && (
              <LigneFaits
                faits={[
                  ...(v.d.prixDepart ? [`dès ${v.d.prixDepart} €`] : []),
                  ...(v.d.delaiJours ? [`réalisation ${v.d.delaiJours} j`] : []),
                ]}
              />
            )}
            <p class="actions">
              <a class="btn btn--wa" href={v.wa}>{LIBELLES.laMeme}</a>
              <a class="btn btn--creux" href={`/contact/?creation=${v.id}#devis`}>{LIBELLES.devis}</a>
            </p>
            <a class="lien-fleche" href={v.url}>Voir la fiche complète</a>
          </div>
        </article>
      ) : (
        <ul class="grille cartes">
          {pieces.map((c, i) => (
            <li>
              <CarteCreation
                creation={c}
                prioritaire={i < 2}
                tailles="(max-width: 34rem) 92vw, (max-width: 64rem) 46vw, 27rem"
              />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- ===================== DENTELLE : la technique (seule section tapis) ===================== -->
  {
    estDentelle && (
      <section class="bande tapis technique loin">
        <TeteSection titre="La technique, en trois temps">
          {/* ⚠️ À confirmer par Emma : réalise-t-elle la dentelle libre sur commande ? */}
          <p>C’est le travail que je préfère, et une technique encore rare en Ille-et-Vilaine.</p>
        </TeteSection>
        <Etapes
          etapes={[
            { titre: 'Le support provisoire', texte: 'Je tends dans le cadre un voile soluble, qui sert de support le temps de la broderie.' },
            { titre: 'La broderie', texte: 'La machine brode le motif sur ce voile, en croisant les fils pour qu’ils se soutiennent entre eux.' },
            { titre: 'Le rinçage', texte: 'Au rinçage, le voile se dissout. Il ne reste que la dentelle, qui tient seule.' },
          ]}
        />
      </section>
    )
  }

  <!-- ===================== POUR CONTINUER ===================== -->
  <nav class="bande continuer loin" aria-labelledby="continuer-titre">
    <TeteSection titre="Poursuivre la visite" id="continuer-titre" />
    <div class="grille">
      <div class="continuer__liste"><ListeLignes lignes={suite} /></div>
    </div>
  </nav>

  <AppelFinal titre="Une demande sur mesure" messageWa={messageWa}>
    <p>
      Indiquez-moi le prénom, l’objet et la date souhaitée. Je vous réponds avec un prix et un délai
      de réalisation, et je vous soumets le motif pour validation avant toute broderie.
    </p>
  </AppelFinal>
</Base>

<style>
  /* ============================ FILTRES (mêmes que la galerie) ============================ */
  .filtres { display: grid; gap: 0.7rem; }
  .filtres--bande { padding-block: 0 var(--serre); }
  .filtres__titre { font-size: var(--t-micro); color: var(--gris); }
  .filtres__liste {
    display: flex; gap: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .filtres__liste::-webkit-scrollbar { display: none; }
  .filtres__liste > li { flex: none; }
  .filtre {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--encre) 20%, transparent);
    color: var(--encre);
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, color 200ms ease;
  }
  .filtre:hover, .filtre[aria-current] { background: var(--encre); border-color: var(--encre); color: var(--lin-haut); }
  @media (min-width: 48rem) {
    .filtres__liste { flex-wrap: wrap; overflow: visible; }
  }

  .pieces { padding-block: 0 var(--respire); }

  /* Une seule pièce : photo col. 1-6, texte col. 8-12, alignés en haut. */
  .vedette { row-gap: 1.5rem; align-items: start; }
  .vedette__photo { display: block; overflow: hidden; border-radius: var(--r-m); background: var(--lin-bas); }
  .vedette__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 900ms var(--sortie); }
  .vedette__photo:hover :global(img) { transform: scale(1.04); }
  .vedette__dire { display: grid; gap: 1.1rem; justify-items: start; }
  .vedette h2 a { text-decoration: none; }
  .vedette h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  @media (min-width: 48rem) {
    .vedette__photo { grid-column: 1 / span 6; }
    .vedette__dire { grid-column: 8 / -1; }
  }

  /* Plusieurs pièces : cartes de largeur égale, comme la galerie. */
  .cartes { row-gap: clamp(2.5rem, 5vw, 4rem); }
  .cartes > li { display: grid; }
  @media (min-width: 34rem) { .cartes > li { grid-column: span 6; } }
  @media (min-width: 64rem) { .cartes > li { grid-column: span 4; } }

  .technique { padding-block: var(--serre); }
  .continuer { padding-block: var(--serre); }
  @media (min-width: 48rem) { .continuer__liste { grid-column: 1 / span 8; } }
</style>
