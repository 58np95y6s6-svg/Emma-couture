---
/**
 * /creations/<slug>/ — la fiche d'une création. Page de conversion.
 *
 * Deux appels à l'action : WhatsApp (avec l'URL absolue de la fiche dans le
 * message, pour que l'aperçu affiche la photo) et le formulaire de devis
 * pré-rempli. Maillage vers les occasions, la catégorie (fil d'Ariane) et le
 * sur-mesure (appel final).
 *
 * Présentation « fiche produit » (demande client : les codes d'une boutique,
 * sans panier, sans quantité, sans stock, sans avis inventés) :
 *   fil d'Ariane ;
 *   photo principale col. 1-6 (+ vignettes cliquables si data.photos) ;
 *   col. 8-12, collante sur grand écran : catégorie, H1, prix, accroche,
 *   personnalisation, délai, « Commander sur WhatsApp », « Demander un
 *   devis », réassurance, mention « sur commande » ;
 *   puis Description + Livraison et délais (6/6), « Vous aimerez aussi »
 *   (rangée) et l'appel final.
 *
 * Sur téléphone, une barre d'action fixe en bas d'écran reprend les deux
 * appels, uniquement quand ni les boutons de la fiche ni l'appel final ne
 * sont à l'écran ; elle remplace le bouton WhatsApp flottant du gabarit.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import FilAriane from '../../components/FilAriane.astro';
import TeteSection from '../../components/TeteSection.astro';
import LigneFaits from '../../components/LigneFaits.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, ATELIER, OCCASIONS, LIBELLES, lienWhatsApp } from '../../config';


/** Libellés d'affichage. Les slugs viennent de src/content.config.ts. */
const NOM_CATEGORIE: Record<string, string> = {
  naissance: 'Naissance',
  'linge-de-bain': 'Linge de bain',
  vetements: 'Vêtements',
  couture: 'Couture',
  'decoration-ajouree': 'Dentelle libre',
  noel: 'Noël',
};

/** Forme utilisée dans une phrase : « Cette pièce convient pour une naissance… ». */
const NOM_OCCASION: Record<string, string> = {
  naissance: 'une naissance',
  mariage: 'un mariage',
  'fete-des-meres': 'la fête des mères',
  noel: 'Noël',
  anniversaire: 'un anniversaire',
  bapteme: 'un baptême',
  retraite: 'un départ en retraite',
};

/** Seules ces occasions ont une page : ne jamais lier vers une URL absente. */
const OCCASIONS_AVEC_PAGE = new Set<string>(OCCASIONS.map((o) => o.slug));

export const getStaticPaths: GetStaticPaths = async () => {
  const creations = await getCollection('creations', ({ data }) => !data.masquee);
  return creations.map((creation) => ({
    params: { slug: creation.id },
    props: { creation },
  }));
};

const { creation } = Astro.props;
const { data, id } = creation;
const { Content } = await render(creation);

/* Apostrophe typographique à l'affichage (le contenu garde l'apostrophe droite). */
const typo = (t: string) => t.replace(/'/g, '’');

/* « Vous aimerez aussi » : d'abord la même catégorie, puis le reste, jamais
   la pièce courante. */
const toutes = (await getCollection('creations', ({ data: d }) => !d.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const memeCategorie = toutes.filter((c) => c.id !== id && c.data.categorie === data.categorie);
const autres = [...memeCategorie, ...toutes.filter((c) => c.id !== id && !memeCategorie.includes(c))]
  .slice(0, 6);

const urlFiche = `/creations/${id}/`;
const urlAbsolue = new URL(urlFiche, SITE.url).href;

/* Accord du titre de page : « brodée » pour une trousse, « brodé » pour un
   cadre. Le genre se lit dans l'article ; un titre élidé est traité au masculin. */
const feminin = /^la\s/i.test(data.titre.trim());
const brode = feminin ? 'brodée' : 'brodé';

/* WhatsApp : l'URL de la fiche est jointe au message. C'est l'aperçu Open
   Graph du lien qui porte la photo — wa.me n'accepte aucune pièce jointe. */
const messageWa = `Bonjour Emma, j'ai vu « ${data.titre} » sur votre site et j'aimerais un modèle similaire.`;
const wa = lienWhatsApp(messageWa, urlAbsolue);
const devis = `/contact/?creation=${id}#devis`;

/* Image de partage 1200×630 dérivée de la photo de la création : c'est elle
   qui s'affiche dans l'aperçu WhatsApp. Largeur plafonnée à celle du
   fichier source : on ne fabrique pas de pixels. */
const ogLargeur = Math.min(1200, data.photo.width);
const og = await getImage({
  src: data.photo,
  width: ogLargeur,
  height: Math.round((ogLargeur * 630) / 1200),
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

const categorieNom = NOM_CATEGORIE[data.categorie] ?? data.categorie;
const occasions = data.occasions.map((o) => ({
  nom: NOM_OCCASION[o] ?? o,
  lien: OCCASIONS_AVEC_PAGE.has(o) ? `/cadeaux/${o}/` : null,
}));

/* Données structurées. Aucune note, aucun avis : rien d'inventé. */
const produit: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.titre,
  description: data.accroche,
  image: [new URL(og.src, SITE.url).href],
  url: urlAbsolue,
  category: categorieNom,
  brand: { '@type': 'Brand', name: SITE.nom },
  ...(data.prixDepart
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'EUR',
          price: data.prixDepart,
          /* « À partir de » : le prix plancher, motif et support à confirmer. */
          availability:
            ATELIER.commandes === 'ouvertes'
              ? 'https://schema.org/InStock'
              : 'https://schema.org/PreOrder',
          itemCondition: 'https://schema.org/NewCondition',
          url: urlAbsolue,
          seller: { '@id': `${SITE.url}/#atelier` },
        },
      }
    : {}),
};

const titre = `${data.titre} — ${brode} à ${SITE.ville} (35) | ${SITE.nom}`;
const description = `${data.accroche} ${
  data.prixDepart ? `À partir de ${data.prixDepart} €. ` : ''
}${brode[0].toUpperCase()}${brode.slice(1)} à ${SITE.ville} en ${
  SITE.departement
}, motif validé avant broderie, envoi partout en France.`;

const icoWa =
  'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-1.5 0-3.9-1.2-5.6-3S7 10.4 7 9.3c0-.8.5-1.6 1-1.9.3-.2.9-.2 1.1.1l.9 1.5c.1.3.1.5-.1.8l-.4.5c-.2.2-.2.4 0 .7.4.7 1.7 2 2.5 2.3.3.1.5.1.7-.1l.6-.6c.2-.2.5-.3.7-.2l1.6.8c.4.2.5.6.4.9Z';

const fil = [
  { nom: 'Créations', url: '/creations/' },
  { nom: categorieNom, url: `/creations/${data.categorie}/` },
  { nom: typo(data.titre), url: urlFiche },
];

/* Ce que la cliente choisit. Uniquement des options réellement proposées
   (d'après les textes du site) : rien d'inventé.
   ⚠️ [À CONFIRMER PAR EMMA] la liste par catégorie. */
const PERSO: Record<string, string[]> = {
  naissance: [
    'Le prénom',
    'Les informations de naissance : date, heure, poids et taille',
    'La couleur du fil',
    'Le style d’écriture',
  ],
  'linge-de-bain': ['Le prénom', 'La couleur du linge', 'La couleur du fil', 'Le style d’écriture'],
  vetements: ['Le prénom, l’initiale ou le motif', 'L’emplacement de la broderie', 'La couleur du fil'],
  couture: [
    'Le tissu : parmi mes coupons, ou le vôtre',
    'Le prénom ou le texte brodé',
    'La couleur du fil',
    'Le style d’écriture',
  ],
  'decoration-ajouree': [
    'Le motif ou l’initiale',
    'La couleur du fil',
    'La présentation : sous cadre, à suspendre ou à coudre',
  ],
  noel: ['Le prénom de chacun', 'La couleur du fil', 'Le style d’écriture'],
};
const personnalisation = PERSO[data.categorie] ?? ['Le prénom ou le texte brodé', 'La couleur du fil'];

/* Réassurance, sous les boutons. */
const faits = ['Motif validé avant broderie', 'Emballage cadeau compris', 'Remise à Vitré ou Rennes, ou envoi'];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil} flottant={false} messageWa={messageWa}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix, délais, numéro WhatsApp et e-mail sont provisoires (src/config.ts
    et src/content/creations/). Vocabulaire : broderie MACHINE.
  */}

  <script type="application/ld+json" set:html={JSON.stringify(produit)} />

  <!-- ===================== FICHE PRODUIT ===================== -->
  <div class="bande fiche">
    <div class="grille">
      <div class="fiche__fil"><FilAriane fil={fil} /></div>

      <div class="fiche__galerie">
        <figure class="fiche__photo" data-vue="0">
          <Image
            src={data.photo}
            alt={data.alt}
            widths={[400, 640, 880, 1000]}
            sizes="(max-width: 48rem) 92vw, 45vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        {data.photos.map((p, i) => (
          <figure class="fiche__photo" data-vue={i + 1} hidden>
            <Image
              src={p}
              alt={`${typo(data.titre)}, vue ${i + 2}`}
              widths={[400, 640, 880, 1000]}
              sizes="(max-width: 48rem) 92vw, 45vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
        {
          data.photos.length > 0 && (
            <ul class="fiche__vignettes" aria-label="Choisir une vue">
              {[data.photo, ...data.photos].map((p, i) => (
                <li>
                  <button type="button" class="fiche__vignette" data-vue={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Vue ${i + 1}`}>
                    <Image src={p} alt="" widths={[120, 240]} sizes="5rem" loading="lazy" decoding="async" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class={`fiche__infos fiche__infos--${data.categorie}`}>
        <p class="fiche__cat mono"><a href={`/creations/${data.categorie}/`}>{categorieNom}</a></p>
        <h1>{typo(data.titre)}</h1>
        {/* ⚠️ Prix d'exemple, à valider par Emma (repli de l'admin). */}
        <p class="prix fiche__prix" data-reglage-creation={id}>
          {data.prixDepart ? <>dès <b>{data.prixDepart}&nbsp;€</b></> : <b>Prix sur devis</b>}
        </p>
        <p class="fiche__accroche">{data.accroche}</p>

        <div class="fiche__perso">
          <h2 class="fiche__h">Personnalisation</h2>
          <p class="fiche__note">Vous choisissez&nbsp;:</p>
          <ul class="fiche__liste">
            {personnalisation.map((x) => <li>{x}</li>)}
          </ul>
        </div>

        {/* ⚠️ Délai d'exemple, à valider par Emma. */}
        {data.delaiJours && (
          <p class="fiche__delai">
            <span class="mono">Réalisation</span> {data.delaiJours}&nbsp;jours ouvrés après validation du motif
          </p>
        )}

        <p class="fiche__actions">
          <a class="btn btn--wa btn--grand" href={wa}>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icoWa} /></svg>
            {LIBELLES.commander}
          </a>
          <a class="btn btn--creux btn--grand" href={devis}>{LIBELLES.devis}</a>
        </p>

        <LigneFaits faits={faits} />
        {/* [À CONFIRMER PAR EMMA] modalités de paiement. */}
        <p class="fiche__mention">Pièce réalisée sur commande. Le paiement se fait après validation du motif.</p>
      </div>
    </div>
  </div>

  <!-- ===================== DESCRIPTION + LIVRAISON ===================== -->
  <section class="bande infos loin" aria-label="Description, livraison et délais">
    <div class="grille">
      <div class="infos__bloc">
        <h2 class="fiche__h">Description</h2>
        <div class="infos__texte">
          <Content />
          {
            occasions.length > 0 && (
              <p>
                Cette pièce convient pour{' '}
                {occasions.map((o, i) => (
                  <>
                    {i > 0 && (i === occasions.length - 1 ? ' et ' : ', ')}
                    {o.lien ? <a href={o.lien}>{o.nom}</a> : o.nom}
                  </>
                ))}
                .
              </p>
            )
          }
        </div>
      </div>
      <div class="infos__bloc">
        <h2 class="fiche__h">Livraison et délais</h2>
        <div class="infos__texte">
          <p>
            Je vous soumets le motif avant toute broderie. Une fois validé, la pièce est réalisée
            {data.delaiJours ? <> en {data.delaiJours}&nbsp;jours ouvrés environ</> : ' dans le délai convenu ensemble'}.
          </p>
          <p>
            Elle vous est remise en main propre à {SITE.ville} ou à Rennes, sur rendez-vous, ou envoyée
            partout en France, emballée et prête à offrir.
          </p>
          <p><a href="/sur-mesure/">Le déroulement d’une commande</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== VOUS AIMEREZ AUSSI ===================== -->
  {
    autres.length > 0 && (
      <section class="bande suite loin">
        <TeteSection titre="Vous aimerez aussi" variante="duo">
          <a slot="lien" class="lien-fleche" href="/creations/">Toutes les créations</a>
        </TeteSection>
        <div class="rangee" tabindex="0" role="region" aria-label="Vous aimerez aussi, rangée défilante">
          {autres.map((c) => (
            <CarteCreation creation={c} tailles="(max-width: 40rem) 74vw, (max-width: 64rem) 42vw, 24rem" />
          ))}
        </div>
      </section>
    )
  }

  <AppelFinal titre="Une question sur cette pièce" messageWa={`${messageWa} ${urlAbsolue}`} lienDevis={devis}>
    <p>
      Indiquez-moi le prénom, la couleur et la date souhaitée. Je vous réponds avec une proposition,
      un prix et un délai, sans engagement de votre part.
    </p>
  </AppelFinal>

  <!-- ===================== BARRE D'ACTION (téléphone) =====================
       Fixe en bas d'écran, affichée seulement quand ni les boutons de la
       fiche ni l'appel final ne sont visibles. Sans JavaScript, elle reste
       masquée : les boutons de la fiche et l'appel final suffisent. -->
  <div class="barre-action" data-visible="false">
    <p class="barre-action__prix mono" aria-hidden="true">
      {data.prixDepart ? <>dès <b>{data.prixDepart}&nbsp;€</b></> : <b>sur devis</b>}
    </p>
    <a class="btn btn--wa" href={wa} tabindex="-1">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icoWa} /></svg>
      <span class="barre-action__long">{LIBELLES.commander}</span><span class="barre-action__court">Commander</span>
    </a>
    <a class="btn btn--creux" href={devis} tabindex="-1">{LIBELLES.devis}</a>
  </div>
</Base>

<script>
  /* Vignettes : affichent la vue choisie dans le grand cadre. */
  const vignettes = document.querySelectorAll<HTMLButtonElement>('.fiche__vignette');
  const vues = document.querySelectorAll<HTMLElement>('.fiche__photo');
  vignettes.forEach((b) =>
    b.addEventListener('click', () => {
      const n = b.dataset.vue;
      vues.forEach((v) => (v.hidden = v.dataset.vue !== n));
      vignettes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );

  /* La barre n'apparaît qu'entre les boutons de la fiche et l'appel final. */
  const barre = document.querySelector<HTMLElement>('.barre-action');
  const haut = document.querySelector('.fiche__actions');
  const fin = document.querySelector('.final');
  if (barre && haut && fin && 'IntersectionObserver' in window) {
    let hautVisible = true;
    let finAtteinte = false;
    const liens = barre.querySelectorAll('a');
    const maj = () => {
      /* Boutons de la fiche encore en dessous (pas encore atteints) : la barre peut s'afficher. */
      const visible = !hautVisible && !finAtteinte;
      barre.dataset.visible = String(visible);
      /* Masquée = hors de l'ordre de tabulation. */
      liens.forEach((a) => (visible ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
    };
    new IntersectionObserver(([e]) => {
      hautVisible = e.isIntersecting;
      maj();
    }).observe(haut);
    new IntersectionObserver(([e]) => {
      /* Visible, ou déjà dépassé (on lit le pied de page). */
      finAtteinte = e.isIntersecting || e.boundingClientRect.top < 0;
      maj();
    }).observe(fin);
  }
</script>

<style>
  /* ============================ FICHE PRODUIT ============================ */
  .fiche { padding-block: clamp(1rem, 2vw, 1.5rem) var(--serre); }
  .fiche .grille { row-gap: 1.5rem; align-items: start; }
  .fiche__fil { grid-column: 1 / -1; }

  .fiche__galerie { display: grid; gap: 0.75rem; }
  .fiche__photo { border-radius: var(--r-l); overflow: hidden; aspect-ratio: 4 / 5; background: var(--papier-2); }
  .fiche__photo[hidden] { display: none; }
  .fiche__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fiche__vignettes { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fiche__vignette {
    width: 4.5rem; aspect-ratio: 1; padding: 0;
    border: 3px solid transparent; border-radius: var(--r-s); overflow: hidden;
    background: var(--papier-2); cursor: pointer;
  }
  .fiche__vignette[aria-pressed='true'] { border-color: var(--prune); }
  .fiche__vignette :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* La fiche d'achat : un grand bloc à la couleur de la catégorie, comme la
     carte produit (global.css § 9). */
  .fiche__infos {
    --c: var(--rose); --c-texte: var(--encre);
    display: grid; gap: 1.1rem; align-content: start; justify-items: start;
    padding: clamp(24px, 3.5vw, 48px);
    border-radius: var(--r-l);
    background: var(--c); color: var(--c-texte);
  }
  .fiche__infos--linge-de-bain { --c: var(--menthe); }
  .fiche__infos--vetements, .fiche__infos--couture { --c: var(--bleu); }
  .fiche__infos--decoration-ajouree { --c: var(--beurre); }
  .fiche__infos--noel { --c: var(--prune); --c-texte: #fff; }
  .fiche__infos--noel :global(.btn--wa) { --fond: #fff; --bord: #fff; --texte: var(--prune); --survol: var(--beurre); --survol-texte: var(--encre); }
  .fiche__infos--noel :global(.btn--creux) { --texte: #fff; --bord: #fff; --survol: #fff; --survol-texte: var(--prune); }
  .fiche__infos--noel :global(:focus-visible) { outline-color: #fff; }
  .fiche__infos :global(.faits) { color: inherit; }

  .fiche__cat { font-size: var(--t-micro); }
  .fiche__cat a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: 4px; }
  .fiche__infos h1 { text-wrap: balance; max-width: 14ch; }
  .fiche__prix, .fiche__prix :global(b) { color: inherit; }
  .fiche__prix { font-size: var(--t-petit); }
  .fiche__prix b { font-size: 2.4em; line-height: 1; }
  .fiche__accroche { font-size: var(--t-chapo); max-width: 34rem; }

  .fiche__perso { width: 100%; display: grid; gap: 0.4rem; padding-block-start: 1rem; border-block-start: 1px solid color-mix(in oklab, currentColor 22%, transparent); }
  .fiche__h { font-size: var(--t-h3); }
  .fiche__note { font-size: var(--t-petit); }
  .fiche__liste { display: grid; gap: 0.25rem; padding-inline-start: 1.2rem; list-style: disc; font-size: var(--t-petit); }
  .fiche__delai { font-size: var(--t-petit); }
  .fiche__delai .mono { font-size: var(--t-micro); margin-inline-end: 0.4em; }

  .fiche__actions { width: 100%; display: grid; gap: 0.6rem; }
  .fiche__actions .btn { width: 100%; justify-content: center; }
  .fiche__mention { font-size: var(--t-petit); }

  @media (min-width: 48rem) {
    .fiche__galerie { grid-column: 1 / span 6; }
    .fiche__infos { grid-column: 8 / -1; }
  }
  @media (min-width: 64rem) {
    .fiche__infos { position: sticky; top: 6.5rem; }
  }

  /* ============================ DESCRIPTION + LIVRAISON (6/6) ============================ */
  .infos { padding-block: var(--serre); }
  .infos .grille { row-gap: 2.5rem; }
  .infos__bloc { display: grid; gap: 1rem; align-content: start; }
  .infos__bloc + .infos__bloc { padding: clamp(24px, 3.5vw, 40px); border-radius: var(--r-l); background: var(--papier-2); }
  @media (min-width: 48rem) { .infos__bloc:first-child { padding-block-start: clamp(24px, 3.5vw, 40px); } }
  .infos__texte { color: var(--encre-doux); max-width: var(--mesure); }
  .infos__texte :global(p + p) { margin-block-start: 0.8em; }
  .infos__texte a { color: var(--encre); }
  @media (min-width: 48rem) {
    .infos__bloc:first-child { grid-column: 1 / span 6; }
    .infos__bloc:last-child { grid-column: 8 / -1; }
  }

  .suite { padding-block: var(--serre) var(--respire); }

  /* ============================ BARRE D'ACTION ============================ */
  .barre-action {
    position: fixed; inset-inline: 0; inset-block-end: 0; z-index: 80;
    display: grid;
    grid-template-columns: auto minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center; gap: 0.5rem;
    padding: 0.6rem max(var(--marge), env(safe-area-inset-right)) calc(0.6rem + env(safe-area-inset-bottom)) max(var(--marge), env(safe-area-inset-left));
    background: color-mix(in oklab, var(--papier) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-start: 1px solid color-mix(in oklab, var(--encre) 18%, transparent);
    transition: transform 300ms var(--sortie), visibility 300ms;
