---
/**
 * /creations/<slug>/ — la fiche d'une création. Page de conversion.
 *
 * Deux appels à l'action : WhatsApp (avec l'URL absolue de la fiche dans le
 * message, pour que l'aperçu affiche la photo) et le formulaire de devis
 * pré-rempli. Maillage vers la catégorie, les occasions et le sur-mesure.
 *
 * Mise en page : HautDePage (texte col. 1-7, photo col. 8-12), puis le texte
 * de la pièce (col. 1-6) et ses liens (col. 8-12), le déroulement (Etapes),
 * les autres pièces en rangée et l'appel final.
 *
 * Sur téléphone, une barre d'action collante en bas d'écran reprend les deux
 * appels dès que ceux du haut de page sortent de l'écran ; elle remplace le
 * bouton WhatsApp flottant du gabarit, masqué sur cette page.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import HautDePage from '../../components/HautDePage.astro';
import TeteSection from '../../components/TeteSection.astro';
import Etapes from '../../components/Etapes.astro';
import ListeLignes from '../../components/ListeLignes.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { SITE, ATELIER, OCCASIONS, lienWhatsApp } from '../../config';

/** Libellés d'affichage. Les slugs viennent de src/content.config.ts. */
const NOM_CATEGORIE: Record<string, string> = {
  naissance: 'Naissance',
  'linge-de-bain': 'Linge de bain',
  vetements: 'Vêtements',
  couture: 'Couture',
  'decoration-ajouree': 'Dentelle libre',
  noel: 'Noël',
};

const NOM_OCCASION: Record<string, string> = {
  naissance: 'Une naissance',
  mariage: 'Un mariage',
  'fete-des-meres': 'La fête des mères',
  noel: 'Noël',
  anniversaire: 'Un anniversaire',
  bapteme: 'Un baptême',
  retraite: 'Un départ en retraite',
};

/** Seules ces occasions ont une page : ne jamais lier vers une URL absente. */
const OCCASIONS_AVEC_PAGE = new Set(OCCASIONS.map((o) => o.slug));

export const getStaticPaths: GetStaticPaths = async () => {
  const creations = await getCollection('creations', ({ data }) => !data.masquee);
  return creations.map((creation) => ({
    params: { slug: creation.id },
    props: { creation },
  }));
};

const { creation } = Astro.props;
const { data, id } = creation;
const { Content } = await render(creation);

/* Les autres pièces : d'abord la même catégorie, complétée par le reste. */
const toutes = (await getCollection('creations', ({ data: d }) => !d.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const memeCategorie = toutes.filter((c) => c.id !== id && c.data.categorie === data.categorie);
const autres = [...memeCategorie, ...toutes.filter((c) => c.id !== id && !memeCategorie.includes(c))]
  .slice(0, 6);

const urlFiche = `/creations/${id}/`;
const urlAbsolue = new URL(urlFiche, SITE.url).href;

/* Accord du titre de page : « brodée » pour une trousse, « brodé » pour un
   cadre. Le genre se lit dans l'article ; un titre élidé est traité au masculin. */
const feminin = /^la\s/i.test(data.titre.trim());
const brode = feminin ? 'brodée' : 'brodé';

/* WhatsApp : l'URL de la fiche est jointe au message. C'est l'aperçu Open
   Graph du lien qui porte la photo — wa.me n'accepte aucune pièce jointe. */
const wa = lienWhatsApp(
  `Bonjour ${SITE.nom}, j'ai vu « ${data.titre} » sur votre site et j'aimerais un modèle similaire.`,
  urlAbsolue,
);
const devis = `/contact/?creation=${id}`;

/* Image de partage 1200×630 dérivée de la photo de la création : c'est elle
   qui s'affiche dans l'aperçu WhatsApp. Largeur plafonnée à celle du
   fichier source : on ne fabrique pas de pixels. */
const ogLargeur = Math.min(1200, data.photo.width);
const og = await getImage({
  src: data.photo,
  width: ogLargeur,
  height: Math.round((ogLargeur * 630) / 1200),
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

const categorieNom = NOM_CATEGORIE[data.categorie] ?? data.categorie;
const occasions = data.occasions.map((o) => ({
  slug: o,
  nom: NOM_OCCASION[o] ?? o,
  lien: OCCASIONS_AVEC_PAGE.has(o as (typeof OCCASIONS)[number]['slug']) ? `/cadeaux/${o}/` : null,
}));

/* Données structurées. Aucune note, aucun avis : rien d'inventé. */
const produit: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.titre,
  description: data.accroche,
  image: [new URL(og.src, SITE.url).href],
  url: urlAbsolue,
  category: categorieNom,
  brand: { '@type': 'Brand', name: SITE.nom },
  ...(data.prixDepart
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'EUR',
          price: data.prixDepart,
          /* « À partir de » : le prix plancher, motif et support à confirmer. */
          availability:
            ATELIER.commandes === 'ouvertes'
              ? 'https://schema.org/InStock'
              : 'https://schema.org/PreOrder',
          itemCondition: 'https://schema.org/NewCondition',
          url: urlAbsolue,
          seller: { '@id': `${SITE.url}/#atelier` },
        },
      }
    : {}),
};

const titre = `${data.titre} — ${brode} à ${SITE.ville} (35) | ${SITE.nom}`;
const description = `${data.accroche} ${
  data.prixDepart ? `À partir de ${data.prixDepart} €. ` : ''
}${brode[0].toUpperCase()}${brode.slice(1)} à ${SITE.ville} en ${
  SITE.departement
}, motif validé avant broderie, envoi partout en France.`;

const icoWa =
  'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-1.5 0-3.9-1.2-5.6-3S7 10.4 7 9.3c0-.8.5-1.6 1-1.9.3-.2.9-.2 1.1.1l.9 1.5c.1.3.1.5-.1.8l-.4.5c-.2.2-.2.4 0 .7.4.7 1.7 2 2.5 2.3.3.1.5.1.7-.1l.6-.6c.2-.2.5-.3.7-.2l1.6.8c.4.2.5.6.4.9Z';

const fil = [
  { nom: 'Créations', url: '/creations/' },
  { nom: categorieNom, url: `/creations/${data.categorie}/` },
  { nom: data.titre, url: urlFiche },
];

/* Un seul délai sur la fiche : la durée de réalisation de la pièce. Le délai
   actuel de l'atelier figure dans l'appel final.
   ⚠️ Prix et délais : exemples à valider par Emma (repli de l'admin). */
const faits = [
  ...(data.prixDepart ? [`À partir de ${data.prixDepart} €`] : ['Prix sur devis']),
  ...(data.delaiJours ? [`Réalisation : ${data.delaiJours} jours`] : []),
  data.cousuMain ? `Cousu main et brodé à ${SITE.ville}` : `Brodé à ${SITE.ville}`,
];

/* Liens utiles : les occasions qui ont une page, la catégorie, le sur-mesure. */
const liens = [
  ...occasions
    .filter((o) => o.lien)
    .map((o) => ({ titre: o.nom, href: o.lien as string })),
  { titre: `Toutes les pièces « ${categorieNom} »`, href: `/creations/${data.categorie}/` },
  { titre: "Le déroulement d'une commande", href: '/sur-mesure/' },
];
const occasionsSansPage = occasions.filter((o) => !o.lien).map((o) => o.nom.toLowerCase());
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil}>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix, délais, numéro WhatsApp et e-mail sont provisoires (src/config.ts
    et src/content/creations/). Vocabulaire : broderie MACHINE.
  */}

  <script type="application/ld+json" set:html={JSON.stringify(produit)} />

  <HautDePage titre={data.titre} fil={fil} image={data.photo} alt={data.alt} faits={faits}>
    <p>{data.accroche}</p>
    <a slot="actions" class="btn btn--wa btn--grand fiche__cta" href={wa}>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icoWa} /></svg>
      Je veux la même
    </a>
    <a slot="actions" class="btn btn--creux btn--grand" href={devis}>Demander un devis</a>
  </HautDePage>

  {
    data.photos.length > 0 && (
      <section class="bande vues" aria-label="Autres vues">
        <ul class="grille">
          {data.photos.map((p, i) => (
            <li>
              <Image
                src={p}
                alt={`${data.titre}, vue ${i + 2}`}
                widths={[320, 480, 620]}
                sizes="(max-width: 48rem) 46vw, 22vw"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ===================== LE TEXTE + LES LIENS ===================== -->
  <section class="bande detail">
    <div class="grille">
      <div class="detail__texte">
        <h2>À propos de cette pièce</h2>
        <div class="prose mesure">
          <Content />
        </div>
        <p class="detail__rassure">
          Motif soumis pour validation avant broderie. Emballage cadeau compris. {ATELIER.zones}.
        </p>
      </div>

      <aside class="detail__cote" aria-labelledby="cote-titre">
        <h3 id="cote-titre">Occasions et liens utiles</h3>
        {occasionsSansPage.length > 0 && (
          <p class="detail__occ">Elle convient aussi pour {occasionsSansPage.join(', ')}.</p>
        )}
        <ListeLignes lignes={liens} />
      </aside>
    </div>
  </section>

  <!-- ===================== DÉROULEMENT ===================== -->
  <section class="bande deroule loin">
    <TeteSection titre="Le déroulement d'une commande" />
    <Etapes
      etapes={[
        {
          titre: 'Votre demande',
          texte: "Indiquez-moi le prénom, la couleur souhaitée et la date. Le lien de cette fiche suffit pour que je sache de quelle pièce il s'agit.",
        },
        {
          titre: 'La validation du motif',
          texte: "Je vous envoie le motif et le prix définitif. Rien n'est brodé avant votre accord, et chaque détail peut être modifié jusque-là.",
          cle: true,
        },
        {
          titre: 'La remise',
          texte: `La pièce vous est remise en main propre à ${SITE.ville} ou à Rennes, ou envoyée soigneusement emballée partout en France.`,
        },
      ]}
    />
  </section>

  <!-- ===================== AUTRES PIÈCES ===================== -->
  {
    autres.length > 0 && (
      <section class="bande suite loin">
        <TeteSection titre="Autres créations" variante="duo">
          <a slot="lien" class="lien-fleche" href="/creations/">Toutes les créations</a>
        </TeteSection>
        <div class="rangee" tabindex="0" role="region" aria-label="Autres créations, rangée défilante">
          {autres.map((c) => (
            <CarteCreation creation={c} tailles="(max-width: 40rem) 74vw, (max-width: 64rem) 42vw, 24rem" />
          ))}
        </div>
      </section>
    )
  }

  <AppelFinal titre="Une question sur cette pièce" messageWa={`Bonjour ${SITE.nom}, j'ai vu « ${data.titre} » sur votre site et j'aimerais un modèle similaire. ${urlAbsolue}`} lienDevis={devis}>
    <p>
      Indiquez-moi le prénom, la couleur et la date souhaitée. Je vous réponds avec une proposition,
      un prix et un délai, sans engagement de votre part.
    </p>
  </AppelFinal>

  <!-- ===================== BARRE D'ACTION (téléphone) =====================
       Collante en bas d'écran tant que la page défile. Elle remplace le
       bouton flottant du gabarit. -->
  <div class="barre-action">
    <p class="barre-action__prix mono" aria-hidden="true">
      {data.prixDepart ? <>dès <b>{data.prixDepart}&nbsp;€</b></> : <b>sur devis</b>}
    </p>
    <a class="btn btn--wa" href={wa}>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icoWa} /></svg>
      Je veux la même
    </a>
    <a class="btn btn--creux" href={devis}>Devis</a>
  </div>
</Base>

<style>
  /* Le bouton flottant du gabarit est remplacé ici par la barre d'action. */
  :global(.flottant) { display: none !important; }
  /* La barre suit le bouton WhatsApp du haut de page : portée posée sur <main>. */
  :global(#contenu) { timeline-scope: --cta-fiche; }
  .fiche__cta { view-timeline: --cta-fiche block; }

  .vues { padding-block: 0 var(--serre); }
  .vues li { grid-column: span 6; }
  .vues li :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-m); }
  @media (min-width: 48rem) { .vues li { grid-column: span 3; } }

  /* ============================ DÉTAIL : col. 1-6 / 8-12 ============================ */
  .detail { padding-block: var(--serre); }
  .detail .grille { row-gap: 3rem; align-items: start; }
  .detail__texte, .detail__cote { display: grid; gap: 1.25rem; align-content: start; }
  .prose { display: grid; gap: 1.1rem; color: var(--encre-doux); }
  .prose :global(strong) { font-weight: 500; color: var(--encre); }
  .prose :global(ul), .prose :global(ol) { display: grid; gap: 0.4rem; padding-inline-start: 1.2rem; list-style: disc; }
  .detail__rassure, .detail__occ { font-size: var(--t-petit); color: var(--encre-doux); }
  @media (min-width: 48rem) {
    .detail__texte { grid-column: 1 / span 6; }
    .detail__cote { grid-column: 8 / -1; }
  }

  .deroule { padding-block: var(--serre); }
  .suite { padding-block: var(--serre) var(--respire); }

  /* ============================ BARRE D'ACTION ============================ */
  .barre-action {
    position: sticky; inset-block-end: 0; z-index: 80;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center; gap: 0.5rem;
    padding: 0.6rem max(var(--marge), env(safe-area-inset-right)) calc(0.6rem + env(safe-area-inset-bottom)) max(var(--marge), env(safe-area-inset-left));
    background: color-mix(in oklab, var(--lin-haut) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-start: 1px solid color-mix(in oklab, var(--encre) 18%, transparent);
  }
  .barre-action .btn { min-height: 3rem; padding: 0.5rem 0.9rem; white-space: nowrap; }
  .barre-action__prix { font-size: var(--t-micro); color: var(--gris); line-height: 1.1; }
  .barre-action__prix b { display: block; font-weight: 400; font-size: 1.2rem; color: var(--encre); }
  @media (max-width: 23rem) {
    .barre-action { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
    .barre-action__prix, .barre-action .ico { display: none; }
  }
  @media (min-width: 64rem) { .barre-action { display: none; } }

  /* La barre s'efface tant que le bouton du haut de page est à l'écran. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .barre-action { animation: barre-cta linear both; animation-timeline: --cta-fiche; animation-range: entry 0% exit 100%; }
    }
  }
  @keyframes barre-cta {
    0%, 100% { transform: none; visibility: visible; }
    12%, 88% { transform: translateY(110%); visibility: hidden; }
  }
</style>
