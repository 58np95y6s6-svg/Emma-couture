---
/**
 * /creations/<slug>/ — la fiche d'une création. Page de conversion.
 *
 * Deux appels à l'action : WhatsApp (avec l'URL absolue de la fiche dans le
 * message, pour que l'aperçu affiche la photo) et le formulaire de devis
 * pré-rempli. Maillage vers la catégorie, les occasions et le sur-mesure.
 *
 * Sur téléphone, une barre d'action collante en bas d'écran reprend les deux
 * appels dès que ceux du panneau sortent de l'écran ; elle remplace le bouton
 * WhatsApp flottant du gabarit, masqué sur cette page.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CarteCreation from '../../components/CarteCreation.astro';
import { SITE, ATELIER, OCCASIONS, lienWhatsApp } from '../../config';

/** Libellés d'affichage. Les slugs viennent de src/content.config.ts. */
const NOM_CATEGORIE: Record<string, string> = {
  naissance: 'Naissance',
  'linge-de-bain': 'Linge de bain',
  vetements: 'Vêtements',
  couture: 'Couture',
  'decoration-ajouree': 'Dentelle libre',
  noel: 'Noël',
};

const NOM_OCCASION: Record<string, string> = {
  naissance: 'Une naissance',
  mariage: 'Un mariage',
  'fete-des-meres': 'La fête des mères',
  noel: 'Noël',
  anniversaire: 'Un anniversaire',
  bapteme: 'Un baptême',
  retraite: 'Un départ en retraite',
};

/** Seules ces occasions ont une page : ne jamais lier vers une URL absente. */
const OCCASIONS_AVEC_PAGE = new Set(OCCASIONS.map((o) => o.slug));

export const getStaticPaths: GetStaticPaths = async () => {
  const creations = await getCollection('creations', ({ data }) => !data.masquee);
  return creations.map((creation) => ({
    params: { slug: creation.id },
    props: { creation },
  }));
};

const { creation } = Astro.props;
const { data, id } = creation;
const { Content } = await render(creation);

/* Les autres pièces : d'abord la même catégorie, complétée par le reste. */
const toutes = (await getCollection('creations', ({ data: d }) => !d.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const memeCategorie = toutes.filter((c) => c.id !== id && c.data.categorie === data.categorie);
const autres = [...memeCategorie, ...toutes.filter((c) => c.id !== id && !memeCategorie.includes(c))]
  .slice(0, 6);

const urlFiche = `/creations/${id}/`;
const urlAbsolue = new URL(urlFiche, SITE.url).href;

/* Accord : « la même » pour une trousse, « le même » pour un cadre. Le genre
   se lit dans l'article du titre ; un titre élidé est traité au masculin. */
const feminin = /^la\s/i.test(data.titre.trim());
const meme = feminin ? 'la même' : 'le même';
const brode = feminin ? 'brodée' : 'brodé';

/* WhatsApp : l'URL de la fiche est jointe au message. C'est l'aperçu Open
   Graph du lien qui porte la photo — wa.me n'accepte aucune pièce jointe. */
const wa = lienWhatsApp(
  `Bonjour ${SITE.nom}, j'ai vu « ${data.titre} » sur votre site et j'aimerais ${meme}.`,
  urlAbsolue,
);
const devis = `/contact/?creation=${id}`;

/* Image de partage 1200×630 dérivée de la photo de la création : c'est elle
   qui s'affiche dans l'aperçu WhatsApp. Largeur plafonnée à celle du
   fichier source : on ne fabrique pas de pixels. */
const ogLargeur = Math.min(1200, data.photo.width);
const og = await getImage({
  src: data.photo,
  width: ogLargeur,
  height: Math.round((ogLargeur * 630) / 1200),
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
});

const categorieNom = NOM_CATEGORIE[data.categorie] ?? data.categorie;
const occasions = data.occasions.map((o) => ({
  slug: o,
  nom: NOM_OCCASION[o] ?? o,
  lien: OCCASIONS_AVEC_PAGE.has(o as (typeof OCCASIONS)[number]['slug']) ? `/cadeaux/${o}/` : null,
}));

/* Données structurées. Aucune note, aucun avis : rien d'inventé. */
const produit: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.titre,
  description: data.accroche,
  image: [new URL(og.src, SITE.url).href],
  url: urlAbsolue,
  category: categorieNom,
  brand: { '@type': 'Brand', name: SITE.nom },
  ...(data.prixDepart
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'EUR',
          price: data.prixDepart,
          /* « À partir de » : le prix plancher, motif et support à confirmer. */
          availability:
            ATELIER.commandes === 'ouvertes'
              ? 'https://schema.org/InStock'
              : 'https://schema.org/PreOrder',
          itemCondition: 'https://schema.org/NewCondition',
          url: urlAbsolue,
          seller: { '@id': `${SITE.url}/#atelier` },
        },
      }
    : {}),
};

const titre = `${data.titre} — ${brode} à ${SITE.ville} (35) | ${SITE.nom}`;
const description = `${data.accroche} ${
  data.prixDepart ? `À partir de ${data.prixDepart} €. ` : ''
}${brode[0].toUpperCase()}${brode.slice(1)} à ${SITE.ville} en ${
  SITE.departement
}, motif validé avant broderie, envoi partout en France.`;

const icoWa =
  'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-1.5 0-3.9-1.2-5.6-3S7 10.4 7 9.3c0-.8.5-1.6 1-1.9.3-.2.9-.2 1.1.1l.9 1.5c.1.3.1.5-.1.8l-.4.5c-.2.2-.2.4 0 .7.4.7 1.7 2 2.5 2.3.3.1.5.1.7-.1l.6-.6c.2-.2.5-.3.7-.2l1.6.8c.4.2.5.6.4.9Z';
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[
    { nom: 'Créations', url: '/creations/' },
    { nom: categorieNom, url: `/creations/${data.categorie}/` },
    { nom: data.titre, url: urlFiche },
  ]}
>
  {/*
    ⚠️ CONTENU D'EXEMPLE
    Prix, délais, numéro WhatsApp et e-mail sont provisoires (src/config.ts
    et src/content/creations/). Vocabulaire : broderie MACHINE.
  */}

  <script type="application/ld+json" set:html={JSON.stringify(produit)} />

  <!-- ===================== FICHE ===================== -->
  <section class="bande fiche">
    <nav class="ariane fiche__ariane" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href="/creations/">Créations</a>
      <span aria-hidden="true">/</span>
      <a href={`/creations/${data.categorie}/`}>{categorieNom}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.titre}</span>
    </nav>

    <div class="fiche__photos">
      <figure class="fiche__grande">
        <Image
          src={data.photo}
          alt={data.alt}
          widths={[390, 620, 800, 1000]}
          sizes="(max-width: 64rem) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="fiche__ref mono">réf. {id}</figcaption>
      </figure>

      {
        data.photos.length > 0 && (
          <ul class="fiche__vues">
            {data.photos.map((p, i) => (
              <li>
                <Image
                  src={p}
                  alt={`${data.titre}, vue ${i + 2}`}
                  widths={[320, 480, 620]}
                  sizes="(max-width: 64rem) 45vw, 22vw"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="fiche__panneau">
      <div class="fiche__collant">
        <p class="fiche__cat">
          <a href={`/creations/${data.categorie}/`}>{categorieNom}</a>
          {data.cousuMain && <span>cousu main</span>}
        </p>

        <h1>{data.titre}</h1>
        <p class="chapo">{data.accroche}</p>

        {/* ⚠️ Prix et délais : exemples à valider par Emma (repli de l'admin). */}
        <dl class="tickets" data-reglage-creation={id}>
          {
            data.prixDepart && (
              <div class="ticket ticket--prix">
                <dt>à partir de</dt>
                <dd>{data.prixDepart}&nbsp;€</dd>
              </div>
            )
          }
          {
            data.delaiJours && (
              <div class="ticket">
                <dt>réalisation</dt>
                <dd>{data.delaiJours}&nbsp;jours ouvrés</dd>
              </div>
            )
          }
          <div class="ticket">
            <dt>délai de l'atelier</dt>
            <dd>{ATELIER.delaiActuel}</dd>
          </div>
          <div class="ticket">
            <dt>{data.cousuMain ? 'cousu et brodé à' : 'brodé à'}</dt>
            <dd>{SITE.ville}</dd>
          </div>
        </dl>

        <p class="actions fiche__actions">
          <a class="btn btn--wa btn--grand" href={wa}>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icoWa} /></svg>
            Je veux {meme}
          </a>
          <a class="btn btn--creux btn--grand" href={devis}>Demander un devis</a>
        </p>

        <ul class="fiche__rassure">
          <li>Motif soumis pour validation avant broderie</li>
          <li>Emballage cadeau compris</li>
          <li>{ATELIER.zones}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== LE TEXTE + LE MAILLAGE ===================== -->
  <section class="bande detail">
    <div class="detail__texte">
      <h2 class="detail__h2">À propos de cette pièce</h2>
      <div class="prose">
        <Content />
      </div>
    </div>

    <aside class="detail__cote" aria-label="Occasions et liens utiles">
      <h2 class="detail__h3">Pour quelle occasion</h2>
      {
        occasions.length > 0 ? (
          <ul class="detail__occ">
            {occasions.map((o) =>
              o.lien ? (
                <li>
                  <a href={o.lien}>{o.nom}</a>
                </li>
              ) : (
                <li>
                  <span>{o.nom}</span>
                </li>
              ),
            )}
          </ul>
        ) : (
          <p class="detail__vide">Elle convient à toutes les occasions.</p>
        )
      }
      <p class="detail__liens">
        <a class="lien-fleche" href="/sur-mesure/">Le déroulement d'une commande</a>
        <a class="lien-fleche" href={`/creations/${data.categorie}/`}>
          Toutes les pièces «&nbsp;{categorieNom}&nbsp;»
        </a>
      </p>
    </aside>
  </section>

  <!-- ===================== DÉROULEMENT : une vraie séquence ===================== -->
  <section class="bande tapis etapes-fiche loin">
    <h2 class="titre-xl">Le déroulement d'une commande</h2>
    <ol class="sequence">
      <li>
        <span class="mono">1</span>
        <h3>Votre demande</h3>
        <p>
          Indiquez-moi le prénom, la couleur souhaitée et la date. Le lien de cette fiche suffit
          pour que je sache de quelle pièce il s'agit.
        </p>
      </li>
      <li>
        <span class="mono">2</span>
        <h3>La validation du motif</h3>
        <p>
          Je vous envoie le motif et le prix définitif. Rien n'est brodé avant votre accord, et
          chaque détail peut être modifié jusque-là.
        </p>
      </li>
      <li>
        <span class="mono">3</span>
        <h3>La remise</h3>
        <p>
          La pièce vous est remise en main propre à {SITE.ville} ou à Rennes, ou envoyée
          soigneusement emballée partout en France.
        </p>
      </li>
    </ol>
    <p class="actions">
      <a class="btn btn--or" href={devis}>Demander un devis pour cette pièce</a>
    </p>
  </section>

  <!-- ===================== AUTRES PIÈCES ===================== -->
  {
    autres.length > 0 && (
      <section class="bande suite loin">
        <div class="suite__tete">
          <h2 class="titre-xl">Dans la même veine</h2>
          <a class="lien-fleche" href="/creations/">Toutes les créations</a>
        </div>

        <div class="rangee" tabindex="0" role="region" aria-label="Autres créations, rangée défilante">
          {autres.map((c) => (
            <CarteCreation creation={c} tailles="(max-width: 40rem) 74vw, (max-width: 64rem) 42vw, 24rem" />
          ))}
        </div>
      </section>
    )
  }

  <!-- ===================== BARRE D'ACTION (téléphone) =====================
       Collante en bas d'écran tant que la page défile, posée au-dessus du
       pied de page à la fin. Elle remplace le bouton flottant du gabarit. -->
  <div class="barre-action">
    <p class="barre-action__prix mono" aria-hidden="true">
      {data.prixDepart ? <>dès <b>{data.prixDepart}&nbsp;€</b></> : <b>sur devis</b>}
    </p>
    <a class="btn btn--wa barre-action__wa" href={wa}>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icoWa} /></svg>
      Je veux {meme}
    </a>
    <a class="btn btn--creux barre-action__devis" href={devis}>Devis</a>
  </div>
</Base>

<style>
  /* Le bouton flottant du gabarit est remplacé ici par la barre d'action. */
  :global(.flottant) { display: none !important; }
  /* La barre suit les CTA du panneau : la portée de leur timeline est posée
     sur <main>, ancêtre commun. */
  :global(#contenu) { timeline-scope: --cta-fiche; }

  /* ============================ FICHE ============================
     Téléphone : la photo prend toute la largeur, bord à bord.
     Ordinateur : la photo occupe la moitié gauche jusqu'au bord de l'écran,
     le panneau reste collé à droite pendant qu'on la parcourt. */
  .fiche {
    padding-block: 0 var(--serre);
    row-gap: clamp(1rem, 3vw, 2rem);
  }
  .fiche__ariane { min-width: 0; }
  .fiche__ariane [aria-current] {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%;
  }

  .fiche__photos { grid-column: bord-d / bord-f; display: grid; gap: 0.6rem; min-width: 0; }
  .fiche__grande { position: relative; overflow: hidden; background: var(--lin-bas); }
  .fiche__grande :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
  }
  .fiche__ref {
    position: absolute; inset-block-end: 0.8rem; inset-inline-start: 0.8rem;
    max-width: calc(100% - 1.6rem);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-s);
    background: color-mix(in oklab, var(--lin-haut) 86%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.75rem;
    color: var(--encre-doux);
  }
  .fiche__vues {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(8rem, 100%), 1fr));
    gap: 0.6rem;
    padding-inline: var(--marge);
  }
  .fiche__vues :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-s); }

  .fiche__panneau { min-width: 0; }
  .fiche__collant { display: grid; gap: clamp(0.9rem, 2vw, 1.3rem); justify-items: start; }
  .fiche__cat { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 1rem; font-family: var(--f-mono); font-size: var(--t-micro); }
  .fiche__cat a {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--coquelicot-fonce);
    text-underline-offset: 4px;
  }
  .fiche__cat span {
    padding: 0.25rem 0.6rem; border-radius: var(--r-s);
    border: 1px solid color-mix(in oklab, var(--encre) 25%, transparent);
    color: var(--encre-doux);
  }
  .fiche h1 { max-width: 14ch; font-size: clamp(2.8rem, 1.4rem + 5vw, 6.2rem); }
  .fiche .chapo { max-width: 32rem; }

  /* Les étiquettes : comme des tickets de fiche d'atelier, la valeur en grand. */
  .tickets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    max-width: 34rem;
    border: 1.5px dashed color-mix(in oklab, var(--encre) 32%, transparent);
    border-radius: var(--r-m);
    background: color-mix(in oklab, var(--papier) 60%, transparent);
  }
  .ticket { display: grid; gap: 0.15rem; padding: 0.85rem 1rem; min-width: 0; }
  .ticket:nth-child(even) { border-inline-start: 1px dashed color-mix(in oklab, var(--encre) 22%, transparent); }
  .ticket:nth-child(n + 3) { border-block-start: 1px dashed color-mix(in oklab, var(--encre) 22%, transparent); }
  .ticket dt { font-family: var(--f-mono); font-size: var(--t-micro); color: var(--gris); }
  .ticket dd {
    margin: 0;
    font-family: var(--f-titre);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.05;
    color: var(--encre);
  }
  .ticket--prix dd { font-size: clamp(2.1rem, 1.6rem + 2vw, 3.2rem); color: var(--coquelicot-fonce); }

  .fiche__actions { view-timeline: --cta-fiche block; width: 100%; }
  .fiche__actions .btn { flex: 1 1 13rem; }
  @media (min-width: 64rem) { .fiche__actions .btn { flex: 0 1 auto; } }
  .fiche__rassure {
    display: grid; gap: 0.35rem;
    font-size: var(--t-petit);
    color: var(--encre-doux);
    max-width: 32rem;
  }
  .fiche__rassure li { display: flex; gap: 0.7rem; align-items: baseline; }
  .fiche__rassure li::before {
    content: ''; flex: none;
    inline-size: 1.1rem; block-size: 2px;
    transform: translateY(-0.3em);
    background: repeating-linear-gradient(90deg, var(--coquelicot) 0 5px, transparent 5px 8px);
  }

  @media (min-width: 64rem) {
    .fiche {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.52))
        [mi] minmax(0, calc(var(--large) * 0.48))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      padding-block-start: 0;
      align-items: start;
    }
    .fiche__ariane { grid-column: mi / large-f; grid-row: 1; padding-inline-start: clamp(2rem, 4vw, 4.5rem); }
    .fiche__photos { grid-column: bord-d / mi; grid-row: 1 / span 2; }
    .fiche__grande { border-radius: 0 var(--r-l) var(--r-l) 0; }
    .fiche__grande :global(img) { max-height: calc(100svh - 5rem); min-height: 36rem; }
    .fiche__vues { padding-inline: var(--marge) 0; }
    .fiche__panneau { grid-column: mi / large-f; grid-row: 2; padding-inline-start: clamp(2rem, 4vw, 4.5rem); }
    .fiche__collant { position: sticky; top: 6.5rem; }
  }
  @media (min-width: 90rem) {
    .fiche__grande :global(img) { aspect-ratio: 5 / 5.4; }
  }

  /* ============================ DÉTAIL ============================ */
  .detail {
    padding-block: var(--serre);
    row-gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  .detail__texte { display: grid; gap: 1rem; }
  .detail__h2 { font-size: var(--t-h3); }
  .prose {
    display: grid; gap: 1.1rem;
    max-width: var(--mesure);
    font-size: var(--t-corps);
    line-height: 1.7;
    color: var(--encre-doux);
  }
  .prose :global(p) { text-wrap: pretty; }
  .prose :global(p:first-child) { font-size: var(--t-chapo); line-height: 1.45; color: var(--encre); }
  .prose :global(strong) { font-weight: 500; color: var(--encre); }
  .prose :global(ul), .prose :global(ol) { display: grid; gap: 0.5rem; padding-inline-start: 1.2rem; list-style: disc; }

  .detail__cote {
    display: grid; gap: 0.9rem; align-content: start;
    padding: clamp(1.3rem, 3vw, 2rem);
    border-radius: var(--r-l);
    background: var(--rose);
  }
  .detail__h3 { font-size: var(--t-h3); }
  .detail__occ { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .detail__occ a, .detail__occ span {
    display: inline-flex; align-items: center;
    min-height: 44px; padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: var(--t-petit);
    text-decoration: none;
    background: var(--lin-haut);
    color: var(--encre);
  }
  .detail__occ a:hover { background: var(--encre); color: var(--lin-haut); }
  .detail__occ span { background: transparent; border: 1px dashed color-mix(in oklab, var(--encre) 40%, transparent); }
  .detail__vide { font-size: var(--t-petit); }
  .detail__liens { display: grid; justify-items: start; }

  @media (min-width: 64rem) {
    .detail {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.58))
        [mi] minmax(0, calc(var(--large) * 0.42))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      align-items: start;
    }
    .detail__texte { grid-column: large-d / mi; padding-inline-end: 4rem; }
    .detail__cote { grid-column: mi / large-f; }
  }

  /* ============================ DÉROULEMENT ============================ */
  .etapes-fiche { padding-block: var(--serre); row-gap: clamp(2rem, 4vw, 3rem); }
  .etapes-fiche .titre-xl { max-width: 14ch; }
  .sequence {
    display: grid;
    border-block-start: 1.5px dashed color-mix(in oklab, var(--tapis-trait) 55%, transparent);
  }
  .sequence li {
    display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); column-gap: 0.8rem; row-gap: 0.4rem;
    padding-block: 1.3rem;
    border-block-end: 1px dashed color-mix(in oklab, var(--tapis-trait) 35%, transparent);
  }
  .sequence .mono { grid-row: span 2; font-size: 1rem; color: var(--rose); padding-block-start: 0.35rem; }
