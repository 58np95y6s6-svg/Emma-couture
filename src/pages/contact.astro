     ========================================================================== */

  /* --- Mise en page : une seule section ---------------------------------
     Téléphone : titre → formulaire → autres moyens (ordre du DOM).
     Ordinateur : titre et autres moyens à gauche, formulaire à droite,
     visible dès l'arrivée sans défiler. */
  .ct {
    padding-block: clamp(0.5rem, 2vw, 1.5rem) var(--respire);
    row-gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .ct {
      grid-template-columns:
        [bord-d] minmax(var(--marge), 1fr)
        [large-d] minmax(0, calc(var(--large) * 0.4)) [mi] minmax(0, calc(var(--large) * 0.6))
        [large-f] minmax(var(--marge), 1fr) [bord-f];
      grid-template-rows: auto auto 1fr;
    }
    .ct-ariane { grid-column: large-d / large-f; grid-row: 1; }
    .ct-tete { grid-column: large-d / mi; grid-row: 2; padding-inline-end: clamp(2rem, 4vw, 4rem); }
    .ct-aside { grid-column: large-d / mi; grid-row: 3; margin-inline-end: clamp(2rem, 4vw, 4rem); }
    .ct-form__hote { grid-column: mi / large-f; grid-row: 2 / span 2; }
  }

  /* --- Ouverture -------------------------------------------------------- */
  .ct-tete {
    display: grid;
    gap: clamp(1rem, 2vw, 1.4rem);
    justify-items: start;
  }
  .ct-tete h1 {
    font-size: clamp(2.9rem, 1.6rem + 4.4vw, 5.6rem);
    max-width: 11ch;
  }
  .ct-tete .chapo { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); }
  @media (min-width: 64rem) { .ct-tete__wa { display: none; } }

  /* --- Le formulaire : une fiche de commande ---------------------------- */
  .ct-alerte {
    font-size: var(--t-petit);
    background: color-mix(in oklab, var(--dore) 35%, var(--lin-haut));
    border-inline-start: 3px solid var(--coquelicot);
