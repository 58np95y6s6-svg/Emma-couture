---
/**
 * /contact/ — la page de conversion du site.
 *
 * Formulaire Netlify Forms (`name="demande"`), honeypot `bot-field`,
 * `action="/merci/"`. Tous les champs sont écrits dans le HTML statique :
 * Netlify les détecte au build.
 *
 * ⚠️ RÈGLE D'OR : le formulaire fonctionne SANS JavaScript. Le découpage en
 * quatre étapes est une amélioration progressive ajoutée par le script en bas
 * de page. Sans script, tous les groupes restent visibles, la validation
 * native du navigateur s'applique et l'envoi fonctionne.
 *
 * Pré-remplissage côté client (le site est statique) :
 *  - `?creation=<id>` : vignette de la pièce, champs cachés, type « catalogue »
 *    coché, occasion cochée si la pièce n'en a qu'une → on démarre à l'étape 2 ;
 *  - `?occasion=<slug>` : occasion cochée (liens des pages occasions).
 * Les vignettes sont pré-rendues dans un <template> (inerte : aucune image
 * n'est téléchargée tant qu'elle n'est pas clonée).
 *
 * ⚠️ MAQUETTE — numéro, e-mail, délais et fourchettes de budget provisoires.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import TeteSection from '../components/TeteSection.astro';
import ListeLignes from '../components/ListeLignes.astro';
import LigneFaits from '../components/LigneFaits.astro';
import { SITE, CONTACT, ATELIER, LIBELLES, lienWhatsApp, telephoneLisible } from '../config';

import ogSource from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const og = await getImage({ src: ogSource, format: 'webp', width: 1200 });

/* Les occasions proposées, avec le slug utilisé dans les URL du site. */
const OCCASIONS_FORM = [
  { slug: 'naissance', v: 'Une naissance' },
  { slug: 'mariage', v: 'Un mariage' },
  { slug: 'fete-des-meres', v: 'La fête des mères' },
  { slug: 'noel', v: 'Noël' },
  { slug: 'anniversaire', v: 'Un anniversaire' },
  { slug: 'bapteme', v: 'Un baptême' },
  { slug: 'retraite', v: 'Un départ, une retraite' },
  { slug: 'aucune', v: 'Pas d’occasion particulière' },
];

/* ---------------------------------------------------------------------------
   Les créations, pour le pré-remplissage depuis une fiche.
   On ne sérialise que le strict nécessaire.
--------------------------------------------------------------------------- */
const creations = (await getCollection('creations', ({ data }) => !data.masquee)).sort(
  (a, b) => a.data.ordre - b.data.ordre
);

const avecImage = await Promise.all(
  creations.map(async (c) => ({
    c,
    img: await getImage({ src: c.data.photo, format: 'webp', width: 600 }),
  }))
);

const indexCreations = Object.fromEntries(
  avecImage.map(({ c, img }) => [
    c.id,
    {
      titre: c.data.titre,
      url: `/creations/${c.id}/`,
      image: img.src,
      occasions: c.data.occasions ?? [],
    },
  ])
);

/* Fourchettes de budget. ⚠️ EXEMPLES indicatifs, à faire valider par Emma. */
const BUDGETS = [
  'Moins de 30 €',
  'Entre 30 et 50 €',
  'Entre 50 et 100 €',
  'Plus de 100 €',
  'Je ne sais pas encore',
];

/* Particuliers uniquement : pas d'option « logo de club ou d'entreprise ». */
const TYPES = [
  { v: 'Une pièce du catalogue', d: 'Doudou, drap de bain, cadre de naissance, chaussette de Noël…' },
  { v: 'Un vêtement ou du linge que je vous apporte', d: 'Sweat, polo, serviette, linge de maison' },
  { v: 'Un sac, une trousse ou un tablier à coudre', d: 'Cousu main, puis brodé' },
  { v: 'De la dentelle libre', d: 'Broderie sans tissu de support : arbre de vie, papillon, initiale' },
  { v: 'Je ne sais pas encore', d: 'Décrivez-moi votre idée, je vous ferai une proposition' },
];

const fil = [{ nom: 'Contact', url: '/contact/' }];
const titre = `Contact et devis · broderie personnalisée à ${SITE.ville} | ${SITE.nom}`;
const description = `Décrivez votre projet de broderie personnalisée ou de couture sur mesure en quatre étapes courtes : je vous réponds avec un prix et un délai. WhatsApp, e-mail ou téléphone. ${SITE.ville}, Rennes et toute la France.`;

const lieuRemise = `Je travaille à domicile et ne reçois pas de public : remise en main propre sur rendez-vous, dans un lieu public, à ${SITE.ville} ou à Rennes. Envoi soigné partout en France.`;

const autresMoyens = [
  { titre: 'WhatsApp', texte: LIBELLES.whatsapp, href: lienWhatsApp() },
  { titre: 'Téléphone', texte: telephoneLisible(), href: `tel:${CONTACT.telephone}` },
  { titre: 'E-mail', texte: CONTACT.email, href: `mailto:${CONTACT.email}` },
  { titre: 'Instagram', texte: `@${CONTACT.instagram}, où les pièces récentes sont publiées en premier`, href: CONTACT.instagramUrl },
];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil} flottant={false}>
  {/* Données de pré-remplissage : lues par le script en bas de page. */}
  <script
    type="application/json"
    id="ct-creations"
    is:inline
    set:html={JSON.stringify(indexCreations)}
  />

  {/* Vignettes pré-rendues. Un <template> est inerte : rien n'est téléchargé. */}
  <template id="ct-vignettes">
    {
      creations.map((c) => (
        <div data-creation={c.id}>
          <Image
            src={c.data.photo}
            alt={c.data.alt}
            widths={[180, 360]}
            sizes="96px"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </template>

  <HautDePage titre="Contact et demande de devis" fil={fil} fond="rose">
    <p>
      Quatre étapes courtes suffisent&nbsp;: je vous réponds avec un prix, un délai de réalisation
      et une proposition de motif.
    </p>
    <div class="ct-faits">
      <LigneFaits faits={[ATELIER.delaiReponse, `Délai actuel : ${ATELIER.delaiActuel}`, 'Sans engagement']} />
    </div>
    <p class="ct-wa"><a class="lien-fleche" href={lienWhatsApp()}>{LIBELLES.whatsapp}</a></p>

    {/* Grand écran : les autres moyens remplissent la colonne face au
        formulaire. Téléphone : ils passent sous le formulaire (section
        .ct-autres), pour que le formulaire suive directement le chapô. */}
    <div class="ct-coord">
      <p class="ct-coord__titre">Autres moyens de me joindre</p>
      <dl>
        <div><dt>Téléphone</dt><dd><a href={`tel:${CONTACT.telephone}`}>{telephoneLisible()}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
        <div><dt>Instagram</dt><dd><a href={CONTACT.instagramUrl} rel="me noopener" target="_blank">@{CONTACT.instagram}</a></dd></div>
        <div><dt>Remise</dt><dd>{lieuRemise}</dd></div>
      </dl>
      <p><a class="lien-fleche" href="/sur-mesure/#faq-titre">Questions fréquentes</a></p>
    </div>

    <!-- ===================== LE FORMULAIRE ===================== -->
    <div slot="aside" class="ct-hote" id="devis">
      {
        ATELIER.commandes !== 'ouvertes' && (
          <p class="ct-alerte">
            {ATELIER.commandes === 'conges'
              ? `Je suis en congés${ATELIER.retourLe ? ` jusqu’au ${ATELIER.retourLe}` : ''}. Vous pouvez néanmoins m’écrire : je vous répondrai à mon retour.`
              : 'Mon planning est actuellement complet. Vous pouvez néanmoins m’écrire : je vous indiquerai à partir de quelle date je peux réaliser votre commande.'}
          </p>
        )
      }

      <form
        class="ct-form"
        id="demande"
        name="demande"
        method="POST"
        action="/merci/"
        enctype="multipart/form-data"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        aria-label="Demande de devis"
      >
        {/* Netlify l'injecte au déploiement ; on l'écrit quand même, pour que
            l'envoi fonctionne à l'identique en local et en prévisualisation. */}
        <input type="hidden" name="form-name" value="demande" />

        {/* Anti-spam : champ leurre, masqué et retiré du parcours clavier. */}
        <p class="ct-leurre">
          <label for="bot-field">Ne remplissez pas ce champ</label>
          <input id="bot-field" type="text" name="bot-field" tabindex="-1" autocomplete="off" />
        </p>

        {/* Rattachement à une création, rempli par le script si ?creation=… */}
        <input type="hidden" name="creation_slug" value="" />
        <input type="hidden" name="creation_titre" value="" />
        <input type="hidden" name="creation_url" value="" />
        <input type="hidden" name="creation_image" value="" />

        <!-- Vignette de la pièce concernée -->
        <div class="ct-piece" id="ct-piece" hidden>
          <div class="ct-piece__img" id="ct-piece-img"></div>
          <div class="ct-piece__txt">
            <p class="ct-piece__quoi">Votre demande concerne</p>
            <p class="ct-piece__titre" id="ct-piece-titre"></p>
            <p class="ct-piece__liens">
              <a id="ct-piece-lien" href="/creations/">Voir la fiche</a>
              <button type="button" class="ct-piece__non" id="ct-piece-non">
                Ce n’est pas cette pièce
              </button>
            </p>
          </div>
        </div>

        <!-- Jauge d'avancement : révélée par le script uniquement -->
        <p class="ct-jauge" id="ct-jauge" hidden aria-live="polite"></p>

        <!-- ÉTAPE 1 — type de projet + occasion -->
        <div class="ct-pas" data-pas data-titre="Votre projet">
          <fieldset class="ct-champ" id="ct-type" tabindex="-1">
            <legend>Quel type de pièce souhaitez-vous&nbsp;?</legend>
            <div class="ct-options">
              {
                TYPES.map((t, i) => (
                  <label class="ct-opt">
                    <input
                      type="radio"
                      name="type_projet"
                      value={t.v}
                      required
                      id={i === 0 ? 'type-catalogue' : undefined}
                    />
                    <span class="ct-opt__nom">{t.v}</span>
                    <span class="ct-opt__d">{t.d}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="ct-champ" tabindex="-1">
            <legend>Pour quelle occasion&nbsp;?</legend>
            <div class="ct-options ct-options--serre">
              {
                OCCASIONS_FORM.map((o) => (
                  <label class="ct-opt ct-opt--court">
                    <input type="radio" name="occasion" value={o.v} data-slug={o.slug} required />
                    <span class="ct-opt__nom">{o.v}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <!-- ÉTAPE 2 — date + budget -->
        <div class="ct-pas" data-pas data-titre="Date et budget">
          <fieldset class="ct-champ" tabindex="-1">
            <legend>Pour quelle date&nbsp;?</legend>
            <p class="ct-ligne">
              <label for="date_souhaitee">Date à laquelle vous souhaitez recevoir la pièce</label>
              <input type="date" id="date_souhaitee" name="date_souhaitee" aria-describedby="note-date" />
              <span class="ct-note" id="note-date">
                Si elle est proche, indiquez-la tout de même&nbsp;: je vérifierai ce qui est
                réalisable.
              </span>
            </p>
            <label class="ct-case">
              <input type="checkbox" name="date_souple" value="Pas de date précise" />
              <span>Je n’ai pas de date précise</span>
            </label>
          </fieldset>

          <fieldset class="ct-champ" tabindex="-1">
            <legend>Quel budget envisagez-vous&nbsp;?</legend>
            <p class="ct-aide">Une indication sans engagement, pour vous proposer un support adapté.</p>
            <div class="ct-options ct-options--serre">
              {
                BUDGETS.map((b) => (
                  <label class="ct-opt ct-opt--court">
                    <input type="radio" name="budget" value={b} required />
                    <span class="ct-opt__nom">{b}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <!-- ÉTAPE 3 — texte à broder + photo d'inspiration -->
        <div class="ct-pas" data-pas data-titre="Le texte et l’inspiration">
          <fieldset class="ct-champ" tabindex="-1">
            <legend>Quel texte souhaitez-vous faire broder&nbsp;?</legend>
            <p class="ct-ligne">
              <label for="texte_broder">Texte à broder <span class="ct-facultatif">facultatif</span></label>
              <input
                type="text"
                id="texte_broder"
                name="texte_broder"
                maxlength="120"
                autocomplete="off"
                placeholder="Ambre, 16 janvier 2026, 3,85 kg"
                aria-describedby="note-texte"
              />
              <span class="ct-note" id="note-texte">Prénom, date, mesures ou courte phrase.</span>
            </p>
            <p class="ct-ligne">
              <label for="precisions">Précisions <span class="ct-facultatif">facultatif</span></label>
              <textarea
                id="precisions"
                name="precisions"
                rows="4"
                maxlength="2000"
                placeholder="Couleur du tissu et du fil, écriture cursive ou capitales, dimensions…"
              ></textarea>
            </p>
          </fieldset>

          <fieldset class="ct-champ" tabindex="-1">
            <legend>Une photo d’inspiration&nbsp;? <span class="ct-facultatif">facultatif</span></legend>
            <p class="ct-ligne">
              <label for="inspiration">Capture d’écran, dessin ou photo du vêtement à broder</label>
              <input type="file" id="inspiration" name="inspiration" accept="image/*" aria-describedby="note-photo" />
              <span class="ct-note" id="note-photo">
                Une seule photo, de moins de 8&nbsp;Mo. Vous pourrez aussi me l’envoyer ensuite sur
                WhatsApp.
              </span>
            </p>
          </fieldset>
        </div>

        <!-- ÉTAPE 4 — canal de réponse, puis coordonnées -->
        <div class="ct-pas" data-pas data-titre="Vos coordonnées">
          <fieldset class="ct-champ" tabindex="-1">
            <legend>Comment préférez-vous être recontacté·e&nbsp;?</legend>
            <div class="ct-options ct-options--trois">
              <label class="ct-opt ct-opt--court">
                <input type="radio" name="canal" value="WhatsApp" required />
                <span class="ct-opt__nom">WhatsApp</span>
              </label>
              <label class="ct-opt ct-opt--court">
                <input type="radio" name="canal" value="E-mail" required />
                <span class="ct-opt__nom">E-mail</span>
              </label>
              <label class="ct-opt ct-opt--court">
                <input type="radio" name="canal" value="Téléphone" required />
                <span class="ct-opt__nom">Téléphone</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="ct-champ" tabindex="-1">
            <legend>Vos coordonnées</legend>
            <div class="ct-duo">
              <p class="ct-ligne">
                <label for="prenom">Prénom <span class="ct-oblig">obligatoire</span></label>
                <input type="text" id="prenom" name="prenom" required autocomplete="given-name" maxlength="80" />
              </p>
              <p class="ct-ligne">
                <label for="telephone">
                  Téléphone <span class="ct-oblig" id="tel-oblig" hidden>obligatoire</span>
                </label>
                <input
                  type="tel"
                  id="telephone"
                  name="telephone"
                  autocomplete="tel"
                  inputmode="tel"
                  pattern="\+?[0-9 .]{9,19}"
                  maxlength="20"
                  aria-describedby="note-tel"
                />
                <span class="ct-note" id="note-tel">
                  Nécessaire pour une réponse par WhatsApp ou par téléphone.
                </span>
              </p>
              <p class="ct-ligne">
                <label for="email">Adresse e-mail <span class="ct-oblig" id="email-oblig">obligatoire</span><span class="ct-facultatif" id="email-facultatif" hidden>facultatif</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" />
              </p>
              <p class="ct-ligne">
                <label for="ville">Ville <span class="ct-facultatif">facultatif</span></label>
                <input
                  type="text"
                  id="ville"
                  name="ville"
                  autocomplete="address-level2"
                  maxlength="80"
                  placeholder="Vitré, Rennes…"
                />
              </p>
            </div>

            <label class="ct-case ct-case--large">
              <input type="checkbox" name="nouveautes" value="Oui" />
              <span>
                Je souhaite être prévenu·e des nouveautés et des dates limites de commande pour
                Noël, à raison de quelques messages par an.{' '}
                <a href="/politique-de-confidentialite/">Utilisation de mes données</a>
              </span>
            </label>
          </fieldset>
        </div>

        <!-- Envoi : toujours présent dans le HTML, donc utilisable sans JS -->
        <div class="ct-envoi" id="ct-envoi">
          <button type="submit" class="btn btn--wa btn--grand ct-envoi__btn">Envoyer ma demande</button>
          <p class="ct-rgpd">
            Vos réponses servent uniquement à traiter votre demande. Elles ne sont ni revendues ni
            transmises.{' '}
            <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
          </p>
        </div>

        <!-- Navigation par étapes : révélée par le script uniquement.
             « Suivant » est le premier dans le DOM : pleine largeur et en
             premier sur téléphone, à droite sur grand écran. -->
        <div class="ct-nav" id="ct-nav" hidden>
          <button type="button" class="btn btn--wa" id="ct-suiv">Suivant</button>
          <button type="button" class="btn btn--creux" id="ct-prec">Précédent</button>
        </div>
      </form>
    </div>
  </HautDePage>

  <!-- ===================== AUTRES MOYENS (téléphone et tablette portrait) ===================== -->
  <section class="bande ct-autres" aria-labelledby="ct-autres-titre">
    <TeteSection titre="Autres moyens de me joindre" id="ct-autres-titre">
      <p>Un simple message suffit aussi pour commencer. {lieuRemise}</p>
      <a slot="lien" class="lien-fleche" href="/sur-mesure/#faq-titre">Questions fréquentes</a>
    </TeteSection>
    <ListeLignes lignes={autresMoyens} />
  </section>
</Base>

<script>
  /* ==========================================================================
     /contact/ — amélioration progressive du formulaire.

     Tout ce qui suit est facultatif : sans ce script, tous les groupes du
     formulaire restent visibles, la validation native du navigateur s'applique
     et le bouton « Envoyer ma demande » fonctionne. Le script découpe le
     parcours en quatre étapes, rattache une création ou une occasion, et rend
     le téléphone obligatoire si l'on choisit WhatsApp ou le téléphone.
     ========================================================================== */

  const form = document.getElementById('demande') as HTMLFormElement | null;

  if (form) {
    type Fiche = { titre: string; url: string; image: string; occasions: string[] };
    type Champ = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    const brut = document.getElementById('ct-creations')?.textContent ?? '{}';
    let fiches: Record<string, Fiche> = {};
    try {
      fiches = JSON.parse(brut);
    } catch {
      fiches = {};
    }

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const bloc = $('ct-piece');
    const hoteImg = $('ct-piece-img');
    const hoteTitre = $('ct-piece-titre');
    const hoteLien = $<HTMLAnchorElement>('ct-piece-lien');
    const boutonNon = $('ct-piece-non');
    const modeles = $<HTMLTemplateElement>('ct-vignettes');
    const groupeType = $<HTMLFieldSetElement>('ct-type');
    const catalogue = $<HTMLInputElement>('type-catalogue');

    const champ = (nom: string) => form.querySelector<HTMLInputElement>(`input[name="${nom}"]`);
    const occasion = (slug: string) =>
      form.querySelector<HTMLInputElement>(`input[name="occasion"][data-slug="${CSS.escape(slug)}"]`);

    /* Ce que le script a coché lui-même, pour pouvoir le défaire. */
    let occasionAuto: HTMLInputElement | null = null;

    function rattache(slug: string, f: Fiche): boolean {
      champ('creation_slug')!.value = slug;
      champ('creation_titre')!.value = f.titre;
      champ('creation_url')!.value = new URL(f.url, location.origin).href;
      champ('creation_image')!.value = new URL(f.image, location.origin).href;

      if (hoteTitre) hoteTitre.textContent = f.titre;
      if (hoteLien) hoteLien.href = f.url;

      /* La vignette est clonée depuis le <template> : aucune image n'a été
         téléchargée avant ce moment. */
      const source = modeles?.content.querySelector(`[data-creation="${CSS.escape(slug)}"] img`);
      if (source && hoteImg) hoteImg.replaceChildren(source.cloneNode(true));
      if (bloc) bloc.hidden = false;

      /* Le type de projet est connu : coché, et la question disparaît. */
      if (catalogue) catalogue.checked = true;
      if (groupeType) groupeType.hidden = true;

      /* Une seule occasion pour la pièce : on la coche aussi. */
      if (f.occasions.length === 1 && !form.querySelector('input[name="occasion"]:checked')) {
        const o = occasion(f.occasions[0]);
        if (o) {
          o.checked = true;
          occasionAuto = o;
        }
      }
      return !!form.querySelector('input[name="occasion"]:checked');
    }

    function detache() {
      for (const nom of ['creation_slug', 'creation_titre', 'creation_url', 'creation_image']) {
        const c = champ(nom);
        if (c) c.value = '';
      }
      if (bloc) bloc.hidden = true;
      if (hoteImg) hoteImg.replaceChildren();
      if (catalogue) catalogue.checked = false;
      if (groupeType) groupeType.hidden = false;
      if (occasionAuto) occasionAuto.checked = false;
      occasionAuto = null;
      const url = new URL(location.href);
      url.searchParams.delete('creation');
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    }

    const params = new URLSearchParams(location.search);
    let depart = 0;

    const slugOccasion = params.get('occasion');
    if (slugOccasion) {
      const o = occasion(slugOccasion);
      if (o) o.checked = true;
    }

    const demande = params.get('creation');
    if (demande && Object.prototype.hasOwnProperty.call(fiches, demande)) {
      /* Type et occasion connus : on démarre à l'étape 2. */
      if (rattache(demande, fiches[demande])) depart = 1;
    }

    /* ----------------------------------------------------------------------
       Coordonnées selon le canal choisi :
       WhatsApp ou téléphone → téléphone obligatoire, e-mail facultatif ;
       e-mail (ou rien de choisi) → e-mail obligatoire.
       Sans JavaScript, l'e-mail reste obligatoire (attribut dans le HTML).
    ---------------------------------------------------------------------- */
    const tel = $<HTMLInputElement>('telephone');
    const telOblig = $('tel-oblig');
    const email = $<HTMLInputElement>('email');
    const emailOblig = $('email-oblig');
    const emailFacultatif = $('email-facultatif');
    function regleTelephone() {
      const canal = form.querySelector<HTMLInputElement>('input[name="canal"]:checked')?.value;
      const requis = canal === 'WhatsApp' || canal === 'Téléphone';
      if (tel) tel.required = requis;
      if (telOblig) telOblig.hidden = !requis;
      if (email) email.required = !requis;
      if (emailOblig) emailOblig.hidden = requis;
      if (emailFacultatif) emailFacultatif.hidden = !requis;
    }
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'canal') regleTelephone();
    });
    regleTelephone();

    /* Date : pas dans le passé. */
    const date = $<HTMLInputElement>('date_souhaitee');
    if (date) {
      const j = new Date();
      date.min = new Date(j.getTime() - j.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    }

    /* Photo : Netlify Forms refuse les fichiers de plus de 8 Mo. */
    const photo = $<HTMLInputElement>('inspiration');
    photo?.addEventListener('change', () => {
      const f = photo.files?.[0];
      photo.setCustomValidity(f && f.size > 8 * 1024 * 1024 ? 'Cette photo dépasse 8 Mo : choisissez-en une plus légère, ou envoyez-la ensuite sur WhatsApp.' : '');
    });

    /* ----------------------------------------------------------------------
       Découpage en étapes courtes
    ---------------------------------------------------------------------- */
    const pas = Array.from(form.querySelectorAll<HTMLElement>('[data-pas]'));
    const nav = $('ct-nav');
    const jauge = $('ct-jauge');
    const envoi = $('ct-envoi');
    const prec = $<HTMLButtonElement>('ct-prec');
    const suiv = $<HTMLButtonElement>('ct-suiv');

    if (pas.length > 1 && nav && jauge && envoi && prec && suiv) {
      /* À partir d'ici c'est nous qui validons : on coupe la validation
         native, sinon un champ requis dans une étape masquée bloquerait
         l'envoi sans message visible. */
      form.noValidate = true;
      form.classList.add('ct-form--etapes');
      nav.hidden = false;
      jauge.hidden = false;

      let courant = 0;
      const doux = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const defile = (el: Element) => el.scrollIntoView({ behavior: doux ? 'smooth' : 'auto', block: 'start' });

      function nettoie(etape: HTMLElement) {
        etape.querySelectorAll('.ct-err').forEach((z) => z.remove());
        for (const c of etape.querySelectorAll('[aria-invalid="true"]')) {
          c.removeAttribute('aria-invalid');
          c.removeAttribute('aria-errormessage');
        }
      }

      function message(c: Champ): string {
        if (c.type === 'radio') return 'Choisissez une réponse pour continuer.';
        if (c.name === 'telephone') {
          return c.validity.valueMissing
            ? 'Indiquez votre numéro de téléphone pour être recontacté·e par WhatsApp ou par téléphone.'
            : 'Ce numéro de téléphone n’a pas l’air complet.';
        }
        if (c.name === 'email') {
          return c.validity.valueMissing
            ? 'Indiquez votre adresse e-mail.'
            : 'Cette adresse e-mail n’a pas l’air valide.';
        }
        if (c.name === 'prenom') return 'Indiquez votre prénom.';
        if (c.name === 'date_souhaitee') return 'Choisissez une date à venir.';
        return c.validationMessage || 'Ce champ est à compléter.';
      }

      /** Valide une étape ; affiche le premier problème et y conduit. */
      function valide(etape: HTMLElement, conduire = true): boolean {
        nettoie(etape);
        const champs = Array.from(etape.querySelectorAll<Champ>('input, select, textarea')).filter(
          (c) => c.name !== 'bot-field' && c.type !== 'hidden' && !c.closest('fieldset[hidden]')
        );
        const vus = new Set<string>();
        for (const c of champs) {
          /* Pour un groupe de boutons radio, un seul passage suffit. */
          if (c.type === 'radio') {
            if (vus.has(c.name)) continue;
            vus.add(c.name);
          }
          if (c.checkValidity()) continue;

          const groupe = c.closest('fieldset')!;
          const z = document.createElement('p');
          z.className = 'ct-err';
          z.id = `ct-err-${c.name}`;
          z.setAttribute('role', 'alert');
          z.textContent = message(c);
          /* Sous la légende : le message, puis le champ. */
          groupe.querySelector('legend')!.after(z);
          const cibles = c.type === 'radio' ? etape.querySelectorAll<Champ>(`input[name="${c.name}"]`) : [c];
          cibles.forEach((x) => {
            x.setAttribute('aria-invalid', 'true');
            x.setAttribute('aria-errormessage', z.id);
          });
          if (conduire) {
            c.focus({ preventScroll: true });
            defile(groupe);
          }
          return false;
        }
        return true;
      }

      function affiche(i: number, focalise = true) {
        courant = Math.max(0, Math.min(i, pas.length - 1));
        pas.forEach((p, n) => {
          p.hidden = n !== courant;
        });
        const dernier = courant === pas.length - 1;
        prec.hidden = courant === 0;
        suiv.hidden = dernier;
        envoi.classList.toggle('ct-envoi--pret', dernier);
        jauge.textContent = `Étape ${courant + 1} sur ${pas.length} · ${pas[courant].dataset.titre ?? ''}`;
        jauge.style.setProperty('--part', String((courant + 1) / pas.length));

        if (focalise) {
          const cible = pas[courant].querySelector<HTMLElement>('fieldset:not([hidden])');
          cible?.focus({ preventScroll: true });
          const haut = form.getBoundingClientRect().top;
          if (haut < 0 || haut > window.innerHeight * 0.5) defile(form);
        }
      }

      suiv.addEventListener('click', () => {
        if (valide(pas[courant])) affiche(courant + 1);
      });
      prec.addEventListener('click', () => {
        nettoie(pas[courant]);
        affiche(courant - 1);
      });

      /* Une erreur s'efface dès que la réponse change. */
      form.addEventListener('change', (e) => {
        const c = e.target as Champ;
        if (c.getAttribute('aria-invalid') === 'true' || c.type === 'radio') {
          const groupe = c.closest('fieldset');
          if (groupe?.querySelector('.ct-err') && (c.type === 'radio' || c.checkValidity())) {
            groupe.querySelectorAll('.ct-err').forEach((z) => z.remove());
            groupe.querySelectorAll('[aria-invalid="true"]').forEach((x) => {
              x.removeAttribute('aria-invalid');
              x.removeAttribute('aria-errormessage');
            });
          }
        }
      });

      /* Entrée dans un champ texte fait avancer, pas envoyer. */
      form.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key !== 'Enter') return;
        const cible = ev.target as HTMLElement;
        if (cible.tagName === 'TEXTAREA' || cible.tagName === 'BUTTON') return;
        if (courant === pas.length - 1) return;
        ev.preventDefault();
        if (valide(pas[courant])) affiche(courant + 1);
      });

      /* Dernier filet : si un champ d'une étape est incomplet, on y retourne
         au lieu d'envoyer une demande inutilisable. */
      form.addEventListener('submit', (e) => {
        for (let i = 0; i < pas.length; i += 1) {
          if (!valide(pas[i], false)) {
            e.preventDefault();
            affiche(i, false);
            valide(pas[i]);
            return;
          }
        }
      });

      /* Ce n'est pas cette pièce : retour à la première question. */
      boutonNon?.addEventListener('click', () => {
        detache();
        nettoie(pas[courant]);
        affiche(0);
      });

      affiche(depart, false);
    } else {
      boutonNon?.addEventListener('click', detache);
    }
  }
</script>

<style>
  /* /contact/ — préfixe `ct-`. Chaque bloc masquable a sa règle [hidden]
