---
/**
 * /l-atelier/ — qui est Emma, son matériel, sa façon de travailler.
 *
 * Direction : c'est LA page du tapis de coupe. Le haut de page et la section
 * « sur la table » sont posés sur le tapis vert, avec ses graduations en
 * centimètres et sa ligne de coupe à 45°. C'est son vrai poste de travail.
 *
 * ⚠️ Emma travaille CHEZ ELLE. Aucune adresse, aucune invitation à passer,
 * aucun horaire d'ouverture sur cette page. Remise en main propre sur
 * rendez-vous, adresse communiquée seulement après accord.
 * ⚠️ Broderie MACHINE. « Cousu main » ne vaut que pour les sacs, trousses
 * et tabliers qu'elle confectionne.
 * ⚠️ Aucun chiffre biographique : depuis combien de temps elle brode,
 * combien de pièces, combien de bobines → [À COMPLÉTER] par Emma.
 */
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, CONTACT, ATELIER, lienWhatsApp } from '../config';

import portrait from '../assets/creations/galerie/emma-brodeuse-vitre-portrait.webp';
import bobines from '../assets/creations/bandeau/atelier-mur-bobines-fil-broderie-vitre.webp';
import machine from '../assets/creations/plein-ecran/machine-a-broder-en-cours-atelier-vitre.webp';
import machineDetail from '../assets/creations/detail/machine-a-broder-en-cours-atelier-vitre.webp';
import papillon from '../assets/creations/plein-ecran/papillon-brode-dentelle-ajouree-coquelicots.webp';
import arbre from '../assets/creations/galerie/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';
import sacBanane from '../assets/creations/detail/sac-banane-cousu-main-broderie-chats.webp';
import trousse from '../assets/creations/galerie/trousse-cousue-main-brodee-prenom-lisa.webp';
import ogSource from '../assets/creations/og/emma-brodeuse-vitre-portrait.webp';

const og = await getImage({ src: ogSource, format: 'webp', width: 1200 });

const titre = `L'atelier · broderie machine et couture à ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Brodeuse et couturière à ${SITE.ville} (35), je réalise seule chaque pièce : broderie machine personnalisée, dentelle libre, sacs et trousses cousus main. Le motif vous est soumis avant toute réalisation.`;

const wa = lienWhatsApp("Bonjour Emma, j'ai lu la page de l'atelier et j'ai une question.");

/* Les graduations du tapis : un chiffre tous les 5 cm, alignés sur le
   quadrillage de .tapis (même unité --cm). Purement décoratif. */
const graduations = Array.from({ length: 13 }, (_, i) => i * 5);

/* Ce qu'il y a sur la table. L'étiquette dit l'unité ou la référence
   qui compte pour chaque outil : c'est une information, pas un ornement. */
const outils = [
  {
    eti: 'densité de points',
    nom: 'La machine à broder',
    dire: "Elle suit un fichier que je prépare pour chaque motif. C'est dans ce fichier que se règle la densité des points, dont dépend la bonne tenue de la broderie au lavage.",
  },
  {
    eti: 'polyester 40',
    nom: 'Le fil',
    dire: "Brillant et résistant, il ne déteint pas. Les pièces brodées se lavent en machine à 30° sans que la broderie ne s'altère.",
  },
  {
    eti: 'en millimètres',
    nom: 'Les cadres',
    dire: "Le cadre détermine la taille maximale du motif. C'est pourquoi je vous demande toujours les dimensions exactes du support à broder.",
  },
  {
    eti: 'quadrillé au centimètre',
    nom: 'Le tapis de coupe',
    dire: "Celui qui sert de fond à cette page. J'y coupe les tissus des sacs, des trousses et des tabliers avant de les assembler.",
  },
];

/* La fabrication : une vraie séquence, donc numérotée. */
const chemin = [
  {
    nom: 'Votre message',
    dire: "Vous m'indiquez le prénom, l'occasion, la date souhaitée et le support, avec une photo d'inspiration si vous en avez une. Je vous pose ensuite les questions utiles.",
  },
  {
    nom: 'La validation du motif',
    dire: "Je prépare l'écriture, la taille, l'emplacement et les couleurs de fil, puis je vous soumets le motif. Tant que la broderie n'est pas lancée, tout peut encore être ajusté.",
    fort: true,
  },
  {
    nom: 'La préparation',
    dire: 'Je tends le tissu dans le cadre et je choisis les fils. Le placement se règle au millimètre.',
  },
  {
    nom: 'La broderie',
    dire: "La machine brode le motif validé. Je reste à côté pendant toute la réalisation : un fil qui casse doit être repris immédiatement.",
  },
  {
    nom: 'Les finitions',
    dire: "Je coupe les fils, je retire le support et je repasse la pièce, puis je la prépare dans un emballage cadeau.",
  },
];
---

<Base
  titre={titre}
  description={description}
  imageOg={og.src}
  fil={[{ nom: "L'atelier", url: '/l-atelier/' }]}
>
  {/*
    ⚠️ CONTENU D'EXEMPLE — numéro, e-mail et délais provisoires (src/config.ts).
    [À COMPLÉTER] depuis combien de temps Emma brode : à afficher en réassurance
    une fois confirmé, jamais avant.
  */}

  <!-- ===================== HAUT DE PAGE : sur le tapis ===================== -->
  <section class="bande tapis at-ouv">
    <div class="at-regle plein" aria-hidden="true">
      {graduations.map((n) => <span>{n}</span>)}
    </div>
    <span class="at-coupe plein" aria-hidden="true"></span>

    <nav class="ariane at-ariane" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">L'atelier</span>
    </nav>

    <div class="at-ouv__dire">
      <h1>L'atelier de broderie et de couture, à {SITE.ville}</h1>
      <p class="chapo">
        Je suis Emma, brodeuse et couturière à {SITE.ville}, en Ille-et-Vilaine. Je réalise
        seule chaque pièce, en broderie machine personnalisée et en couture sur mesure&nbsp;:
        c'est moi qui réponds à vos messages, qui brode et qui emballe.
      </p>
      <p class="actions">
        <a class="btn btn--wa" href={wa}>Me poser une question</a>
        <a class="btn btn--creux" href="/creations/">Voir ce que je fais</a>
      </p>
    </div>

    <div class="at-ouv__poste">
      <figure class="at-tambour">
        <span class="at-tambour__vis" aria-hidden="true"></span>
        <Image
          src={portrait}
          alt="Emma, brodeuse et couturière à Vitré, à son poste de travail"
          widths={[320, 480, 640, 820]}
          sizes="(max-width: 64rem) 78vw, 30rem"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <p class="at-fiche mono">
        <span>poste de travail</span>
        <span>{SITE.ville} (35)</span>
        <span>broderie machine + couture</span>
      </p>
    </div>
  </section>

  <!-- ===================== BANDEAU BOBINES ===================== -->
  <div class="bandeau at-bandeau">
    <Image
      src={bobines}
      alt="Le mur de l'atelier, entièrement couvert de bobines de fil à broder rangées par couleur"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="bandeau__mot" aria-hidden="true">Le mur de bobines</p>
  </div>

  <!-- ===================== QUI JE SUIS ===================== -->
  <section class="bande at-moi">
    <h2 class="titre-xl">Une seule interlocutrice, du premier message à l'envoi</h2>
    <div class="at-moi__txt">
      <p class="at-moi__lead">
        Je travaille seule. Je lis vos messages, je choisis la bobine dans le mur de fils, je
        lance la machine et je prépare le paquet.
      </p>
      <p>
        Lorsque vous souhaitez savoir où en est votre commande, je peux vous répondre
        immédiatement. Si vous préférez une autre couleur de fil ou un prénom placé un peu plus
        haut, je modifie le motif directement, sans intermédiaire.
      </p>
      <p>
        Je réalise une pièce à la fois. Le délai de réalisation est actuellement de{' '}
        <b>{ATELIER.delaiActuel}</b>&nbsp;; si votre date est plus proche, je vous indique dès ma
        première réponse ce qu'il est possible de faire.
        {/* ⚠️ délai = exemple, piloté par l'admin */}
      </p>
    </div>
  </section>

  <!-- ===================== SUR LA TABLE : le tapis, encore ===================== -->
  <section class="bande tapis at-table" id="materiel">
    <div class="at-table__tete">
      <h2 class="titre-xl">Le matériel</h2>
      <figure class="at-table__fig devoile">
        <Image
          src={machine}
          alt="La tête de la machine à broder en pleine action : un cerisier en fleurs et un colibri se forment en fil de couleur sur le tissu tendu"
          widths={[480, 800, 1200]}
          sizes="(max-width: 64rem) 92vw, 36vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <ul class="at-outils">
      {
        outils.map((o) => (
          <li class="at-outil">
            <p class="at-outil__eti mono">{o.eti}</p>
            <h3>{o.nom}</h3>
            <p>{o.dire}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== LE CHEMIN D'UNE PIÈCE (vraie séquence) ===================== -->
  <section class="bande at-chemin" id="fabrication">
    <div class="at-chemin__tete">
      <h2 class="titre-xl">Les étapes de fabrication</h2>
      <p class="mesure">
        Chaque commande suit le même déroulement, de votre première demande à l'envoi de la pièce.
      </p>
      <figure class="at-chemin__fig" data-broderie="tambour">
        <Image
          src={machineDetail}
          alt="Gros plan sur le fil en cours de broderie : les points se superposent pour former un pétale"
          widths={[360, 560, 800]}
          sizes="(max-width: 64rem) 70vw, 22rem"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <ol class="at-gestes">
      {
        chemin.map((g) => (
          <li class:list={['at-geste', { 'at-geste--fort': g.fort }]}>
            <h3>{g.nom}</h3>
            <p>{g.dire}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ===================== LA DENTELLE LIBRE ===================== -->
  <section class="bande at-dentelle loin" id="dentelle">
    <h2 class="titre-geant at-dentelle__titre">La dentelle libre</h2>

    <div class="at-dentelle__dire">
      <p class="chapo">
        La machine brode sur un support soluble, qui disparaît au rinçage. Il ne reste que le
        fil&nbsp;: une pièce ajourée, sans tissu, qui tient d'elle-même.
      </p>
      <p class="mesure">
        C'est un travail exigeant à préparer&nbsp;: avec trop peu de points, la pièce s'affaisse,
        avec trop de points, elle gondole. C'est aussi la technique que je préfère, et celle que
        l'on rencontre le moins souvent.
      </p>
      <p class="actions">
        <a class="btn btn--creux" href="/creations/decoration-ajouree/">Voir les pièces ajourées</a>
      </p>
    </div>

    <figure class="at-dentelle__a">
      <Image
        src={papillon}
        alt="Papillon brodé en dentelle libre, ailes rouges et noires entièrement faites de fil, surmonté de coquelicots"
        widths={[480, 800, 1200]}
        sizes="(max-width: 64rem) 92vw, 44vw"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="at-dentelle__b">
      <Image
        src={arbre}
        alt="Arbre de vie brodé en dentelle ajourée fil doré, pièce autoportante sans support tissu"
        widths={[360, 560, 800]}
        sizes="(max-width: 64rem) 60vw, 22vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Arbre de vie en fil doré, sans support tissu</figcaption>
    </figure>
  </section>

  <!-- ===================== LA COUTURE ===================== -->
  <section class="bande at-couture loin" id="couture">
    <ul class="at-patron">
      <li>
        <Image
          src={sacBanane}
          alt="Sac banane cousu main en tissu imprimé, brodé d'un motif de chats"
          widths={[320, 520, 760]}
          sizes="(max-width: 40rem) 80vw, (max-width: 64rem) 44vw, 24vw"
          loading="lazy"
          decoding="async"
        />
        <span>Sac banane cousu, puis brodé</span>
      </li>
      <li>
        <Image
          src={trousse}
          alt="Trousse en tissu fleuri bleu et blanc, cousue main, brodée au prénom en fil doré"
          widths={[320, 520, 760]}
          sizes="(max-width: 40rem) 80vw, (max-width: 64rem) 44vw, 24vw"
          loading="lazy"
          decoding="async"
        />
        <span>Trousse brodée au prénom en fil doré</span>
      </li>
    </ul>

    <div class="at-couture__txt">
      <h2 class="titre-xl">La couture</h2>
      <p class="mesure">
        Les sacs, trousses, tabliers et bavoirs sont cousus main à l'atelier&nbsp;: je coupe le
        tissu, j'assemble la pièce, puis je la brode. Vous pouvez choisir parmi mes tissus ou me
        confier le vôtre, par exemple un drap de famille ou une chemise à transformer.
      </p>
      <p class="mesure">
        Les dimensions, la doublure, la fermeture et les poches se décident ensemble, avant la
        coupe.
      </p>
      <p class="actions">
        <a class="lien-fleche" href="/creations/couture/">Voir les sacs et les trousses</a>
      </p>
    </div>
  </section>

  <!-- ===================== OÙ ME TROUVER + APPEL FINAL ===================== -->
  <section class="final bande at-final" id="rendez-vous">
    <div class="at-final__dire">
      <h2 class="titre-xl">Retrait sur rendez-vous</h2>
      <p class="chapo">
        Mon atelier se trouve à mon domicile et n'est pas ouvert au public. Pour une remise en main
        propre, nous convenons ensemble d'un lieu et d'un horaire, à {SITE.ville} ou à Rennes&nbsp;;
        l'adresse précise vous est communiquée après accord. J'assure également un envoi soigné
        partout en France, sous emballage cadeau.
      </p>
      <p class="actions">
        <a class="btn btn--wa btn--grand" href={wa}>Écrire sur WhatsApp</a>
        <a class="btn btn--or btn--grand" href="/contact/#devis">Demander un devis</a>
      </p>
    </div>

    <dl class="at-final__liste">
      <div>
        <dt>en main propre</dt>
        <dd>
          <a href="/brodeuse-vitre/">{SITE.ville}</a> ou{' '}
          <a href="/broderie-personnalisee-rennes/">Rennes</a>, sur rendez-vous.
        </dd>
      </div>
      <div>
        <dt>par la poste</dt>
        <dd>Partout en France. Les frais d'envoi figurent dans le devis.</dd>
      </div>
      <div>
        <dt>en ligne</dt>
        <dd>
          <a href={CONTACT.instagramUrl} rel="me noopener" target="_blank">@{CONTACT.instagram}</a>,
          pour suivre les pièces en cours.
        </dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  /* ============================ HAUT DE PAGE ============================ */
  .at-ouv {
    padding-block: 0 clamp(3.5rem, 8vw, 7rem);
    row-gap: clamp(1.8rem, 4vw, 3rem);
    overflow: hidden;
  }
  /* Sur le tapis, le quadrillage reste net jusqu'aux bords : c'est un vrai tapis. */
  .at-ouv::before {
    mask-image: linear-gradient(180deg, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent);
  }

  /* La règle graduée du bord du tapis, chiffres tous les 5 cm */
  .at-regle {
    grid-row: 1;
    display: flex;
    overflow: hidden;
    block-size: 2.4rem;
    border-block-end: 1px solid color-mix(in oklab, var(--tapis-trait) 55%, transparent);
    background-image:
      linear-gradient(90deg, var(--tapis-trait) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--tapis-trait) 60%, transparent) 1px, transparent 1px);
    background-size: calc(var(--cm) * 5) 14px, var(--cm) 7px;
    background-position: -1px 100%, -1px 100%;
    background-repeat: repeat-x;
  }
  .at-regle span {
    flex: none;
    inline-size: calc(var(--cm) * 5);
    padding: 0.35rem 0 0 0.3rem;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--tapis-trait);
  }

  /* La ligne de coupe à 45°, comme sur tous les tapis de coupe */
  .at-coupe {
    grid-row: 1 / span 4;
    justify-self: end;
    align-self: start;
    inline-size: min(70%, 46rem);
    aspect-ratio: 1;
    pointer-events: none;
    background: linear-gradient(to top right,
      transparent calc(50% - 0.75px),
      color-mix(in oklab, var(--tapis-trait) 55%, transparent) calc(50% - 0.75px) calc(50% + 0.75px),
      transparent calc(50% + 0.75px));
    mask-image: repeating-linear-gradient(45deg, #000 0 10px, transparent 10px 16px);
    -webkit-mask-image: repeating-linear-gradient(45deg, #000 0 10px, transparent 10px 16px);
    opacity: 0.8;
  }

  .at-ariane { grid-row: 2; color: var(--tapis-trait); }
  .at-ariane a:hover { color: var(--rose); }
  .at-ariane [aria-current] { color: var(--lin-haut); }

  .at-ouv__dire { grid-row: 3; display: grid; gap: clamp(1.1rem, 2.4vw, 1.8rem); justify-items: start; position: relative; }
  .at-ouv h1 { color: var(--lin-haut); max-width: 12ch; }

  .at-ouv__poste {
    grid-row: 4;
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2.2rem;
    padding-block-start: 1.6rem;
  }

  /* Le tambour à broder : cercle de toile dans un anneau de bois */
  .at-tambour {
    --bois: #C9A97E;
    --bois-fonce: #8A6A46;
    --anneau: clamp(8px, 1.6vw, 13px);
    position: relative;
    inline-size: min(78vw, 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tapis-2);
    box-shadow:
      0 0 0 var(--anneau) var(--bois),
      0 0 0 calc(var(--anneau) + 2px) var(--bois-fonce),
      0 0 0 calc(var(--anneau) + 7px) var(--bois),
      0 40px 60px -20px rgb(0 0 0 / 0.55);
  }
  .at-tambour :global(img) {
    inline-size: 100%; block-size: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .at-tambour__vis {
    position: absolute; z-index: 2;
    inset-block-start: -1.9rem; inset-inline-start: 50%;
    inline-size: 1.1rem; block-size: 1.7rem;
    transform: translateX(-50%);
    border-radius: 3px;
    background: linear-gradient(90deg, var(--bois-fonce), var(--bois) 45%, var(--bois-fonce));
  }
  .at-tambour__vis::after {
    content: ''; position: absolute; inset: -0.55rem -0.35rem auto;
    block-size: 0.55rem; border-radius: 3px 3px 1px 1px;
    background: #B6AEA8;
  }

  /* L'étiquette d'atelier posée sur le tapis, en biais */
  .at-fiche {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 1rem 0.8rem;
    background: var(--papier);
    color: var(--encre);
    font-size: var(--t-micro);
    line-height: 1.5;
    border-radius: var(--r-s);
    box-shadow: 0 12px 24px -14px rgb(0 0 0 / 0.6);
    transform: rotate(-3deg);
  }
  .at-fiche span:first-child { color: var(--coquelicot-fonce); }

  @media (min-width: 64rem) {
    .at-ouv { min-height: calc(100svh - 4.5rem); grid-template-rows: auto auto 1fr; }
    .at-ouv__dire { grid-row: 3; align-self: center; max-width: 58%; }
    .at-ouv h1 { font-size: clamp(3.8rem, 1rem + 4.6vw, 6.6rem); max-width: 13ch; }
    .at-ouv__poste { grid-row: 2 / 4; align-self: center; justify-self: end; inline-size: 38%; padding-block-start: 4rem; }
    .at-tambour { inline-size: 100%; max-inline-size: 30rem; }
    .at-fiche { position: absolute; inset-block-end: -1rem; inset-inline-start: -2.5rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .at-ouv__dire > * { animation: arrive 800ms var(--sortie) both; }
    .at-ouv__dire > :nth-child(2) { animation-delay: 90ms; }
    .at-ouv__dire > :nth-child(3) { animation-delay: 180ms; }
    .at-tambour { animation: tend 1100ms var(--sortie) 150ms both; }
    .at-fiche { animation: pose 900ms var(--sortie) 600ms both; }
    .at-regle { animation: deroule 1200ms var(--sortie) both; }
  }
  @keyframes arrive { from { transform: translateY(24px); opacity: 0.001; } to { transform: none; opacity: 1; } }
  @keyframes tend { from { transform: scale(0.86) rotate(-10deg); opacity: 0.001; } to { transform: none; opacity: 1; } }
  @keyframes pose { from { transform: translateY(-30px) rotate(6deg); opacity: 0.001; } to { transform: rotate(-3deg); opacity: 1; } }
  @keyframes deroule { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  /* ============================ BANDEAU ============================ */
  .at-bandeau { block-size: clamp(12rem, 34vw, 28rem); }

  /* ============================ QUI JE SUIS ============================ */
  .at-moi {
    padding-block: var(--respire) var(--serre);
    row-gap: clamp(2rem, 5vw, 3rem);
  }
  .at-moi .titre-xl { max-width: 13ch; }
  .at-moi__txt { display: grid; gap: 1.1rem; max-width: 38rem; }
  .at-moi__txt p { color: var(--encre-doux); }
  .at-moi__lead {
    font-family: var(--f-titre);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--encre) !important;
    text-wrap: pretty;
  }
  .at-moi__txt b { font-weight: 500; color: var(--encre); }
  @media (min-width: 64rem) {
    .at-moi { grid-template-columns: [bord-d] minmax(var(--marge), 1fr) [large-d] minmax(0, calc(var(--large) * 0.55)) [mi] minmax(0, calc(var(--large) * 0.45)) [large-f] minmax(var(--marge), 1fr) [bord-f]; }
