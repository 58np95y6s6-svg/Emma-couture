---
/**
 * /l-atelier/ — qui est Emma, son matériel, sa façon de travailler.
 *
 * Construite avec les composants canoniques (HautDePage, TeteSection,
 * ListeLignes, Etapes, AppelFinal). Une seule section sur le tapis de coupe :
 * le matériel. Chaque photo n'apparaît qu'une fois dans la page.
 *
 * ⚠️ Emma travaille CHEZ ELLE. Aucune adresse, aucune invitation à passer,
 * aucun horaire d'ouverture sur cette page. Remise en main propre sur
 * rendez-vous, adresse communiquée seulement après accord.
 * ⚠️ Broderie MACHINE. « Cousu main » ne vaut que pour les sacs, trousses
 * et tabliers qu'elle confectionne.
 * ⚠️ Aucun chiffre biographique : depuis combien de temps elle brode,
 * combien de pièces, combien de bobines → [À COMPLÉTER] par Emma.
 */
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import TeteSection from '../components/TeteSection.astro';
import ListeLignes from '../components/ListeLignes.astro';
import Etapes from '../components/Etapes.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { SITE, CONTACT, LIBELLES, lienWhatsApp } from '../config';

import portrait from '../assets/creations/galerie/emma-brodeuse-vitre-portrait.webp';
import machine from '../assets/creations/galerie/machine-a-broder-en-cours-atelier-vitre.webp';
import arbre from '../assets/creations/galerie/arbre-de-vie-brode-dentelle-ajouree-fil-dore.webp';
import trousse from '../assets/creations/galerie/trousse-cousue-main-brodee-prenom-lisa.webp';
import ogSource from '../assets/creations/og/emma-brodeuse-vitre-portrait.webp';

const og = await getImage({ src: ogSource, format: 'webp', width: 1200 });

const titre = `L’atelier · broderie machine et couture à ${SITE.ville} (35) | ${SITE.nom}`;
const description = `Brodeuse et couturière à ${SITE.ville} (35), je réalise seule chaque pièce : broderie machine personnalisée, dentelle libre, sacs et trousses cousus main. Le motif vous est soumis avant toute réalisation.`;
const fil = [{ nom: 'L’atelier', url: '/l-atelier/' }];

const messageWa = 'Bonjour Emma, j’ai lu la page de l’atelier et je souhaiterais un renseignement.';

/* Le matériel. La méta dit l'unité ou la référence qui compte : une donnée. */
const outils = [
  {
    titre: 'La machine à broder',
    texte: 'Elle suit un fichier que je prépare pour chaque motif. C’est dans ce fichier que se règle la densité des points, dont dépend la bonne tenue de la broderie au lavage.',
    meta: 'fichier par motif',
  },
  {
    titre: 'Le fil',
    texte: 'Brillant et résistant, il ne déteint pas. Les pièces brodées se lavent en machine à 30° sans que la broderie ne s’altère.',
    meta: 'polyester 40',
  },
  {
    titre: 'Les cadres',
    texte: 'Le cadre détermine la taille maximale du motif. C’est pourquoi je vous demande toujours les dimensions exactes du support à broder.',
    meta: 'en millimètres',
  },
  {
    titre: 'Le tapis de coupe',
    texte: 'J’y coupe les tissus des sacs, des trousses et des tabliers avant de les assembler.',
    meta: 'quadrillé au centimètre',
  },
];

/* La fabrication : une vraie séquence, réduite à quatre temps. */
const etapes = [
  {
    titre: 'Votre message',
    texte: 'Vous m’indiquez le prénom, l’occasion, la date souhaitée et le support, avec une photo d’inspiration si vous en avez une.',
  },
  {
    titre: 'La validation du motif',
    texte: 'Je prépare l’écriture, la taille, l’emplacement et les couleurs de fil, puis je vous soumets le motif. Tant qu’il n’est pas brodé, tout reste modifiable.',
    cle: true,
  },
  {
    titre: 'La broderie',
    texte: 'Je tends le tissu dans le cadre, je règle le placement au millimètre, puis je reste à côté de la machine pendant toute la réalisation.',
  },
  {
    titre: 'Les finitions',
    texte: 'Je coupe les fils, je retire le support et je repasse la pièce, puis je la prépare dans un emballage cadeau.',
  },
];
---

<Base titre={titre} description={description} imageOg={og.src} fil={fil} messageWa={messageWa}>
  {/*
    ⚠️ CONTENU D'EXEMPLE — numéro, e-mail et délais provisoires (src/config.ts).
    [À COMPLÉTER] depuis combien de temps Emma brode : à afficher en réassurance
    une fois confirmé, jamais avant.
  */}

  <HautDePage
    titre={`L’atelier de broderie et de couture, à ${SITE.ville}`}
    fil={fil}
    image={portrait}
    alt="Portrait d’Emma, brodeuse et couturière à Vitré, souriante, en plein air"
    cadrage="54% 58%"
    faits={[`Atelier à ${SITE.ville} (35)`, 'Broderie machine et couture', 'Retrait sur rendez-vous']}
  >
    <p>
      Je suis Emma, brodeuse et couturière à {SITE.ville}, en Ille-et-Vilaine. Je travaille seule,
      en broderie machine personnalisée et en couture sur mesure&nbsp;: c’est moi qui réponds à vos
      messages, qui brode et qui emballe.
    </p>
    <p>
      Vous n’avez qu’une interlocutrice, du premier message à l’envoi. L’atelier se trouve à mon
      domicile&nbsp;: la remise en main propre se fait sur rendez-vous.
    </p>
    <a slot="actions" class="btn btn--wa btn--grand" href={lienWhatsApp(messageWa)}>{LIBELLES.whatsapp}</a>
    <a slot="actions" class="btn btn--creux btn--grand" href="/creations/">Voir les créations</a>
  </HautDePage>

  <!-- ===================== LE MATÉRIEL (le seul tapis de la page) ===================== -->
  <section class="bande tapis" id="materiel">
    <TeteSection titre="Le matériel">
      <p>Quatre outils, et ce que chacun change pour votre pièce.</p>
    </TeteSection>
    <div class="grille at-materiel">
      <figure class="at-materiel__fig">
        <Image
          src={machine}
          alt="La tête de la machine à broder en pleine action : un cerisier en fleurs et un colibri se forment en fil de couleur sur le tissu tendu"
          widths={[400, 640, 900]}
          sizes="(max-width: 48rem) 92vw, 36vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="at-materiel__liste">
        <ListeLignes lignes={outils} />
      </div>
    </div>
  </section>

  <!-- ===================== FABRICATION ===================== -->
  <section class="bande bloc at-section" id="fabrication">
    <TeteSection titre="Les étapes de fabrication" />
    <Etapes etapes={etapes} />
  </section>

  <!-- ===================== DENTELLE LIBRE + COUTURE : deux colonnes 6/6 ===================== -->
  <section class="bande at-section loin" id="savoir-faire" aria-label="La dentelle libre et la couture">
    <div class="grille at-duo">
      <article class="at-duo__col">
        <figure class="at-fig">
          <Image
            src={arbre}
            alt="Arbre de vie brodé en dentelle ajourée fil doré, pièce autoportante sans support tissu"
            widths={[400, 640, 900]}
            sizes="(max-width: 48rem) 92vw, 46vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <h2>La dentelle libre</h2>
        <p>
          La machine brode sur un support soluble, qui disparaît au rinçage. Il ne reste que le
          fil&nbsp;: une pièce ajourée, sans tissu, qui tient d’elle-même. C’est la technique que je
          préfère, et celle que l’on rencontre le moins souvent.
        </p>
        <a class="lien-fleche" href="/creations/decoration-ajouree/">Voir les pièces ajourées</a>
      </article>
      <article class="at-duo__col">
        <figure class="at-fig">
          <Image
            src={trousse}
            style="object-position: 50% 70%"
            alt="Trousse en tissu fleuri bleu et blanc, cousue main, brodée au prénom en fil doré"
            widths={[400, 640, 900]}
            sizes="(max-width: 48rem) 92vw, 46vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <h2>La couture</h2>
        <p>
          Les sacs, trousses, tabliers et bavoirs sont cousus main à l’atelier&nbsp;: je coupe le
          tissu, j’assemble la pièce, puis je la brode. Vous pouvez choisir parmi mes tissus ou me
          confier le vôtre.
        </p>
        <a class="lien-fleche" href="/creations/couture/">Voir les sacs et les trousses</a>
      </article>
    </div>
  </section>

  <AppelFinal titre="Parlons de votre projet" messageWa={messageWa}>
    <p>
      Remise en main propre à <a href="/brodeuse-vitre/">{SITE.ville}</a> ou à{' '}
      <a href="/broderie-personnalisee-rennes/">Rennes</a>, sur rendez-vous&nbsp;: l’adresse vous
      est communiquée après accord. Envoi soigné partout en France. Les pièces en cours sont
      visibles sur Instagram&nbsp;:{' '}
      <a href={CONTACT.instagramUrl} rel="me noopener" target="_blank">@{CONTACT.instagram}</a>.
    </p>
  </AppelFinal>
</Base>

<style>
  .at-section { padding-block: var(--serre); }
  .at-section.bloc { padding-block: var(--respire); }
  .grille { row-gap: 2rem; }

  .at-materiel { align-items: start; }
  .at-materiel__fig :global(img) {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-carte);
  }

  .at-duo { row-gap: var(--serre); }
  .at-duo__col { grid-column: 1 / -1; display: grid; gap: 1rem; align-content: start; justify-items: start; }
  .at-duo__col p { color: var(--encre-doux); max-width: 34rem; }
  .at-fig { width: 100%; margin-block-end: 0.5rem; }
  .at-fig :global(img) {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-l);
  }

  @media (min-width: 48rem) {
    .at-materiel__fig { grid-column: 1 / span 5; }
    .at-materiel__fig :global(img) { aspect-ratio: 4 / 5; }
    .at-materiel__liste { grid-column: 6 / -1; }
    .at-duo__col { grid-column: span 6; }
  }
</style>
