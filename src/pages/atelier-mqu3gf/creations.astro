---
import Atelier from '../../layouts/Atelier.astro';
---

<Atelier titre="Créations mises en avant">
  <p class="at-intro">
    Les cartes de la page d'accueil : leur nom, leur prix, leur délai, leur photo et leur ordre.
    Le prix et le délai changent aussi partout où la carte apparaît sur le site.
  </p>
  <p class="at-erreur" id="erreur-chargement" role="alert" hidden></p>

  <div id="section" class="ed-grille" hidden>
    <section class="at-carte" aria-labelledby="t-liste">
      <h2 id="t-liste">Vos créations</h2>
      <p class="at-aide">
        Dans l'ordre de l'accueil : la première de la liste s'affiche en premier.
        Appuyez sur « Modifier » pour changer le nom, le prix ou la photo.
      </p>
      <p class="at-compte" id="compte" role="status"></p>
      <ol class="ed-liste" id="liste"></ol>
    </section>

    <section class="at-carte at-carte--apercu ed-apercu" aria-labelledby="t-apercu">
      <h2 id="t-apercu">Aperçu de l'accueil</h2>
      <div id="apercu"></div>
    </section>

    <div id="zone-enregistrer" class="ed-enregistrer"></div>
  </div>
</Atelier>

<script>
  import '../../admin/pages/creations.js';
</script>
