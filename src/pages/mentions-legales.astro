---
/**
 * Mentions légales.
 *
 * Règles tenues ici :
 *  - ⚠️ Emma travaille chez elle : AUCUNE adresse de rue n'est publiée. Seule
 *    la ville apparaît. La question de l'adresse du siège, légalement exigée,
 *    est posée explicitement dans l'encadré « à compléter ».
 *  - Les valeurs manquantes viennent de src/config.ts et sont affichées telles
 *    quelles, en évidence : on ne remplace jamais un « [À COMPLÉTER] » par une
 *    valeur inventée.
 *  - Pas de vente en ligne pour l'instant → ni CGV ni médiateur de la
 *    consommation à ce stade (voir CLAUDE.md § Périmètre).
 *  - Seule page (avec la politique de confidentialité) où le nom légal
 *    apparaît : partout ailleurs, c'est « Emma Broderie ».
 *
 * Mise en page : page de lecture longue. Colonne de ~65 caractères, sommaire
 * collant à gauche sur grand écran ; le lien de la section en cours s'allume,
 * en CSS pur (timeline-scope + view-timeline), sans script.
 * ⚠️ Même gabarit que politique-de-confidentialite.astro : les deux feuilles
 * de style sont jumelles, à garder alignées.
 */
import Base from '../layouts/Base.astro';
import HautDePage from '../components/HautDePage.astro';
import { SITE, CONTACT, telephoneLisible } from '../config';
/* Le gabarit retombe sinon sur /og-defaut.jpg, qui n'existe pas encore
   dans public/ : l'aperçu de partage serait cassé. */
import ogPage from '../assets/creations/og/atelier-mur-bobines-fil-broderie-vitre.webp';

const titre = `Mentions légales | ${SITE.nom}`;
const description =
  "Mentions légales du site emma-broderie.fr : éditeur, statut de micro-entreprise, SIRET, contact, hébergeur et propriété intellectuelle des photographies.";

/** Vrai si la valeur de config est encore un marqueur à compléter. */
const manque = (v: string) => v.includes('[À');

/**
 * Ce qu'il reste à demander à Emma avant la mise en ligne.
 * La liste est affichée sur la page : tant qu'elle n'est pas vide, les
 * mentions légales ne sont pas conformes.
 */
const aFournir = [
  {
    quoi: 'Adresse du siège de l’entreprise',
    pourquoi:
      'La loi exige l’adresse de l’entreprise. Emma travaillant à son domicile, il faut choisir : publier l’adresse personnelle, ou passer par une adresse de domiciliation ou une boîte postale. À trancher avec elle avant la mise en ligne.',
    etat: 'décision à prendre',
  },
  {
    quoi: 'Régime de TVA',
    pourquoi:
      'La mention « TVA non applicable, article 293 B du CGI » n’est juste que si Emma est bien sous le régime de la franchise en base.',
    etat: 'à confirmer',
  },
];

/* Le sommaire : un identifiant par section, dans l'ordre de la page. Les
   mêmes identifiants nomment les timelines de défilement (voir le style). */
const sommaire = [
  { id: 'a-completer', nom: 'À compléter' },
  { id: 'editeur', nom: 'Éditeur du site' },
  { id: 'publication', nom: 'Directrice de la publication' },
  { id: 'hebergeur', nom: 'Hébergeur' },
  { id: 'propriete', nom: 'Propriété intellectuelle' },
  { id: 'vente', nom: 'Vente en ligne' },
  { id: 'liens', nom: 'Liens et responsabilité' },
];
const fil = [{ nom: 'Mentions légales', url: '/mentions-legales/' }];
const tl = (id: string) => `--lg-${id}`;
const portee = `timeline-scope: ${sommaire.map((s) => tl(s.id)).join(', ')}`;
---

<Base
  titre={titre}
  description={description}
  imageOg={ogPage.src}
  fil={fil}
>
  <HautDePage titre="Mentions légales" fil={fil}>
    <p>
      Cette page présente mon entreprise, l’hébergeur du site et les conditions d’utilisation
      de mes photographies. Pour le traitement de vos données personnelles, je vous invite à
      consulter la <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
    </p>
  </HautDePage>

  <div class="bande lecture">
    <div class="grille lecture__grille" style={portee}>
      <nav class="som" aria-labelledby="som-titre">
        <p class="som__titre mono" id="som-titre">Sur cette page</p>
        <ol>
          {
            sommaire.map((s) => (
              <li>
                <a href={`#${s.id}`} style={`animation-timeline: ${tl(s.id)}`}>
                  {s.nom}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="lecture__texte">
        <!-- Encart à compléter : à supprimer quand la liste est vide. -->
        <aside
          class="sec chantier"
          id="a-completer"
          aria-labelledby="chantier-titre"
          style={`view-timeline-name: ${tl('a-completer')}`}
        >
          <h2 id="chantier-titre">À compléter avant la mise en ligne</h2>
          <p>
            Ces informations sont obligatoires et ne sont pas encore renseignées. Elles sont
            affichées ici telles quelles, plutôt qu’inventées.
          </p>
          <dl class="chantier__liste">
            {
              aFournir.map((a) => (
                <div>
                  <dt>{a.quoi}</dt>
                  <dd class="chantier__etat mono">{a.etat}</dd>
                  <dd>{a.pourquoi}</dd>
                </div>
              ))
            }
          </dl>
        </aside>

        <section class="sec" id="editeur" style={`view-timeline-name: ${tl('editeur')}`}>
          <h2>Éditeur du site</h2>
          <dl class="fiche">
            <div>
              <dt>Nom commercial</dt>
              <dd>{SITE.nom}</dd>
            </div>
            <div>
              <dt>Exploitante</dt>
              <dd>
                {SITE.nomLegal}
              </dd>
            </div>
            <div>
              <dt>Statut</dt>
              <dd>Entrepreneure individuelle — micro-entreprise</dd>
            </div>
            <div>
              <dt>Activité</dt>
              <dd>Broderie machine sur textile et couture sur mesure</dd>
            </div>
            <div>
              <dt>SIRET</dt>
              <dd>
                {manque(SITE.siret) ? <b class="manque mono">{SITE.siret}</b> : SITE.siret}
              </dd>
            </div>
            <div>
              <dt>Siège</dt>
              <dd>
                {SITE.commune} ({SITE.codePostal}), {SITE.departement}, France
                <span class="drapeau">
                  adresse précise non publiée — l’atelier est au domicile de l’exploitante
                </span>
              </dd>
            </div>
            <div>
              <dt>Courriel</dt>
              <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
            </div>
            <div>
              <dt>Téléphone</dt>
              <dd><a href={`tel:${CONTACT.telephone}`}>{telephoneLisible()}</a></dd>
            </div>
            <div>
              <dt>TVA</dt>
              <dd>
                TVA non applicable, article 293 B du Code général des impôts
                <span class="drapeau">à confirmer selon le régime réel d’Emma</span>
              </dd>
            </div>
          </dl>
        </section>

        <section class="sec" id="publication" style={`view-timeline-name: ${tl('publication')}`}>
          <h2>Directrice de la publication</h2>
          <p>
            {SITE.nomLegal}, exploitante de {SITE.nom}. C’est elle qui écrit et valide les contenus
            publiés sur ce site.
          </p>
        </section>

        <section class="sec" id="hebergeur" style={`view-timeline-name: ${tl('hebergeur')}`}>
          <h2>Hébergeur</h2>
          <address class="adresse">
            <b>Netlify, Inc.</b>
            <span>512 2nd Street, Suite 200</span>
            <span>San Francisco, CA 94107</span>
            <span>États-Unis</span>
            <a href="https://www.netlify.com/" rel="noopener nofollow" target="_blank">netlify.com</a>
          </address>
          <p class="note">
            Netlify héberge les pages du site, reçoit les formulaires de contact et stocke les
            données de l’espace d’administration. Les conséquences de cet hébergement hors Union
            européenne sont détaillées dans
            la <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
          </p>
        </section>

        <section class="sec" id="propriete" style={`view-timeline-name: ${tl('propriete')}`}>
          <h2>Propriété intellectuelle</h2>
          <p>
            Les photographies publiées sur ce site ont été prises dans l’atelier et montrent des
            pièces réellement brodées ou cousues par {SITE.nom}. Elles lui appartiennent, ainsi que
            les motifs de broderie, les textes et la mise en page du site.
          </p>
          <p>
            Toute reproduction, même partielle, sur un autre site, une boutique en ligne, un
            catalogue ou un support imprimé est interdite sans accord écrit préalable. Les motifs
            brodés ne sont ni vendus ni cédés sous forme de fichiers.
          </p>
          <p class="note">
            Certaines pièces photographiées portent le prénom de la personne à qui elles étaient
            destinées. Si vous êtes concerné·e et souhaitez qu’une photo soit retirée, il suffit de
            le demander par courriel&nbsp;: elle est retirée sans discussion.
          </p>
        </section>

        <section class="sec" id="vente" style={`view-timeline-name: ${tl('vente')}`}>
          <h2>Vente en ligne</h2>
          <p>
            Ce site ne vend rien directement&nbsp;: il n’y a ni panier, ni paiement, ni prise de
            commande automatique. Chaque projet passe par un échange, un devis, puis un accord. Il
            n’y a donc pas de conditions générales de vente ni de médiateur de la consommation à ce
            stade.
          </p>
          <p class="note">
            <!-- ⚠️ Si un paiement en ligne est ajouté plus tard (liens Stripe), CGV et médiateur de
                 la consommation deviennent obligatoires en B2C. Voir CLAUDE.md § Périmètre. -->
            Si un paiement en ligne est ajouté un jour, cette page sera complétée avant.
          </p>
        </section>

        <section class="sec" id="liens" style={`view-timeline-name: ${tl('liens')}`}>
          <h2>Liens et responsabilité</h2>
          <p>
            Les informations affichées (délais, exemples de prix, disponibilités) sont indicatives
            et peuvent changer&nbsp;: seul le devis envoyé par écrit engage. Les liens sortants —
            réseaux sociaux, WhatsApp — mènent vers des services qui ont leurs propres règles, sur
            lesquelles {SITE.nom} n’a pas la main.
          </p>
        </section>

        <p class="voir-aussi">
          <a class="lien-fleche" href="/politique-de-confidentialite/">Politique de confidentialité</a>
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Page de lecture longue — gabarit jumeau de politique-de-confidentialite.
     Sommaire en col. 1-4 (collant), texte en col. 5-12 (~65 caractères). */
  .lecture { padding-block: var(--serre) var(--respire); }
  .lecture__grille { row-gap: 2rem; align-items: start; }
  .lecture__texte { max-width: 40rem; }
  @media (min-width: 64rem) {
    .som { grid-column: 1 / span 4; }
    .lecture__texte { grid-column: 5 / -1; }
  }

  /* ---------- Sommaire ---------- */
  .som__titre { font-size: var(--t-micro); color: var(--gris); padding-block-end: 0.4rem; }
  /* Téléphone : une ligne de liens qui défile dans son propre conteneur. */
  .som ol {
    display: flex; gap: 1.25rem;
    overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none;
    border-block: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .som ol::-webkit-scrollbar { display: none; }
  .som li { flex: none; }
  .som a {
    position: relative;
    display: flex; align-items: center; min-height: 44px;
    font-size: var(--t-petit); color: var(--encre-doux); text-decoration: none; white-space: nowrap;
  }
  .som a:hover { color: var(--prune); }
  @media (min-width: 64rem) {
    .som { position: sticky; inset-block-start: 6.5rem; }
    .som ol {
      display: grid; gap: 0; overflow: visible; border-block: 0;
      border-inline-start: 1px solid color-mix(in oklab, currentColor 18%, transparent);
    }
    .som a { white-space: normal; padding-inline-start: 1.1rem; line-height: 1.35; }
    /* Repère de la section en cours : un trait plein sur le filet. */
    .som a::before {
      content: ''; position: absolute; inset-block: 0.55rem; inset-inline-start: -1.5px; inline-size: 2px;
      background: var(--prune); border-radius: 2px;
      transform: scaleY(0); transform-origin: 50% 0;
    }
    .som a:hover::before { transform: none; }
  }
  /* La section en cours s'allume sans script (timeline-scope + view-timeline). */
  @supports (timeline-scope: --a) and (animation-timeline: view()) {
    .sec { view-timeline-inset: 28% 71%; }
    @media (min-width: 64rem) {
      .som a { animation: som-actif linear; animation-range: cover 0% cover 100%; }
      .som a::before {
        animation: inherit; animation-name: som-repere;
        animation-timeline: inherit; animation-range: inherit;
      }
    }
  }
  @keyframes som-actif { from, to { color: var(--prune); font-weight: 700; } }
  @keyframes som-repere { from, to { transform: none; } }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: var(--serre);
    border-block-start: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .sec:first-child { padding-block-start: 0; border: 0; }
  /* Texte long en colonne de 40rem : les H2 restent dans l'échelle mais
     descendent d'un cran, sinon Anybody casse chaque titre en 3 lignes. */
  .sec h2 { text-wrap: balance; margin-block-end: 1rem; font-size: calc(var(--t-h3) * 1.45); line-height: 1.02; }
  .sec p { max-width: 38rem; line-height: 1.7; color: var(--encre-doux); }
  .sec p + p { margin-block-start: 1em; }
  .sec a { text-underline-offset: 3px; overflow-wrap: anywhere; }
  .sec a:hover { color: var(--prune); }
  .sec .note {
    margin-block-start: 1.25em; padding: 1rem 1.25rem;
    border-radius: var(--r-m); background: var(--papier-2);
    font-size: var(--t-petit); color: var(--encre-doux);
  }

  /* ---------- Fiche d'identité ---------- */
  .fiche > div {
    display: grid; gap: 0.15rem; padding-block: 0.75rem;
    border-block-end: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }
  .fiche dt { font-family: var(--f-mono); font-size: var(--t-micro); color: var(--gris); }
  .fiche dd { min-width: 0; line-height: 1.55; }
  @media (min-width: 40rem) {
    .fiche > div { grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); column-gap: 1.5rem; align-items: baseline; }
  }
  .drapeau { display: block; padding-block-start: 0.2rem; font-size: var(--t-petit); color: var(--gris); }

  .voir-aussi {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid color-mix(in oklab, currentColor 15%, transparent);
  }

  .manque { padding: 0.1rem 0.6rem; border-radius: 999px; font-size: var(--t-petit); font-weight: 400; color: var(--encre); background: var(--beurre); }
  .adresse { display: grid; justify-items: start; font-style: normal; line-height: 1.6; color: var(--encre-doux); }
  .adresse b { font-weight: 500; color: var(--encre); }
  .adresse a { display: inline-flex; align-items: center; min-height: 44px; }

  /* ---------- Encart « à compléter » : un bloc beurre arrondi ---------- */
  .sec.chantier {
    padding: clamp(20px, 4vw, 40px);
    margin-block-end: var(--serre);
    border: 0;
    border-radius: var(--r-l);
    background: var(--beurre);
  }
  .chantier p { color: var(--encre); }
  .chantier__liste { margin-block-start: 1rem; }
  .chantier__liste > div {
    display: grid; gap: 0.2rem; padding-block: 0.8rem;
    border-block-start: 1px solid color-mix(in oklab, currentColor 22%, transparent);
  }
  .chantier__liste dt { font-weight: 700; }
  .chantier__liste dd { min-width: 0; font-size: var(--t-petit); color: var(--encre); }
  .chantier__liste .chantier__etat { font-size: var(--t-micro); color: var(--prune); overflow-wrap: anywhere; }
  .chantier + .sec { border: 0; padding-block-start: 0; }
</style>
