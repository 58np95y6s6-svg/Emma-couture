---
import { SITE, ATELIER, OCCASIONS, LIBELLES, lienWhatsApp } from '../config';

const liens = [
  { href: '/creations/', texte: 'Créations' },
  { href: '/creations/decoration-ajouree/', texte: 'Dentelle libre' },
  { href: '/sur-mesure/', texte: 'Sur-mesure' },
  { href: '/l-atelier/', texte: "L'atelier" },
  { href: '/contact/', texte: 'Contact' },
];

const ici = Astro.url.pathname;
/* Toute page /creations/… allume « Créations », sauf la dentelle libre. */
const dentelle = ici.startsWith('/creations/decoration-ajouree/');
const actif = (href: string) =>
  href === '/creations/' ? ici.startsWith('/creations/') && !dentelle : ici.startsWith(href);

/* Le statut de l'atelier vient de l'admin (repli : config). */
const statut = {
  ouvertes: { texte: 'Commandes ouvertes', classe: '' },
  complet: { texte: 'Carnet complet', classe: 'statut--complet' },
  conges: { texte: `En congés${ATELIER.retourLe ? ` jusqu'au ${ATELIER.retourLe}` : ''}`, classe: 'statut--conges' },
}[ATELIER.commandes];
---

<header class="entete">
  <div class="entete__in">
    <a class="marque" href="/" aria-label={`${SITE.nom}, accueil`}>
      <span class="marque__bobines" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></span>
      <span class="marque__nom">Emma Broderie</span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.texte}</a>)}
    </nav>

    <p class={`statut ${statut.classe}`} data-reglage="statut">{statut.texte}</p>

    <a class="btn btn--creux btn--petit entete__cta entete__wa" href={lienWhatsApp()}>WhatsApp</a>
    <a class="btn btn--wa btn--petit entete__cta" href="/contact/#devis">{LIBELLES.devis}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu-mobile">
      <span class="burger__traits" aria-hidden="true"><i></i><i></i></span>
      <span class="burger__mot">Menu</span>
    </button>
  </div>

  <nav class="menu" id="menu-mobile" aria-label="Menu" hidden>
    {liens.map((l) => <a href={l.href}>{l.texte}</a>)}
    <p class="menu__titre">Idées cadeaux</p>
    <div class="menu__occasions">
      {OCCASIONS.map((o) => <a href={`/cadeaux/${o.slug}/`}>{o.nom}</a>)}
    </div>
    <p class="menu__actions">
      <a class="btn btn--wa" href={lienWhatsApp()}>{LIBELLES.whatsapp}</a>
      <a class="btn btn--clair" href="/contact/#devis">{LIBELLES.devis}</a>
    </p>
    <p class={`statut statut--menu ${statut.classe}`}>{statut.texte}</p>
  </nav>
  <div class="progression" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></div>
</header>
