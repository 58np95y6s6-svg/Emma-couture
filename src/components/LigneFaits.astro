---
/**
 * Une ligne de faits vérifiables : « À partir de 32 € · Délai actuel 2 semaines · … ».
 * Du texte, pas des pastilles. Les valeurs viennent de config / du contenu.
 */
interface Props {
  faits: string[];
  /** Sur fond sombre ou coloré. */
  clair?: boolean;
  /** Nom accessible de la liste, ex. « Communes desservies ». */
  label?: string;
}
const { faits, clair = false, label } = Astro.props;
---

<ul class:list={['faits', { 'faits--clair': clair }]} aria-label={label}>
  {faits.map((f) => <li>{f}</li>)}
</ul>
