---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { lienWhatsApp, SITE } from '../config';

interface Props {
  creation: CollectionEntry<'creations'>;
  /** Passé à `sizes` : dépend du contexte d'affichage. */
  tailles?: string;
  /** La première carte d'une page n'est pas différée. */
  prioritaire?: boolean;
}

const { creation, tailles = '(max-width: 40rem) 74vw, (max-width: 64rem) 42vw, 24rem', prioritaire = false } = Astro.props;
const { data, id } = creation;

const urlFiche = `/creations/${id}/`;
const urlAbsolue = new URL(urlFiche, SITE.url).href;

/* L'URL de la fiche est jointe au message : WhatsApp en affiche l'aperçu
   Open Graph, seule façon d'y faire apparaître la photo. */
const wa = lienWhatsApp(
  `Bonjour Emma, j'ai vu « ${data.titre} » sur votre site et j'aimerais un modèle similaire.`,
  urlAbsolue,
);
---

<article class="carte">
  <a class="carte__lien" href={urlFiche}>
    <figure class="carte__img">
      <Image
        src={data.photo}
        alt={data.alt}
        widths={[320, 480, 640, 800]}
        sizes={tailles}
        loading={prioritaire ? 'eager' : 'lazy'}
        decoding="async"
      />
    </figure>
    <div class="carte__txt">
      <h3>{data.titre}</h3>
      <p>{data.accroche}</p>
      {/* ⚠️ Prix et délais d'exemple, à valider par Emma (repli de l'admin). */}
      {
        (data.prixDepart || data.delaiJours) && (
          <p class="carte__ligne prix" data-reglage-creation={id}>
            {data.prixDepart && (
              <span>
                dès <b>{data.prixDepart}&nbsp;€</b>
              </span>
            )}
            {data.delaiJours && <span>{data.delaiJours}&nbsp;jours</span>}
          </p>
        )
      }
    </div>
  </a>

  <p class="carte__cta">
    <a class="lien-wa" href={wa}>Je veux la même</a>
    <a class="lien-fleche" href={`/contact/?creation=${id}`}>Devis</a>
  </p>
</article>
