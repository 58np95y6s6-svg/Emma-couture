---
/**
 * CARTE PRODUIT d'une création — codes d'une boutique en ligne, sans panier.
 *
 * La carte entière est un seul lien vers la fiche : photo 4:5, titre, prix
 * « dès N € » bien lisible, délai « réalisation N j » discret. La commande
 * (WhatsApp ou devis) se fait depuis la fiche. Pas d'étoiles, pas de stock,
 * pas de quantité : rien qui n'existe pas.
 *
 * Utilisée dans les grilles du catalogue (/creations/, catégories) et dans
 * les rangées défilantes (accueil, occasions, « Vous aimerez aussi »).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  creation: CollectionEntry<'creations'>;
  /** Passé à `sizes` : dépend du contexte d'affichage. */
  tailles?: string;
  /** La première carte d'une page n'est pas différée. */
  prioritaire?: boolean;
}

const { creation, tailles = '(max-width: 40rem) 74vw, (max-width: 64rem) 42vw, 24rem', prioritaire = false } = Astro.props;
const { data, id } = creation;

const urlFiche = `/creations/${id}/`;
/* Apostrophe typographique à l'affichage. */
const titre = data.titre.replace(/'/g, '’');
/* Étiquette courte de la catégorie ; la couleur de la carte en découle. */
const NOMS_CATEGORIES: Record<string, string> = {
  naissance: 'Naissance',
  'linge-de-bain': 'Linge de bain',
  vetements: 'Vêtements',
  couture: 'Couture',
  'decoration-ajouree': 'Dentelle libre',
  noel: 'Noël',
};
---

<article class={`carte carte--${data.categorie}`}>
  <a class="carte__lien" href={urlFiche}>
    <figure class="carte__img">
      <Image
        src={data.photo}
        alt={data.alt}
        widths={[320, 480, 640, 800]}
        sizes={tailles}
        loading={prioritaire ? 'eager' : 'lazy'}
        decoding="async"
      />
    </figure>
    <div class="carte__txt">
      <p class="carte__cat mono">{NOMS_CATEGORIES[data.categorie]}</p>
      <h3 class="carte__titre">{titre}</h3>
      {/* ⚠️ Prix et délais d'exemple, à valider par Emma (repli de l'admin). */}
      <p class="carte__ligne" data-reglage-creation={id}>
        <span class="prix carte__prix">
          {data.prixDepart ? <>dès <b>{data.prixDepart}&nbsp;€</b></> : <b>Sur devis</b>}
        </span>
        {data.delaiJours && <span class="carte__delai mono">{data.delaiJours}&nbsp;jours</span>}
      </p>
    </div>
  </a>
</article>

<style>
  /* Les règles de base (.carte, couleur par catégorie, survol) sont dans
     global.css § 9 ; ici, le détail de la carte produit. */
  .carte__titre { line-height: 1.1; text-wrap: balance; }
  .carte__lien:hover .carte__titre { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .carte__cat { font-size: var(--t-micro); }
  .carte__ligne { flex-wrap: wrap; }
  .carte__prix, .carte__prix :global(b) { color: inherit; }
  .carte__delai { font-size: var(--t-micro); }
</style>
