---
/**
 * ÉTAPES — le seul composant pour toutes les séquences du site.
 * Colonnes égales sur grand écran, verticales sur téléphone. Cartes papier,
 * grand chiffre en couleur de fil. L'étape `cle` (la validation du motif)
 * porte le prune.
 */
interface Etape {
  titre: string;
  texte: string;
  cle?: boolean;
}
interface Props {
  etapes: Etape[];
}
const { etapes } = Astro.props;
---

<ol class="etp" style={`--n:${etapes.length}`}>
  {
    etapes.map((e, i) => (
      <li class:list={{ 'etp--cle': e.cle }}>
        <span class="etp__n" aria-hidden="true">{i + 1}</span>
        <h3>{e.titre}</h3>
        <p class="etp__texte">{e.texte}</p>
      </li>
    ))
  }
</ol>

<style>
  /* Cartes papier, grand chiffre aux couleurs des fils. L'étape clé (la
     validation du motif) prend le prune. */
  .etp { display: grid; gap: var(--gout); }
  .etp > li {
    display: flex; flex-direction: column; gap: 0.85rem;
    padding: clamp(1.4rem, 2.6vw, 2.25rem);
    border-radius: var(--r-carte);
    background: var(--papier);
    color: var(--encre);
  }
  .etp__n {
    font-family: var(--f-titre); font-weight: 800; font-stretch: 140%;
    font-size: clamp(3rem, 2.3rem + 3vw, 5.2rem); line-height: 0.85; letter-spacing: -0.03em;
    color: var(--fil-bleu);
  }
  .etp > li:first-child .etp__n { color: var(--fil-rose); }
  .etp--cle .etp__n { color: var(--prune) !important; }
  .etp h3 { font-size: var(--t-h3); }
  .etp__texte { color: var(--encre-doux); max-width: 38ch; }
  @media (min-width: 48rem) {
    .etp { grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .etp { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  }
</style>
