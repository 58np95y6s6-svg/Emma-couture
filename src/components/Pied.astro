---
import { SITE, CONTACT, ATELIER } from '../config';
---

<footer class="pied bande">
  <div class="pied__in">
    <div class="pied__nav">
      <h2 class="pied__marque-nom"><span class="marque__bobines" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></span>Emma Broderie</h2>
      {/* data-reglage : valeurs pilotées par l'admin (src/scripts/reglages.js). */}
      <p>Broderie machine et couture sur mesure, à <span data-reglage="ville">{SITE.ville}</span> ({SITE.departement}).</p>
      <a href={`mailto:${CONTACT.email}`} data-reglage="email">{CONTACT.email}</a>
      <a href={CONTACT.instagramUrl} rel="me noopener" target="_blank">Instagram @{CONTACT.instagram}</a>
      <a href="https://www.facebook.com/" rel="me noopener" target="_blank" data-reglage="facebook" hidden>Facebook</a>
    </div>

    <nav class="pied__nav pied__nav--large" aria-label="Créations">
      <h2>Créations</h2>
      <a href="/creations/naissance/">Naissance &amp; enfant</a>
      <a href="/creations/linge-de-bain/">Linge de bain</a>
      <a href="/creations/couture/">Sacs &amp; trousses</a>
      <a href="/creations/decoration-ajouree/">Dentelle libre</a>
      <a href="/sur-mesure/">Sur-mesure &amp; prix</a>
    </nav>

    <nav class="pied__nav" aria-label="Occasions">
      <h2>Occasions</h2>
      <a href="/cadeaux/naissance/">Cadeau de naissance</a>
      <a href="/cadeaux/mariage/">Mariage</a>
      <a href="/cadeaux/fete-des-meres/">Fête des mères</a>
      <a href="/cadeaux/noel/">Noël</a>
    </nav>

    <div class="pied__nav">
      <h2>Où me trouver</h2>
      <p><span data-reglage="zones">{ATELIER.zones}</span>.</p>
      <a href="/brodeuse-vitre/">Brodeuse à Vitré</a>
      <a href="/broderie-personnalisee-rennes/">Broderie à Rennes</a>
    </div>
  </div>

  <p class="pied__bas">
    <span>{SITE.nomLegal} · micro-entreprise · SIRET {SITE.siret}</span>
    <a href="/mentions-legales/">Mentions légales</a>
    <a href="/politique-de-confidentialite/">Confidentialité</a>
  </p>
</footer>

<style>
  .pied__marque-nom { display: flex; align-items: center; gap: 0.6rem; }
  .pied__nav a[hidden] { display: none; }
</style>
