---
/**
 * HAUT DE PAGE des pages internes — un seul gabarit pour tout le site.
 *
 *   fil d'Ariane (col. 1-12)
 *   H1 (col. 1-7) · chapô (slot par défaut) · actions (slot "actions") · faits
 *   photo 4:5 (col. 8-12), haut aligné sur le haut du H1
 *
 * Options : `fond` (couleur d'une occasion : texte clair), pas d'`image`
 * (pages légales, contact, merci). Aucun objet superposé à la photo.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FilAriane from './FilAriane.astro';
import LigneFaits from './LigneFaits.astro';

interface Props {
  titre: string;
  fil: { nom: string; url: string }[];
  image?: ImageMetadata;
  alt?: string;
  /** Cadrage de la photo, ex. '50% 30%'. */
  cadrage?: string;
  faits?: string[];
  /** Couleur du bloc : 'rose' | 'menthe' | 'beurre' | 'bleu' | 'prune' | 'papier'. */
  fond?: string;
}

const { titre, fil, image, alt = '', cadrage = '50% 40%', faits = [], fond } = Astro.props;
const aActions = Astro.slots.has('actions');
/* Sans photo, la colonne de droite peut recevoir un contenu utile
   (filtres, formulaire, coordonnées) plutôt que rester vide. */
const aAside = !image && Astro.slots.has('aside');
const teinte = fond ?? (image ? 'rose' : 'papier');
const sombre = teinte === 'prune';
---

<header
  class:list={['hdp bande', { 'hdp--seul': !image, 'hdp--aside': aAside, 'hdp--sombre': sombre }]}
  style={`--hdp-fond:var(--${teinte === 'papier' ? 'papier-2' : teinte})`}
>
  <div class="grille">
    <div class="hdp__fil"><FilAriane fil={fil} /></div>

    <div class="hdp__texte">
      <h1>{titre}</h1>
      <div class="hdp__chapo chapo"><slot /></div>
      {aActions && <p class="actions"><slot name="actions" /></p>}
      {faits.length > 0 && <LigneFaits faits={faits} clair={sombre} />}
    </div>

    {aAside && <div class="hdp__aside"><slot name="aside" /></div>}

    {
      image && (
        <figure class="hdp__photo">
          <Image
            src={image}
            alt={alt}
            widths={[400, 640, 880, 1000]}
            sizes="(max-width: 48rem) 92vw, 36vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={`object-position:${cadrage}`}
          />
        </figure>
      )
    }
  </div>
</header>

<style>
  /* Le bento de la maquette « Bobines » : le texte dans un grand bloc de
     couleur, la photo arrondie à côté, à la même hauteur. */
  .hdp { padding-block: clamp(0.5rem, 1.5vw, 1rem) var(--serre); }
  .hdp .grille { row-gap: var(--gout); }
  .hdp__fil { grid-column: 1 / -1; }
  .hdp__texte {
    grid-column: 1 / -1;
    display: grid; gap: 1.25rem; align-content: space-between; justify-items: start;
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--r-l);
    background: var(--hdp-fond);
  }
  .hdp h1 { font-size: var(--t-h1); max-width: 18ch; }
  /* Colonne de texte étroite (5/12) face à un formulaire ou une liste :
     Anybody est large, le H1 descend d'un cran pour tenir en 2-3 lignes. */
  @media (min-width: 48rem) {
    .hdp--aside h1 { font-size: clamp(2.05rem, 1rem + 2.6vw, 3.4rem); }
  }
  .hdp__chapo { max-width: 36rem; color: var(--encre); }
  .hdp__chapo :global(p + p) { margin-block-start: 0.8em; }
  .hdp--sombre .hdp__texte { color: #fff; }
  .hdp--sombre .hdp__chapo { color: color-mix(in oklab, #fff 92%, transparent); }
  .hdp--sombre :global(.btn--wa) { --fond: #fff; --bord: #fff; --texte: var(--prune); --survol: var(--beurre); --survol-texte: var(--encre); }
  .hdp--sombre :global(.btn--creux) { --texte: #fff; --bord: #fff; --survol: #fff; --survol-texte: var(--prune); }
  .hdp--sombre :global(:focus-visible) { outline-color: #fff; }
  .hdp :global(.faits) { color: inherit; }

  .hdp__aside { grid-column: 1 / -1; }
  .hdp__photo {
    grid-column: 1 / -1;
    border-radius: var(--r-l);
    overflow: hidden;
    aspect-ratio: 5 / 4;
    background: var(--papier-2);
  }
  .hdp__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 48rem) {
    .hdp__texte { grid-column: 1 / span 7; }
    .hdp--seul .hdp__texte { grid-column: 1 / -1; }
    .hdp--aside .hdp__texte { grid-column: 1 / span 5; align-self: start; }
    .hdp__aside { grid-column: 6 / -1; }
    .hdp__photo { grid-column: 8 / -1; aspect-ratio: auto; min-height: 100%; }
  }
  @media (min-width: 48rem) {
    .hdp--seul:not(.hdp--aside) .hdp__texte { padding-inline-end: max(clamp(24px, 4vw, 56px), 25%); }
  }
</style>
