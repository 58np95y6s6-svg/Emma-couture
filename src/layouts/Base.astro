---
/**
 * Gabarit de toutes les pages publiques.
 * En-tête, pied, bouton WhatsApp flottant, SEO et données structurées.
 */
import { SITE, CONTACT, ATELIER, COMMUNES, lienWhatsApp } from '../config';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import '../styles/broderie.css';
import '../styles/global.css';

interface Props {
  titre: string;
  description: string;
  /** Image de partage, 1200×630. Chemin absolu depuis la racine du site. */
  imageOg?: string;
  /** Les pages comme /merci/ ne doivent pas être indexées. */
  noindex?: boolean;
  /** Fil d'Ariane : [{ nom, url }], sans l'accueil qui est ajouté seul. */
  fil?: { nom: string; url: string }[];
  /** Message pré-rempli du bouton WhatsApp flottant, propre à la page. */
  messageWa?: string;
  /** false sur les pages qui ont déjà leur barre d'action (contact, fiche). */
  flottant?: boolean;
}

const {
  titre, description, imageOg = '/og-defaut.jpg', noindex = false, fil = [],
  messageWa, flottant = true,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const urlImage = new URL(imageOg, Astro.site ?? SITE.url).href;

/**
 * LocalBusiness sur toutes les pages.
 * ⚠️ Pas d'adresse précise : Emma travaille à son domicile. On publie la
 * ville et la zone desservie, jamais la rue.
 */
const donneesLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#atelier`,
  name: SITE.nom,
  /* Particuliers uniquement : pas de « logos » (positionnement CLAUDE.md).
     Broderie MACHINE ; « cousu main » ne vaut que pour la couture. */
  description:
    'Brodeuse et couturière à Vitré (Ille-et-Vilaine) : broderie machine personnalisée au prénom ou au motif sur linge de bain, vêtements et cadeaux de naissance, dentelle libre, et couture sur mesure de sacs, trousses, pochettes et tabliers cousus main.',
  /* Uniquement ce qu'Emma pratique réellement (constaté sur ses photos). */
  knowsAbout: ['Broderie machine', 'Broderie personnalisée', 'Dentelle libre', 'Couture'],
  url: SITE.url,
  email: CONTACT.email,
  telephone: CONTACT.telephone,
  image: urlImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.ville,
    postalCode: SITE.codePostal,
    addressRegion: SITE.departement,
    addressCountry: 'FR',
  },
  /* Mêmes communes que les pages locales (config.COMMUNES). Pas
     d'AggregateRating : aucun avis réel publié à ce jour. */
  areaServed: [
    { '@type': 'City', name: 'Vitré' },
    { '@type': 'City', name: 'Rennes' },
    ...[...COMMUNES.autourDeVitre, ...COMMUNES.versRennes].map((name) => ({ '@type': 'City', name })),
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
    { '@type': 'Country', name: 'France' },
  ],
  sameAs: [CONTACT.instagramUrl],
};

const donneesFil =
  fil.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ nom: 'Accueil', url: '/' }, ...fil].map((e, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: e.nom,
          item: new URL(e.url, SITE.url).href,
        })),
      }
    : null;
---

<!doctype html>
<html lang={SITE.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#FBF7F3" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={urlImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..150,600..800&family=Atkinson+Hyperlegible+Mono:wght@400;500&family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(donneesLocalBusiness)} />
    {donneesFil && <script type="application/ld+json" set:html={JSON.stringify(donneesFil)} />}
  </head>

  <body>
    <a class="saut" href="#contenu">Aller au contenu</a>

    <Entete />

    <main id="contenu">
      <slot />
    </main>

    <Pied />

    {flottant && <a class="flottant" href={lienWhatsApp(messageWa)}>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-1.5 0-3.9-1.2-5.6-3S7 10.4 7 9.3c0-.8.5-1.6 1-1.9.3-.2.9-.2 1.1.1l.9 1.5c.1.3.1.5-.1.8l-.4.5c-.2.2-.2.4 0 .7.4.7 1.7 2 2.5 2.3.3.1.5.1.7-.1l.6-.6c.2-.2.5-.3.7-.2l1.6.8c.4.2.5.6.4.9Z"
        /></svg
      >
      <span class="lu-seulement">Écrire sur WhatsApp</span>
    </a>}

    <script>
      /* Menu mobile : ouverture, fermeture par Échap, par clic extérieur ou sur
         un lien ; le focus revient au bouton ; la page ne défile plus dessous. */
      const bouton = document.querySelector<HTMLButtonElement>('.burger');
      const menu = document.getElementById('menu-mobile');
      const mot = bouton?.querySelector('.burger__mot');
      if (bouton && menu) {
        const regle = (ouvert: boolean, rendreFocus = false) => {
          bouton.setAttribute('aria-expanded', String(ouvert));
          menu.hidden = !ouvert;
          if (mot) mot.textContent = ouvert ? 'Fermer' : 'Menu';
          document.documentElement.classList.toggle('menu-ouvert', ouvert);
          if (!ouvert && rendreFocus) bouton.focus();
        };
        bouton.addEventListener('click', () => regle(bouton.getAttribute('aria-expanded') !== 'true'));
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) regle(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) regle(false, true);
        });
        document.addEventListener('click', (e) => {
          const cible = e.target as Node;
          if (!menu.hidden && !menu.contains(cible) && !bouton.contains(cible)) regle(false);
        });
      }
    </script>

    <script>
      /* Importé plutôt que référencé en `src` : Astro l'empaquette alors
         avec le reste, au lieu d'émettre un chemin qui n'existe pas. */
      import '../scripts/broderie.js';
    </script>
  </body>
</html>
